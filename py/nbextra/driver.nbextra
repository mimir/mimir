[include]
#include <mim/ast/ast.h>
#include <nanobind/stl/optional.h>
#include <nanobind/stl/pair.h>

[class:Driver]
    // Driver::sym is a template method (fe::SymPool), so the generator skips it;
    // expose the std::string instantiation.
    .def("sym", [](Driver& self, const std::string& s) { return self.sym(s); })
    // Imports::add reports the resolved file as a `const fs::path*` into the
    // Driver's own store — not a Python type. Hand out the path itself instead
    // (None if it did not resolve), paired with add()'s "this file is new" flag.
    .def("add_import", [](Driver& d, std::string path, std::string sym) {
        auto [p, fresh] = d.imports().add(fs::path(path), d.sym(sym), ast::Tok::Tag::K_import);
        std::optional<std::string> resolved;
        if (p) resolved = p->string();
        return std::pair{resolved, fresh};
    })
    .def("add_plugin", [](Driver& d, std::string path, std::string sym) {
        auto [p, fresh] = d.imports().add(fs::path(path), d.sym(sym), ast::Tok::Tag::K_plugin);
        std::optional<std::string> resolved;
        if (p) resolved = p->string();
        return std::pair{resolved, fresh};
    })
    .def("load_plugin", [](Driver& d, std::string plugin) {
        ast::load_plugin(d.world(), plugin);
    })
    .def("load_plugins", [](Driver& d, std::vector<std::string> plugins) {
        ast::load_plugins(d.world(), plugins);
    })
