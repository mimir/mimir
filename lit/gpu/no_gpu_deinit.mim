// RUN: rm -f %t.ll
// RUN: (! %mim %s -p opt)

plugin core;
plugin gpu;

con kernel (m: %gpu.GlobalM, m: %gpu.SharedM, m: %gpu.ConstM, m: %gpu.LocalM,
            group_id item_id: Idx 4, (), data: %gpu.GlobalPtr I32,
            return: Cn [%gpu.GlobalM, %gpu.SharedM, %gpu.ConstM, %gpu.LocalM]) =
    let m = %mem.store (m, data, 42I32);
    return (m, m, m, m);

fun extern main (m: %mem.M 0, argc: I32, argv: %mem.Ptr («⊤:Nat; %mem.Ptr («⊤:Nat; I8», 0)», 0))
: [%mem.M 0, %gpu.GlobalM, I32] =
    let (m, ptr) = %mem.alloc (I32, 0) m;
    let m = %mem.store (m, ptr, argc);

    let (m, m, m) = %gpu.init m;

    let (m, d_ptr) = %mem.alloc (I32, 1) m;
    let (m, m) = %gpu.copy_to_device.block (m, m, ptr, d_ptr);

    ret (m, m, m) = %gpu.launch (4, 4, %gpu.default_stream, ff, ()) kernel d_ptr $ (m, m, m);

    let (m, m) = %gpu.copy_to_host.block (m, m, d_ptr, ptr);
    let m = %mem.free (m, d_ptr);

    let (m, val) = %mem.load (m, ptr);
    let m = %mem.free (m, ptr);

    return (m, m, val);
