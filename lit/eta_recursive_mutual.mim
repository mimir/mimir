// RUN: %mim %s -o - | %FileCheck %s
plugin mem;
plugin compile;

// η-reducing `b1` to `(exit, b2)#c` and `b2` to `(exit, b1)#d` would unfold the recursion forever.
extern lam _compile (): compile.Phase =
    compile.phases ff (compile.phases tt (compile.beta_red, compile.eta_conv));

extern con foo (m: mem.M 0, c: Bool, d: Bool, return: Cn [mem.M 0, Nat]) =
    con exit (m: mem.M 0) = return (m, 1);
    mutual
        con b1 (m: mem.M 0) = (exit, b2)#c m;
        con b2 (m: mem.M 0) = (exit, b1)#d m;
    end
    (b1, b2)#d m;

// CHECK: con b1 ([[M:[[:alnum:]_]+]]: core.M 0) =
// CHECK-NEXT: ({{[[:alnum:]_]+}}, {{[[:alnum:]_]+}})#c [[M]];
