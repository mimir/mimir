// RUN: %mim %s -o - | %FileCheck %s

plugin core;

// The rule's type `{s: Nat} Idx s ↝ Idx s` binds the meta variable `s` its types mention, but not `m`, `a`, or `b`.
rule swap (s: Nat, m: Nat, a b: Idx s): core.wrap.sub m (a, b) => core.wrap.sub m (b, a);
// The type solves `s` and `t` from the argument's type.
rule second (s t: Nat, a: Idx s, b: Idx t): (a, b) => b;

extern lam narrow (x y: I8): I8 = swap ▷ core.wrap.sub 0 (x, y);
extern lam wide (x y: I32): I32 = swap ▷ core.wrap.sub 0 (x, y);
extern lam mixed (x: I8, y: I16): I16 = second ▷ (x, y);
// A Fire that does not match still has the type its argument's type instantiates.
extern lam stuck (x: I16): I16 = swap ▷ x;
extern lam apply (r: {s: Nat} Idx s ↝ Idx s, x: I8): I8 = r ▷ x;
extern lam pass (x y: I8): I8 = apply (swap, core.wrap.sub 0 (x, y));

// CHECK-DAG: extern lam apply ([[R:[a-z_0-9]+]]: {[[S:[a-z_0-9]+]]: Nat} Idx [[S]] ↝ Idx [[S]], [[A:[a-z_0-9]+]]: I8){{.*}}: I8 =
// CHECK-DAG: [[R]] ▷ [[A]];
// CHECK-DAG: extern lam mixed (_: I8, [[MY:[a-z_0-9]+]]: I16){{.*}}: I16 =
// CHECK-DAG: [[MY]];
// CHECK-DAG: extern lam narrow ([[NX:[a-z_0-9]+]]: I8, [[NY:[a-z_0-9]+]]: I8){{.*}}: I8 =
// CHECK-DAG: core.wrap.sub 0 @ i8 ([[NY]], [[NX]]);
// CHECK-DAG: extern lam pass ([[PX:[a-z_0-9]+]]: I8, [[PY:[a-z_0-9]+]]: I8){{.*}}: I8 =
// CHECK-DAG: core.wrap.sub 0 @ i8 ([[PY]], [[PX]]);
// CHECK-DAG: extern lam stuck ([[SX:[a-z_0-9]+]]: I16): I16 =
// CHECK-DAG: (rl {{.*}} => core.wrap.sub {{.*}}) ▷ [[SX]];
// CHECK-DAG: extern lam wide ([[WX:[a-z_0-9]+]]: I32, [[WY:[a-z_0-9]+]]: I32){{.*}}: I32 =
// CHECK-DAG: core.wrap.sub 0 @ i32 ([[WY]], [[WX]]);
