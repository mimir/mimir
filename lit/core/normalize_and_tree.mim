// RUN: %mim %s

plugin core;
plugin refly;

let _ = refly.struc.e
    (core.bit2.and_ 0
        (core.bit2.and_ 0
            (core.bit2.and_ 0 (tt, tt),
             core.bit2.and_ 0 (ff, ff)),
         core.bit2.and_ 0
            (core.bit2.and_ 0 (ff, tt),
             core.bit2.and_ 0 (tt, ff))),
     ff);
