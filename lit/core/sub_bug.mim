// RUN: %mim %s
// see https://github.com/mimir/mimir/issues/253

plugin core;
plugin refly;

// only the wrapping mode may turn `a - 1` into `a + 255`
lam f (a: I8): «4; I8» =
    ( refly.equiv.struc_eq (core.wrap.sub 0              (a, 1I8), core.wrap.add 0              (255I8, a))
    , refly.equiv.struc_ne (core.wrap.sub core.mode.nsw  (a, 1I8), core.wrap.add core.mode.nsw  (255I8, a))
    , refly.equiv.struc_ne (core.wrap.sub core.mode.nuw  (a, 1I8), core.wrap.add core.mode.nuw  (255I8, a))
    , refly.equiv.struc_ne (core.wrap.sub core.mode.nsuw (a, 1I8), core.wrap.add core.mode.nsuw (255I8, a))
    );
