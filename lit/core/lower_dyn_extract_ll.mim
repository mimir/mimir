// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p opt %s -p ll
// RUN: %FileCheck %s < %{s:stem}.ll
// RUN: clang %{s:stem}.ll -o %t -Wno-override-module
// RUN: %t ; test $? -eq 42

plugin core;
plugin mem;

use core.ops.u.w;

// The index is dynamic in `sel` and `upd`, so a component travels as an untagged union.
extern fun sel (t: [I32, I64], i: Idx 2): (I32, I64)#i = return t#i;
extern fun upd (t: [I32, I64], i: Idx 2, v: (I32, I64)#i): [I32, I64] = return (t#i ← v);

extern fun main(m: mem.M 0, argc: I32, argv: mem.Ptr0 «core.idx2nat argc; mem.Ptr0 mem.Char»): [mem.M 0, I32] =
    ret x = sel $ ((30I32, 2I64), 0₂);
    ret y = sel $ ((1I32, 2I64), 1₂);
    ret t = upd $ ((0I32, 0I64), 0₂, 10I32);
    return (m, x + core.conv.u i32 y + t#0₂);

// CHECK-DAG: define [1 x i64] @sel(
// CHECK-DAG: define {{.*}} @upd({{.*}}, [1 x i64] %{{[a-z_0-9]+}})
