// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p opt %s -p ll
// RUN: clang -c %{s:stem}.ll -o %t -Wno-override-module

plugin core;
plugin mem;
plugin refly;

extern con bitcast_bitcast(i: mem.Ptr (I8, 0), return: Cn I32) =
    return (refly.equiv.struc_eq (core.bitcast I32 (core.bitcast Nat i), core.bitcast I32 i));
