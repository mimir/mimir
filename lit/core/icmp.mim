// RUN: %mim -p opt %s -o - | %FileCheck %s

plugin core;

extern lam a(x: Idx 23) = core.icmp.e   (x, x);
extern lam b(x: Idx 23) = core.icmp.ule (x, x);
extern lam c(x: Idx 23) = core.icmp.ul  (x, x);
extern lam d(x: Idx 23) = core.icmp.ne  (x, x);
extern lam e(x: Idx 23) = core.icmp.ne  (x, 7₂₃);

// CHECK-DAG: tt
// CHECK-DAG: tt
// CHECK-DAG: icmp
// CHECK-DAG: ff
