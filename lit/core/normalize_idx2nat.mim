// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p opt %s -p ll
// RUN: clang -c %{s:stem}.ll -o %t -Wno-override-module

plugin core;
plugin mem;
plugin refly;

extern con idx2nat_lit(return: Cn Nat) =
    return (refly.struc.e (core.idx2nat 42I8, 42));

extern con idx2nat_unit(x: Idx 1, return: Cn Nat) =
    return (refly.struc.e (core.idx2nat x, 0));

extern con idx2nat_dyn(m: mem.M 0, x: I8, p: mem.Ptr0 «core.idx2nat x; I32», return: Cn [mem.M 0, I32]) =
    return (mem.load (m, mem.lea (p, core.conv.u (core.idx2nat x) 0I8)));

extern con bitcast_idx2nat(i: I64, return: Cn [I64, I8]) =
    return (refly.struc.e (core.bitcast I64 (core.idx2nat i), i), refly.struc.e (core.bitcast I8 (core.idx2nat i), core.bitcast I8 i));
