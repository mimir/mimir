// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p opt %s -p ll -o -
// RUN: clang %{s:stem}.ll -o %t -Wno-override-module
// RUN: %t ; test $? -eq 81

plugin core;
plugin mem;

use core.ops.u.w;

fun pow(a b: I32): I32 =
    con pow_cont(v: I32) =
        return (a * v);

    con pow_then() =
        return 1I32;

    con pow_else() =
        pow ((a, b - 1I32), pow_cont);

    let cmp = b == 0I32;
    (pow_else, pow_then)#cmp ();

extern fun main(m: mem.M 0, argc: I32, argv: mem.Ptr0 (mem.Ptr0 I8)): [mem.M 0, I32] =
    ret res = pow $ (3I32, 4I32);
    return (m, res);
