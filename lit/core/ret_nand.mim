// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p opt %s -p ll
// RUN: clang %{s:stem}.ll -o %t -Wno-override-module
// RUN: %t 3 10 ; test $? -eq 13

plugin core;
plugin mem;

extern con atoi [mem.M 0, mem.Ptr0 mem.Char, Cn [mem.M 0, I32]];

extern con main (m: mem.M 0, argc: I32, argv: mem.Ptr0 «core.idx2nat argc; mem.Ptr0 mem.Char», return: Cn [mem.M 0, I32]) =
    let argv_ptr_a = mem.lea (argv, core.idx 0 (core.idx2nat argc) 1);
    let (m, val) = mem.load (m, argv_ptr_a);
    atoi (m, val, atoi_cont_a)
    where
        con atoi_cont_a (m: mem.M 0, a: I32) =
            let argv_ptr_b = mem.lea (argv, core.idx 0 (core.idx2nat argc) 2);
            let argv_load_b = mem.load (m, argv_ptr_b);
            atoi (argv_load_b#0₂, argv_load_b#1₂, atoi_cont_b)
            where
                con atoi_cont_b (m: mem.M 0, b: I32) = return (m, core.bit2.and 0 (0b00000000000000000000000000001111I32, core.bit2.nand 0 (a, b)));
            end;
    end;
