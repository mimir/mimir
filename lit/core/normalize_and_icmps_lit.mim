// RUN: %mim %s

plugin core;
plugin refly;

let _ = refly.equiv.struc_eq (core.bit2.and_ 0 (core.icmp.uge (tt, ff), core.icmp.ug (tt, ff)), tt);

lam and_lit2 (in: I8): Bool =
    refly.equiv.struc_eq (core.bit2.and_ 0 (core.icmp.uge (in, 'a'), core.icmp.ule (in, 'a')),
                          core.icmp.e (in, 'a'));
