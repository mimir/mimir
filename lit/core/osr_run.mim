// RUN: rm -f %{s:stem}.ll
// RUN: %mim %s -p ll -o - | %FileCheck %s
// RUN: clang %{s:stem}.ll -o %t -Wno-override-module
// RUN: %t ; test $? -eq 80
// RUN: %t a b ; test $? -eq 210

plugin core;
plugin mem;
plugin compile;
plugin opt;

// Sums `i * 7I32 + argc * i` for `i < argc + 4I32`.
extern fun main(m: mem.M 0, argc: I32, argv: mem.Ptr0 «core.idx2nat argc; mem.Ptr0 mem.Char»): [mem.M 0, I32] =
    head (0I32, 0I32) where
        con head (i s: I32) =
            (exit, body)#(core.icmp.sl (i, core.wrap.add 0 (argc, 4I32))) () where
                con body () =
                    let s = core.wrap.add 0 (s, core.wrap.mul 0 (i, 7I32));
                    head (core.wrap.add 0 (i, 1I32), core.wrap.add 0 (s, core.wrap.mul 0 (argc, i)));
                con exit () = return (m, s);
            end;
    end;

extern lam _compile(): compile.Phase = compile.phases ff (core.osr, opt._default_compile ());

// CHECK-NOT: core.wrap.mul
