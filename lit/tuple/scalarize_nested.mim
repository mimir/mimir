// RUN: %mim -p opt %s -o - --scalarize-threshold 32 | %FileCheck %s
// RUN: %mim -p opt %s -o - --scalarize-threshold 64 | %FileCheck %s
plugin tuple;
plugin refly;

con f (i : Idx 4, t : <<(4, 4, 4); Nat>>, r : Cn [<<(4, 4); Nat>>]) = r t#i;

con extern main(i :(Idx 2), r : Cn [<<(4, 4); Nat>>]) = (f (2:(Idx 4), <4,4,4; 20>, r), f (3:(Idx 4), ‹4, 4, 4; 19›, r))#i;

// `t` is Extract%ed with the non-constant index `i`, so it must NOT be scalarized -
// splitting it would only force the body to reassemble the tuple.
// Hence `f` keeps its nested array parameter regardless of the threshold and the packs
// stay nested at the call sites.
// CHECK-DAG: ‹4; ‹4; ‹4; 20›››
// CHECK-DAG: ‹4; ‹4; ‹4; 19›››
