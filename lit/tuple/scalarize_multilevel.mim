// RUN: %mim -p opt %s -o - --scalarize-threshold 8 | %FileCheck %s
// RUN: %mim -p opt %s -o - --scalarize-threshold 2 | %FileCheck %s --check-prefix=KEEP
plugin core;
plugin tuple;
plugin refly;

use core.ops.n;

con f (t: «2, 2; Nat», r: Cn Nat) =
    let ((a, b), (c, d)) = t;
    r (a + b + c + d);

extern con main(i: Idx 2, r: Cn Nat) =
    (f (((10, 20), (30, 40)), r), f (((50, 60), (70, 80)), r))#i;

// `t` is only Extract%ed with constant indices, so it may be scalarized.
// Scalarize peels one level per run; the surrounding fixed-point pipeline re-runs it until
// the fused «2, 2; Nat» is fully flattened into 4 scalar arguments.
// CHECK-DAG: f (10, 20, 30, 40)
// CHECK-DAG: f (50, 60, 70, 80)

// With the threshold at the arity (2), num_tprojs yields 1, so nothing is scalarized and the
// nested tuple is kept.
// KEEP-DAG: ((10, 20), (30, 40))
// KEEP-DAG: ((50, 60), (70, 80))
