// RUN: %mim %s -o %t.mim
// RUN: %mim --no-opt %t.mim -o - | %FileCheck %s

plugin core;
plugin mem;
plugin x86;
import compile;

extern lam _compile (): compile.Phase = compile.phases ff (compile.named "x86.isel", compile.named "x86.schedule");

extern con fused (m: mem.M 0, a b x y: I32, return: Cn [mem.M 0, I32]) = return (m, (x, y)#(core.icmp.sl (a, b)));
extern con plain (m: mem.M 0, c: Bool, x y: I64, return: Cn [mem.M 0, I64]) = return (m, (x, y)#c);
extern con byte (m: mem.M 0, c: Bool, x y: I8, return: Cn [mem.M 0, I8]) = return (m, (x, y)#c);
extern con flag (m: mem.M 0, c x y: Bool, return: Cn [mem.M 0, Bool]) = return (m, (x, y)#c);

// CHECK-DAG: (x86.cmp @ i32)
// CHECK-DAG: (x86.cmovcc.l @ i32)
// CHECK-DAG: (x86.cmovcc.ne @ 0)
// CHECK-DAG: (x86.movzx @ i8 i32)
// CHECK-DAG: (x86.trunc @ i32 i8)
// CHECK-DAG: (x86.movzx @ 2 i32)
// CHECK-DAG: (x86.trunc @ i32 2)
