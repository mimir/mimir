// RUN: %mim %s -o - | %FileCheck %s

plugin mem;
plugin x86;

extern con g (m: mem.M 0, a: I32, return: Cn [mem.M 0, I32]) =
    return (m, x86.add (a, x86.add (x86.mov 1I32, x86.mov 2I32)));

extern con f (m: mem.M 0, a: I32, return: Cn [mem.M 0, I32]) =
    g (m, x86.add (a, x86.add (x86.mov 1I32, x86.mov 2I32)), return);

// CHECK-COUNT-4: (x86.mov @ i32)
