// RUN: %mim %s -o - | %FileCheck %s

plugin core;
plugin mem;
plugin x86;
import compile;

extern lam _compile (): compile.Phase = compile.phases ff (compile.named "x86.legalize", compile.named "x86.isel", compile.named "x86.schedule");

extern con f (m: mem.M 0, x: I32, return: Cn [mem.M 0, I32]) =
    ret (m, p) = mem.mslot (I8, 0) $ (m, 16);
    let m = mem.store (m, p, 0I8);
    return (m, x);

// CHECK-NOT: mem.mslot
// CHECK: x86.slot 16
