// RUN: %mim %s -X x86:k=4 -X x86:live=%t.live -o - | %FileCheck %s
// RUN: %FileCheck %s --check-prefix=LIVE < %t.live

plugin compile;
plugin mem;
plugin x86;

/// At the entry of `join`, `a`, `b`, `d`, and `c` are used before `y`, so `y` becomes a memory φ.
extern con f (m: mem.M 0, c: Bool, a b d: I32, return: Cn [mem.M 0, I32]) =
    con join (m: mem.M 0, y: I32) =
        return (m, x86.add (x86.add (x86.add (x86.add (a, b), d), x86.movzx i32 c), y));
    con t (m: mem.M 0) = join (m, 1I32);
    con e (m: mem.M 0) = join (m, 7I32);
    (e, t)#c m;

extern lam _compile (): compile.Phase = compile.phases ff (x86.schedule, x86.spilling, x86.live);

// CHECK-DAG: con join (m{{[_0-9]*}}: core.M 0, y: x86.Spill i32)
// CHECK-DAG: (x86.reload @ i32) {{.*}} y;
// CHECK-DAG: (x86.spill @ i32) m{{[_0-9]*}} 7I32;
// CHECK-DAG: (x86.spill @ i32) m{{[_0-9]*}} 1I32;
// LIVE:      fun f
// LIVE-NOT:  max {{([5-9]|[1-9][0-9]+)}} flags
