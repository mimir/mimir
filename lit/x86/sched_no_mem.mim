// RUN: (! %mim %s -o - 2>&1) | %FileCheck %s

plugin core;
plugin mem;
plugin mach;
plugin x86;
import compile;

extern lam _compile (): compile.Phase = compile.phases ff (mach.legalize, compile.named "x86.isel", mach.schedule);

extern con f (a b: I32, return: Cn I32) = return (core.wrap.add 0 (a, b));

// CHECK: x86 backend: continuation `f` has no `mem.M` to schedule on
