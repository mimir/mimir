// RUN: %mim %s -o - | %FileCheck %s

plugin core;
plugin mem;
plugin mach;
plugin x86;
import compile;

extern lam _compile (): compile.Phase = compile.phases ff (mach.legalize, compile.named "x86.isel");

// A left shift by 2 is the index scaled by 4, so no `shl` remains.
extern lam f (m: mem.M 0, p i: I64): [mem.M 0, I8] =
    mach.load I8 (m, core.wrap.add 0 (p, core.wrap.shl 0 (i, 2I64)));

// CHECK-NOT: x86.shl
// CHECK: x86.index {{.*}} (i, 2I2)
// CHECK-NOT: x86.shl
