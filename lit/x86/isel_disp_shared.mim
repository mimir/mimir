// RUN: %mim %s -o - | %FileCheck %s

plugin core;
plugin mem;
plugin x86;
import compile;

extern lam _compile (): compile.Phase = compile.phases ff (compile.named "x86.isel");

// Both addresses share `i + 4`, which each folds into its displacement nevertheless.
extern lam f (m: mem.M 0, p q: mem.Ptr0 I8, i: I64): [mem.M 0, I8] =
    let j = core.wrap.add 0 (i, 4I64);
    let (m, x) = mem.load (m, mem.ptradd (p, j));
    let (m, y) = mem.load (m, mem.ptradd (q, j));
    (m, core.wrap.add 0 (x, y));

// CHECK-NOT: x86.add @ 0
// CHECK-COUNT-2: x86.addr (4I32,
// CHECK-NOT: x86.add @ 0
