// RUN: %mim --no-opt %s -o - | FileCheck %s

plugin mem;
plugin x86;

extern lam f (a b: I32): I32 =
    let x = x86.add (a, b);
    let y = x86.imul (x, 3I32);
    x86.cmovcc 12 (x86.cmp (x, y), x, y);

// CHECK: x86.cmovcc 12

extern lam g (m: mem.M 0, p i: I64): [mem.M 0, I32] =
    let a = x86.addr (2I2, 0I32) (p, i);
    let (m, x) = x86.load 4294967296 (m, a);
    (x86.store (m, a, x86.add (x, 1I32)), x);

// CHECK: x86.load i32
