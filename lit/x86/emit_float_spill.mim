// REQUIRES: x86_64-linux
// RUN: %mim %s -p x86 -X x86:o=%t.s
// RUN: %FileCheck %s < %t.s
// RUN: clang %t.s -o %t
// RUN: %t a b ; test $? -eq 10

plugin core;
plugin mem;
plugin math;
plugin x86;

use math.ops.none;

extern con g (m: mem.M 0, x: math.F32, return: Cn [mem.M 0, math.F32]) =
    return (m, x * 2.0:math.F32);

/// `a` is live across the call to `g`, which clobbers every XMM register, so it goes to the stack.
extern con main (m: mem.M 0, argc: I32, return: Cn [mem.M 0, I32]) =
    let a = math.conv.s2f math.f32 argc;
    let b = a + 1.5:math.F32;
    con k (m: mem.M 0, y: math.F32) = return (m, math.conv.f2s i32 (b + y));
    g (m, a, k);

// CHECK-DAG: movss %xmm{{[0-9]+}}, -{{[0-9]+}}(%rbp)
// CHECK-DAG: movss -{{[0-9]+}}(%rbp), %xmm{{[0-9]+}}
