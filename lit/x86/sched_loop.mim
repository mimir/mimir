// RUN: %mim %s -o - | %FileCheck %s

plugin core;
plugin mem;
plugin x86;

extern con f (m: mem.M 0, p: I64, a b: I32, return: Cn [mem.M 0, I32]) =
    con loop (m: mem.M 0, i: I32) =
        let (m, c) = x86.load i8 (m, x86.addr (0I32, p));
        con exit (m: mem.M 0) = return (m, i);
        con body (m: mem.M 0) = loop (m, x86.add (i, x86.imul (a, x86.mov 7I32)));
        (exit, body)#(core.icmp.ne (c, 0I8)) m;
    loop (m, b);

// CHECK: (x86.mov @ i32)
// CHECK: (x86.imul @ i32)
// CHECK: con loop
// CHECK: con body
// CHECK: (x86.add @ i32)
// CHECK-NOT: x86.imul
