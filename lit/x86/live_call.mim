// RUN: %mim %s | %FileCheck %s

plugin compile;
plugin mem;
plugin x86;

extern con g [mem.M 0, I32, Cn [mem.M 0, I32]];

extern con f (m: mem.M 0, a b: I32, return: Cn [mem.M 0, I32]) =
    con k (m: mem.M 0, x: I32) =
        let (q, r) = x86.div (b, x);
        return (m, x86.add (q, r));
    g (m, x86.add (a, b), k);

extern lam _compile (): compile.Phase = compile.phases ff (x86.schedule, x86.live);

// `b` survives the call, and `div` yields two values.
// CHECK:      fun f
// CHECK-NEXT: f: in {} out {b{{[_0-9]*}}} max 2 fpr 0 flags 0
// CHECK-NEXT: k{{[_0-9]*}}: in {b{{[_0-9]*}}} out {} max 2 fpr 0 flags 0
