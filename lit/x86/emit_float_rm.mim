// REQUIRES: x86_64-linux
// RUN: %mim %s -p x86 -X x86:o=%t.s
// RUN: %FileCheck %s < %t.s
// RUN: clang -c %t.s -o %t.o

plugin core;
plugin mem;
plugin math;
plugin x86;

use math.ops.none;

/// The loaded operand comes second, so it folds.
extern con sub_rm (m: mem.M 0, p: mem.Ptr0 math.F32, x: math.F32, return: Cn [mem.M 0, math.F32]) =
    let (m, y) = mem.load (m, p);
    return (m, x - y);

/// The loaded operand comes first, but `add` and `mul` commute.
extern con add_rm (m: mem.M 0, p: mem.Ptr0 math.F32, x: math.F32, return: Cn [mem.M 0, math.F32]) =
    let (m, y) = mem.load (m, p);
    return (m, y + x);

extern con mul_rm (m: mem.M 0, p: mem.Ptr0 math.F64, x: math.F64, return: Cn [mem.M 0, math.F64]) =
    let (m, y) = mem.load (m, p);
    return (m, y * x);

/// `sub` does not commute, so a loaded first operand stays a load.
extern con sub_load (m: mem.M 0, p: mem.Ptr0 math.F32, x: math.F32, return: Cn [mem.M 0, math.F32]) =
    let (m, y) = mem.load (m, p);
    return (m, y - x);

/// `ucomiss` reads its source from memory: `y < x` is `x > y`, but `x < y` needs `y` in a register.
extern con lt_rm (m: mem.M 0, p: mem.Ptr0 math.F32, x: math.F32, return: Cn [mem.M 0, Bool]) =
    let (m, y) = mem.load (m, p);
    return (m, math.cmp.l math.mode.none (y, x));

extern con lt_load (m: mem.M 0, p: mem.Ptr0 math.F32, x: math.F32, return: Cn [mem.M 0, Bool]) =
    let (m, y) = mem.load (m, p);
    return (m, math.cmp.l math.mode.none (x, y));

extern con conv_rm (m: mem.M 0, p: mem.Ptr0 I64, return: Cn [mem.M 0, math.F64]) =
    let (m, y) = mem.load (m, p);
    return (m, math.conv.s2f math.f64 y);

extern con sqrt_rm (m: mem.M 0, p: mem.Ptr0 math.F32, return: Cn [mem.M 0, math.F32]) =
    let (m, y) = mem.load (m, p);
    return (m, math.rt.sq math.mode.none y);

// CHECK-DAG: subss (%rdi), %xmm0
// CHECK-DAG: addss (%rdi), %xmm0
// CHECK-DAG: mulsd (%rdi), %xmm0
// CHECK-DAG: movss (%rdi), %xmm{{[0-9]+}}
// CHECK-DAG: ucomiss (%rdi), %xmm0
// CHECK-DAG: ucomiss %xmm0, %xmm{{[0-9]+}}
// CHECK-DAG: cvtsi2sdq (%rdi), %xmm0
// CHECK-DAG: sqrtss (%rdi), %xmm0
