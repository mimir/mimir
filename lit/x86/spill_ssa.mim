// RUN: %mim %s -X x86:k=3 -X x86:live=%t.live -o - | %FileCheck %s
// RUN: %FileCheck %s --check-prefix=LIVE < %t.live

plugin compile;
plugin mem;
plugin x86;

/// `t` evicts `a` and reloads it for `join`, while `e` keeps it, so `join` gets a new parameter for `a`.
extern con f (m: mem.M 0, c: Bool, a b: I32, return: Cn [mem.M 0, I32]) =
    con join (m: mem.M 0, y: I32) = return (m, x86.add (a, y));
    con t (m: mem.M 0) = join (m, x86.sub (x86.imul (x86.add (b, 1I32), x86.add (b, 2I32)), b));
    con e (m: mem.M 0) = join (m, b);
    (e, t)#c m;

extern lam _compile (): compile.Phase = compile.phases ff (x86.schedule, x86.spilling, x86.live);

// CHECK-DAG: con join (m{{[_0-9]*}}: core.M 0, y: I32, a{{[_0-9]+}}: I32)
// CHECK-DAG: join (m{{[_0-9]*}}, b, a);
// CHECK-DAG: [[R:_[0-9]+]] = x86.sched @ (x86.Spill i32, I32) (x86.reload @ i32)
// CHECK-DAG: join ([[R]]#ff, {{_[0-9]+}}#tt, [[R]]#tt);
// LIVE:      fun f
// LIVE-NOT:  max {{([4-9]|[1-9][0-9]+)}} flags
