// RUN: %mim %s -o - | %FileCheck %s

plugin compile;
plugin mem;
plugin x86;

extern con f (m: mem.M 0, c: Bool, a b: I32, return: Cn [mem.M 0, I32]) =
    let x = x86.add (a, b);
    con join (m: mem.M 0, y: I32) = return (m, x86.imul (x, y));
    con t (m: mem.M 0) = join (m, x86.add (x, 1I32));
    con e (m: mem.M 0) = join (m, a);
    (e, t)#c m;

extern lam _compile (): compile.Phase = compile.phases ff (compile.named "x86.schedule");

// CHECK: extern con f
// CHECK-NEXT: (x86.add @ i32) {{.*}} (a, b);
// CHECK-NOT: (a, b)
