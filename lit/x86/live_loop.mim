// RUN: %mim %s | %FileCheck %s

plugin compile;
plugin mem;
plugin x86;

extern con f (m: mem.M 0, n a: I32, return: Cn [mem.M 0, I32]) =
    con head (m: mem.M 0, i acc: I32) =
        con body (m: mem.M 0) = head (m, x86.add (i, 1I32), x86.add (acc, a));
        con exit (m: mem.M 0) = return (m, x86.imul (acc, a));
        (exit, body)#(x86.cc.l (x86.cmp (i, n))) m;
    head (m, 0I32, 0I32);

extern lam _compile (): compile.Phase = compile.phases ff (x86.schedule, x86.live);

// `n` and `a` are live around the loop, while `i` and `acc` are parameters of `head`; the branch consumes the flags, not the `Bool` of the `cc`.
// CHECK:      fun f
// CHECK-NEXT: f: in {} out {n{{[_0-9]*}}, a{{[_0-9]*}}} max 2 fpr 0 flags 0
// CHECK-NEXT: head{{[_0-9]*}}: in {n{{[_0-9]*}}, a{{[_0-9]*}}} out {i{{[_0-9]*}}, n{{[_0-9]*}}, acc{{[_0-9]*}}, a{{[_0-9]*}}} max 4 fpr 0 flags 1
// CHECK-DAG:  exit{{[_0-9]*}}: in {acc{{[_0-9]*}}, a{{[_0-9]*}}} out {} max 2 fpr 0 flags 0
// CHECK-DAG:  body{{[_0-9]*}}: in {i{{[_0-9]*}}, n{{[_0-9]*}}, acc{{[_0-9]*}}, a{{[_0-9]*}}} out {n{{[_0-9]*}}, a{{[_0-9]*}}} max 4 fpr 0 flags 0
