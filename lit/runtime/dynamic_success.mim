// RUN: rm -f dynamic_success.ll
// RUN: %mim -p opt -p clos %s -p ll
// RUN: clang dynamic_success.ll -o %t -Wno-override-module
// RUN: %t; test $? -eq 7

plugin runtime;
plugin core;

con extern main [mem: %mem.M 0, argc: I32,
                 argv: %mem.Ptr (%mem.Ptr (I8, 0), 0),
                 return: Cn [%mem.M 0, I32]] =
    let condition = %core.icmp.sg (argc, 0I32);
    let mem = %runtime.assert (mem, condition, "dynamic success");
    return (mem, 7I32);
