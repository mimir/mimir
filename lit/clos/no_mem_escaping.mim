// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p opt -p clos %s -p ll
// RUN: clang %S/../lib.c %{s:stem}.ll -o %t -Wno-override-module
// RUN: %t | %FileCheck %s

// Regression test for #126: closures whose Pi type has no leading mem.M must still be closure-converted
// correctly. `f`, `g`, and `h` are typed `Cn [I32, Cn I32]` -- no mem -- yet are packed into real, escaping
// (heap-stored) closures, so this exercises the actual env-packing/unpacking machinery rather than relying on
// scalarize to inline everything away.

plugin core;
plugin mem;

use core.ops.u.w;

extern con println_i32 [m: mem.M 0, val: I32, return: Cn [mem.M 0]];

con f (x: I32, k: Cn I32) = k (x + 42I32);
con g (x: I32, k: Cn I32) = k (1I32);

extern con main (m: mem.M 0, argc: I32, argv: mem.Ptr (mem.Ptr (I8, 0), 0), return: Cn [mem.M 0, I32]) =
    con h (x: I32, k: Cn I32) = k (x + argc);

    let pb_type = Cn [I32, Cn I32];

    let (m, pb_ptr) = mem.malloc (pb_type, 0) (m, 96);
    let pb_arr         = core.bitcast (mem.Ptr («⊤:Nat; pb_type», 0)) pb_ptr;

    let lea = mem.lea (pb_arr, core.idx_unsafe 0);
    let m = mem.store (m, lea, f);
    let lea = mem.lea (pb_arr, core.idx_unsafe 1);
    let m = mem.store (m, lea, g);
    let lea = mem.lea (pb_arr, core.idx_unsafe 2);
    let m = mem.store (m, lea, h);

    let (m, func0) = mem.load (m, mem.lea (pb_arr, core.idx_unsafe 0));
    let (m, func1) = mem.load (m, mem.lea (pb_arr, core.idx_unsafe 1));
    let (m, func2) = mem.load (m, mem.lea (pb_arr, core.idx_unsafe 2));

    func0 (1I32, cn (r0: I32) =
        func1 (1I32, cn (r1: I32) =
            func2 (1I32, cn (r2: I32) =
                println_i32 (m, r0, cn (m: mem.M 0) =
                    println_i32 (m, r1, cn (m: mem.M 0) =
                        println_i32 (m, r2, cn (m: mem.M 0) =
                            return (((m, 0I32)))))))));

// CHECK: 43
// CHECK: 1
// CHECK: 2
