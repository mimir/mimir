// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p opt -p clos %s -p ll -o -

plugin core;
plugin mem;

use core.ops.u.w;

let void_ptr = mem.Ptr («⊤:Nat; []», 0);

extern con printInteger [m: mem.M 0, val: I32, return: Cn [mem.M 0]];
extern con printNL [m: mem.M 0, return: Cn [mem.M 0]];
extern con time [m: mem.M 0, return: Cn [mem.M 0, void_ptr]];
extern con print_time_diff [m: mem.M 0, t1 t2: void_ptr, return: Cn [mem.M 0]];

let arr_size = ⊤:Nat;
let size = 100000;

con printArr (m: mem.M 0, arr: mem.Ptr («size; I32», 0), return: Cn [mem.M 0]) =
    con loop_body (m: mem.M 0, i: I32, continue: Cn mem.M 0) =
        let lea = mem.lea (arr, core.bitcast (Idx arr_size) i);
        let (load_mem, val) = mem.load (m, lea);
        printInteger(load_mem, val, continue);

    con loop_head (m: mem.M 0, i: I32) =
        con yield (m: mem.M 0) = loop_head( m, i + 1I32);
        con enter (m: mem.M 0) = loop_body ( m, i, yield );
        con exit (m: mem.M 0) = printNL (m, return);

        let condition = i < core.bitcast I32 size;
        let target = (exit, enter)#condition;
        target ( m );

    loop_head ( m, 0I32 );

con init (m: mem.M 0, arr: mem.Ptr («size; I32», 0), offset: I32, return: Cn [mem.M 0]) =
    con loop_body (m: mem.M 0, i: I32, continue: Cn mem.M 0) =
        let lea = mem.lea (arr, core.bitcast (Idx arr_size) i);
        let add = offset + i;
        let store_mem = mem.store (m, lea, add);
        continue(store_mem);

    con loop_head (m: mem.M 0, i: I32) =
        con yield (m: mem.M 0) = loop_head( m, i + 1I32);
        con enter (m: mem.M 0) = loop_body ( m, i, yield );

        let condition = i < core.bitcast I32 size;
        let target = (return, enter)#condition;
        target ( m );

    loop_head ( m, 0I32 );

con const (m: mem.M 0, arr: mem.Ptr («size; I32», 0), constValue: I32, return: Cn [mem.M 0]) =
    con loop_body (m: mem.M 0, i: I32, continue: Cn mem.M 0) =
        let lea = mem.lea (arr, core.bitcast (Idx arr_size) i);
        let store_mem = mem.store (m, lea, constValue);
        continue(store_mem);

    con loop_head (m: mem.M 0, i: I32) =
        con yield (m: mem.M 0) = loop_head( m, i + 1I32);
        con enter (m: mem.M 0) = loop_body ( m, i, yield );

        let condition = i < core.bitcast I32 size;
        let target = (return, enter)#condition;
        target ( m );

    loop_head ( m, 0I32 );

con outer (m: mem.M 0, x: I32, return: Cn [mem.M 0]) =
    let (alloc_mem_a, a_arr) = mem.alloc («size; I32», 0) (m);
    let (alloc_mem_b, b_arr) = mem.alloc («size; I32», 0) (alloc_mem_a);
    let (alloc_mem_c, c_arr) = mem.alloc («size; I32», 0) (alloc_mem_b);

    let (alloc_mem_ad, ad_arr) = mem.alloc («size; I32», 0) (alloc_mem_c);
    let (alloc_mem_bd, bd_arr) = mem.alloc («size; I32», 0) (alloc_mem_ad);
    let (alloc_mem_cd, cd_arr) = mem.alloc («size; I32», 0) (alloc_mem_bd);

    let pb_type = Cn [mem.M 0, I32, Cn [mem.M 0]];
    let (alloc_pb_mem, pb_ptr) = mem.alloc («size; pb_type», 0) (alloc_mem_cd);
    let pb_arr = core.bitcast (mem.Ptr («⊤:Nat; pb_type», 0)) pb_ptr;
    let finish_mem = alloc_pb_mem;

    con loop_body (m: mem.M 0, i: I32, return: Cn mem.M 0) =
        let a_lea = mem.lea (a_arr, core.bitcast (Idx arr_size) i);
        let b_lea = mem.lea (b_arr, core.bitcast (Idx arr_size) i);
        let c_lea = mem.lea (c_arr, core.bitcast (Idx arr_size) i);

        let (a_load_mem, a_val) = mem.load (m, a_lea);
        let (b_load_mem, b_val) = mem.load (a_load_mem, b_lea);

        let prod = a_val * b_val;

        let c_store_mem = mem.store (b_load_mem, c_lea, prod);

        con left_pb (m: mem.M 0, s: I32, return: Cn [mem.M 0]) =
            let ad_lea = mem.lea (ad_arr, core.bitcast (Idx arr_size) i);
            let (load_mem, val) = mem.load (m, ad_lea);
            let new_val = val + s;
            let store_mem = mem.store (load_mem, ad_lea, new_val);
            return store_mem;

        con right_pb (m: mem.M 0, s: I32, return: Cn [mem.M 0]) =
            let bd_lea = mem.lea (bd_arr, core.bitcast (Idx arr_size) i);
            let (load_mem, val) = mem.load (m, bd_lea);
            let new_val = val + s;
            let store_mem = mem.store (load_mem, bd_lea, new_val);
            return store_mem;

        con mul_pb (m: mem.M 0, s: I32, return: Cn [mem.M 0]) =
            let sa_mul = s * b_val;

            con next (m: mem.M 0) =
                right_pb(m, s * a_val, return);

            left_pb( m, sa_mul,  next);

        let lea_pb = mem.lea (pb_arr, core.bitcast (Idx arr_size) i);
        let store_pb_mem = mem.store (c_store_mem, lea_pb, mul_pb);

        return(store_pb_mem);

    con print_c (m: mem.M 0) = printArr(m, c_arr, return);
    con print_b (m: mem.M 0) = printArr(m, b_arr, print_c);
    con print_a (m: mem.M 0) = printArr(m, a_arr, print_b);
    con print_cd(m: mem.M 0) = printArr(m, cd_arr, print_a);
    con print_bd(m: mem.M 0) = printArr(m, bd_arr, print_cd);
    con print_ad(m: mem.M 0) = printArr(m, ad_arr, print_bd);

    con time_start_cont (m: mem.M 0, start_time: void_ptr) =
        con timer (m: mem.M 0) =
            con time_end_cont (m: mem.M 0, end_time: void_ptr) =
                print_time_diff (m, start_time, end_time, print_ad);
            time (m, time_end_cont);
            // print_ad(mem)

        con backward_loop_head (m: mem.M 0, i: I32) =
            con yield (m: mem.M 0) = backward_loop_head( m, i + 1I32 );

            con enter (m: mem.M 0) =
                let lea_pb = mem.lea (pb_arr, core.bitcast (Idx arr_size) i);
                let (backward_pass_mem, backward_pass) = mem.load (m, lea_pb);
                backward_pass ( backward_pass_mem, 1I32, yield );

            let condition = i < core.bitcast I32 size;
            let target = (timer, enter)#condition;
            target ( m );

        con loop_head (m: mem.M 0, i: I32) =
            con exit (m: mem.M 0) = backward_loop_head(m, 0I32);
            con yield (m: mem.M 0) = loop_head( m, i + 1I32);
            con enter (m: mem.M 0) = loop_body ( m, i, yield );

            let condition = i < core.bitcast I32 size;
            let target = (exit, enter)#condition;
            target ( m );
        loop_head ( m, 0I32 );

    con init_a (m: mem.M 0) =
        con init_b (m: mem.M 0) =
            con init_c (m: mem.M 0) =
                con init_ad (m: mem.M 0) =
                    con init_bd (m: mem.M 0) =
                        con init_cd (m: mem.M 0) =
                            time (m, time_start_cont);
                            // loop_head ( mem, 0I32 )
                        const(m, cd_arr, 1I32, init_cd);
                    const(m, bd_arr,  0I32, init_bd);
                const(m, ad_arr,  0I32, init_ad);
            const(m, c_arr, 0I32, init_c);
        init(m, b_arr, 1I32, init_b);
    init(finish_mem, a_arr, 0I32, init_a);

extern con main (m: mem.M 0, argc: I32, argv: mem.Ptr («⊤:Nat; mem.Ptr («⊤:Nat; I8», 0)», 0), return: Cn [mem.M 0, I32]) =
    con callback (m: mem.M 0) = return (m, 1I32);
    outer(m, 1I32, callback);
