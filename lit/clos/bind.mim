// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p opt -p clos %s -p ll
// RUN: clang %S/../lib.c %{s:stem}.ll -o %t -Wno-override-module
// RUN: %t | %FileCheck %s

plugin mem;
plugin core;

use core.ops.u.w;

let pb_type = Cn [mem.M 0, Cn [mem.M 0]];
let size    = 100;

extern con println_i32 [m: mem.M 0, val: I32, return: Cn [mem.M 0]];

con recursive (m: mem.M 0, i: I32, last_pullback: pb_type, return: Cn [mem.M 0]) =
    let condition = i < core.bitcast I32 size;
    (exit, loop_body)#condition m
    where
        con loop_body (m: mem.M 0) =
            println_i32( m, i , next )
            where
                con next (m: mem.M 0) =
                    recursive( m, i + 1I32, pb, return )
                    where
                        con pb (m: mem.M 0, return: Cn [mem.M 0]) =
                            println_i32( m, i , next )
                            where
                                con next (m: mem.M 0) = last_pullback (m, return);
                            end;
                    end;
            end;

        con exit (m: mem.M 0) = last_pullback ( m, return );
    end;

con outer (m: mem.M 0, x: I32, return: Cn [mem.M 0]) =
    recursive ( m, 0I32, end_, return )
    where
        con end_ (m: mem.M 0, return: Cn [mem.M 0]) = return m;
    end;

extern con main (m: mem.M 0, argc: I32, argv: mem.Ptr («⊤:Nat; mem.Ptr («⊤:Nat; I8», 0)», 0), return: Cn [mem.M 0, I32]) =
    outer(m, 1I32, callback)
    where
        con callback (m: mem.M 0) = return (m, 0I32);
    end;

// CHECK: 99
// CHECK-COUNT-98: {{[0-9]+}}
// CHECK: 0
