// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p opt -p clos %s -p ll -o -

/// Issue #117: closure conversion of a higher-order return.
/// A differentiated `pow`: a recursive function whose augmented return continuation folds pullback
/// continuations inside each other, so the return continuation is itself higher-order.
plugin core;
plugin mem;

use core.ops.u.w;

let PbVec  = Cn [mem.M 0, «2; I32»];    // innermost pullback continuation
let Pb     = Cn [mem.M 0, I32, PbVec];  // pullback
let AugRet = Cn [mem.M 0, I32, Pb];     // augmented return continuation
let TupPb  = Cn [mem.M 0, PbVec];

con zero_pb (m: mem.M 0, x: I32, pb_ret: PbVec) @tt =
    con k (m: mem.M 0, v: «2; I32») = pb_ret (m, v);
    k (m, ‹2; 0I32›);

con tup_pb (m: mem.M 0, pb_ret: PbVec) @tt =
    con k (m: mem.M 0, v: «2; I32») = pb_ret (m, v);
    k (m, ‹2; 0I32›);

con aug_f (m: mem.M 0, x: I32, aug_ret: AugRet) =
    con aug_pow_cont (m: mem.M 0, r: I32, pb: Pb) =
        con comp_tup_pb (m: mem.M 0, s: I32, pb_ret: PbVec) @tt =
            con fwd (m: mem.M 0, v: «2; I32») = pb_ret (m, v);
            con comp_cont (m: mem.M 0, ab: [I32, I32]) @tt =
                let (a, b) = ab;
                let p = r * s;
                fwd (m, (p + a, b));
            pb (m, 4I32 * s, comp_cont);
        let u = 4I32 * r;
        aug_ret (m, u, comp_tup_pb);

    con aug_pow_else (m: mem.M 0, unused: TupPb) =
        aug_f (m, 4294967295I32 + x, aug_pow_cont);

    con aug_pow_then (m: mem.M 0, unused: TupPb) =
        aug_ret (m, 1I32, zero_pb);

    let cond = core.icmp.xyglE (0I32, x);
    (aug_pow_else, aug_pow_then)#cond (m, tup_pb);

extern con main (m: mem.M 0, argc: I32, argv: mem.Ptr («⊤:Nat; mem.Ptr («⊤:Nat; I8», 0)», 0), return: Cn [mem.M 0, I32]) =
    con fwd (res: [mem.M 0, I32]) = return res;

    con ret_cont (m: mem.M 0, r: I32, pb: Pb) =
        con pb_ret_cont (m: mem.M 0, prs: [I32, I32]) =
            let (pr_a, pr_b) = prs;
            let a = 10000I32 * r;
            let b = 100I32 * pr_a;
            fwd (m, a + (pr_b + b));
        pb (m, 1I32, pb_ret_cont);

    aug_f (m, 3I32, ret_cont);
