// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p opt -p clos %s -p ll -o -

plugin core;
plugin mem;

use core.ops.u.w;


con f (m: mem.M 0, x: I32, return: Cn [mem.M 0, I32]) = return (m, x + 42I32);
con g (m: mem.M 0, x: I32, return: Cn [mem.M 0, I32]) = return (m, 1I32);

extern fun main(m: mem.M 0, argc: I32, argv: mem.Ptr0 «core.idx2nat argc; mem.Ptr0 mem.Char»): [mem.M 0, I32] =
    con h(m: mem.M 0, x: I32, return: Cn [mem.M 0, I32]) = return (m, x + argc);

    let pb_type  = Cn [mem.M 0, I32, Cn [mem.M 0, I32]];

    let (m, pb_arr) = mem.malloc («3; pb_type», 0) (m, 32);
    let (m, a_arr)  = mem.alloc («4; I32», 0) (m);

    let lea = mem.lea (pb_arr, 0₃);
    let m = mem.store (m, lea, f);
    let lea = mem.lea (pb_arr, 1₃);
    let m = mem.store (m, lea, g);
    let lea = mem.lea (pb_arr, 2₃);
    let m = mem.store (m, lea, h);
    let lea = mem.lea (a_arr, 0₄);
    let m = mem.store (m, lea, 10I32);
    let lea = mem.lea (pb_arr, 2₃);
    let (m, func) = mem.load (m, lea);
    let (m,  val) = mem.load (m, lea);

    func(m, 1I32, cn (m: mem.M 0, x: I32) = return (m, x));
