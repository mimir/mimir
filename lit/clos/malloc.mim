// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p opt -p clos %s -p ll -o -

plugin core;
plugin mem;


con f (m: mem.M 0, x: I32, return: Cn [mem.M 0, I32]) = return (m, core.wrap.add 0 (x, 42I32));
con g (m: mem.M 0, x: I32, return: Cn [mem.M 0, I32]) = return (m, 1I32);

extern fun main(m: mem.M 0, argc: I32, argv: mem.Ptr («⊤:Nat; mem.Ptr («⊤:Nat; I8», 0)», 0)): [mem.M 0, I32] =
    con h(m: mem.M 0, x: I32, return: Cn [mem.M 0, I32]) = return (m, core.wrap.add 0 (x, argc));

    let pb_type  = Cn [mem.M 0, I32, Cn [mem.M 0, I32]];
    let Tas      = (pb_type, 0);
    let arr_size = ⊤:Nat;

    let (m, pb_ptr) = mem.malloc Tas (m, 32);
    let pb_arr        = core.bitcast (mem.Ptr («⊤:Nat; Cn [mem.M 0, I32, Cn [mem.M 0, I32]]», 0)) pb_ptr;
    let (m, a_arr)  = mem.alloc («4; I32», 0) (m);

    let lea = mem.lea (pb_arr, core.idx_unsafe 0);
    let m = mem.store (m, lea, f);
    let lea = mem.lea (pb_arr, core.idx_unsafe 1);
    let m = mem.store (m, lea, g);
    let lea = mem.lea (pb_arr, core.idx_unsafe 2);
    let m = mem.store (m, lea, h);
    let lea = mem.lea (a_arr, core.idx_unsafe 0);
    let m = mem.store (m, lea, core.idx_unsafe 10);
    let lea = mem.lea (pb_arr, core.idx_unsafe 2);
    let (m, func) = mem.load (m, lea);
    let (m,  val) = mem.load (m, lea);

    func(m, 1I32, cn (m: mem.M 0, x: I32) = return (m, x));
