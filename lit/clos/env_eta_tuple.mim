// RUN: %mim -p opt -p clos -o /dev/null %s
//
// Regression test: when the free vars of a continuation are exactly the projections
// of one def in index order, ClosConv's env tuple η-reduces back to that def.
// ClosConv used to recover the free vars from the env tuple's ops, which then yielded
// the underlying def's ops instead (pointer-as-extract-index errors, free-var leaks).
// The essential ingredient is done2 reading p from done1's outer scope.

plugin core;
plugin tensor;
plugin mem;
plugin cps;

fun extern pad_row (input: «3; I32»): «5; I32» =
    return (%tensor.pad 3 (0, 1, 1) (input, 5I32));

fun extern cat_two (a: «3; I32», b: «2; I32»): «5; I32» =
    return (%tensor.concat @(I32, 2, 1) 0₁ @(3, 2) (a, b));

con extern main (mem: %mem.M 0, argc: I32, argv: %mem.Ptr (%mem.Ptr (I8, 0), 0), return: Cn [%mem.M 0, I32]) =
    let t = (10I32, 20I32, 30I32);
    let u = (1I32, 2I32);
    con done1 (p: «5; I32») =
        con done2 (c: «5; I32») =
            let v1 = %tensor.get @(I32, 1, (5, )) (p, (0₅, ));   // reads p from OUTER scope
            let v2 = %tensor.get @(I32, 1, (5, )) (c, (4₅, ));
            let s  = %core.wrap.add 0 (v1, v2);
            return (mem, s);
        cat_two ((t, u), done2);
    pad_row (t, done1);
