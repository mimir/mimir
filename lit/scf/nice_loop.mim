// RUN: %mim %s -o -

// NOTE: sketch of the intended nice_loop/nice_header wrapper interface; the
// wrappers are not implemented yet. `continue` branches straight back to the
// loop header — there is no separate continue block.

plugin scf;

fun extern foo () = %scf.nice_loop break loop 5 where
    lam loop (continue, break) (i: Nat) = %scf.nice_header (left, right) (%core.ncmp.e (i, 0)) () where
        lam left () = continue (%core.nat.sub (i, 1));
        lam right () = break ();
    end;
    lam break () = return 5;
end;
