// RUN: %mim %s -o -

plugin scf;

con extern foo (path: %scf.Path, step: %scf.Step, gen: %scf.Gen, token: %scf.Token path step gen, cond_outer: Bool, cond_inner: Bool, return: %scf.Ret Nat) =
    %scf.if token merge (else_outer, then_outer) cond_outer () where
        con then_outer (_, struct, token) = %scf.merge token struct 1;
        con else_outer (_, struct, token) =
            %scf.if token break_inner (else_inner, then_inner) cond_inner () where
                con then_inner (_, s, token) = %scf.merge token s 2;
                con else_inner (_, s, token) = %scf.merge token s 3;
                con break_inner (x: Nat, token) = %scf.merge token struct x;
            end;
        con merge (x: Nat, token) = %scf.return token return x;
    end;
