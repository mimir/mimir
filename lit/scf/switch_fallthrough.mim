// RUN: %mim %s -o -
// A case body may fall through to the next case as long as the token it
// hands to %scf.fallthrough is its OWN case token (path pinned to
// `%scf.case case path step`, same scope as the case itself, only
// progress/step may differ). case0 falls straight through into case1 here.

plugin scf;

con extern foo (path: %scf.Path, step: %scf.Step,
                 token: %scf.Token path step, return: %scf.Ret Nat) =
  %scf.switch @2 token exit default ((0, case0), (1, case1)) 0 1 where
    con case1 (x: Nat, struct, tok) = %scf.break.s tok struct x;
    con case0 (x: Nat, struct, tok) = %scf.fallthrough tok struct x;
    con default (x: Nat, struct, tok) = %scf.break.s tok struct 4;
    con exit (x: Nat, tok) = %scf.return tok return x;
end;
