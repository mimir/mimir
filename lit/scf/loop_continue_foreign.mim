// RUN: not %mim %s -o - 2>&1 | FileCheck %s
// %scf.Loop has no introduction rule, exactly like %scf.Token/%scf.Ret (see
// ret_forge.mim): the only way to hold one is to receive it as a parameter --
// modeling a capability smuggled in from anywhere. Its `path` (p) is a
// structurally distinct bound variable from this function's OWN `path`, so
// no amount of arm/case/default/body peeling on `path` can ever reach `p`.

plugin scf;

con extern foo (p: %scf.Path, s: %scf.Step, id: %scf.Id, gen: %scf.Gen,
                loop_cap: %scf.Loop p s id gen [] Nat,
                path: %scf.Path, step: %scf.Step, gen2: %scf.Gen,
                token: %scf.Token path step gen2, return: %scf.Ret Nat) =
    %scf.continue token loop_cap 0; // ILLEGAL: path can never reach p

// CHECK: error
