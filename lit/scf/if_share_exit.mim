// RUN: %mim %s -o -
// Counterpart to if_share_tail.mim: a chain block CAN be shared across two
// separate construct instances, as long as it sits outside both constructs
// rather than inside one of their arms. `exit` is the break/merge target of
// TWO different %scf.if applications, one running in `left` and one in
// `right` -- mutually exclusive native branches of an unstructured tuple
// selection, both reached from `foo`'s SAME activation (native selection is
// an ordinary conditional branch, not a call -- it does not cross an
// activation boundary). `left`/`right` both use `foo`'s own `token`
// parameter (annotated against `foo`'s own `path`/`step` parameters), so
// their if's break-continuation types are the literal SAME
// closed-over-`path` type `Cn [Nat, Token path (%scf.inc step)]`, and
// `exit` type-checks as either one's target.
// This means path-purity's uniqueness guarantee is narrower than "a block
// can only ever have one predecessor": it only forces per-instance identity
// on blocks INSIDE a construct (arms/cases/body, via their own tt/ff or
// index discrimination), not on a construct's own exit, which stays an
// ordinary chain block nameable from wherever a same-depth, same-token-type
// chain happens to run -- here, two unrelated ifs reached via native (mixed)
// control flow within one activation.
// ROOT REDESIGN CORRECTION (2026-07-05): an earlier revision of this test
// had `left`/`right` each bind their OWN fresh `root` parameter instead of
// sharing `foo`'s. That was wrong -- native tuple selection is an ordinary
// branch, not a call, so it does not introduce a new activation, and giving
// `left`/`right` independent roots misrepresented them as if it did. That
// mistake happened to crash mim (a real, separately-confirmed compiler bug,
// see lit/bug/bug_repro_hole_free_var.mim), which was misread as the
// ROOT-CONSTANT-LEAK fix "working as intended" -- it wasn't; the crash was
// an artifact of the wrong test, not evidence of anything about the
// redesign. With the shared root modeled correctly, this test passes clean,
// exactly as it did before the redesign -- the ROOT-CONSTANT-LEAK fix is
// about closing sharing ACROSS genuinely different activations (see
// if_share_tail.mim's `callee`, reached via an actual %scf.call), not
// about native branches of the same one.
// V2 (2026-07-06): Root/ROOT/enter are gone; functions now bind
// `path`/`step`/`token` as ordinary parameters and %scf.call never
// instantiates them. Same separation story (parametricity over the
// function's own bound `path`), one activation still means one shared
// token thread -- nothing about this test's semantics changes.

plugin scf;

fun extern foo (path: %scf.Path, step: %scf.Step, token: %scf.Token path step, sel cond: Bool, cond2: Bool) =
  (left, right)#sel token where
  con left (token: %scf.Token path step) =
    %scf.if token exit (else_l, then_l) cond2 () where
      con then_l (_: [], struct, tok) = %scf.merge tok struct 1;
      con else_l (_: [], struct, tok) = %scf.merge tok struct 0;
    end;
  con right (token: %scf.Token path step) =
    %scf.if token exit (else_r, then_r) cond2 () where
      con then_r (_: [], struct, tok) = %scf.merge tok struct 2;
      con else_r (_: [], struct, tok) = %scf.merge tok struct 3;
    end;
  con exit (x: Nat, tok) = return x;
end;
