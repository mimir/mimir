// RUN: %mim %s -o -

plugin scf;

con extern foo (path: %scf.Path, step: %scf.Step, token: %scf.Token path step, return: %scf.Ret Nat) =
  %scf.switch @3 token exit default ((0, case0), (1, case1), (2, case2)) 1 () where
    con case2 (_: [], struct, tok) = %scf.break.s tok struct 2;
    con case1 (_: [], struct, tok) = %scf.break.s tok struct 1;
    con case0 (_: [], struct, tok) = %scf.break.s tok struct 0;
    con default (_: [], struct, tok) = %scf.break.s tok struct 4;
    con exit (x: Nat, tok) = %scf.return tok return x;
end;
