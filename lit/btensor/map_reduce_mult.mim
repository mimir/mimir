// RUN: rm -f %t.ll
// RUN: %mim -p opt -o - %s

plugin core;
plugin btensor;
plugin buffer;
plugin mem;

use core.ops.u.w;


con inner_fun ((mm: mem.M 0, acc: I32, (a b: I32)), return: Cn [mem.M 0, I32]) =
    let v       = a * b;
    let new_acc = acc + v; // reduce op = addition
    return (mm, new_acc);

extern con f(mm: mem.M 0,
              (k l m: Nat),
              M: buffer.Buf (2, (k, m), I32),
              N: buffer.Buf (2, (m, l), I32),
              return: Cn [mem.M 0, buffer.Buf (2, (k, l), I32)]) =
    let (mm, MN) = btensor.map_reduce ((k, l), (k, l, m))
        (inner_fun, 0I32)
        (btensor.proj_map (0, 1))
        (btensor.proj_map (0, 2), btensor.proj_map (2, 1))
        (mm, (M, N));
    return (mm, MN);

// CHECK-NOT: %btensor.
