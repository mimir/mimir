// RUN: rm -f %t.ll
// RUN: %mim -p opt -o - %s | %FileCheck %s

plugin core;
plugin btensor;

lam ex_internal_mapRed_matrix_transpose((k l: Nat), T: *)@tt: Cn [[%mem.M 0, %buffer.Buf (2, (k, l), T)], Cn [%mem.M 0, %buffer.Buf (2, (l, k), T)] ] =
    // TODO: or use generalized addition function
    // ignore acc
    con transpose_comb ((mem: %mem.M 0, acc: T, (a: T)), return: Cn [%mem.M 0, T]) = return (mem, a);
    con inner_matrix_transpose((mem: %mem.M 0, M: %buffer.Buf (2, (k, l), T)), return: Cn [%mem.M 0, %buffer.Buf (2, (l, k), T)])@tt =
        // TODO: use generalized zero
        let zero = (⊥:T);
        return (
            %btensor.map_reduce ((l, k), (l, k))
                (transpose_comb, zero)
                %affine.id
                (%btensor.proj_map (1, 0),)
                (mem, M)
        );
    inner_matrix_transpose;

con extern f (mem: %mem.M 0, (k l: Nat), return: Cn %mem.M 0) =
    // M:%buffer.Buf (2,(k, m), I32),
    // N:%buffer.Buf (2,(m, l), I32),

    let (mem, M) = %buffer.lit (2, (k, l), I32) (mem, 42I32);

    con cont (mem: %mem.M 0, N: %buffer.Buf (2, (l, k), I32)) = return mem;
    ex_internal_mapRed_matrix_transpose ((k, l), I32) ((mem, M), cont);

// CHECK-NOT: %btensor.
