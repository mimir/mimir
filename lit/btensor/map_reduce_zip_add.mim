// RUN: rm -f %t.ll
// RUN: %mim -p opt -o - %s  | %FileCheck %s

plugin core;
plugin btensor;
plugin affine;
plugin buffer;
plugin mem;

use core.ops.u.w;


extern con g ((m: mem.M 0, acc: I32, (a b: I32)), return: Cn [mem.M 0, I32]) =
    let v       = a + b;
    let new_acc = acc + v; // reduce op = addition
    return (m, new_acc);

extern con f (m: mem.M 0,
    (k l: Nat),
    M: buffer.Buf (2, (k, l), I32),
    return: Cn [mem.M 0, buffer.Buf (2, (k, l), I32)]) =
    let MT = M;
    let (m, MT2) = btensor.map_reduce ((k, l), (k, l))
        (g, 0I32)
        affine.id
        (btensor.proj_map (0, 1), btensor.proj_map (0, 1))
        (m, (M, M));
    return (m, MT);

// CHECK-NOT: %btensor.
