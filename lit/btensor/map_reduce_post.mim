// RUN: %mim -p opt %s -p ll -X ll:o=%t.ll -o /dev/null
// RUN: clang %t.ll -o %t -Wno-override-module
// RUN: %t
// RUN: %mim -p opt %s -o - | %FileCheck %s

// Runs `map_reduce_post` with heterogeneous input and output types, logical singleton axes and an epilogue.
// The dynamic case adds a runtime bound, combiner side effects and an empty epilogue-input pack.
plugin core;
plugin mem;
plugin affine;
plugin buffer;
plugin btensor;
plugin cps;

use core.ops.u.w;

fun mix (m: mem.M 0, acc: I32, (a: I32, b: I64))@tt: [mem.M 0, I32] =
    return (m, acc + a + core.conv.u 4294967296 b);
fun bias (m: mem.M 0, acc: I32, b: I64)@tt: [mem.M 0, I64] =
    return (m, core.conv.u 0 acc + b);

fun heterogeneous (m: mem.M 0)@tt: [mem.M 0, Bool] =
    let (m, a) = buffer.init (3, (2, 1, 3), I32) (m, ((1I32, 2I32, 3I32), (4I32, 5I32, 6I32)));
    let (m, b) = buffer.init (3, (2, 1, 3), I64) (m, ((10I64, 20I64, 30I64), (40I64, 50I64, 60I64)));
    let (m, p) = buffer.init (2, (2, 1), I64) (m, (100I64, 200I64));
    let (m, dst) = buffer.alloc (2, (2, 1), I64) m;
    let (m, out) = btensor.map_reduce_post @(2, 1)
        ((2, 1), (2, 1, 3), btensor.mk_sched (3, 0))
        @((I32, I64), (3, 3), ((2, 1, 3), (2, 1, 3)), I64, 2, (2, 1))
        (mix, 0I32, bias) (btensor.proj_map @(3, 2) (0, 1))
        ((affine.id @3, affine.id @3), affine.id @2) (m, dst, (a, b), p);
    // Observe the normalized buffer directly; logical index projection belongs to the lowering.
    let (m, x) = buffer.read (1, 2, I64) (m, out, 0₂);
    let (m, y) = buffer.read (1, 2, I64) (m, out, 1₂);
    let ok = core.bit2.and 2 (core.icmp.e (x, 166I64), core.icmp.e (y, 365I64));
    return (m, ok);

// Update a separate counter on each reduction step to check the memory chain.
// The loop bound is dynamic; storage is static so this does not require dynamic-sized LLVM pointees.
extern con dynamic (n: Nat, m: mem.M 0, k: Cn [mem.M 0, Bool]) =
    let (m, counter) = buffer.init (0, (), I32) (m, 0I32);
    fun step (m: mem.M 0, acc: I32, value_in: I32)@tt: [mem.M 0, I32] =
        let (m, value) = buffer.read (0, (), I32) (m, counter, ());
        let (m, _) = buffer.write (0, (), I32) (m, counter, (), value + 1I32);
        return (m, acc + value_in);
    let (m, src) = buffer.lit (1, 3, I32) (m, 1I32);
    let (m, dst) = buffer.alloc (0, (), I32) m;
    lam scalar (_: «1; affine.Index»): [] = ();
    lam first (_: «1; affine.Index»): «1; affine.Index» = affine.lit 0;
    let (m, out) = btensor.map_reduce_post @(1, 0)
        ((), n, btensor.mk_sched (1, 0)) (step, 0I32, btensor.id)
        scalar (first, ()) (m, dst, src, ());
    let (m, value) = buffer.read (0, (), I32) (m, out, ());
    let (m, updates) = buffer.read (0, (), I32) (m, counter, ());
    let expected = core.conv.u 4294967296 (core.bitcast I64 n);
    let ok = core.bit2.and 2 (core.icmp.e (value, expected), core.icmp.e (updates, expected));
    k (m, ok);

extern con main (m: mem.M 0, argc: I32, argv: mem.Ptr (mem.Ptr (I8, 0), 0), return: Cn [mem.M 0, I32]) =
    let (m, h) = cps.cps2ds heterogeneous m;
    con check_dynamic (m: mem.M 0, d: Bool) =
        con check_empty (m: mem.M 0, e: Bool) =
            let ok = core.bit2.and 2 (h, core.bit2.and 2 (d, e));
            return (m, core.select (ok, 0I32, 1I32));
        dynamic (0, m, check_empty);
    dynamic (5, m, check_dynamic);

// CHECK-NOT: %btensor.map_reduce
// CHECK-NOT: %buffer.
// CHECK-NOT: %affine.
