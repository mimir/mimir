// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p opt -p math -o - -p ll %s
// RUN: clang %S/../lib.c %{s:stem}.ll -o %t -Wno-override-module
// RUN: %t 2 3 | %FileCheck %s

plugin core;
plugin btensor;
plugin buffer;
plugin math;
plugin mem;

let MT1 = (2, (2, 4), math.F64);

extern con print_int_matrix    [mm: mem.M 0, k l: Nat, m: buffer.Buf (2, (k, l), I32), return: Cn [mem.M 0]];
extern con print_double_matrix [mm: mem.M 0, k l: Nat, m: buffer.Buf (2, (k, l), math.F64), return: Cn [mem.M 0]];

extern con main (mm: mem.M 0, argc: I64, argv: mem.Ptr («core.idx2nat argc; mem.Ptr (mem.Char, 0)», 0), return: Cn [mem.M 0, I32]) =
    let c = 42.0:math.F64;
    let (mm, m) = buffer.lit MT1 (mm, c);
    print_double_matrix (mm, 2, 4, m, return_cont)
    where
        con return_cont (mm: mem.M 0) = return (mm, 0I32);
    end;

// CHECK: 42.00, 42.00, 42.00, 42.00,
// CHECK: 42.00, 42.00, 42.00, 42.00,
