// RUN: %mim -p opt -p cps -p math -o - %s | %FileCheck %s

// TODO: allocation error due to dynamic size,
// ./build/bin/mim lit/btensor/print_const_dyn_mat.mim -p cps -p clos -o - -VVVV --output-ll %{s:stem}.ll
// add_mem error (bitcast gets (mem, mat) as argument at some point)

plugin core;
plugin btensor;
plugin buffer;
plugin mem;

let u8 = I8;
let String = mem.Ptr0 mem.Char;

extern con atoi [mem.M 0, String, Cn [mem.M 0, I32]];
extern con print_int_matrix [mm: mem.M 0, k l: Nat, m: buffer.Buf (2, (k, l), I32), return: Cn [mem.M 0]];

extern con f (mm: mem.M 0, (k l: Nat), return: Cn [mem.M 0]) =
    let (mm, M) = buffer.lit (2, (k, l), I32) (mm, 3I32);
    print_int_matrix (mm, k, l, M, return);

extern con main (mm: mem.M 0,
        argc: I32,
        argv: mem.Ptr0 «core.idx2nat argc; String», // const char *argv[]
        return: Cn [mem.M 0, I32]
    ) =
    let arg1_ptr    = mem.lea (argv, core.idx 0 (core.idx2nat argc) 1); // argv+1 : const char**
    let (mm, arg1) = mem.load (mm, arg1_ptr); // argv[1] : const char*
    let arg2_ptr    = mem.lea (argv, core.idx 0 (core.idx2nat argc) 2); // argv+2
    let (mm, arg2) = mem.load (mm, arg2_ptr); // argv[2]
    // cont (mem, m, return)
    atoi (mm, arg1, atoi_cont_1)
    where
        con atoi_cont_1 (mm: mem.M 0, a: I32) =
            atoi (mm, arg2, atoi_cont_2)
            where
                con atoi_cont_2 (mm: mem.M 0, b: I32) =
                    let a_nat = core.idx2nat a;
                    let b_nat = core.idx2nat b;
                    f (mm, (a_nat, b_nat), return_cont)
                    where
                        con return_cont (mm: mem.M 0) = return (mm, 0I32);
                    end;
            end;
    end;

// CHECK-NOT: btensor.
