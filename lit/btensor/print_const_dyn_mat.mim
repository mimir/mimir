// RUN: %mim -p opt -p cps -p math -o - %s | %FileCheck %s

// TODO: allocation error due to dynamic size,
// ./build/bin/mim lit/btensor/print_const_dyn_mat.mim -p cps -p clos -o - -VVVV --output-ll %{s:stem}.ll
// add_mem error (bitcast gets (mem, mat) as argument at some point)

plugin core;
plugin btensor;

let u8 = I8;
let String = %mem.Ptr («⊤:Nat; I8», 0);

ccon atoi [%mem.M 0, String, Cn [%mem.M 0, I32]];
ccon print_int_matrix [mem: %mem.M 0, k l: Nat, m: %buffer.Buf (2, (⊤:Nat, ⊤:Nat), I32), return: Cn [%mem.M 0]];

con print_int_matrix_wrap (mem: %mem.M 0, k l: Nat, m: %buffer.Buf (2, (k, l), I32), return: Cn [%mem.M 0]) =
    let m = %core.bitcast (%buffer.Buf (2, (⊤:Nat, ⊤:Nat), I32)) m;
    print_int_matrix(mem, k, l, m, return);

con extern f (mem: %mem.M 0, (k l: Nat), return: Cn [%mem.M 0]) =
    let (mem, M) = %buffer.lit (2, (k, l), I32) (mem, 3I32);
    print_int_matrix_wrap (mem, k, l, M, return);

con extern main (mem: %mem.M 0,
        argc: I32,
        argv: %mem.Ptr («⊤:Nat; String», 0), // const char *argv[]
        return: Cn [%mem.M 0, I32]
    ) =
    let arg1_ptr    = %mem.lea (argv, 1I32); // argv+1 : const char**
    let (mem, arg1) = %mem.load (mem, arg1_ptr); // argv[1] : const char*
    let arg2_ptr    = %mem.lea (argv, 2I32); // argv+2
    let (mem, arg2) = %mem.load (mem, arg2_ptr); // argv[2]
    // cont (mem, m, return)
    atoi (mem, arg1, atoi_cont_1)
    where
        con atoi_cont_1 (mem: %mem.M 0, a: I32) =
            atoi (mem, arg2, atoi_cont_2)
            where
                con atoi_cont_2 (mem: %mem.M 0, b: I32) =
                    let a_nat = %core.bitcast Nat a;
                    let b_nat = %core.bitcast Nat b;
                    f (mem, (a_nat, b_nat), return_cont)
                    where
                        con return_cont (mem: %mem.M 0) = return (mem, 0I32);
                    end;
            end;
    end;

// CHECK-NOT: %btensor.
