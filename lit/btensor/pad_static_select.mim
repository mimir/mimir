// RUN: %mim %s -o - | %FileCheck %s --implicit-check-not=pad_read --implicit-check-not=pad_input --implicit-check-not=pad_fill

plugin core;
plugin mem;
plugin buffer;
plugin btensor;
plugin compile;

extern con static_pad (m: mem.M 0, dst: buffer.Buf (1, 5, I32), a: buffer.Buf (1, 3, I32), return: Cn [mem.M 0, buffer.Buf (1, 5, I32)]) =
    return (btensor.pad 3 (0, 1, 1) 5 (m, dst, a, 7I32));

extern lam _compile (): compile.Phase = compile.phases ff (btensor.lower_map_reduce, compile.cleanup);

// CHECK: buffer.read
