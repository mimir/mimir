// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p opt %s -p ll --output-mim - | %FileCheck %s

plugin core;
plugin btensor;
plugin buffer;
plugin mem;

extern con main (mm: mem.M 0, argc: I32, argv: mem.Ptr (mem.Ptr (I8, 0), 0), return: Cn [mem.M 0, I32]) =
    let MT = (2, (3, 5), I32);
    let (mm, m) = buffer.lit MT (mm, 5I32);
    return (mm, core.bitcast I32 (buffer.shape MT (m, 0₂)));

// CHECK-DAG: return{{.*}}3{{.*}}
