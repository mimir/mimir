// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p opt %s -p ll --output-mim - | %FileCheck %s

plugin core;
plugin btensor;
plugin buffer;
plugin mem;

extern con main (mm: mem.M 0, argc: I32, argv: mem.Ptr («core.idx2nat argc; mem.Ptr (mem.Char, 0)», 0), return: Cn [mem.M 0, I32]) =
    let MT = (2, (3, 5), I32);
    let (mm, m) = buffer.lit MT (mm, 5I32);
    return (mm, core.bitcast I32 (buffer.shape MT (m, 0₂)));

// CHECK-DAG: return_{{[0-9]+}} ({{.*}}, 3I32)
