// RUN: rm -f %t.ll
// RUN: %mim -p opt -o - %s | %FileCheck %s

plugin core;
plugin btensor;
plugin buffer;
plugin mem;

extern con f (m: mem.M 0, (k l: Nat), return: Cn [mem.M 0, buffer.Buf (2, (k, l), I32)]) =
    let (m, M) = buffer.alloc (2, (k, l), I32) m;
    return (m, M);

// CHECK-NOT: %btensor.
