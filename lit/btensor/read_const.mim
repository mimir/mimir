// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p opt %s -p ll --output-mim - | %FileCheck %s

plugin core;
plugin btensor;
plugin buffer;
plugin mem;

extern con main (mm: mem.M 0, argc: I32, argv: mem.Ptr («core.idx2nat argc; mem.Ptr (mem.Char, 0)», 0), return: Cn [mem.M 0, I32]) =
    let MT = (2, (3, 3), I32);
    let c = 5I32;
    let (mm, m) = buffer.lit MT (mm, c);
    let f = buffer.read MT;
    let idx = ‹2; 0₃›;
    let (mm, d) = buffer.read MT (mm, m, idx);
    return (mm, d);

// CHECK-DAG: return_{{[0-9]+}} ({{.*}}, 5I32)
