// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p opt -o - -p ll %s
// RUN: clang %S/../lib.c %{s:stem}.ll -o %t -Wno-override-module
// RUN: %t 2 3 | %FileCheck %s

plugin core;
plugin math;
plugin btensor;
plugin buffer;
plugin mem;

let MT1 = (2, (2, 4), math.F64);
let MT2 = (2, (4, 3), math.F64);
let R: btensor.Ring = (math.F64, 0.0:math.F64, math.arith.add 0, math.arith.mul 0);

extern con print_int_matrix    [mm: mem.M 0, k l: Nat, m: buffer.Buf (2, (⊤:Nat, ⊤:Nat), I32), return: Cn [mem.M 0]];
extern con print_double_matrix [mm: mem.M 0, k l: Nat, m: buffer.Buf (2, (⊤:Nat, ⊤:Nat), math.F64), return: Cn [mem.M 0]];

con print_int_matrix_wrap (mm: mem.M 0, k l: Nat, m: buffer.Buf (2, (k, l), I32), return: Cn [mem.M 0]) =
    let m2 = core.bitcast (buffer.Buf (2, (⊤:Nat, ⊤:Nat), I32)) m;
    print_int_matrix(mm, k, l, m2, return);

con print_double_matrix_wrap (mm: mem.M 0, k l: Nat, m: buffer.Buf (2, (k, l), math.F64), return: Cn [mem.M 0]) =
    let m2 = core.bitcast (buffer.Buf (2, (⊤:Nat, ⊤:Nat), math.F64)) m;
    print_double_matrix(mm, k, l, m2, return);


extern con main (mm: mem.M 0, argc: I32, argv: mem.Ptr (mem.Ptr (I8, 0), 0), return: Cn [mem.M 0, I32]) =
    con return_cont (mm: mem.M 0) = return (mm, 0I32);
    let c         = 3.0:math.F64;
    let d         = 5.0:math.F64;
    let (mm, m1)  = buffer.lit MT1 (mm, c);
    let (mm, m2)  = buffer.lit MT2 (mm, d);
    let (mm, mP) = btensor.product_2d R (mm, m1, m2);
    print_double_matrix_wrap (mm, 2, 3, mP, return_cont);

// CHECK: 60.00, 60.00, 60.00,
// CHECK: 60.00, 60.00, 60.00,
