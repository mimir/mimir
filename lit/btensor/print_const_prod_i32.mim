// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p opt -o - -p ll %s
// RUN: clang %S/../lib.c %{s:stem}.ll -o %t -Wno-override-module
// RUN: %t | %FileCheck %s

plugin core;
plugin btensor;
plugin buffer;
plugin mem;

use core.ops.u.w;

let MT1 = (2, (2, 4), I32);
let MT2 = (2, (4, 3), I32);

fun mul_add (m: mem.M 0, acc: I32, (a b: I32))@tt: [mem.M 0, I32] = return (m, acc + a * b);

extern con print_int_matrix [mm: mem.M 0, k l: Nat, m: buffer.Buf (2, (k, l), I32), return: Cn [mem.M 0]];

extern con main (mm: mem.M 0, argc: I32, argv: mem.Ptr («core.idx2nat argc; mem.Ptr (mem.Char, 0)», 0), return: Cn [mem.M 0, I32]) =
    con return_cont (mm: mem.M 0) = return (mm, 0I32);
    let (mm, m1) = buffer.lit MT1 (mm, 3I32);
    let (mm, m2) = buffer.lit MT2 (mm, 5I32);
    let (mm, dst) = buffer.alloc (2, (2, 3), I32) mm;
    let (mm, mP)  = btensor.map_reduce ((2, 3), (2, 3, 4)) (mul_add, 0I32)
        (btensor.proj_map (0, 1))
        (btensor.proj_map (0, 2), btensor.proj_map (2, 1))
        (mm, dst, (m1, m2));
    print_int_matrix (mm, 2, 3, mP, return_cont);

// CHECK: 60, 60, 60,
// CHECK: 60, 60, 60,
