// RUN: rm -f %t.ll
// RUN: %mim -p opt -o - %s | %FileCheck %s

plugin core;
plugin btensor;
plugin affine;
plugin buffer;
plugin mem;

use core.ops.u.w;

fun identity(m: mem.M 0, a:   I32): [mem.M 0, I32] = return (m, a);
fun addition(m: mem.M 0, a b: I32): [mem.M 0, I32] = return (m, a + b);

extern fun f(m: mem.M 0, k l: Nat, M: buffer.Buf (2, (k, l), I32)): [mem.M 0, buffer.Buf (2, (l, k), I32)] =
    return (btensor.map_reduce ((l, k), (l, k)) (addition, 0I32) affine.id (btensor.proj_map (1, 0)) (m, M));

// CHECK-NOT: btensor.
