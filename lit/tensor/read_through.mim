// RUN: %mim %s -o - | %FileCheck %s --implicit-check-not=tensor.broadcast --implicit-check-not=tensor.repeat

plugin tensor;
plugin compile;
plugin refly;

use tensor;

let b = broadcast ((2, 1), (2, 3), from_array @(2, (2, 1), Nat) (1, 2));

let m   = tensor.from_array ((1, 2, 3), (4, 5, 6));
let rep = repeat (2, 3) (4, 6) m;

let _ = refly.struc.e (tensor.get (b, (1₂, 2₃)), 2);
let _ = refly.struc.e (tensor.get (rep, (3₄, 4₆)), 5);

extern lam broadcast_param (t: Tensor 2 (2, 1) Nat, i: Idx 2, j: Idx 3): Nat =
    refly.struc.e (get (broadcast ((2, 1), (2, 3), t), (i, j)), get (t, (i, 0₁)));

extern fun broadcast_read (): Nat = return (tensor.get (b, (1₂, 2₃)));
extern fun repeat_read    (): Nat = return (tensor.get (rep, (3₄, 4₆)));

extern lam _compile (): compile.Phase =
    compile.phases ff (
        lower_tensor,
        compile.cleanup,
    );

// CHECK-DAG: extern fun broadcast_read
// CHECK-DAG: return 2;
// CHECK-DAG: extern fun repeat_read
// CHECK-DAG: return 5;
