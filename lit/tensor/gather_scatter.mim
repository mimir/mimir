// RUN: %mim %s -p opt -o - | %FileCheck %s --implicit-check-not=tensor.gather --implicit-check-not=tensor.scatter

// Gather lowers to indexed reads; scatter lowers to an ordered sequence of
// reads and writes. Their element formulas remain visible as plain extracts and inserts.
// CHECK-DAG: extern fun gather2d
// CHECK-DAG: extern fun scatter2d
// CHECK-DAG: core.bitcast @ (Idx 3) I64
// CHECK-DAG: ←

plugin core;
plugin tensor;
plugin affine;
plugin compile;

extern fun gather2d (input: «2, 3; I32», index: «2, 2; Idx 3»): «2, 2; I32» =
    return (tensor.gather ((2, 3), (2, 2)) 1_2 (input, index));

extern fun scatter2d
    (input: «2, 3; I32», index: «2, 2; Idx 3», updates: «2, 2; I32»): «2, 3; I32» =
    return (tensor.scatter ((2, 3), (2, 2), (2, 2)) 1_2 (input, index, updates));

extern lam _compile (): compile.Phase =
    compile.phases ff (
        tensor.lower_tensor,
        tensor.lower_map_reduce,
        compile.cleanup,
    );
