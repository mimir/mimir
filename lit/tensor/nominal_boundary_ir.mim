// RUN: %mim %s -o - | %FileCheck %s --implicit-check-not='nom Tensor' --implicit-check-not=core.Ptr

plugin core;
plugin tensor;
plugin compile;
use tensor;

extern con forward (m: Nat, a: Tensor 2 (m, 3) I32, return: Cn [Tensor 2 (m, 3) I32]) = return a;

extern con grouped (pair: [n: Nat, a: Tensor 1 n I32], return: Cn [Tensor 1 (pair#0₂) I32]) =
    return (pair#1₂);

extern lam _compile (): compile.Phase = compile.phases ff (tensor.lower_to_mem, compile.cleanup);

// CHECK-LABEL: extern con forward (
// CHECK-SAME: [[M:[a-zA-Z_0-9]+]]: Nat,
// CHECK-SAME: buffer.Buf (2, ([[M]], 3), I32)
// CHECK-SAME: Cn buffer.Buf (2, ([[M]], 3), I32)
// CHECK-LABEL: extern fun grouped ((n: Nat,
// CHECK-SAME: buffer.Buf (1, n, I32))
// CHECK-SAME: buffer.Buf (1, {{.*}}#ff, I32)
