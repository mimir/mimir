// RUN: %mim %s -o %t
// RUN: cat %t | %FileCheck %s
// RUN: cat %t | %FileCheck %s --check-prefix=GONE

// %tensor.reshape (row-major) loops over the result and reads the input at the delinearized linear index, via the
// %affine.linearize / %affine.delinearize helpers (which lower to %core arithmetic + %core.div). Checked on the lowered
// Mim IR (no codegen), as for hlo.mim / map_reduce_aff. `s_in` is explicit so inference can pin the element type.
// GONE-NOT: %tensor.reshape
// GONE-NOT: map_reduce_aff
// GONE-NOT: %affine
// GONE-NOT: linearize

plugin core;
plugin tensor;
plugin affine;
plugin mem;

// Flatten 2x3 -> 6: out[k] = input[(k / 3) % 2][k % 3].
// CHECK-DAG: fun extern flatten
// CHECK-DAG: %core.div.udiv
// CHECK-DAG: %core.div.urem
fun extern flatten (input: «2, 3; I32»): «6; I32» =
    return (%tensor.reshape (2, 3) 6 input);

// Unflatten 6 -> 2x3.
// CHECK-DAG: fun extern unflatten
fun extern unflatten (input: «6; I32»): «2, 3; I32» =
    return (%tensor.reshape 6 (2, 3) input);

// Rank-preserving reshape 2x3 -> 3x2.
// CHECK-DAG: fun extern reshape32
fun extern reshape32 (input: «2, 3; I32»): «3, 2; I32» =
    return (%tensor.reshape (2, 3) (3, 2) input);

// Imagine a few extra ranks.
// CHECK-DAG: fun extern reshape213
fun extern reshape213 (input: «2, 3; I32»): «2, 1, 3; I32» =
    return (%tensor.reshape (2, 3) (2, 1, 3) input);

// Imagine a few extra ranks.
// CHECK-DAG: fun extern reshape2323
fun extern reshape2323 (input: «2, 6, 3; I32»): «2, 3, 2, 3; I32» =
    return (%tensor.reshape (2, 6, 3) (2, 3, 2, 3) input);



