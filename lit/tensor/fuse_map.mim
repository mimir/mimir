// RUN: %mim -p opt %s -o - | %FileCheck %s

// Two chained pure tensor maps (no reductions): the fuse phase should collapse
// them into a single tensor.map_reduce.
plugin core;
plugin tensor;
plugin compile;

use core.ops.n;
use tensor;

lam add1 (x: Nat): Nat = x + 1;
lam mul2 (x: Nat): Nat = x * 2;

extern con f (v: «2; «3; Nat»», return: Cn «2; «3; Nat»») =
    let v = buf v;
    return (unary mul2 (unary add1 v));

extern lam _compile (): compile.Phase =
    compile.phases ff (
        compile.cleanup,
        lower_tensor,
        fuse_tensor,
        compile.cleanup,
    );

// CHECK: tensor.map_reduce
// CHECK-NOT: tensor.map_reduce
