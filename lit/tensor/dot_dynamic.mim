// RUN: %mim %s -p opt -o - | %FileCheck %s

// A matrix product whose extents are *runtime* values: dot_schedule's tile-size guard
// (tensor.if_static) cannot resolve at compile time, so the tensor lowering residualizes it to
// the neutral tile (ts = 1) and the op lowers with symbolic bounds — the same selector serves
// static shapes (register-blocked k) and dynamic shapes, with no staging annotation at the call
// site.

plugin core;
plugin tensor;
plugin compile;

use tensor;

let Ring = (Nat, 0, core.nat.add, core.nat.mul);

// CHECK-DAG: extern fun mm_dyn
extern fun mm_dyn {m k l: Nat} (a: «m, k; Nat», b: «k, l; Nat»): «m, l; Nat» =
    return (product_2d Ring (buf a, buf b));

extern lam _compile (): compile.Phase =
    compile.phases ff (
        compile.cleanup,
        lower_tensor,
        lower_map_reduce,
        compile.cleanup,
    );

// The tile-size guard must not survive to the output: the lowering resolves it (to ts = 1 here).
// CHECK-NOT: if_static
