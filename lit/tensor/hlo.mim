// REQUIRES: release || !system-win32
// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p opt %s -p ll -o - | %FileCheck %s
// RUN: clang++ -std=c++23 %S/hlo_step_aux.cpp %{s:stem}.ll -o %t -O1 -Wno-override-module
// RUN: %t

// Full-size two-layer MLP training step (batch 128, 784→1024→1024→10), an HLO dump lowered through the
// DEFAULT pipeline all the way to LLVM and executed against a plain C++ reference in hlo_step_aux.cpp.
// `main_hlo` computes the six SGD-updated results (two weight matrices per layer plus biases) and returns
// the update delta (old − new = lr·grad) of one element of each, so every forward and backward chain stays
// live and the driver can check the backward pass numerically. hlo_train.mim is the compact one-layer
// variant of this test; hlo_exec.mim covers the forward pass only.
plugin tensor;
plugin core;
plugin math;

use tensor;
use math.arith as ma;

let F32     = math.F32;
let fast    = math.mode.fast;
let one     = 1.0:F32;
let neg_inf = math.neg_inf math.f32;
let Ring    = (F32, 0:F32, ma.add fast, ma.mul fast);

let `+ = binary (ma.add fast);
let `- = binary (ma.sub fast);
let `* = binary (ma.mul fast);
let `/ = binary (ma.div fast);

lam max       {r: Nat, s: «r; Nat»} (is: [tensor.Tensor r s F32, tensor.Tensor r s F32]): tensor.Tensor r s F32 = binary (math.extrema.fmax fast) is;
lam ge        {r: Nat, s: «r; Nat»} (is: [tensor.Tensor r s F32, tensor.Tensor r s F32]): tensor.Tensor r s Bool = binary (math.cmp.ge fast) is;
lam tanh      {r: Nat, s: «r; Nat»} (i: tensor.Tensor r s F32): tensor.Tensor r s F32 = unary (math.tri.tanh fast) i;
lam exp       {r: Nat, s: «r; Nat»} (i: tensor.Tensor r s F32): tensor.Tensor r s F32 = unary (math.exp.exp fast) i;
lam abs       {r: Nat, s: «r; Nat»} (i: tensor.Tensor r s F32): tensor.Tensor r s F32 = unary (math.abs fast) i;
lam minus     {r: Nat, s: «r; Nat»} (i: tensor.Tensor r s F32): tensor.Tensor r s F32 = unary (math.minus fast) i;
lam is_finite {r: Nat, s: «r; Nat»} (i: tensor.Tensor r s F32): tensor.Tensor r s Bool = unary (math.is_finite fast) i;

extern fun main_hlo (arg0: tensor.Tensor 2 (784, 1024) F32, arg1: tensor.Tensor 1 1024 F32, arg2: tensor.Tensor 2 (1024, 1024) F32, arg3: tensor.Tensor 1 1024 F32, arg4: tensor.Tensor 2 (1024, 10) F32, arg5: tensor.Tensor 1 10 F32, arg6: tensor.Tensor 2 (128, 784) F32, arg7: tensor.Tensor 2 (128, 10) F32): F32 =
    let h0       = tanh (product_2d Ring (arg6, arg0) + broadcast ((1, 1024), (128, 1024), reshape 1024 (1, 1024) arg1));
    let h1       = tanh (product_2d Ring (h0, arg2) + broadcast ((1, 1024), (128, 1024), reshape 1024 (1, 1024) arg3));
    let logits   = product_2d Ring (h1, arg4) + broadcast ((1, 10), (128, 10), reshape 10 (1, 10) arg5);
    let row_max  = max (splat (128, neg_inf), reduce (math.extrema.fmax fast, neg_inf) 1₂ logits);
    let exps     = exp (logits - broadcast ((128, 1), (128, 10), reshape 128 (128, 1) (select (is_finite row_max, row_max, splat (128, 0:F32)))));
    let sum_exps = reduce (ma.add fast, 0:F32) 1₂ exps;
    let nonneg   = ge (sum_exps, splat (128, 0:F32));
    let d_ce     = broadcast ((1, 1), (128, 10), from_array @(2, (1, 1), F32) (ma.div fast (math.minus fast one, 128.0:F32))) * arg7;
    let d_sum    = reduce (ma.add fast, 0:F32) 1₂ (minus d_ce) / abs sum_exps;
    let zeros    = splat (128, 0:F32);
    let d_logits = d_ce + broadcast ((128, 1), (128, 10), reshape 128 (128, 1) (select (nonneg, d_sum, zeros) + minus (select (nonneg, zeros, d_sum)))) * exps;
    let d_h1     = dot_product Ring (1₂, 1₂, (), ()) (d_logits, arg4);
    let d_z1     = d_h1 * (from_array ‹128; ‹1024; one›› - h1) + d_h1 * h1;
    let d_h0     = dot_product Ring (1₂, 1₂, (), ()) (d_z1, arg2) * (from_array ‹128, 1024; one› - h0);
    let d_z0     = d_h0 + d_h0 * h0;
    let lr = 0.001:F32;
    // Return the SGD update delta (old − new = lr·grad) of one element of each of the six results,
    // so every gradient chain stays live and the driver can check the backward pass numerically.
    let g0 = ma.sub fast (get (arg0, (3₇₈₄, 5₁₀₂₄)), get ((arg0 - from_array ‹784, 1024; lr› * transpose_2d (dot_product Ring (0₂, 0₂, (), ()) (d_z0, arg6))), (3₇₈₄, 5₁₀₂₄)));
    let g1 = ma.sub fast (tensor.get (arg1, 7₁₀₂₄), get ((arg1 - from_array ‹1024; lr› * reduce (ma.add fast, 0:F32) 0₂ d_z0), 7₁₀₂₄));
    let g2 = ma.sub fast (get (arg2, (11₁₀₂₄, 13₁₀₂₄)), get ((arg2 - from_array ‹1024, 1024; lr› * transpose_2d (dot_product Ring (0₂, 0₂, (), ()) (d_z1, h0))), (11₁₀₂₄, 13₁₀₂₄)));
    let g3 = ma.sub fast (tensor.get (arg3, 17₁₀₂₄), get ((arg3 - from_array ‹1024; lr› * reduce (ma.add fast, 0:F32) 0₂ d_z1), 17₁₀₂₄));
    let g4 = ma.sub fast (get (arg4, (19₁₀₂₄, 2₁₀)), get ((arg4 - from_array ‹1024, 10; lr› * transpose_2d (dot_product Ring (0₂, 0₂, (), ()) (d_logits, h1))), (19₁₀₂₄, 2₁₀)));
    let g5 = ma.sub fast (tensor.get (arg5, 3₁₀), get ((arg5 - from_array ‹10; lr› * reduce (ma.add fast, 0:F32) 0₂ d_logits), 3₁₀));
    let g6 = ma.add fast (g0, ma.add fast (g1, ma.add fast (g2, ma.add fast (g3, ma.add fast (g4, g5)))));
    return g6;

// CHECK-NOT: tensor.map_reduce
