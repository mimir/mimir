// REQUIRES: release || !system-win32
// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p opt %s -p ll -o - | %FileCheck %s
// RUN: clang++ -std=c++23 %S/hlo_step_aux.cpp %{s:stem}.ll -o %t -O1 -Wno-override-module
// RUN: %t

// Full-size two-layer MLP training step (batch 128, 784→1024→1024→10), an HLO dump lowered through the
// DEFAULT pipeline all the way to LLVM and executed against a plain C++ reference in hlo_step_aux.cpp.
// `main_hlo` computes the six SGD-updated results (two weight matrices per layer plus biases) and returns
// the update delta (old − new = lr·grad) of one element of each, so every forward and backward chain stays
// live and the driver can check the backward pass numerically. hlo_train.mim is the compact one-layer
// variant of this test; hlo_exec.mim covers the forward pass only.
plugin tensor as *;
plugin refly;
plugin core;
plugin cps;
plugin affine;
plugin math;

use math.arith as ma;

let f32 = math.f32;
let F32 = math.F32;

let R: Ring = (F32, 0:F32, ma.add 0, ma.mul 0);

lam `+            {r: Nat, s: «r; Nat»} (is: [«s; F32», «s; F32»]): «s;  F32» = binary (ma.add 0) is;
lam `-            {r: Nat, s: «r; Nat»} (is: [«s; F32», «s; F32»]): «s;  F32» = binary (ma.sub 0) is;
lam `*            {r: Nat, s: «r; Nat»} (is: [«s; F32», «s; F32»]): «s;  F32» = binary (ma.mul 0) is;
lam `/            {r: Nat, s: «r; Nat»} (is: [«s; F32», «s; F32»]): «s;  F32» = binary (ma.div 0) is;
lam F32_max       {r: Nat, s: «r; Nat»} (is: [«s; F32», «s; F32»]): «s;  F32» = binary (math.extrema.fmax 0) is;
lam F32_GE        {r: Nat, s: «r; Nat»} (is: [«s; F32», «s; F32»]): «s; Bool» = binary (math.cmp.ge 0) is;
lam F32_tanh      {r: Nat, s: «r; Nat»} (i: «s; F32»): «s;  F32» = unary (math.tri.tanh 0) i;
lam F32_exp       {r: Nat, s: «r; Nat»} (i: «s; F32»): «s;  F32» = unary (math.exp.exp 0) i;
lam F32_abs       {r: Nat, s: «r; Nat»} (i: «s; F32»): «s;  F32» = unary (math.abs 0) i;
lam F32_minus     {r: Nat, s: «r; Nat»} (i: «s; F32»): «s;  F32» = unary (math.minus 0) i;
lam F32_is_finite {r: Nat, s: «r; Nat»} (i: «s; F32»): «s; Bool» = unary (math.is_finite 0) i;

// out[i] = fold_j g (input[i, j]): reduce a «n, m; F32» tensor along axis 1
// (one output loop over n, one reduction loop over m).
lam reduce_ax1 (g: [F32, F32] → F32, init: F32) {n m: Nat} (input: «n, m; F32»): «n; F32» =
    map_reduce (n, (n, m)) (pool_fun g, init) (proj_map 0) (proj_map (0, 1), ) input;
// out[j] = fold_i g (input[i, j]): reduce along axis 0 (the output loop runs over m, the reduction over n).
lam reduce_ax0 (g: [F32, F32] → F32, init: F32) {n m: Nat} (input: «n, m; F32»): «m; F32» =
    map_reduce (m, (m, n)) (pool_fun g, init) (proj_map 0) (proj_map (1, 0), ) input;

extern fun main_hlo (arg0: «784; «1024; F32»», arg1: «1024; F32», arg2: «1024; «1024; F32»», arg3: «1024; F32», arg4: «1024; «10; F32»», arg5: «10; F32», arg6: «128; «784; F32»», arg7: «128; «10; F32»») : F32 =
    let v_cst = math.conv.f2f (23, 8) (1.0:math.F64);
    let v_4  = F32_tanh (product_2d R (arg6, arg0) + broadcast ((1, 1024), (128, 1024), arg1));
    let v_11 = F32_tanh (product_2d R (v_4, arg2) + broadcast ((1, 1024), (128, 1024), arg3));
    let v_17 = product_2d R (v_11, arg4) + broadcast ((1, 10), (128, 10), arg5);
    let v_20 = F32_max (‹128; 0xFF800000:F32›, reduce_ax1 ((math.extrema.fmax 0), 0xFF800000:F32) v_17);
    let v_27 = F32_exp (v_17 - broadcast ((128, 1), (128, 10), select (F32_is_finite v_20, v_20, ‹128; 0:F32›)));
    let v_28 = reduce_ax1 ((ma.add 0), 0:F32) v_27;
    let v_32 = F32_GE (v_28, ‹128, 1; 0:F32›);
    let v_37 = broadcast ((1, 1), (128, 10), ma.div 0 (math.minus 0 v_cst, math.conv.f2f (23, 8) (128.0:math.F64))) * arg7;
    let v_41 = reduce_ax1 ((ma.add 0), 0:F32) (F32_minus v_37) / F32_abs v_28;
    let v_42 = ‹128, 1; 0:F32›;
    let v_50 = v_37 + broadcast ((128, 1), (128, 10), select (v_32, v_41, v_42) + F32_minus (select (v_32, v_42, v_41))) * v_27;
    let v_56 = dot_product R (1₂, 1₂, (), ()) (v_50, arg4);
    let v_59 = v_56 * (‹128; ‹1024; v_cst›› - v_11) + v_56 * v_11;
    let v_66 = dot_product R (1₂, 1₂, (), ()) (v_59, arg2) * (‹128, 1024; v_cst› - v_4);
    let v_68 = v_66 + v_66 * v_4;
    let lr = math.conv.f2f (23, 8) (0.001:math.F64);
    // Return the SGD update delta (old − new = lr·grad) of one element of each of the six results,
    // so every gradient chain stays live and the driver can check the backward pass numerically.
    let g0 = ma.sub 0 (get ((3₇₈₄, 5₁₀₂₄), arg0), get ((3₇₈₄, 5₁₀₂₄), arg0 - ‹784, 1024; lr› * transpose_2d (dot_product R (0₂, 0₂, (), ()) (v_68, arg6))));
    let g1 = ma.sub 0 (get ((7₁₀₂₄), arg1), get ((7₁₀₂₄), arg1 - ‹1024; lr› * reduce_ax0 ((ma.add 0), 0:F32) v_68));
    let g2 = ma.sub 0 (get ((11₁₀₂₄, 13₁₀₂₄), arg2), get ((11₁₀₂₄, 13₁₀₂₄), arg2 - ‹1024, 1024; lr› * transpose_2d (dot_product R (0₂, 0₂, (), ()) (v_59, v_4))));
    let g3 = ma.sub 0 (get ((17₁₀₂₄), arg3), get ((17₁₀₂₄), arg3 - ‹1024; lr› * reduce_ax0 ((ma.add 0), 0:F32) v_59));
    let g4 = ma.sub 0 (get ((19₁₀₂₄, 2₁₀), arg4), get ((19₁₀₂₄, 2₁₀), arg4 - ‹1024, 10; lr› * transpose_2d (dot_product R (0₂, 0₂, (), ()) (v_50, v_11))));
    let g5 = ma.sub 0 (get ((3₁₀), arg5), get ((3₁₀), arg5 - ‹10; lr› * reduce_ax0 ((ma.add 0), 0:F32) v_50));
    let g6 = ma.add 0 (g0, ma.add 0 (g1, ma.add 0 (g2, ma.add 0 (g3, ma.add 0 (g4, g5)))));
    return g6;

// CHECK-NOT: tensor.map_reduce
