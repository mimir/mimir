// RUN: %mim -p opt %s -o - | %FileCheck %s
// RUN: %mim -p opt %s -o - | %FileCheck %s --check-prefix=GONE

// Exercises tensor.map_reduce with hand-written affine access maps.
// The inputs are taken as extern array arguments (as in hlo.mim) so the lowering is realistic; the
// test checks the lowered Mim IR (no codegen). The GONE prefix asserts the axiom is fully lowered
// away in every function.
// GONE-NOT: %tensor.map_reduce

plugin core;
plugin tensor;
plugin cps;
plugin affine;
plugin mem;

fun add  (x: I32, y: «1; I32»)@tt = return (core.wrap.add 0 (x, y#0₁));
fun copy (x: I32, y: «1; I32»)@tt = return (y#0₁);
lam id1 (i: affine.Index): «1; affine.Index» = i;
lam id1i(i, j: affine.Index): «1; affine.Index» = i;
lam id2 (i, j: affine.Index): «2; affine.Index» = (i, j);
lam tr  (i, j: affine.Index): «2; affine.Index» = (j, i);
lam sl  (i: affine.Index): «1; affine.Index» = (affine.op.add (affine.semiop.mul (i, 3), affine.lit 2), );

// A reduction (`Ro = 1`, `Rn = 2`): out[i] = sum_j input[i][j], with a projection input access and the identity output map.
// CHECK-DAG: extern fun row_sum
extern fun row_sum (input: «3, 4; I32»): «3; I32» =
    return (tensor.map_reduce (3, (3, 4)) (add, 0I32) id1i id2 input);

// Transpose via the output map `acc_out` (`Rn = Ro`, no reduction loop): out[j][i] = input[i][j].
// CHECK-DAG: extern fun transpose
extern fun transpose (input: «2, 3; I32»): «3, 2; I32» =
    return (tensor.map_reduce ((3, 2), (2, 3)) (copy, ⊥:I32) tr id2 input);

// A strided slice via the affine input map: out[i] = input[3*i + 2].
// CHECK-DAG: extern fun strided
// The affine read index `3*i + 2` lowers to %core arithmetic:
// CHECK-DAG: %core.wrap.mul {{.*}}(3I64
// CHECK-DAG: %core.wrap.add {{.*}}(2I64
extern fun strided (input: «8; I32»): «2; I32» =
    return (tensor.map_reduce (‹1; 2›, ‹1; 2›) (copy, ⊥:I32) id1 sl input);
