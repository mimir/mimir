// RUN: %mim %s -p opt -o %t
// RUN: cat %t | %FileCheck %s
// RUN: cat %t | %FileCheck %s --check-prefix=GONE

// %tensor.pool: 2-D pooling, a windowed reduction over %tensor.map_reduce (Ro=4 output loops, Rr=2 kernel loops),
// reading the input at stride·o + dilation·k after padding via %tensor.pad with the fold's identity `init`. The fold
// `g` + `init` are operands, so max-pooling (g = max, init = -inf) and sum-/avg-pooling (g = +, init = 0) share one op.
// Checked on the lowered Mim IR (no codegen), as for conv / slice. Inputs use N,C >= 2 so the NCHW layout does not
// collapse leading size-1 dims.
// GONE-NOT: %tensor.pool
// GONE-NOT: %tensor.pad
// GONE-NOT: map_reduce
// GONE-NOT: %affine

plugin core;
plugin tensor;
plugin affine;
plugin mem;

// max over two Nats (no -inf needed when there is no padding: 0 seeds the max for non-negative inputs).
lam nat_max (a b: Nat): Nat = %core.select (%core.ncmp.ge (a, b), a, b);

// 2x2 max-pool, stride 2, no padding: «2,2,4,4» -> «2,2,2,2». The reduction is the `nat_max` comparison; the strided
// window read lowers to %core arithmetic.
// CHECK-DAG: fun extern maxpool
// CHECK-DAG: %core.ncmp
// CHECK-DAG: %core.wrap.mul {{.*}}(2I64
fun extern maxpool (input: «2, 2, 4, 4; Nat»): «2, 2, 2, 2; Nat» =
    return (%tensor.pool (nat_max, 0) ((2, 2), (2, 2), (1, 1), (0, 0), (2, 2)) input);

// 2x2 sum-pool, stride 2, padding 1 (pad value = init = 0): «2,2,4,4» -> «2,2,3,3». Exercises the %tensor.pad
// composition and a different fold (the running sum lowers to %core.nat.add).
// CHECK-DAG: fun extern sumpool
// CHECK-DAG: %core.nat.add
fun extern sumpool (input: «2, 2, 4, 4; Nat»): «2, 2, 3, 3; Nat» =
    return (%tensor.pool (%core.nat.add, 0) ((2, 2), (2, 2), (1, 1), (1, 1), (3, 3)) input);
