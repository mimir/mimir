// RUN: %mim %s -p opt -o %t
// RUN: cat %t | %FileCheck %s
// RUN: cat %t | %FileCheck %s --check-prefix=GONE

// %tensor.flip: reverse every axis, out[…d…] = input[… (s_in#d − 1) − d …]. A pure linear affine read over
// %tensor.map_reduce_aff. Checked on the lowered Mim IR (no codegen), as for hlo.mim / reshape.
// GONE-NOT: %tensor.flip
// GONE-NOT: map_reduce_aff
// GONE-NOT: %affine

plugin core;
plugin tensor;
plugin affine;
plugin mem;

// 1-D reverse of a length-4 vector: out[i] = input[3 - i].
// CHECK-DAG: fun extern flip1d
// CHECK-DAG: %core.wrap.sub {{.*}}(3I64
fun extern flip1d (input: «4; I32»): «4; I32» =
    return (%tensor.flip 4 input);

// 2-D reverse: out[i][j] = input[1 - i][2 - j].
// CHECK-DAG: fun extern flip2d
fun extern flip2d (input: «2, 3; I32»): «2, 3; I32» =
    return (%tensor.flip (2, 3) input);
