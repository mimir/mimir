// RUN: (! %mim -p opt %s -o - 2>&1) | %FileCheck %s

plugin tensor;

// CHECK: scatter index shape exceeds updates shape at axis 1
extern fun invalid (input: tensor.Tensor 2 (2, 4) I32, index: tensor.Tensor 2 (2, 4) (Idx 2), updates: tensor.Tensor 2 (2, 3) I32): tensor.Tensor 2 (2, 4) I32 =
    return (tensor.scatter ((2, 4), (2, 4), (2, 3)) 0₂ (input, index, updates));
