// RUN: %mim -p opt %s -o - | %FileCheck %s

// A trailing pure map over a matrix product (the GEMM-epilogue pattern): the product must not be
// inlined into the map's combiner (it reduces), but the map composes into the product's `post`
// epilogue — a single map_reduce with post = add1 remains.
plugin tensor;
plugin core;
plugin opt;

lam add1 (x: Nat): Nat = %core.nat.add (x, 1);

con extern f (a: «2, 3; Nat», b: «3, 4; Nat», return: Cn «2, 4; Nat») =
    let prod = %tensor.product_2d (Nat, 0, %core.nat.add, %core.nat.mul) (a, b);
    let out  = %tensor.unary @(Nat, Nat) add1 @(2, (2, 4)) prod;
    return out;

lam extern _compile (): %compile.Phase =
    %compile.phases ff (
        %compile.cleanup,
        %tensor.lower_tensor,
        %tensor.fuse_tensor,
        %compile.cleanup,
    );

// CHECK: %tensor.map_reduce
// CHECK-NOT: %tensor.map_reduce
