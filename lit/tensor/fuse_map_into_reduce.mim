// RUN: %mim -p opt %s -o - | %FileCheck %s

// A trailing pure map over a matrix product (the GEMM-epilogue pattern): the product must not be
// inlined into the map's combiner (it reduces), but the map composes into the product's `post`
// epilogue — a single map_reduce with post = add1 remains.
plugin core;
plugin tensor;
plugin compile;

use core.ops.n;
use tensor;

lam add1 (x: Nat): Nat = x + 1;

let Ring = (Nat, 0, core.nat.add, core.nat.mul);

let `* = product_2d Ring;

extern con f (a: tensor.Tensor 2 (2, 3) Nat, b: tensor.Tensor 2 (3, 4) Nat, return: Cn [tensor.Tensor 2 (2, 4) Nat]) =
    return (unary add1 (a * b));

extern lam _compile (): compile.Phase =
    compile.phases ff (
        compile.cleanup,
        lower_tensor,
        fuse_tensor,
        compile.cleanup,
    );

// CHECK: tensor.map_reduce
// CHECK-NOT: tensor.map_reduce
