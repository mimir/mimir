// RUN: %mim %s -p opt -o %t
// RUN: cat %t | %FileCheck %s
// RUN: cat %t | %FileCheck %s --check-prefix=GONE
// `-X tensor:reassoc-max` caps the chain length that gets enumerated (and hence dispatched over).
// RUN: %mim %s -p opt -X tensor:reassoc-max=2 -o %t2
// RUN: cat %t2 | %FileCheck %s --check-prefix=NODISP
// RUN: cat %t2 | %FileCheck %s --check-prefix=NOCMP
// `-X tensor:reassoc-vec` counts plain multiplications instead of padded vector lanes.
// RUN: %mim %s -p opt -X tensor:reassoc-vec=1 -o %t3
// RUN: cat %t3 | %FileCheck %s --check-prefix=SCALAR

// %tensor.reassoc: matrix-chain order.
// Every cost below counts vector-lane slots: a product's trailing extent is the vector loop, so a
// literal one is charged rounded up to a multiple of 8 (the default `-X tensor:reassoc-vec`).

plugin core;
plugin tensor;

lam nat_ring (): %tensor.Ring = (Nat, 0, %core.nat.add, %core.nat.mul);

// 4x10 · 10x2 · 2x10 written right-deep costs 10·2·16 + 4·10·16 = 960; the dynamic program picks the
// left-deep bracketing at 4·10·8 + 4·2·16 = 448.
// CHECK-DAG: fun extern chain3
// CHECK-DAG: %tensor.product_2d {{.*}} (4, 10, 2)
// CHECK-DAG: %tensor.product_2d {{.*}} (4, 2, 10)
// GONE-NOT: %tensor.product_2d {{.*}} (10, 2, 10)
fun extern chain3 (a: «4, 10; Nat», b: «10, 2; Nat», c: «2, 10; Nat»): «4, 10; Nat» =
    let R = nat_ring ();
    return (%tensor.product_2d R (a, %tensor.product_2d R (b, c)));

// 30x35 · 35x15 · 15x5 · 5x10 written left-deep costs 22800; the optimum is ((A·(B·C))·D) at 15000,
// a bracketing that is neither left- nor right-deep.
// CHECK-DAG: fun extern chain4
// CHECK-DAG: %tensor.product_2d {{.*}} (35, 15, 5)
// CHECK-DAG: %tensor.product_2d {{.*}} (30, 35, 5)
// CHECK-DAG: %tensor.product_2d {{.*}} (30, 5, 10)
fun extern chain4 (a: «30, 35; Nat», b: «35, 15; Nat», c: «15, 5; Nat», d: «5, 10; Nat»): «30, 10; Nat» =
    let R = nat_ring ();
    return (%tensor.product_2d R (%tensor.product_2d R (%tensor.product_2d R (a, b), c), d));

// A shared intermediate is a chain boundary: reassociating across `ab` would leave it materialized
// for its second consumer as well, so both chains keep contracting 35 first.
// CHECK-DAG: fun extern shared
// CHECK-DAG: %tensor.product_2d {{.*}} (30, 15, 5)
// CHECK-DAG: %tensor.product_2d {{.*}} (30, 15, 10)
fun extern shared (a: «30, 35; Nat», b: «35, 15; Nat», c: «15, 5; Nat», d: «15, 10; Nat»)
                 : [«30, 5; Nat», «30, 10; Nat»] =
    let R  = nat_ring ();
    let ab = %tensor.product_2d R (a, b);
    return (%tensor.product_2d R (ab, c), %tensor.product_2d R (ab, d));

// A symbolic extent is fine as long as one bracketing wins for *every* value of it. Here the rank-8
// bottleneck does: x·(U·V) costs 768·8·768 + 589824·m, (x·U)·V costs 12288·m, and 12288 ≤ 589824
// with nothing left over - so the reassociation is provable without knowing m.
// CHECK-DAG: fun extern low_rank
// CHECK-DAG: %tensor.product_2d (Nat, 0, %core.nat.add, %core.nat.mul) ({{.*}}, 768, 8)
// CHECK-DAG: %tensor.product_2d (Nat, 0, %core.nat.add, %core.nat.mul) ({{.*}}, 8, 768)
fun extern low_rank {m: Nat} (x: «m, 768; Nat», u: «768, 8; Nat», v: «8, 768; Nat»): «m, 768; Nat» =
    let R = nat_ring ();
    return (%tensor.product_2d R (x, %tensor.product_2d R (u, v)));

// The same shape without a bottleneck has no single winner: contracting 784 first costs
// 28224000 + 96000·m, 300 first 276256·m, 120 first 4339200 + 12544·m, and so on - small m prefers a
// small constant, large m a small factor. Three of the five bracketings survive the domination test
// (each wins for some m), so their costs are compared at run time and only the winner's thunk runs.
// The two comparisons below are that tournament; the `()` is the selected thunk being forced.
// CHECK-DAG: fun extern batch_dispatch
// CHECK-DAG: %core.nat.add (4339200, {{.*}})
// CHECK-DAG: %core.nat.add (576000, {{.*}})
// CHECK-DAG: %core.ncmp.gLe ({{.*}}, ({{.*}})#{{.*}})
// CHECK-DAG: ({{.*}})#{{.*}} ();
// Capped at 2 the chain falls back to the static dynamic program, which cannot decide it either, so
// it survives as written and no cost is computed at run time.
// NODISP-DAG: %tensor.product_2d (Nat, 0, %core.nat.add, %core.nat.mul) ({{.*}}, 784, 300)
// NODISP-DAG: %tensor.product_2d (Nat, 0, %core.nat.add, %core.nat.mul) ({{.*}}, 300, 120)
// NODISP-DAG: %tensor.product_2d (Nat, 0, %core.nat.add, %core.nat.mul) ({{.*}}, 120, 10)
// NOCMP-NOT: %core.ncmp
fun extern batch_dispatch {m: Nat} (x: «m, 784; Nat», w1: «784, 300; Nat», w2: «300, 120; Nat»,
                                    w3: «120, 10; Nat»): «m, 10; Nat» =
    let R = nat_ring ();
    return (%tensor.product_2d R (%tensor.product_2d R (%tensor.product_2d R (x, w1), w2), w3));

// Multiplications alone would keep this chain as written: 100·4·2 + 100·2·8 = 2400 beats
// 4·2·8 + 100·4·8 = 3264. But `a·b` is 100 wide and 2 narrow, and 2 columns leave 6 of the 8 vector
// lanes idle - charged, the chain as written costs 4800 while the other bracketing still costs 3264,
// so it is reassociated to keep the vectors full.
// CHECK-DAG: fun extern narrow
// CHECK-DAG: %tensor.product_2d {{.*}} (4, 2, 8)
// CHECK-DAG: %tensor.product_2d {{.*}} (100, 4, 8)
// GONE-NOT: %tensor.product_2d {{.*}} (100, 4, 2)
// Counting plain multiplications leaves it as written.
// SCALAR-DAG: %tensor.product_2d {{.*}} (100, 4, 2)
// SCALAR-DAG: %tensor.product_2d {{.*}} (100, 2, 8)
fun extern narrow (a: «100, 4; Nat», b: «4, 2; Nat», c: «2, 8; Nat»): «100, 8; Nat» =
    let R = nat_ring ();
    return (%tensor.product_2d R (%tensor.product_2d R (a, b), c));

// `%tensor.lower_to_mem` rejects a tensor-typed function *value*, which is what the dispatcher's
// thunks are - and it cannot carry a symbolically shaped tensor across a function boundary either.
// So this test stops after the reassociation it is about.
lam extern _compile (): %compile.Phase = %tensor.reassoc;
