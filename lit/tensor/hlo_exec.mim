// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p opt %s -p ll
// RUN: clang++ -std=c++23 %S/hlo_aux.cpp %{s:stem}.ll -o %t -Wno-override-module
// RUN: %t

// Executable forward pass of the MLP in hlo.mim, lowered all the way to LLVM and driven by aux.cpp.
// `main_hlo` computes, for a batch of 128 samples:
//   h0     = tanh(arg6 · arg0 + arg1)          // 128×784 · 784×1024 -> 128×1024
//   h1     = tanh(h0   · arg2 + arg3)          // 128×1024 · 1024×1024 -> 128×1024
//   logits =      h1   · arg4 + arg5           // 128×1024 · 1024×10 -> 128×10
//   out[i] = max_j logits[i][j]                // row-wise reduction -> 128
// The parameter order matches the C prototype in aux.cpp (arg0..arg4, arg6, arg7, arg5); arg7 (the
// labels, only used by the training/backward pass) stays unused here.
//
// This runs through the DEFAULT `-p opt` pipeline, so the tensor ops are bufferized via
// tensor.lower_to_mem (get/set/map_reduce/broadcast -> buffer/%btensor -> mem). See hlo.mim for the
// full training step (forward + backward), which is likewise executed and checked against a reference.
plugin tensor;
plugin core;
plugin math;

use tensor;

let F32     = math.F32;
let fast    = math.mode.fast;
let neg_inf = math.neg_inf math.f32;
let Ring    = (F32, 0:F32, math.arith.add fast, math.arith.mul fast);

let `+ = binary (math.arith.add fast);
let `* = product_2d Ring;

lam tanh {r: Nat, s: «r; Nat»} (i: «s; F32»): «s; F32» = unary (math.tri.tanh fast) i;

extern fun main_hlo (arg0: «784; «1024; F32»», arg1: «1024; F32», arg2: «1024; «1024; F32»», arg3: «1024; F32», arg4: «1024; «10; F32»», arg6: «128; «784; F32»», arg7: «128; «10; F32»», arg5: «10; F32»)
: «128; F32» =
    let (arg0, arg1, arg2, arg3, arg4, arg6, arg7, arg5) = (buf arg0, buf arg1, buf arg2, buf arg3, buf arg4, buf arg6, buf arg7, buf arg5);
    let h0     = tanh (arg6 * arg0 + broadcast ((1, 1024), (128, 1024), arg1));
    let h1     = tanh (h0 * arg2 + broadcast ((1, 1024), (128, 1024), arg3));
    let logits = h1 * arg4 + broadcast ((1, 10), (128, 10), arg5);
    return (reduce (math.extrema.fmax fast, neg_inf) 1₂ logits);
