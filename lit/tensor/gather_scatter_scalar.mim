// RUN: %mim %s -p opt -o - | %FileCheck %s --implicit-check-not=tensor.gather --implicit-check-not=tensor.scatter --implicit-check-not=btensor.gather --implicit-check-not=btensor.scatter

// Singleton tensors retain their rank-one logical gather/scatter shapes.
// CHECK-LABEL: extern fun gather_scalar
// CHECK-LABEL: extern fun scatter_scalar
// CHECK-NOT: tensor.gather
// CHECK-NOT: tensor.scatter
// CHECK-NOT: btensor.gather
// CHECK-NOT: btensor.scatter

plugin tensor;
plugin btensor;
plugin compile;

extern fun gather_scalar (input: tensor.Tensor 1 1 I32, index: tensor.Tensor 1 1 (Idx 1)): tensor.Tensor 1 1 I32 =
    return (tensor.gather ((1), (1)) 0₁ (input, index));

extern fun scatter_scalar (input: tensor.Tensor 1 1 I32, index: tensor.Tensor 1 1 (Idx 1), updates: tensor.Tensor 1 1 I32): tensor.Tensor 1 1 I32 =
    return (tensor.scatter ((1), (1), (1)) 0₁ (input, index, updates));

extern lam _compile (): compile.Phase =
    compile.phases ff (
        tensor.lower_to_mem,
        btensor.lower_map_reduce,
        compile.cleanup,
    );
