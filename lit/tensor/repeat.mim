// RUN: %mim %s -p opt -o - | %FileCheck %s
// RUN: %mim %s -p opt -o - | %FileCheck %s --check-prefix=GONE

// tensor.repeat tiles an input to a larger shape: out[…d…] = input[… d mod s_in#d …]. The wrap-around read lowers via
// the affine `mod` semiop to core.div.urem. Checked on the lowered Mim IR (no codegen), as for hlo.mim / map_reduce.
// GONE-NOT: tensor.repeat
// GONE-NOT: map_reduce
// GONE-NOT: affine\.

plugin tensor;

// Tile a length-3 vector to length 6: out[i] = input[i mod 3].
// CHECK-DAG: extern con tile1d
// CHECK-DAG: core.div.urem
extern fun tile1d (input: tensor.Tensor 1 3 I32): tensor.Tensor 1 6 I32 =
    return (tensor.repeat 3 6 (input));

// Tile a 2x3 matrix along both axes to 4x6: out[i][j] = input[i mod 2][j mod 3].
// CHECK-DAG: extern con tile2d
extern fun tile2d (input: tensor.Tensor 2 (2, 3) I32): tensor.Tensor 2 (4, 6) I32 =
    return (tensor.repeat (2, 3) (4, 6) (input));
