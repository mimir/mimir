// RUN: %mim -p opt %s -o - | %FileCheck %s

// Strip-mining as a pure domain transform on the Tileable interface: the strip-mined computation
// is an ordinary %tensor.map_reduce_post over a higher-rank domain with composed access maps —
// no new op, no lowering support.

plugin core;
plugin tensor;
plugin affine;
plugin opt;

fun add (x: Nat, y: «1; Nat»)@tt: Nat = return (%core.nat.add (x, y#0₁));
lam mo (o: «3; %affine.index»): «2; %affine.index» = (o#0_3, o#1_3);
lam mi (o: «3; %affine.index»): «3; %affine.index» = o;

// out[i, j] = Σ_k in[i, j, k] over «2, 4, 8» with the reduction dim strip-mined by 2:
// the domain becomes (2, 4, 4, 2) with two reduction dims.
fun extern sum_red (input: «2, 4, 8; Nat»): «2, 4; Nat» =
    return (%tensor.materialize (%tensor.strip_mine_red (
        %tensor.mr_tileable @1 @(Nat, Nat, 2, 1) ((2, 4), (0, 1), (2, 4, 8))
            @(Nat, 3, (2, 4, 8)) (add, 0, %tensor.id @Nat)
            mo mi input,
        2, 2)));

// The same sum with the parallel dim j (extent 4) split by 2: the domain becomes (2, 2, 2, 8)
// and the output is packed «2, 2, 2» (a row-major reshape restores «2, 4»).
fun extern sum_par (input: «2, 4, 8; Nat»): «2, 2, 2; Nat» =
    return (%tensor.materialize (%tensor.strip_mine_par (
        %tensor.mr_tileable @1 @(Nat, Nat, 2, 1) ((2, 4), (0, 1), (2, 4, 8))
            @(Nat, 3, (2, 4, 8)) (add, 0, %tensor.id @Nat)
            mo mi input,
        1, 2)));

lam extern _compile (): %compile.Phase =
    %compile.phases ff (%compile.internal_cleanup,);

// The cleanup pass zonks inference holes, so the transformed domains print as plain literals.
// CHECK-DAG: (2, 4, 4, 2)
// CHECK-DAG: (2, 2, 2, 8)
