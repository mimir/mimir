// REQUIRES: release || !system-win32
// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p opt %s -p ll
// RUN: clang++ -std=c++23 %S/hlo_train_aux.cpp %{s:stem}.ll -o %t -Wno-override-module
// RUN: %t

// Executable training step (forward + backward) of a one-layer MLP, lowered all the way to LLVM and
// checked against a plain C++ reference in hlo_train_aux.cpp. It exercises the full backward-pass op set
// end to end:
//   tensor.product_2d, tensor.dot_product (both contraction axes), tensor.transpose_2d,
//   tensor.broadcast (vector *and scalar* — the scalar case is the one lower_to_mem now bufferizes via a
//   btensor.broadcast fill loop), tensor.select, tensor.reduce, and the elementwise math ops.
// `main_hlo` returns one scalar summing one element of each result, so no chain is dead-code-eliminated.
// hlo.mim is the full-size two-layer (128/784/1024/10) network this is a compact stand-in for; it now
// runs as an executable test as well, so this variant mainly gives fast, small-dimension coverage.
//
// Dimensions: batch N=4, in I=8, out O=3.
plugin tensor;
plugin core;
plugin math;

use tensor;

let F32     = math.F32;
let fast    = math.mode.fast;
let neg_inf = math.neg_inf math.f32;
let Ring    = (F32, 0:F32, math.arith.add fast, math.arith.mul fast);

let lr = 0.001:F32;
let c  = 0.5:F32; // loss-gradient scale

let `+ = binary (math.arith.add fast);
let `- = binary (math.arith.sub fast);
let `* = binary (math.arith.mul fast);

lam tanh      {r: Nat, s: «r; Nat»} (i: «s; F32»): «s; F32»  = unary (math.tri.tanh fast) i;
lam is_finite {r: Nat, s: «r; Nat»} (i: «s; F32»): «s; Bool» = unary (math.is_finite fast) i;

extern fun main_hlo (w: «8; «3; F32»», b: «3; F32», x: «4; «8; F32»», t: «4; «3; F32»»): F32 =
    let (w, b, x, t) = (buf w, buf b, buf x, buf t);
    // forward: a = tanh(x·w + b)
    let z = product_2d Ring (x, w);                                     // [4, 3]
    let a = tanh (z + broadcast ((1, 3), (4, 3), b));                   // [4, 3]
    // loss gradient d = c * (a - t), with c a *scalar* broadcast
    let d = broadcast ((1, 1), (4, 3), c) * (a - t);                    // [4, 3]
    // row reduction + select (kept live through the result)
    let rmax = reduce (math.extrema.fmax fast, neg_inf) 1₂ z;           // [4]
    let sel  = select (is_finite rmax, rmax, ‹4; 0: F32›);              // [4]
    // backward: dW = (dᵀ·x)ᵀ, dx = d·wᵀ, db = Σ_n d
    let dW = transpose_2d (dot_product Ring (0₂, 0₂, (), ()) (d, x));   // [8, 3]
    let dx = dot_product Ring (1₂, 1₂, (), ()) (d, w);                  // [4, 8]
    let db = reduce (math.arith.add fast, 0: F32) 0₂ d;                 // [3]
    // SGD update
    let w2 = w - ‹8, 3; lr› * dW;
    let b2 = b - ‹3; lr› * db;
    // sum one element of each result so no chain is dead-code-eliminated
    let add = math.arith.add fast;
    return (add (add (w2#(0₈, 0₃), b2#0₃), add (dx#(0₄, 0₈), sel#0₄)));
