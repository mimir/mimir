// REQUIRES: release || !system-win32
// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p opt %s -p ll
// RUN: clang++ -std=c++23 %S/hlo_train_aux.cpp %{s:stem}.ll -o %t -Wno-override-module
// RUN: %t

// Executable training step (forward + backward) of a one-layer MLP, lowered all the way to LLVM and
// checked against a plain C++ reference in hlo_train_aux.cpp. It exercises the full backward-pass op set
// end to end:
//   %tensor.product_2d, %tensor.dot_product (both contraction axes), %tensor.transpose_2d,
//   %tensor.broadcast (vector *and scalar* — the scalar case is the one lower_to_mem now bufferizes via a
//   %btensor.broadcast fill loop), %tensor.select, reduce_ax0 / reduce_ax1, and the elementwise math ops.
// `main_hlo` returns one scalar summing one element of each result, so no chain is dead-code-eliminated.
// hlo.mim is the full-size two-layer (128/784/1024/10) network this is a compact stand-in for; it now
// runs as an executable test as well, so this variant mainly gives fast, small-dimension coverage.
//
// Dimensions: batch N=4, in I=8, out O=3.
plugin tensor;
plugin core;
plugin affine;
plugin mem;
plugin cps;
plugin math;
use tensor;

let f32 = %math.f32;
let F32 = %math.F32;

let R: %tensor.Ring = (F32, 0: F32, %math.arith.add 0, %math.arith.mul 0);

// NB: a decimal literal `x.y: %math.F32` currently lowers to 0.0 — only F64 decimal literals parse
// correctly — so F32 constants are built by converting an F64 literal with %math.conv.f2f.
let f32_lr = %math.conv.f2f (23, 8) (0.001: %math.F64); // learning rate
let f32_c  = %math.conv.f2f (23, 8) (0.5: %math.F64);   // loss-gradient scale

lam F32_add {r: Nat, s: «r; Nat»} [is: [«s; F32», «s; F32»]]: «s; F32» = %tensor.binary (%math.arith.add 0) is;
lam F32_sub {r: Nat, s: «r; Nat»} [is: [«s; F32», «s; F32»]]: «s; F32» = %tensor.binary (%math.arith.sub 0) is;
lam F32_mul {r: Nat, s: «r; Nat»} [is: [«s; F32», «s; F32»]]: «s; F32» = %tensor.binary (%math.arith.mul 0) is;
lam F32_tanh {r: Nat, s: «r; Nat»} [i: «s; F32»]: «s; F32» = %tensor.unary (%math.tri.tanh 0) i;
lam F32_is_finite {r: Nat, s: «r; Nat»} [i: «s; F32»]: «s; Bool» = %tensor.unary (%math.is_finite 0) i;

// out[i] = fold_j g (input[i, j]): reduce along axis 1 (one output loop over n, one reduction over m).
lam reduce_ax1 (g: [F32, F32] → F32, init: F32) {n m: Nat} (input: «n, m; F32»): «n; F32» =
    %tensor.map_reduce (n, (n, m)) (pool_fun g, init)
        (%tensor.proj_map 0) (%tensor.proj_map (0, 1), ) input;
// out[j] = fold_i g (input[i, j]): reduce along axis 0.
lam reduce_ax0 (g: [F32, F32] → F32, init: F32) {n m: Nat} (input: «n, m; F32»): «m; F32» =
    %tensor.map_reduce (m, (m, n)) (pool_fun g, init)
        (%tensor.proj_map 0) (%tensor.proj_map (1, 0), ) input;

fun extern main_hlo (w: «8; «3; F32»», b: «3; F32», x: «4; «8; F32»», t: «4; «3; F32»»): F32 =
    // forward: a = tanh(x·w + b)
    let z   = %tensor.product_2d R (x, w);                                   // [4, 3]
    let zb  = F32_add (z, %tensor.broadcast ((1, 3), (4, 3), b));
    let a   = F32_tanh zb;                                      // [4, 3]
    // loss gradient d = c * (a - t), with c a *scalar* broadcast
    let d0  = F32_sub (a, t);
    let sc  = %tensor.broadcast ((1, 1), (4, 3), f32_c);                     // scalar broadcast -> [4, 3]
    let d   = F32_mul (sc, d0);                                 // [4, 3]
    // row reduction + select (kept live through the result)
    let rmax = reduce_ax1 ((%math.extrema.fmax 0), 0xFF800000: F32) z;  // [4]
    let fin  = F32_is_finite rmax;                                          // [4]
    let sel  = %tensor.select (fin, rmax, ‹4; 0: F32›);                     // [4]
    // backward: dW = (dᵀ·x)ᵀ, dx = d·wᵀ, db = Σ_n d
    let dW  = %tensor.transpose_2d (%tensor.dot_product R (0₂, 0₂, (), ()) (d, x)); // [8, 3]
    let dx  = %tensor.dot_product R (1₂, 1₂, (), ()) (d, w);       // [4, 8]
    let db  = reduce_ax0 ((%math.arith.add 0), 0: F32) d;               // [3]
    // SGD update
    let w2  = F32_sub (w, F32_mul (‹8, 3; f32_lr›, dW));
    let b2  = F32_sub (b, F32_mul (‹3; f32_lr›, db));
    // sum one element of each result so no chain is dead-code-eliminated
    let s0 = %tensor.get ((0₈, 0₃), w2);
    let s1 = %tensor.get   ((0₃, ), b2);
    let s2 = %tensor.get ((0₄, 0₈), dx);
    let s3 = %tensor.get   ((0₄, ), sel);
    return (%math.arith.add 0 (%math.arith.add 0 (s0, s1), %math.arith.add 0 (s2, s3)));
