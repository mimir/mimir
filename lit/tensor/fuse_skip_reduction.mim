// RUN: %mim -p opt %s -o - | %FileCheck %s

// The inner map_reduce performs a reduction (sums along an axis), so its value at any
// position requires a loop. The fuse phase must NOT fuse it into the outer pure map.
plugin tensor;
plugin core;
plugin opt;

lam add1 (x: Nat): Nat = %core.nat.add (x, 1);

fun sum_reduce (acc x: Nat)@tt: Nat = return (%core.nat.add (acc, x));

con extern f (v: «2; «3; Nat»», return: Cn «2; Nat») =
    // inner[i] = Σ_j v[i, j]: one output loop (bound 2), one reduction loop (bound 3)
    let inner = %tensor.map_reduce (2, (2, 3)) (sum_reduce, 0)
        (%tensor.proj_map 0)
        (%tensor.proj_map (0, 1), )
        v;
    // outer[i] = inner[i] + 1    (pure map)
    let outer = %tensor.unary add1 inner;
    return outer;

lam extern _compile (): %compile.Phase =
    %compile.phases ff (
        %compile.internal_cleanup,
        %tensor.lower_tensor,
        %tensor.fuse_tensor,
        %compile.internal_cleanup,
    );

// Two %tensor.map_reduce operations must remain, since the inner has a reduction.
// CHECK: %tensor.map_reduce
// CHECK: %tensor.map_reduce
