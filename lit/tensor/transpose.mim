// RUN: %mim -p opt %s
plugin tensor;
plugin refly;
plugin core;
plugin cps;
plugin affine;

let m0 = ((1, 2), (3, 4));

let m1 = %tensor.transpose (tt, ff) m0;
let m2 = %tensor.transpose (2₄, 1₄, 0₄, 3₄) m0;
let m21 = %tensor.transpose (0₄, 3₄, 1₄, 2₄) m0;
let m4 = %tensor.broadcast_in_dim ((2, 1, 2), (2, 50, 2), m0, (2₃, 1₃, 0₃));

fun extern main() = return (m1, m2, m21, m4);
