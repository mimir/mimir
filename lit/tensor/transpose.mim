// RUN: %mim -p opt %s
plugin tensor;

use tensor;

let m0 = ((1, 2), (3, 4));

let m1 = transpose (tt, ff) m0;
let m2 = transpose (2₄, 1₄, 0₄, 3₄) m0;
let m21 = transpose (0₄, 3₄, 1₄, 2₄) m0;
let m4 = broadcast_in_dim ((2, 1, 2), (2, 50, 2), m0, (2₃, 1₃, 0₃));

extern fun main () = return (m1, m2, m21, m4);
