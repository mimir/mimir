// RUN: %mim %s -p opt -o %t
// RUN: cat %t | %FileCheck %s
// RUN: cat %t | %FileCheck %s --check-prefix=GONE

// tensor.concat: joins `nis` inputs along axis `ax`. The per-output-range source selection needs a core.select
// chain (not an affine function), so it is lowered directly in C++ (LowerMapReduce::lower_concat). Checked on the
// lowered Mim IR (no codegen), as for slice / flip.
// GONE-NOT: tensor.concat
// GONE-NOT: map_reduce
// GONE-NOT: affine\.

plugin tensor;

use tensor;

// Concat two 2x3 matrices along axis 0 -> 4x3: rows 0..1 from a, rows 2..3 from b (b read at row i−2).
// The `i ≥ 2` range test lowers to an unsigned core.icmp; the shifted read index is clamped via core.extrema.
// CHECK-DAG: extern con cat0
// CHECK-DAG: core.icmp
// CHECK-DAG: core.extrema.Sm
extern fun cat0 (a b: tensor.Tensor 2 (2, 3) I32): tensor.Tensor 2 (4, 3) I32 =
    return (concat 0₂ (a, b));

// Concat two 2x3 matrices along axis 1 -> 2x6: cols 0..2 from a, cols 3..5 from b.
// CHECK-DAG: extern con cat1
extern fun cat1 (a b: tensor.Tensor 2 (2, 3) I32): tensor.Tensor 2 (2, 6) I32 =
    return (concat 1₂ (a, b));

// Three-input concat along axis 0 with differing extents: 1 + 2 + 1 = 4 rows.
// The explicit per-input shapes exercise singleton axes in the logical indices.
// CHECK-DAG: extern con cat3
extern fun cat3 (a: tensor.Tensor 2 (1, 3) I32, b: tensor.Tensor 2 (2, 3) I32, c: tensor.Tensor 2 (1, 3) I32): tensor.Tensor 2 (4, 3) I32 =
    return (concat 0₂ @((1, 3), (2, 3), (1, 3)) (a, b, c));
