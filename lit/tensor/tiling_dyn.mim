// RUN: %mim -p opt --dump-recursive %s -o - > %t.out
// RUN: %FileCheck %s < %t.out
// RUN: %FileCheck %s --check-prefix=GONE < %t.out

// Tiling with *runtime-only* extents via the frontend Tileable interface - the full
// feature set of tensor_tile.mim, over shapes that are never literals: the row count n
// is a runtime function parameter.
//
// Divisibility side-conditions discharge symbolically because the extents are
// constructed in *provable form*: ⌈n/4⌉·4 is divisible by 4, (n/3)·3 and ⌈n/3⌉·3 are
// divisible by 3, all by construction (the nat normalizer cancels `(x·c)/c` to `x` for
// a literal `c ≠ 0`), so `%refly.check` folds away despite the extents being
// runtime-only. All remainder logic becomes runtime %core.nat arithmetic.
//
// The whole default `-p opt` pipeline runs: the dynamic-extent tensors bufferize to
// `%mem` loops over dynamically-sized buffers (n reaches the buffer allocations and
// `%mem.lea` index arithmetic as a runtime value), so nothing tensor-, matrix-, buffer-
// or affine-level survives, and tiling_dyn_run.mim executes the whole thing for several
// runtime sizes. Each rt_* routine is SELF-CHECKING (returns 0 iff its tiled result
// agrees with an untiled reference) and takes its size as a plain runtime Nat, building
// the dynamic tensors internally; comparisons of two distinct dynamic tensors use
// order-sensitive rolling hashes over var extents (two clos-conversion frontiers found
// on the way: Testing/bug_two_dyn_operands_clos.mim - two distinct compound-extent
// buffers feeding one comparison - and Testing/bug_two_dyn_params_boundary.mim - two
// dynamic tensor params in one extern signature).
//
// The demos, executed for n = 5, 7, 11 by tiling_dyn_run.mim:
// (1) rt_blocked:    the FULL blocked-matmul schedule on runtime rows - rows padded to
//                    ⌈n/4⌉·4 (fold-neutral), tiled i by 4, j and k by 2, parallel group
//                    interchanged to (io, jo, ii, ji), unpacked, sliced back to n rows;
// (2) rt_partial:    partial reduction - k split into (ko, ki) with the reduction-tile
//                    loop OUTERMOST, «n, 4, 2» partials merged over the trailing axis;
// (3) rt_transposed: TRANSPOSED write map under a runtime batch (oax = (0, 2, 1)) with
//                    input scaling fused into the fold: out[b,j,i] = Σ_k a[b,i,k]·2·b[k,j],
//                    checked against an independent %tensor.dot_product + transpose;
// (4) rt_peel_main/rt_peel_epi: non-dividing tile size 3 on arbitrary runtime n,
//                    strategy "peel" - main [0,nm) in 3-tiles + epilogue [nm,n), each
//                    spot-checked against the constant-folded 4x4 product (rows of the
//                    input repeat mod 4); the runtime concat glue is still blocked in
//                    the bufferizer;
// (5) rt_pad:        strategy "pad + slice" - rows padded to ⌈n/3⌉·3, tiled evenly,
//                    the n valid rows sliced back and compared elementwise;
// (6) pure loops:    a 2-D accumulator nest over the runtime domain (n, 4), j tiled by 2;
// (7) tile4_for:     the shape-polymorphic tiled routine instantiated with a RUNTIME
//                    k = n (extent n·4, tiled by 4), against a native %affine.For.
// (unrolled_for is inherently static - PE-known bounds - and stays in tensor_tile.mim.)
//
// CHECK-DAG: fun extern main
// CHECK-DAG: fun extern rt_blocked
// CHECK-DAG: fun extern rt_partial
// CHECK-DAG: fun extern rt_transposed
// CHECK-DAG: fun extern rt_peel_main
// CHECK-DAG: fun extern rt_peel_epi
// CHECK-DAG: fun extern rt_pad
// The remainder arithmetic stays as runtime Nat computation:
// CHECK-DAG: %core.nat.div
// The tiled loop nests are materialized (lower_for turns them into recursive `head`s):
// CHECK-DAG: con head
// Bufferization reached real memory over the runtime-sized buffers:
// CHECK-DAG: %mem.lea
// Everything interface-level and every tensor/matrix/buffer/affine op must be lowered
// away, and the divisibility side-conditions must have discharged:
// GONE-NOT: %tensor.
// GONE-NOT: %matrix.
// GONE-NOT: %buffer.
// GONE-NOT: %affine.
// GONE-NOT: %refly.
// GONE-NOT: Tileable
// GONE-NOT: tileable
// GONE-NOT: strip_mine
// GONE-NOT: partial_reduce
// GONE-NOT: restrict_par
// GONE-NOT: retile
// GONE-NOT: ForT
// No `⊥ : %mem.M` placeholder may survive `%mem.add_mem`: it would leave a load unordered w.r.t. the
// stores that fill its buffer, i.e. a read of uninitialised memory (zero-filled, so invisible, on Linux).
// GONE-NOT: :(%mem.M 0)

plugin core;
plugin tensor;
plugin cps;
plugin affine;
plugin mem;
plugin refly;
plugin vec;

// ---- The tiling interface ---------------------------------------------------
// A `Tileable` existentially packages a computation over an affinely-indexed
// iteration domain (cf. MLIR's TilingInterface):
// * `Out`: the result *type constructor* - what materializing over a domain with
//   `ro` parallel dims of extents `so` yields (a tensor «so; T», an accumulator
//   continuation, ...). Existential like everything op-specific.
// * the iteration domain `Sr` (leading `Ro` parallel dims, trailing `Rr` reduction dims)
//   and the result shape `So` - MLIR's getIterationDomain + getLoopIteratorTypes,
// * `oax`: which result axis each parallel domain dim writes (a permutation; identity
//   for plain writes, e.g. (1, 0) for a transposed output) - MLIR's
//   getResultTilePosition, for permutation write maps.
// * `retile`: rebuild the computation over a *reindexed* domain, given
//   - the new domain (Ro_n, Rr_n, So_n, Sr_n),
//   - `iota`: maps new loop vectors to old loop vectors,
//   - `omega`: maps (old output coordinates, new loop vector) to new output
//     coordinates - it sees the loop vector so that strategies like partial
//     reduction can route a loop dim into the output.
// The op's internals (combiner, init, inputs, access maps) stay hidden in the closure.
let Tileable = [
    Out: [ro: Nat, so: «ro; Nat»] → *,
    Ro: Nat, Rr: Nat,
    So: «Ro; Nat»,
    oax: «Ro; Nat»,
    Sr: «%core.nat.add (Ro, Rr); Nat»,
    retile: [Ro_n Rr_n: Nat]
          → [So_n: «Ro_n; Nat», Sr_n: «%core.nat.add (Ro_n, Rr_n); Nat»]
          → [iota:  «%core.nat.add (Ro_n, Rr_n); %affine.index» → «%core.nat.add (Ro, Rr); %affine.index»,
             omega: [«Ro; %affine.index», «%core.nat.add (Ro_n, Rr_n); %affine.index»] → «Ro_n; %affine.index»]
          → Out (Ro_n, So_n),
];

// Composition helper for access maps: (m ∘ g).
lam comp_map {A B C: *} (m: B → C, g: A → B) (o: A): C = m (g o);

// ---- Instance 1: %tensor.map_reduce ------------------------------------------
// `retile` rebuilds the same map_reduce over the new domain by composing the access
// maps with `iota` and the write map with `omega` - the SSA analog of
// getTiledImplementation. No extract/insert_slice machinery: the tiled reads hit the
// original inputs through reindexed access maps.
lam mr_tileable {nis: Nat}
                {To: *, Ro Rr: Nat}
                (So: «Ro; Nat», oax: «Ro; Nat», Sr: «%core.nat.add (Ro, Rr); Nat»)
                {Tis: «nis; *», Ris: «i: nis; Nat», Sis: «i: nis; «Ris#i; Nat»»}
                (f: Fn [To, «i: nis; Tis#i»] → To, init: To)
                (map_out: [«%core.nat.add (Ro, Rr); %affine.index»] → «Ro; %affine.index»)
                (maps: «i: nis; ([«%core.nat.add (Ro, Rr); %affine.index»] → «Ris#i; %affine.index»)»)
                (is: «i: nis; «Sis#i; Tis#i»»)
              : Tileable =
    lam out_t (ro: Nat, so: «ro; Nat»): * = «so; To»;
    lam retile (Ro_n Rr_n: Nat)
               (So_n: «Ro_n; Nat», Sr_n: «%core.nat.add (Ro_n, Rr_n); Nat»)
               (iota:  «%core.nat.add (Ro_n, Rr_n); %affine.index» → «%core.nat.add (Ro, Rr); %affine.index»,
                omega: [«Ro; %affine.index», «%core.nat.add (Ro_n, Rr_n); %affine.index»] → «Ro_n; %affine.index»)
             : «So_n; To» =
        lam map_out_n (o: «%core.nat.add (Ro_n, Rr_n); %affine.index»): «Ro_n; %affine.index» =
            omega (map_out (iota o), o);
        %tensor.map_reduce @nis @(To, Ro_n, Rr_n) (So_n, Sr_n)
            @(Tis, Ris, Sis) (f, init)
            map_out_n
            ‹i: nis; comp_map (maps#i, iota)›
            is;
    (out_t, Ro, Rr, So, oax, Sr, retile);

// Materialize a Tileable over its current domain (identity reindexing).
lam materialize (t: Tileable): t#Out (t#Ro, t#So) =
    lam id_i (o: «%core.nat.add (t#Ro, t#Rr); %affine.index»): «%core.nat.add (t#Ro, t#Rr); %affine.index» = o;
    lam id_o (oo: «t#Ro; %affine.index», o: «%core.nat.add (t#Ro, t#Rr); %affine.index»): «t#Ro; %affine.index» = oo;
    t#retile (t#Ro, t#Rr) (t#So, t#Sr) (id_i, id_o);

// ---- Domain transforms --------------------------------------------------------
lam nat_lt (a b: Nat): Bool = %core.ncmp.l (a, b);
lam nat_eq (a b: Nat): Bool = %core.ncmp.e (a, b);
// Axis renumbering after inserting a new axis at position `a`.
lam shift_ax (a x: Nat): Nat = %core.select (nat_lt (x, a), x, %core.nat.add (x, 1));

// Split bounds vector `v` (length n) at dim `d` into (nt, ts); the result arity `m`
// (= n+1) is passed explicitly, in the syntactic form the call site's types require
// (the checker does not re-associate %core.nat.add symbolically).
lam split_bounds (m n: Nat, v: «n; Nat», d ts nt: Nat): «m; Nat» =
    ‹i: m; let ii = %core.bitcast Nat i;
           %core.select (nat_lt (ii, d), v#(%core.idx n 0 ii),
           %core.select (nat_eq (ii, d), nt,
           %core.select (nat_eq (ii, %core.nat.add (d, 1)), ts,
           v#(%core.idx n 0 (%core.nat.sub (ii, 1))))))›;

// Recombine a split loop vector (m = n+1): old#d = new#d · ts + new#(d+1).
lam split_iota (m n d ts: Nat) (o: «m; %affine.index»): «n; %affine.index» =
    ‹j: n; let jj = %core.bitcast Nat j;
           %core.select (nat_lt (jj, d), o#(%core.idx m 0 jj),
           %core.select (nat_eq (jj, d),
                         %affine.op.add (%affine.semiop.mul (o#(%core.idx m 0 d), ts),
                                         o#(%core.idx m 0 (%core.nat.add (d, 1)))),
           o#(%core.idx m 0 (%core.nat.add (jj, 1)))))›;

// Split an output coordinate vector (m = n+1): new#a = old#a ⌊/⌋ ts, new#(a+1) = old#a mod ts.
lam split_omega (m n a ts: Nat) (oc: «n; %affine.index»): «m; %affine.index» =
    ‹j: m; let jj = %core.bitcast Nat j;
           %core.select (nat_lt (jj, a), oc#(%core.idx n 0 jj),
           %core.select (nat_eq (jj, a), %affine.semiop.floordiv (oc#(%core.idx n 0 a), ts),
           %core.select (nat_eq (jj, %core.nat.add (a, 1)), %affine.semiop.mod (oc#(%core.idx n 0 a), ts),
           oc#(%core.idx n 0 (%core.nat.sub (jj, 1))))))›;

// Checks that `ts` is a compile-time constant that exactly divides the extent `sd`.
// The proof also discharges *symbolically* for factored extents (e.g. sd = k·ts).
lam check_div (sd ts: Nat): Nat =
    %refly.check (%core.ncmp.e (%core.nat.mul (%core.nat.div (sd, ts), ts), sd),
                  sd, "strip_mine: tile size must divide the extent");

// strip_mine_red: split reduction dim `d` (Ro ≤ d < Ro+Rr) of extent N into two adjacent
// reduction dims (N/ts, ts) - cf. TilingInterface.h: "op[original] → op[original/x, x]".
// The tile size must be a compile-time constant that divides the extent; both are enforced
// during PE via the filter and %refly.check.
lam strip_mine_red (t: Tileable, d ts: Nat)@%core.pe.is_closed ts: Tileable =
    let r   = %core.nat.add (t#Ro, t#Rr);
    let r_n = %core.nat.add (t#Ro, %core.nat.add (t#Rr, 1));
    let nt  = %core.nat.div (check_div (t#Sr#(%core.idx r 0 d), ts), ts);
    lam retile_n (ro_m rr_m: Nat)
                 (so_m: «ro_m; Nat», sr_m: «%core.nat.add (ro_m, rr_m); Nat»)
                 (iota:  «%core.nat.add (ro_m, rr_m); %affine.index» → «r_n; %affine.index»,
                  omega: [«t#Ro; %affine.index», «%core.nat.add (ro_m, rr_m); %affine.index»] → «ro_m; %affine.index»)
               : t#Out (ro_m, so_m) =
        t#retile (ro_m, rr_m) (so_m, sr_m) (comp_map (split_iota (r_n, r, d, ts), iota), omega);
    (t#Out, t#Ro, %core.nat.add (t#Rr, 1), t#So, t#oax,
     split_bounds (r_n, r, t#Sr, d, ts, nt), retile_n);

// strip_mine_par: split parallel dim `d` (d < Ro) into two adjacent parallel dims.
// The result shape splits along with the domain at the axis `d` writes (oax#d), so the
// materialized tensor is *packed* («…, N/ts, ts, …» along that axis); a row-major reshape
// restores the original shape (adjacent in-place splits always collapse row-major).
lam strip_mine_par (t: Tileable, d ts: Nat)@%core.pe.is_closed ts: Tileable =
    let r    = %core.nat.add (t#Ro, t#Rr);
    let ro_n = %core.nat.add (t#Ro, 1);
    let r_n  = %core.nat.add (%core.nat.add (t#Ro, 1), t#Rr);
    let a    = t#oax#(%core.idx (t#Ro) 0 d);
    let sd   = %refly.check (%core.ncmp.e (t#So#(%core.idx (t#Ro) 0 a), t#Sr#(%core.idx r 0 d)),
                             t#Sr#(%core.idx r 0 d),
                             "strip_mine_par: output extent (at oax#d) must match domain extent");
    let nt   = %core.nat.div (check_div (sd, ts), ts);
    // The split dim writes the split axis; all other dims write their old axis,
    // renumbered around the insertion at `a`.
    let oax_n = ‹j: ro_n; let jj = %core.bitcast Nat j;
                          %core.select (nat_lt (jj, d), shift_ax (a, t#oax#(%core.idx (t#Ro) 0 jj)),
                          %core.select (nat_eq (jj, d), a,
                          %core.select (nat_eq (jj, %core.nat.add (d, 1)), %core.nat.add (a, 1),
                          shift_ax (a, t#oax#(%core.idx (t#Ro) 0 (%core.nat.sub (jj, 1)))))))›;
    lam retile_n (ro_m rr_m: Nat)
                 (so_m: «ro_m; Nat», sr_m: «%core.nat.add (ro_m, rr_m); Nat»)
                 (iota:  «%core.nat.add (ro_m, rr_m); %affine.index» → «r_n; %affine.index»,
                  omega: [«ro_n; %affine.index», «%core.nat.add (ro_m, rr_m); %affine.index»] → «ro_m; %affine.index»)
               : t#Out (ro_m, so_m) =
        lam iota_c  (o:  «%core.nat.add (ro_m, rr_m); %affine.index»): «r; %affine.index» =
            split_iota (r_n, r, d, ts) (iota o);
        lam omega_c (oo: «t#Ro; %affine.index», ov: «%core.nat.add (ro_m, rr_m); %affine.index»): «ro_m; %affine.index» =
            omega (split_omega (ro_n, t#Ro, a, ts) oo, ov);
        t#retile (ro_m, rr_m) (so_m, sr_m) (iota_c, omega_c);
    (t#Out, ro_n, t#Rr,
     split_bounds (ro_n, t#Ro, t#So, a, ts, nt), oax_n,
     split_bounds (r_n, r, t#Sr, d, ts, nt), retile_n);

// interchange: permute the loop dims - new loop j iterates old dim perm#j. Loop order and
// write position are decoupled by the write map, so So is untouched (oax is permuted along).
// The permutation must keep parallel dims parallel (perm#j < Ro iff j < Ro), enforced at
// compile time.
lam interchange (t: Tileable, perm: «%core.nat.add (t#Ro, t#Rr); Nat»): Tileable =
    let r = %core.nat.add (t#Ro, t#Rr);
    let perm_ok = ‹j: r; let jj = %core.bitcast Nat j;
                         %refly.check (%core.icmp.e @2 (nat_lt (jj, t#Ro), nat_lt (perm#j, t#Ro)),
                                       perm#j,
                                       "interchange: permutation must not mix parallel and reduction dims")›;
    let sr_n  = ‹i: r; t#Sr#(%core.idx r 0 (perm_ok#i))›;
    let oax_n = ‹j: t#Ro; t#oax#(%core.idx (t#Ro) 0 (perm_ok#(%core.idx r 0 (%core.bitcast Nat j))))›;
    // iota: old dim i is found at the new position j with perm#j = i.
    lam iota_p (o: «r; %affine.index»): «r; %affine.index» =
        ‹i: r; o#((%vec.first %core.ncmp.e (perm_ok, %core.bitcast Nat i))#1_2)›;
    lam retile_n (ro_m rr_m: Nat)
                 (so_m: «ro_m; Nat», sr_m: «%core.nat.add (ro_m, rr_m); Nat»)
                 (iota:  «%core.nat.add (ro_m, rr_m); %affine.index» → «r; %affine.index»,
                  omega: [«t#Ro; %affine.index», «%core.nat.add (ro_m, rr_m); %affine.index»] → «ro_m; %affine.index»)
               : t#Out (ro_m, so_m) =
        t#retile (ro_m, rr_m) (so_m, sr_m) (comp_map (iota_p, iota), omega);
    (t#Out, t#Ro, t#Rr, t#So, oax_n, sr_n, retile_n);

// partial_reduce: split reduction dim `d` into (N/ts, ts) and make the *outer* half a
// NEW LEADING PARALLEL LOOP - the reduction-tile loop runs OUTSIDE the parallel loops,
// which strip_mine_red cannot express. The result gains a TRAILING axis of N/ts partial
// results (trailing, so that a leading runtime extent stays outermost, which the LLVM
// backend requires of dynamically-sized buffers), to be combined afterwards by a merge
// the caller supplies (the combine is not derivable from the op; cf. MLIR's
// ReductionTilingStrategy::PartialReductionOuterReduction, whose tileToPartialReduction/
// mergeReductions live in the separate PartialReductionOpInterface).
lam partial_reduce (t: Tileable, d ts: Nat)@%core.pe.is_closed ts: Tileable =
    let r    = %core.nat.add (t#Ro, t#Rr);
    let ro_n = %core.nat.add (t#Ro, 1);
    let r_n  = %core.nat.add (%core.nat.add (t#Ro, 1), t#Rr);
    let nt   = %core.nat.div (check_div (t#Sr#(%core.idx r 0 d), ts), ts);
    // New domain: ko (extent N/ts) leads, everything shifts right; dim d keeps extent ts.
    let sr_n = ‹i: r_n; let ii = %core.bitcast Nat i;
                        %core.select (nat_eq (ii, 0), nt,
                        %core.select (nat_eq (%core.nat.sub (ii, 1), d), ts,
                        t#Sr#(%core.idx r 0 (%core.nat.sub (ii, 1)))))›;
    let so_n = ‹i: ro_n; let ii = %core.bitcast Nat i;
                         %core.select (nat_eq (ii, t#Ro), nt,
                         t#So#(%core.idx (t#Ro) 0 ii))›;
    // ko (loop dim 0) writes the new trailing axis; all old axes keep their positions.
    let oax_n = ‹j: ro_n; let jj = %core.bitcast Nat j;
                          %core.select (nat_eq (jj, 0), t#Ro,
                          t#oax#(%core.idx (t#Ro) 0 (%core.nat.sub (jj, 1))))›;
    lam iota_d (o: «r_n; %affine.index»): «r; %affine.index» =
        ‹j: r; let jj = %core.bitcast Nat j;
               %core.select (nat_eq (jj, d),
                             %affine.op.add (%affine.semiop.mul (o#(%core.idx r_n 0 0), ts),
                                             o#(%core.idx r_n 0 (%core.nat.add (jj, 1)))),
                             o#(%core.idx r_n 0 (%core.nat.add (jj, 1))))›;
    // The new trailing output coordinate is the reduction-tile loop variable itself.
    lam omega_d (oo: «t#Ro; %affine.index», ov: «r_n; %affine.index»): «ro_n; %affine.index» =
        ‹j: ro_n; let jj = %core.bitcast Nat j;
                  %core.select (nat_eq (jj, t#Ro), ov#(%core.idx r_n 0 0),
                  oo#(%core.idx (t#Ro) 0 jj))›;
    lam retile_n (ro_m rr_m: Nat)
                 (so_m: «ro_m; Nat», sr_m: «%core.nat.add (ro_m, rr_m); Nat»)
                 (iota:  «%core.nat.add (ro_m, rr_m); %affine.index» → «r_n; %affine.index»,
                  omega: [«ro_n; %affine.index», «%core.nat.add (ro_m, rr_m); %affine.index»] → «ro_m; %affine.index»)
               : t#Out (ro_m, so_m) =
        lam iota_c  (o:  «%core.nat.add (ro_m, rr_m); %affine.index»): «r; %affine.index» =
            iota_d (iota o);
        lam omega_c (oo: «t#Ro; %affine.index», ov: «%core.nat.add (ro_m, rr_m); %affine.index»): «ro_m; %affine.index» =
            omega (omega_d (oo, iota ov), ov);
        t#retile (ro_m, rr_m) (so_m, sr_m) (iota_c, omega_c);
    (t#Out, ro_n, t#Rr, so_n, oax_n, sr_n, retile_n);

// restrict_par: restrict parallel dim `d` to the sub-range [lo, hi) - the building block
// for PEELED tiling of non-dividing sizes (main part + epilogue, concatenated along the
// write axis). Reads shift by +lo (iota); the result narrows along the write axis and its
// coordinates shift by -lo (omega).
lam restrict_par (t: Tileable, d lo hi: Nat): Tileable =
    let r  = %core.nat.add (t#Ro, t#Rr);
    let e  = %core.nat.sub (hi, lo);
    let a  = t#oax#(%core.idx (t#Ro) 0 d);
    let sr_n = ‹i: r; %core.select (nat_eq (%core.bitcast Nat i, d), e, t#Sr#i)›;
    let so_n = ‹i: t#Ro; %core.select (nat_eq (%core.bitcast Nat i, a), e, t#So#i)›;
    lam iota_d (o: «r; %affine.index»): «r; %affine.index» =
        ‹j: r; %core.select (nat_eq (%core.bitcast Nat j, d),
                             %affine.op.add (o#j, %affine.constant lo), o#j)›;
    lam omega_d (oo: «t#Ro; %affine.index»): «t#Ro; %affine.index» =
        ‹j: t#Ro; %core.select (nat_eq (%core.bitcast Nat j, a),
                                %affine.op.sub (oo#j, %affine.constant lo), oo#j)›;
    lam retile_n (ro_m rr_m: Nat)
                 (so_m: «ro_m; Nat», sr_m: «%core.nat.add (ro_m, rr_m); Nat»)
                 (iota:  «%core.nat.add (ro_m, rr_m); %affine.index» → «r; %affine.index»,
                  omega: [«t#Ro; %affine.index», «%core.nat.add (ro_m, rr_m); %affine.index»] → «ro_m; %affine.index»)
               : t#Out (ro_m, so_m) =
        lam iota_c  (o:  «%core.nat.add (ro_m, rr_m); %affine.index»): «r; %affine.index» =
            iota_d (iota o);
        lam omega_c (oo: «t#Ro; %affine.index», ov: «%core.nat.add (ro_m, rr_m); %affine.index»): «ro_m; %affine.index» =
            omega (omega_d oo, ov);
        t#retile (ro_m, rr_m) (so_m, sr_m) (iota_c, omega_c);
    (t#Out, t#Ro, t#Rr, so_n, t#oax, sr_n, retile_n);

// tile_sizes: MLIR-style options-as-data. A per-dim tile-size vector (0 = leave the dim
// untiled, cf. SCFTilingOptions) is interpreted at compile time by recursing over the
// dims from last to first (descending, so earlier splits don't shift the positions of
// dims still to be processed). Parallel/reduction dims dispatch to their respective
// strip-mine automatically. The recursion is unrolled by PE (`d` is compile-time known);
// note %vec.fold.l cannot be used here since Tileable is a large (□-kinded) type.
lam tile_go (r0: Nat, sizes: «r0; Nat», ro0: Nat) (t: Tileable, d: Nat)@%core.pe.is_closed d: Tileable =
    lam th_done (): Tileable = t;
    lam th_step (): Tileable =
        let dm = %core.nat.sub (d, 1);
        let s  = sizes#(%core.idx r0 0 dm);
        lam th_id (): Tileable = t;
        lam th_sp (): Tileable = strip_mine_par (t, dm, s);
        lam th_sr (): Tileable = strip_mine_red (t, dm, s);
        let kind = (th_sr, th_sp)#(%core.ncmp.l (dm, ro0));
        tile_go (r0, sizes, ro0) (((kind, th_id)#(%core.ncmp.e (s, 0))) (), dm);
    ((th_done, th_step)#(%core.ncmp.l (0, d))) ();

lam tile_sizes (t: Tileable, sizes: «%core.nat.add (t#Ro, t#Rr); Nat»): Tileable =
    let r = %core.nat.add (t#Ro, t#Rr);
    tile_go (r, sizes, t#Ro) (t, r);

// ---- Loop types as policies -----------------------------------------------------
// The type of anything with %affine.For's calling convention over (mem, A) accumulators:
// a "loop implementation". The nest instance below is parameterized over one - MLIR's
// LoopType/CustomOp (generateLoopHeaderFn/TerminatorFn) as a typed policy value.
lam ForT (A: *): * =
      [Cn [I32, [%mem.M 0, A], Cn [%mem.M 0, A]]]
    → [Cn [%mem.M 0, A]]
    → Cn [I32, I32, I32, [%mem.M 0, A]];

// The default loop implementation: %affine.For itself, eta-wrapped.
con affine_for {A: *} (body: Cn [I32, [%mem.M 0, A], Cn [%mem.M 0, A]])
               (exit: Cn [%mem.M 0, A])
               (begin stop step: I32, init: [%mem.M 0, A])@tt =
    %affine.For body exit (begin, stop, step, init);

// A drop-in loop implementation that fully UNROLLS at compile time (the bounds must be
// PE-known) - e.g. for unrolling innermost tile loops.
con unrolled_for {A: *} (body: Cn [I32, [%mem.M 0, A], Cn [%mem.M 0, A]])
                 (exit: Cn [%mem.M 0, A])
                 (begin stop step: I32, init: [%mem.M 0, A])@%core.pe.is_closed (begin, stop, step) =
    head (begin, init)
    where
        con head (i: I32, acc: [%mem.M 0, A])@%core.pe.is_closed i =
            con th_exit [] = exit acc;
            con cont (acc2: [%mem.M 0, A]) = head (%core.wrap.add 0 (i, step), acc2);
            con th_body [] = body (i, acc, cont);
            ((th_exit, th_body)#(%core.icmp.ul (i, stop))) ();
    end;

// ---- Instance 2: pure loops ---------------------------------------------------
// A CPS accumulator fold over an R-dim iteration domain - the "op" is nothing but a nest
// of For loops (of whatever ForT implementation the policy picks). A fold has no parallel
// dims (Ro = 0, all dims reduction), and materializing yields a continuation
// `Cn [mem, acc, Cn [mem, acc]]` that runs the nest. `retile` rebuilds the nest over the
// new bounds by FOLDING one loop-wrapper per dim over an innermost continuation
// (%vec.fold.r over continuations - no recursion needed); the innermost body recovers the
// ORIGINAL iteration coordinates by evaluating `iota` on the new loop variables via
// %affine.map, so the user body always sees original coordinates, no matter how the
// schedule reshaped the nest.
lam nest_tileable {A: *} (loop: ForT A, r0: Nat, bounds: «r0; Nat»)
                  (body: Cn [%mem.M 0, A, «r0; I32», Cn [%mem.M 0, A]])
                : Tileable =
    lam out_t (ro: Nat, so: «ro; Nat»): * = Cn [%mem.M 0, A, Cn [%mem.M 0, A]];
    lam retile (ro_n rr_n: Nat)
               (so_n: «ro_n; Nat», sr_n: «%core.nat.add (ro_n, rr_n); Nat»)
               (iota:  «%core.nat.add (ro_n, rr_n); %affine.index» → «%core.nat.add (0, r0); %affine.index»,
                omega: [«0; %affine.index», «%core.nat.add (ro_n, rr_n); %affine.index»] → «ro_n; %affine.index»)
             : Cn [%mem.M 0, A, Cn [%mem.M 0, A]] =
        let r_n = %core.nat.add (ro_n, rr_n);
        // Innermost body: translate the new loop vector back to original coordinates.
        con inner0 (pref: «r_n; I32», mem: %mem.M 0, acc: A, k: Cn [%mem.M 0, A]) =
            let ivs = ‹i: r_n; %core.conv.u (sr_n#i) (pref#i)›;
            let (mem2, orig) = %affine.map @(r0, r_n) @(sr_n, bounds) iota ivs mem;
            // Hand the body plain I32 coordinates: a dependently-typed «i; Idx (bounds#i)»
            // in the body's signature would put a dependent pack into closure envs.
            let orig32 = ‹i: r0; %core.conv.u 4294967296 (orig#i)›;
            body (mem2, acc, orig32, k);
        // One loop wrapper per dim (ds = (dim position, extent)).
        lam wrap (ds: «2; Nat», inner: Cn [«r_n; I32», %mem.M 0, A, Cn [%mem.M 0, A]])
               : Cn [«r_n; I32», %mem.M 0, A, Cn [%mem.M 0, A]] =
            con level (pref: «r_n; I32», mem: %mem.M 0, acc: A, k: Cn [%mem.M 0, A]) =
                loop lbody lexit (0I32, %core.bitcast I32 (ds#1_2), 1I32, (mem, acc))
                where
                    con lbody (iv: I32, macc: [%mem.M 0, A], yield: Cn [%mem.M 0, A]) =
                        let pref2 = ‹j: r_n; %core.select (nat_eq (%core.bitcast Nat j, ds#0_2), iv, pref#j)›;
                        inner (pref2, macc#0_2, macc#1_2, yield);
                    con lexit (macc: [%mem.M 0, A]) = k macc;
                end;
            level;
        let steps = ‹d: r_n; (%core.bitcast Nat d, sr_n#d)›;
        let nestc = %vec.fold.r @(Cn [«r_n; I32», %mem.M 0, A, Cn [%mem.M 0, A]], «2; Nat») @r_n wrap (steps, inner0);
        con run (mem: %mem.M 0, acc: A, k: Cn [%mem.M 0, A]) =
            nestc (‹r_n; 0I32›, mem, acc, k);
        run;
    (out_t, 0, r0, (), (), bounds, retile);

// ---- Instance 3: a single %affine.For ------------------------------------------
// Adapts %affine.For's native calling convention (body: Cn [iter, acc, yield]) to the
// interface, via Instance 2. An existing call site
//     %affine.For body exit (0, n, 1, init)
// becomes
//     (materialize (for_tileable (loop, n, body))) (mem, init, exit)
// and the loop thereby joins the schedule library - same body, unchanged.
lam for_tileable {m: Nat} {A: *} (loop: ForT A, n: Nat, body: Cn [Idx m, A, Cn A]): Tileable =
    con nest_body [mem: %mem.M 0, acc: A, iv: I32, k: Cn [%mem.M 0, A]] =
        con yld (acc2: A) = k (mem, acc2);
        body (%core.conv.u m iv, acc, yld);
    nest_tileable @A (loop, 1, n) nest_body;

// Shape-polymorphic tiled routine: the extent k·4 is SYMBOLIC (k is a parameter), yet
// strip-mining by 4 type-checks once and for all - the divisibility side-condition of
// check_div discharges symbolically by Nat normalization ((k·4/4)·4 = k·4), i.e. it is
// carried by the term structure of the shape. Every instantiation is correct by
// construction; MLIR must re-verify per instance (or emit affine.min guards).
lam tile4_for {m: Nat} {A: *} (k: Nat, body: Cn [Idx m, A, Cn A]): Cn [%mem.M 0, A, Cn [%mem.M 0, A]] =
    materialize (tile_sizes (for_tileable (affine_for @A, %core.nat.mul (k, 4), body), 4));

// ---- Harness -----------------------------------------------------------------
let I32Ring: %tensor.Ring = (I32, 0I32, %core.wrap.add @4294967296 0, %core.wrap.mul @4294967296 0);

fun sum_f (x: I32, y: «1; I32»)@tt = return (%core.wrap.add 0 (x, y#0_1));
// Fused fold for the transposed matmul: acc += a-elem · (2 · b-elem).
fun dot2 (acc: I32, xy: «2; I32»)@tt =
    return (%core.wrap.add 0 (acc, %core.wrap.mul 0 (xy#0_2, %core.wrap.mul 0 (2I32, xy#1_2))));
lam dbl (x: I32): I32 = %core.wrap.mul 0 (2I32, x);

// Order-sensitive rolling hash (acc·31 + x) of a whole tensor, broadcast into a
// «2; I32» tensor. The reduction traversal is deterministic, so equal hashes of two
// same-shaped tensors imply equal contents up to hash collisions - and each hash
// consumes only ONE dynamically-shaped tensor (see the bug notes in the header).
fun hash_f (acc: I32, y: «1; I32»)@tt =
    return (%core.wrap.add 0 (%core.wrap.mul 0 (31I32, acc), y#0_1));

lam hash2d (p q: Nat) (x: «p, q; I32»): «2; I32» =
    %tensor.map_reduce @1 @(I32, 1, 2) (2, (2, p, q))
        @(I32, 2, (p, q)) (hash_f, 0I32)
        (%tensor.proj_map @(3, 1) 0) (%tensor.proj_map @(3, 2) (1, 2),) x;

lam hash3d (p q s: Nat) (x: «p, q, s; I32»): «2; I32» =
    %tensor.map_reduce @1 @(I32, 1, 3) (2, (2, p, q, s))
        @(I32, 3, (p, q, s)) (hash_f, 0I32)
        (%tensor.proj_map @(4, 1) 0) (%tensor.proj_map @(4, 3) (1, 2, 3),) x;

// 0 iff the hashes of x and y agree.
lam hash_ne (hx hy: «2; I32»): I32 =
    (0I32, 1I32)#(%core.icmp.ne (%tensor.get @(I32, 1, 2) (hx, 0_2), %tensor.get @(I32, 1, 2) (hy, 0_2)));

// 0 iff x = y.
lam ne01 (x y: I32): I32 = (0I32, 1I32)#(%core.icmp.ne (x, y));

// A p·4 · 4·4 matmul as a Tileable (identity write map).
lam mk_mm {p: Nat} (a: «p, 4; I32», b: «4, 4; I32»): Tileable =
    mr_tileable @2 @(I32, 2, 1) ((p, 4), (0, 1), (p, 4, 4))
        @((I32, I32), (2, 2), ((p, 4), (4, 4)))
        (dot_general_fun I32Ring, 0I32)
        (%tensor.proj_map @(3, 2) (0, 1))
        (%tensor.proj_map @(3, 2) (0, 2), %tensor.proj_map @(3, 2) (2, 1))
        (a, b);

// ---- Self-checking shape-polymorphic tiled routines ------------------------------
// (1) The FULL blocked-matmul schedule on runtime rows: pad the rows to ⌈n/4⌉·4 with
// the fold-neutral element (⌈n/4⌉·4 is divisible by 4 by construction), tile i by 4 and
// j, k by 2, interchange the parallel group to (io, jo, ii, ji), unpack, slice back.
fun extern rt_blocked (n: Nat, base: «4, 4; I32», b: «4, 4; I32», mem: %mem.M 0): [%mem.M 0, I32] =
    let a   = %tensor.repeat @(I32, 2) (4, 4) (n, 4) base;
    let np  = %core.nat.mul (%core.nat.div (%core.nat.add (n, 3), 4), 4);
    let hi  = %core.nat.sub (np, n);
    let a_p = %tensor.pad (n, 4) (0, (0, 0), (hi, 0)) (a, 0I32);
    let mm_p: Tileable =
        mr_tileable @2 @(I32, 2, 1) ((np, 4), (0, 1), (np, 4, 4))
            @((I32, I32), (2, 2), ((%core.nat.add (n, hi), 4), (4, 4)))
            (dot_general_fun I32Ring, 0I32)
            (%tensor.proj_map @(3, 2) (0, 1))
            (%tensor.proj_map @(3, 2) (0, 2), %tensor.proj_map @(3, 2) (2, 1))
            (a_p, b);
    let pk  = materialize (interchange (tile_sizes (mm_p, (4, 2, 2)), (0, 2, 1, 3, 4, 5)));
    let rp  = %tensor.reshape (%tensor.shape 4 pk) (np, 4) pk;
    let r   = %tensor.slice @(I32, 2) (np, 4) ((0, 0), (1, 1), (n, 4)) rp;
    let ref = %tensor.product_2d I32Ring (a, b);
    return (mem, hash_ne (hash2d (n, 4) ref, hash2d (n, 4) r));

// (2) Partial reduction with runtime rows: the reduction-tile loop ko runs OUTERMOST,
// the «n, 4, 2» partials are merged by a separate sum-reduction over the trailing axis.
fun extern rt_partial (n: Nat, base: «4, 4; I32», b: «4, 4; I32», mem: %mem.M 0): [%mem.M 0, I32] =
    let a     = %tensor.repeat @(I32, 2) (4, 4) (n, 4) base;
    let parts = materialize (partial_reduce (mk_mm (a, b), 2, 2));
    let r     = %tensor.map_reduce @1 @(I32, 2, 1) ((n, 4), (n, 4, 2))
        @(I32, 3, (n, 4, 2)) (sum_f, 0I32)
        (%tensor.proj_map @(3, 2) (0, 1))
        (%tensor.proj_map @(3, 3) (0, 1, 2),)
        parts;
    let ref = %tensor.product_2d I32Ring (a, b);
    return (mem, hash_ne (hash2d (n, 4) ref, hash2d (n, 4) r));

// (3) Transposed write map under a runtime batch: out[b, j, i] = Σ_k a[b,i,k]·2·b[k,j] -
// oax = (0, 2, 1), the input scaling fused into the fold; i, j, k tiled by 2. Checked
// against an independent %tensor.dot_product + %tensor.transpose.
fun extern rt_transposed (n: Nat, base3: «4, 4, 4; I32», b: «4, 4; I32», mem: %mem.M 0): [%mem.M 0, I32] =
    let a3 = %tensor.repeat @(I32, 3) (4, 4, 4) (n, 4, 4) base3;
    let mm_t: Tileable =
        mr_tileable @2 @(I32, 3, 1) ((n, 4, 4), (0, 2, 1), (n, 4, 4, 4))
            @((I32, I32), (3, 2), ((n, 4, 4), (4, 4)))
            (dot2, 0I32)
            (%tensor.proj_map @(4, 3) (0, 2, 1))
            (%tensor.proj_map @(4, 3) (0, 1, 3), %tensor.proj_map @(4, 2) (3, 2))
            (a3, b);
    let pk = materialize (tile_sizes (mm_t, (0, 2, 2, 2)));
    let r  = %tensor.reshape (%tensor.shape 5 pk) (n, 4, 4) pk;
    let b2   = %tensor.unary @(I32, I32) dbl @(2, (4, 4)) b;
    let prod = %tensor.dot_product I32Ring @(3, 2) @(1, 0) (2_3, 0_2, (), ()) @((n, 4, 4), (4, 4)) (a3, b2);
    let ref  = %tensor.transpose @(I32, 3, (n, 4, 4)) (prod, (0_3, 2_3, 1_3));
    return (mem, hash_ne (hash3d (n, 4, 4) ref, hash3d (n, 4, 4) r));

// (4a) Peel, main part: rows [0, (n/3)·3) in tiles of 3 - nm is divisible by 3 by
// construction. Spot-checked against the constant-folded 4x4 product (row i of the
// input is base[i mod 4], so ref[i] = (base·b)[i mod 4]).
fun extern rt_peel_main (n: Nat, base: «4, 4; I32», b: «4, 4; I32», mem: %mem.M 0): [%mem.M 0, I32] =
    let a   = %tensor.repeat @(I32, 2) (4, 4) (n, 4) base;
    let nm  = %core.nat.mul (%core.nat.div (n, 3), 3);
    let pk  = materialize (strip_mine_par (restrict_par (mk_mm (a, b), 0, 0, nm), 0, 3));
    let r   = %tensor.reshape (%tensor.shape 3 pk) (nm, 4) pk;
    let p4  = %tensor.product_2d I32Ring (base, b);
    let d0  = ne01 (%tensor.get @(I32, 2, (nm, 4)) (r, (%core.idx nm 0 0, 0_4)),
                    %tensor.get @(I32, 2, (4, 4))  (p4, (0_4, 0_4)));
    let d1  = ne01 (%tensor.get @(I32, 2, (nm, 4)) (r, (%core.idx nm 0 1, 2_4)),
                    %tensor.get @(I32, 2, (4, 4))  (p4, (1_4, 2_4)));
    let d2  = ne01 (%tensor.get @(I32, 2, (nm, 4)) (r, (%core.idx nm 0 2, 3_4)),
                    %tensor.get @(I32, 2, (4, 4))  (p4, (2_4, 3_4)));
    return (mem, %core.wrap.add 0 (d0, %core.wrap.add 0 (d1, d2)));

// (4b) Peel, epilogue: rows [(n/3)·3, n) - iota shifts the reads by the RUNTIME offset
// nm. Row 0 of the epilogue is global row nm, i.e. (base·b)[nm mod 4]; the test sizes
// guarantee a non-empty epilogue.
fun extern rt_peel_epi (n: Nat, base: «4, 4; I32», b: «4, 4; I32», mem: %mem.M 0): [%mem.M 0, I32] =
    let a   = %tensor.repeat @(I32, 2) (4, 4) (n, 4) base;
    let nm  = %core.nat.mul (%core.nat.div (n, 3), 3);
    let re  = %core.nat.sub (n, nm);
    let r   = materialize (restrict_par (mk_mm (a, b), 0, nm, n));
    let p4  = %tensor.product_2d I32Ring (base, b);
    let rw  = %core.idx 4 0 (%core.nat.sub (nm, %core.nat.mul (%core.nat.div (nm, 4), 4)));
    let d0  = ne01 (%tensor.get @(I32, 2, (re, 4)) (r, (%core.idx re 0 0, 1_4)),
                    %tensor.get @(I32, 2, (4, 4))  (p4, (rw, 1_4)));
    let d1  = ne01 (%tensor.get @(I32, 2, (re, 4)) (r, (%core.idx re 0 0, 3_4)),
                    %tensor.get @(I32, 2, (4, 4))  (p4, (rw, 3_4)));
    return (mem, %core.wrap.add 0 (d0, d1));

// (5) Pad + slice: pad the rows up to np = ⌈n/3⌉·3 with the fold-neutral element, tile
// evenly (np is divisible by 3 by construction), slice the n valid rows back out.
fun extern rt_pad (n: Nat, base: «4, 4; I32», b: «4, 4; I32», mem: %mem.M 0): [%mem.M 0, I32] =
    let a   = %tensor.repeat @(I32, 2) (4, 4) (n, 4) base;
    let np  = %core.nat.mul (%core.nat.div (%core.nat.add (n, 2), 3), 3);
    let hi  = %core.nat.sub (np, n);
    let a_p = %tensor.pad (n, 4) (0, (0, 0), (hi, 0)) (a, 0I32);
    let mm_p: Tileable =
        mr_tileable @2 @(I32, 2, 1) ((np, 4), (0, 1), (np, 4, 4))
            @((I32, I32), (2, 2), ((%core.nat.add (n, hi), 4), (4, 4)))
            (dot_general_fun I32Ring, 0I32)
            (%tensor.proj_map @(3, 2) (0, 1))
            (%tensor.proj_map @(3, 2) (0, 2), %tensor.proj_map @(3, 2) (2, 1))
            (a_p, b);
    let pk  = materialize (strip_mine_par (mm_p, 0, 3));
    let rp  = %tensor.reshape (%tensor.shape 3 pk) (np, 4) pk;
    let r   = %tensor.slice @(I32, 2) (np, 4) ((0, 0), (1, 1), (n, 4)) rp;
    let ref = %tensor.product_2d I32Ring (a, b);
    return (mem, hash_ne (hash2d (n, 4) ref, hash2d (n, 4) r));

con extern main [mem: %mem.M 0, argc: I32, argv: %mem.Ptr (%mem.Ptr (I32, 0), 0), return: Cn [%mem.M 0, I32]] =
    let base: «4, 4; I32» = ((1I32, 2I32, 3I32, 4I32),
                             (5I32, 6I32, 7I32, 8I32),
                             (9I32, 10I32, 11I32, 12I32),
                             (13I32, 14I32, 15I32, 16I32));
    let b:    «4, 4; I32» = ((2I32, 0I32, 1I32, 3I32),
                             (1I32, 1I32, 0I32, 2I32),
                             (0I32, 3I32, 2I32, 1I32),
                             (4I32, 1I32, 1I32, 0I32));
    let base3: «4, 4, 4; I32» = ‹4; base›;
    // Runtime size: n = 2·argc + 3 - odd, ≥ 5, never divisible by 3, so the peel
    // epilogue is always non-empty.
    let n = %core.nat.add (%core.nat.mul (%core.bitcast Nat argc, 2), 3);
    let m = %core.nat.mul (n, 4);

    // (6) Pure loops over the runtime domain (n, 4), j tiled by 2.
    con nest_body [mem: %mem.M 0, acc: I32, iv: «2; I32», k: Cn [%mem.M 0, I32]] =
        k (mem, %core.wrap.add 0 (acc, %core.wrap.add 0 (%core.wrap.mul 0 (iv#0_2, 3I32), iv#1_2)));
    let nest     = nest_tileable @I32 (affine_for @I32, 2, (n, 4)) nest_body;
    let run_nref = materialize nest;
    let run_ntld = materialize (tile_sizes (nest, (0, 2)));

    // (7) The shape-polymorphic tiled routine with a RUNTIME instantiation k = n; the
    // native reference loop threads mem through the accumulator pair (a first-class
    // continuation must not close over a raw %mem.M token).
    con for_body (iv: I32, acc: I32, yield: Cn I32) =
        yield (%core.wrap.add 0 (acc, iv));
    con for_body_m (iv: I32, macc: [%mem.M 0, I32], yield: Cn [%mem.M 0, I32]) =
        yield (macc#0_2, %core.wrap.add 0 (macc#1_2, iv));
    let run_t4 = tile4_for @4294967296 @I32 (n, for_body);

    run_nref (mem, 0I32, k_n1)
    where
        con k_n1 (mem1: %mem.M 0, s_nref: I32) =
            run_ntld (mem1, 0I32, k_n2)
            where
                con k_n2 (mem2: %mem.M 0, s_ntld: I32) =
                    %affine.For for_body_m t4_exit (0I32, %core.bitcast I32 m, 1I32, (mem2, 0I32))
                    where
                        con t4_exit (macc: [%mem.M 0, I32]) =
                            run_t4 (macc#0_2, 0I32, k_t4)
                            where
                                con k_t4 (mem3: %mem.M 0, s_t4: I32) =
                                    rt_blocked ((n, base, b, mem3), k1)
                                    where
                                        con k1 [mem4: %mem.M 0, g_blk: I32] =
                                            rt_partial ((n, base, b, mem4), k2)
                                            where
                                                con k2 [mem5: %mem.M 0, g_par: I32] =
                                                    rt_transposed ((n, base3, b, mem5), k3)
                                                    where
                                                        con k3 [mem6: %mem.M 0, g_tr: I32] =
                                                            rt_peel_main ((n, base, b, mem6), k4)
                                                            where
                                                                con k4 [mem7: %mem.M 0, g_pm: I32] =
                                                                    rt_peel_epi ((n, base, b, mem7), k5)
                                                                    where
                                                                        con k5 [mem8: %mem.M 0, g_pe: I32] =
                                                                            rt_pad ((n, base, b, mem8), k6)
                                                                            where
                                                                                con k6 [mem9: %mem.M 0, g_pd: I32] =
                                                                                    let b_ns = (0I32, 1I32)#(%core.icmp.ne (s_nref, s_ntld));
                                                                                    let b_t4 = (0I32, 1I32)#(%core.icmp.ne (macc#1_2, s_t4));
                                                                                    let t0 = %core.wrap.add 0 (g_blk, g_par);
                                                                                    let t1 = %core.wrap.add 0 (t0, g_tr);
                                                                                    let t2 = %core.wrap.add 0 (t1, g_pm);
                                                                                    let t3 = %core.wrap.add 0 (t2, g_pe);
                                                                                    let t4 = %core.wrap.add 0 (t3, g_pd);
                                                                                    let t5 = %core.wrap.add 0 (t4, b_ns);
                                                                                    return (mem9, %core.wrap.add 0 (t5, b_t4));
                                                                            end;
                                                                    end;
                                                            end;
                                                    end;
                                            end;
                                    end;
                            end;
                    end;
            end;
    end;
