// RUN: %mim %s -p opt -o %t
// RUN: cat %t | %FileCheck %s
// RUN: cat %t | %FileCheck %s --check-prefix=GONE

// %tensor.conv: 2-D convolution (groups 1, no bias). A windowed reduction expressed as a %tensor.map_reduce_aff
// over the kernel, reading the input at stride·o + dilation·k after zero-padding via %tensor.pad. The fused
// multiply-add runs in the ring R. Checked on the lowered Mim IR (no codegen), as for slice / pad.
//
// Inputs use N >= 2 and Cin >= 2 so the NCHW layout does not collapse its leading size-1 dims (which would
// defeat rank inference); for N = 1 / Cin = 1 the importer pins the implicit dims with `@`.
// GONE-NOT: %tensor.conv
// GONE-NOT: %tensor.pad
// GONE-NOT: map_reduce
// GONE-NOT: %affine

plugin core;
plugin tensor;
plugin affine;
plugin mem;

// A ring over Nat so the multiply-accumulate lowers to %core.nat.mul / %core.nat.add.
lam nat_ring (): %tensor.Ring = (Nat, 0, %core.nat.add, %core.nat.mul);

// "same" conv: 3x3 kernel, stride 1, dilation 1, pad 1 -> output keeps the 5x5 spatial size.
// CHECK-DAG: fun extern conv_same
// CHECK-DAG: %core.nat.mul
// CHECK-DAG: %core.nat.add
fun extern conv_same (input: «2, 2, 5, 5; Nat», weight: «3, 2, 3, 3; Nat»): «2, 3, 5, 5; Nat» =
    return (%tensor.conv (nat_ring ()) ((1, 1), (1, 1), (1, 1), (5, 5)) (input, weight));
