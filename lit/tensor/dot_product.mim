// RUN: %mim -p opt %s -o - | %FileCheck %s --implicit-check-not='vec.' --implicit-check-not=if_static --implicit-check-not=tensor.dot_product --implicit-check-not=tensor.product_2d --implicit-check-not=tensor.bmm

// The whole dot family lowers to one and the same operation: a tensor.map_reduce_post carrying the
// SELECTED schedule. For these operands the contraction (extent 2, not divisible by 4) is
// strip-mined by the neutral tile -- loop domain (2, 2, 2, 1) resp. (2, 2, 2, 2, 1), with the split
// contraction recombined in the access maps as k = ko*1 + ki -- and the last output dim runs
// innermost (vdim 1 resp. 2) with the 1-extent tile unrolled.
//
// The subscript rows must come out FOLDED: tensor.dot_product_impl builds them with
// vec.diff/vec.fold.l, whose normalizers decline over a non-literal rank (see
// tensor.product_2d_impl), so none of that machinery may survive into the access maps.

plugin core;
plugin tensor;
plugin affine;
plugin cps;
plugin compile;

let R: tensor.Ring = (Nat, 0, core.nat.add, core.nat.mul);

let m   = ((1, 2), (3, 4));
let m3d = (((1, 2), (3, 4)), ((5, 6), (7, 8)));

extern fun main() = return (
    tensor.dot_product R (1₂, 0₂, (), ()) (m, m),
    tensor.product_2d R (m, m),
    tensor.bmm R (m3d, m3d),
    tensor.dot_product R (2₃, 1₃, 0₃, 0₃) (m3d, m3d));

extern lam _compile (): compile.Phase =
    compile.phases ff (
        compile.cleanup,
        tensor.lower_tensor,
        compile.cleanup,
    );

// The selected schedules: (vdim, unroll) = (1, 1) at rank 2 and (2, 1) at rank 3.
// CHECK-DAG: {{mk[_a-zA-Z0-9]* ‹2; 1›}}
// CHECK-DAG: {{mk[_a-zA-Z0-9]* \(2, 1\)}}

// The recombined contraction subscript `ko * 1 + ki`, folded down to plain affine arithmetic.
// CHECK-DAG: affine.semiop.mul ({{[_a-zA-Z0-9]+}}, 1)

// All four operations lower to the same shape, the rank-2 pair before the rank-3 pair.
// CHECK: return (
// CHECK-SAME: tensor.map_reduce_post @ (2, 0) @ (Nat, Nat, 2, 4, {{[_a-zA-Z0-9]+}}) (‹2; 2›, (2, 2, 2, 1),
// CHECK-SAME: tensor.map_reduce_post @ (2, 0) @ (Nat, Nat, 2, 4, {{[_a-zA-Z0-9]+}}) (‹2; 2›, (2, 2, 2, 1),
// CHECK-SAME: tensor.map_reduce_post @ (2, 0) @ (Nat, Nat, 3, 5, {{[_a-zA-Z0-9]+}}) (‹3; 2›, (2, 2, 2, 2, 1),
// CHECK-SAME: tensor.map_reduce_post @ (2, 0) @ (Nat, Nat, 3, 5, {{[_a-zA-Z0-9]+}}) (‹3; 2›, (2, 2, 2, 2, 1),
