// RUN: %mim -p opt %s -o - > %t.out
// RUN: %FileCheck %s < %t.out
// RUN: %FileCheck %s --check-prefix=GONE < %t.out

// Isolation test for the value-semantics %tensor.lower_get_set phase (pinned via a custom _compile):
// all tensors here are local literals, which the buffers-only default pipeline would materialize into
// buffers and read back at runtime (see lit/buffer/exec_local_tensors.mim) — this test instead checks
// that the value phase folds everything at compile time.
plugin tensor;
plugin refly;
plugin core;
plugin cps;
plugin affine;
plugin opt;

let m0 = ((1, 2), (3, 4));
let m1 = ((1, 2, 3), (4, 5, 6));
let m2 = <(2, 2, 3); 1>;

let g1 = %tensor.get @(Nat, 1, 1) (3, 0₁);
let g2 = %tensor.get @(Nat, 2, (2, 2)) (m0, (1₂, 0₂));
let g3 = %tensor.get @(Nat, 2, (2, 3)) (m1, (1₂, 2₃));
let g4 = %tensor.get @(Nat, 3, (2, 2, 3)) (m2, (0₂, 1₂, 2₃));

let s1 = %tensor.set @(Nat, 1, 1) (3, 0₁, 5);
let s2 = %tensor.set @(Nat, 2, (2, 2)) (m0, (1₂, 0₂), 12);
let s3 = %tensor.set @(Nat, 2, (2, 3)) (m1, (1₂, 2₃), 24);
let s4 = %tensor.set @(Nat, 3, (2, 2, 3)) (m2, (0₂, 1₂, 2₃), 36);

let sg2 = %tensor.get @(Nat, 2, (2, 2)) (s2, (1₂, 0₂));
let sg2_1 = %tensor.get @(Nat, 2, (2, 2)) (s2, (1₂, 1₂));
let sg3 = %tensor.get @(Nat, 2, (2, 3)) (s3, (1₂, 2₃));
let sg4 = %tensor.get @(Nat, 3, (2, 2, 3)) (s4, (0₂, 1₂, 2₃));

let _ = %refly.equiv.struc_eq (sg2, 12);
let _ = %refly.equiv.struc_eq (sg3, 24);
let _ = %refly.equiv.struc_eq (sg4, 36);

fun extern e1() = return (g2, g3, g4, sg2_1);

lam extern _compile (): %compile.Phase =
    %compile.phases ff (
        %tensor.lower_get_set,
        %compile.internal_cleanup,
    );

// CHECK-NOT: tensor.get
// CHECK-NOT: tensor.set
// CHECK: return_{{[0-9]+}} (3, 6, 1, 4)
// GONE-NOT: :(%mem.M 0)
