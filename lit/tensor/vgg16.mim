// REQUIRES: release
// RUN: %mim %s -p opt -o %t
// RUN: cat %t | %FileCheck %s
// RUN: cat %t | %FileCheck %s --check-prefix=GONE

// VGG16 forward pass (batch 10, 3x224x224 -> 1000 logits), rewritten in surface syntax from a PyTorch graph
// dump: five conv blocks (13 3x3 "same" convolutions, each followed by bias + ReLU) separated by 2x2/stride-2
// max-pools, then flatten and three fully-connected layers. Conv biases are broadcast NCHW-style via
// tensor.broadcast, FC biases tiled via tensor.repeat; explicit reshapes insert the singleton bias axes.
// Lowered through the DEFAULT pipeline on the Mim IR level (no codegen), checking that no tensor / map_reduce / affine residue remains.
// CHECK: extern con vgg16
// GONE-NOT: tensor.
// GONE-NOT: map_reduce
// GONE-NOT: affine.

plugin tensor;
plugin core;
plugin math;

use tensor;

let F32     = math.F32;
let fast    = math.mode.fast;
let Ring    = (F32, 0:F32, math.arith.add fast, math.arith.mul fast);
let fmax    = math.extrema.fmax fast;
let neg_inf = math.neg_inf math.f32;

let `+ = binary (math.arith.add fast);
let `* = product_2d Ring;

lam relu (x: F32): F32 = fmax (0:F32, x);

// stride 1, dilation 1, padding 1: a 3x3 conv with these keeps the spatial size.
let same = ((1, 1), (1, 1), (1, 1));

// Per-channel bias + ReLU after a convolution: `bias` is broadcast over NCHW.
lam conv_epilogue (n c h w: Nat) (t: tensor.Tensor 4 (n, c, h, w) F32, b: tensor.Tensor 1 c F32): tensor.Tensor 4 (n, c, h, w) F32 =
    unary relu (t + broadcast ((1, c, 1, 1), (n, c, h, w), reshape c (1, c, 1, 1) b));

// x·Wᵀ + b for a linear layer with the weight stored PyTorch-style as «c_out, c_in; F32».
lam linear (n c_in c_out: Nat) (x: tensor.Tensor 2 (n, c_in) F32, w: tensor.Tensor 2 (c_out, c_in) F32, b: tensor.Tensor 1 c_out F32): tensor.Tensor 2 (n, c_out) F32 =
    x * transpose_2d w + repeat (1, c_out) (n, c_out) (reshape c_out (1, c_out) b);

// Parameters follow torchvision's vgg16: w<i>/b<i> is features.<i>.{weight,bias}, fc<i>_* is classifier.<i>.*.
extern fun vgg16
    (x: tensor.Tensor 4 (10, 3, 224, 224) F32,
     w0:  tensor.Tensor 4 (64, 3, 3, 3) F32,    b0:  tensor.Tensor 1 64 F32,
     w2:  tensor.Tensor 4 (64, 64, 3, 3) F32,   b2:  tensor.Tensor 1 64 F32,
     w5:  tensor.Tensor 4 (128, 64, 3, 3) F32,  b5:  tensor.Tensor 1 128 F32,
     w7:  tensor.Tensor 4 (128, 128, 3, 3) F32, b7:  tensor.Tensor 1 128 F32,
     w10: tensor.Tensor 4 (256, 128, 3, 3) F32, b10: tensor.Tensor 1 256 F32,
     w12: tensor.Tensor 4 (256, 256, 3, 3) F32, b12: tensor.Tensor 1 256 F32,
     w14: tensor.Tensor 4 (256, 256, 3, 3) F32, b14: tensor.Tensor 1 256 F32,
     w17: tensor.Tensor 4 (512, 256, 3, 3) F32, b17: tensor.Tensor 1 512 F32,
     w19: tensor.Tensor 4 (512, 512, 3, 3) F32, b19: tensor.Tensor 1 512 F32,
     w21: tensor.Tensor 4 (512, 512, 3, 3) F32, b21: tensor.Tensor 1 512 F32,
     w24: tensor.Tensor 4 (512, 512, 3, 3) F32, b24: tensor.Tensor 1 512 F32,
     w26: tensor.Tensor 4 (512, 512, 3, 3) F32, b26: tensor.Tensor 1 512 F32,
     w28: tensor.Tensor 4 (512, 512, 3, 3) F32, b28: tensor.Tensor 1 512 F32,
     fc0_w: tensor.Tensor 2 (4096, 25088) F32,  fc0_b: tensor.Tensor 1 4096 F32,
     fc3_w: tensor.Tensor 2 (4096, 4096) F32,   fc3_b: tensor.Tensor 1 4096 F32,
     fc6_w: tensor.Tensor 2 (1000, 4096) F32,   fc6_b: tensor.Tensor 1 1000 F32)
    : tensor.Tensor 2 (10, 1000) F32 =
    let (x,
         w0, b0,
         w2, b2,
         w5, b5,
         w7, b7,
         w10, b10,
         w12, b12,
         w14, b14,
         w17, b17,
         w19, b19,
         w21, b21,
         w24, b24,
         w26, b26,
         w28, b28,
         fc0_w, fc0_b,
         fc3_w, fc3_b,
         fc6_w, fc6_b)
      = (x,
         w0, b0,
         w2, b2,
         w5, b5,
         w7, b7,
         w10, b10,
         w12, b12,
         w14, b14,
         w17, b17,
         w19, b19,
         w21, b21,
         w24, b24,
         w26, b26,
         w28, b28,
         fc0_w, fc0_b,
         fc3_w, fc3_b,
         fc6_w, fc6_b);
    // Block 1: 3 -> 64 -> 64, pool 224 -> 112.
    let a = conv_epilogue (10, 64, 224, 224) (conv Ring same (x, w0), b0);
    let a = conv_epilogue (10, 64, 224, 224) (conv Ring same (a, w2), b2);
    let a = pool (fmax, neg_inf) ((2, 2), (2, 2), (1, 1), (0, 0), (112, 112)) a;
    // Block 2: 64 -> 128 -> 128, pool 112 -> 56.
    let a = conv_epilogue (10, 128, 112, 112) (conv Ring same (a, w5), b5);
    let a = conv_epilogue (10, 128, 112, 112) (conv Ring same (a, w7), b7);
    let a = pool (fmax, neg_inf) ((2, 2), (2, 2), (1, 1), (0, 0), (56, 56)) a;
    // Block 3: 128 -> 256 -> 256 -> 256, pool 56 -> 28.
    let a = conv_epilogue (10, 256, 56, 56) (conv Ring same (a, w10), b10);
    let a = conv_epilogue (10, 256, 56, 56) (conv Ring same (a, w12), b12);
    let a = conv_epilogue (10, 256, 56, 56) (conv Ring same (a, w14), b14);
    let a = pool (fmax, neg_inf) ((2, 2), (2, 2), (1, 1), (0, 0), (28, 28)) a;
    // Block 4: 256 -> 512 -> 512 -> 512, pool 28 -> 14.
    let a = conv_epilogue (10, 512, 28, 28) (conv Ring same (a, w17), b17);
    let a = conv_epilogue (10, 512, 28, 28) (conv Ring same (a, w19), b19);
    let a = conv_epilogue (10, 512, 28, 28) (conv Ring same (a, w21), b21);
    let a = pool (fmax, neg_inf) ((2, 2), (2, 2), (1, 1), (0, 0), (14, 14)) a;
    // Block 5: 512 -> 512 -> 512, pool 14 -> 7.
    let a = conv_epilogue (10, 512, 14, 14) (conv Ring same (a, w24), b24);
    let a = conv_epilogue (10, 512, 14, 14) (conv Ring same (a, w26), b26);
    let a = conv_epilogue (10, 512, 14, 14) (conv Ring same (a, w28), b28);
    let a = pool (fmax, neg_inf) ((2, 2), (2, 2), (1, 1), (0, 0), (7, 7)) a;
    // Classifier: flatten, then 25088 -> 4096 -> 4096 -> 1000 (ReLU in between, none after the last layer).
    let a = reshape (10, 512, 7, 7) (10, 25088) a;
    let a = unary relu (linear (10, 25088, 4096) (a, fc0_w, fc0_b));
    let a = unary relu (linear (10, 4096, 4096) (a, fc3_w, fc3_b));
    return (linear (10, 4096, 1000) (a, fc6_w, fc6_b));
