// REQUIRES: release
// RUN: %mim %s -p opt -o %t
// RUN: cat %t | %FileCheck %s
// RUN: cat %t | %FileCheck %s --check-prefix=GONE

// VGG16 forward pass (batch 10, 3x224x224 -> 1000 logits), rewritten in surface syntax from a PyTorch graph
// dump: five conv blocks (13 3x3 "same" convolutions, each followed by bias + ReLU) separated by 2x2/stride-2
// max-pools, then flatten and three fully-connected layers. Conv biases are broadcast NCHW-style via
// %tensor.reshape + %tensor.broadcast, FC biases tiled via %tensor.reshape + %tensor.repeat, exactly as the
// importer emits them. Lowered through the DEFAULT pipeline on the Mim IR level (no codegen), checking that
// no %tensor / map_reduce / %affine residue remains.
// CHECK: extern vgg16
// GONE-NOT: %tensor.
// GONE-NOT: map_reduce
// GONE-NOT: %affine.

plugin tensor;
plugin refly;
plugin core;
plugin cps;
plugin affine;
plugin math;

let f32 = %math.f32;
let F32 = %math.F32;

let R: %tensor.Ring = (F32, 0:F32, %math.arith.add @f32 0, %math.arith.mul @f32 0);

let add     = %math.arith.add @f32 0;
let fmax    = %math.extrema.fmax @f32 0;
let neg_inf = 0xFF800000:F32;

lam relu (x: F32): F32 = fmax (0:F32, x);

// stride 1, dilation 1, padding 1: a 3x3 conv with these keeps the spatial size.
let same = ((1, 1), (1, 1), (1, 1));

// Per-channel bias + ReLU after a convolution: `bias` is reshaped to rank 4 and broadcast over NCHW.
lam conv_epilogue (n c h w: Nat) (t: «n, c, h, w; F32», bias: «c; F32»): «n, c, h, w; F32» =
    let bias4 = %tensor.broadcast ((1, c, 1, 1), (n, c, h, w), %tensor.reshape c (1, c, 1, 1) bias);
    %tensor.unary relu @(4, (n, c, h, w)) (%tensor.binary add @(4, (n, c, h, w)) (t, bias4));

// x·Wᵀ + b for a linear layer with the weight stored PyTorch-style as «c_out, c_in; F32».
lam linear (n c_in c_out: Nat) (x: «n, c_in; F32», w: «c_out, c_in; F32», bias: «c_out; F32»): «n, c_out; F32» =
    let z  = %tensor.product_2d R (x, %tensor.transpose_2d w);
    let b2 = %tensor.repeat (1, c_out) (n, c_out) (%tensor.reshape c_out (1, c_out) bias);
    %tensor.binary add @(2, (n, c_out)) (z, b2);

// Parameters follow torchvision's vgg16: w<i>/b<i> is features.<i>.{weight,bias}, fc<i>_* is classifier.<i>.*.
fun extern vgg16
    (x: «10, 3, 224, 224; F32»,
     w0:  «64, 3, 3, 3; F32»,    b0:  «64; F32»,
     w2:  «64, 64, 3, 3; F32»,   b2:  «64; F32»,
     w5:  «128, 64, 3, 3; F32»,  b5:  «128; F32»,
     w7:  «128, 128, 3, 3; F32», b7:  «128; F32»,
     w10: «256, 128, 3, 3; F32», b10: «256; F32»,
     w12: «256, 256, 3, 3; F32», b12: «256; F32»,
     w14: «256, 256, 3, 3; F32», b14: «256; F32»,
     w17: «512, 256, 3, 3; F32», b17: «512; F32»,
     w19: «512, 512, 3, 3; F32», b19: «512; F32»,
     w21: «512, 512, 3, 3; F32», b21: «512; F32»,
     w24: «512, 512, 3, 3; F32», b24: «512; F32»,
     w26: «512, 512, 3, 3; F32», b26: «512; F32»,
     w28: «512, 512, 3, 3; F32», b28: «512; F32»,
     fc0_w: «4096, 25088; F32»,  fc0_b: «4096; F32»,
     fc3_w: «4096, 4096; F32»,   fc3_b: «4096; F32»,
     fc6_w: «1000, 4096; F32»,   fc6_b: «1000; F32»)
    : «10, 1000; F32» =
    // Block 1: 3 -> 64 -> 64, pool 224 -> 112.
    let a = conv_epilogue (10, 64, 224, 224) (%tensor.conv R same (x, w0), b0);
    let a = conv_epilogue (10, 64, 224, 224) (%tensor.conv R same (a, w2), b2);
    let a = %tensor.pool (fmax, neg_inf) ((2, 2), (2, 2), (1, 1), (0, 0), (112, 112)) a;
    // Block 2: 64 -> 128 -> 128, pool 112 -> 56.
    let a = conv_epilogue (10, 128, 112, 112) (%tensor.conv R same (a, w5), b5);
    let a = conv_epilogue (10, 128, 112, 112) (%tensor.conv R same (a, w7), b7);
    let a = %tensor.pool (fmax, neg_inf) ((2, 2), (2, 2), (1, 1), (0, 0), (56, 56)) a;
    // Block 3: 128 -> 256 -> 256 -> 256, pool 56 -> 28.
    let a = conv_epilogue (10, 256, 56, 56) (%tensor.conv R same (a, w10), b10);
    let a = conv_epilogue (10, 256, 56, 56) (%tensor.conv R same (a, w12), b12);
    let a = conv_epilogue (10, 256, 56, 56) (%tensor.conv R same (a, w14), b14);
    let a = %tensor.pool (fmax, neg_inf) ((2, 2), (2, 2), (1, 1), (0, 0), (28, 28)) a;
    // Block 4: 256 -> 512 -> 512 -> 512, pool 28 -> 14.
    let a = conv_epilogue (10, 512, 28, 28) (%tensor.conv R same (a, w17), b17);
    let a = conv_epilogue (10, 512, 28, 28) (%tensor.conv R same (a, w19), b19);
    let a = conv_epilogue (10, 512, 28, 28) (%tensor.conv R same (a, w21), b21);
    let a = %tensor.pool (fmax, neg_inf) ((2, 2), (2, 2), (1, 1), (0, 0), (14, 14)) a;
    // Block 5: 512 -> 512 -> 512, pool 14 -> 7.
    let a = conv_epilogue (10, 512, 14, 14) (%tensor.conv R same (a, w24), b24);
    let a = conv_epilogue (10, 512, 14, 14) (%tensor.conv R same (a, w26), b26);
    let a = conv_epilogue (10, 512, 14, 14) (%tensor.conv R same (a, w28), b28);
    let a = %tensor.pool (fmax, neg_inf) ((2, 2), (2, 2), (1, 1), (0, 0), (7, 7)) a;
    // Classifier: flatten, then 25088 -> 4096 -> 4096 -> 1000 (ReLU in between, none after the last layer).
    let a = %tensor.reshape (10, 512, 7, 7) (10, 25088) a;
    let a = %tensor.unary relu @(2, (10, 4096)) (linear (10, 25088, 4096) (a, fc0_w, fc0_b));
    let a = %tensor.unary relu @(2, (10, 4096)) (linear (10, 4096, 4096) (a, fc3_w, fc3_b));
    return (linear (10, 4096, 1000) (a, fc6_w, fc6_b));


