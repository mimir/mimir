// RUN: %mim -p opt %s -o - | %FileCheck %s

// A chain of three tensor ops (outer reduction over a pure map over a pure map).
// The fuse phase should collapse all three into a single tensor.map_reduce:
// out[i] = sum_j ((v[i, j] + 1) * 2)
plugin core;
plugin tensor;
plugin compile;

use core.ops.n;
use tensor;

lam add1 (x: Nat): Nat = x + 1;
lam mul2 (x: Nat): Nat = x * 2;

fun sum_reduce (acc x: Nat)@tt: Nat = return (acc + x);

extern con f (v: «2; «3; Nat»», return: Cn «2; Nat») =
    let v = buf v;
    let inner1 = unary add1 v;
    let inner2 = unary mul2 inner1;
    return (map_reduce (2, (2, 3)) (sum_reduce, 0)
        (proj_map 0) (proj_map (0, 1)) inner2);

extern lam _compile (): compile.Phase =
    compile.phases ff (
        compile.cleanup,
        lower_tensor,
        fuse_tensor,
        compile.cleanup,
    );

// CHECK: tensor.map_reduce
// CHECK-NOT: tensor.map_reduce
