// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p opt -p clos -p ll %s
// RUN: clang %{s:stem}.ll -o %t -Wno-override-module
// RUN: %t; test $? -eq 93

plugin core;
plugin tensor;

con extern main (mem: %mem.M 0, argc: I32,
                 argv: %mem.Ptr (%mem.Ptr (I8, 0), 0),
                 return: Cn [%mem.M 0, I32]) =
    let input = ((10I32, 11I32, 12I32), (20I32, 21I32, 22I32));
    let index = ((2_3, 0_3), (1_3, 1_3));
    let updates = ((10I32, 20I32), (30I32, 40I32));
    let gathered = %tensor.gather @(I32, 2) ((2, 3), (2, 2)) 1_2 (input, index);
    let scattered = %tensor.scatter @(I32, 2) ((2, 3), (2, 2), (2, 2)) 1_2
        (input, index, updates);
    let a = %tensor.get ((0_2, 0_2), gathered);
    let b = %tensor.get ((1_2, 0_2), gathered);
    let c = %tensor.get ((0_2, 0_3), scattered);
    let d = %tensor.get ((1_2, 1_3), scattered);
    return (mem, %core.wrap.add 0 (%core.wrap.add 0 (a, b), %core.wrap.add 0 (c, d)));
