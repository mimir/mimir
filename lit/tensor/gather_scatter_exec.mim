// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p opt -p clos -p ll %s
// RUN: clang %{s:stem}.ll -o %t -Wno-override-module
// RUN: %t; test $? -eq 93

plugin core;
plugin tensor;
plugin mem;

use core.ops.u.w;

extern con main (m: mem.M 0, argc: I32,
                 argv: mem.Ptr (mem.Ptr (I8, 0), 0),
                 return: Cn [mem.M 0, I32]) =
    let input = ((10I32, 11I32, 12I32), (20I32, 21I32, 22I32));
    let index = ((2₃, 0₃), (1₃, 1₃));
    let updates = ((10I32, 20I32), (30I32, 40I32));
    let gathered = tensor.gather ((2, 3), (2, 2)) 1₂ (input, index);
    let scattered = tensor.scatter ((2, 3), (2, 2), (2, 2)) 1₂ (input, index, updates);
    return (m, gathered#(0₂, 0₂) + gathered#(1₂, 0₂) + (scattered#(0₂, 0₃) + scattered#(1₂, 1₃)));
