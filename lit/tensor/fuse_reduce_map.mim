// RUN: %mim -p opt %s -o - | %FileCheck %s

// An outer reducing tensor.map_reduce reads from an inner pure map.
// The fuse phase should collapse them: out[i] = sum_j (v[i, j] + 1).
plugin core;
plugin tensor;
plugin compile;

use core.ops.n;
use tensor;

lam add1 (x: Nat): Nat = x + 1;

fun sum_reduce (acc x: Nat)@tt: Nat = return (acc + x);

extern con f (v: «2; «3; Nat»», return: Cn «2; Nat») =
    let v = buf v;
    let inner = unary add1 v;
    // out[i] = Σ_j inner[i, j]: one output loop (bound 2), one reduction loop (bound 3).
    return (map_reduce (2, (2, 3)) (sum_reduce, 0)
        (proj_map 0) (proj_map (0, 1)) inner);

extern lam _compile (): compile.Phase =
    compile.phases ff (
        compile.cleanup,
        lower_tensor,
        fuse_tensor,
        compile.cleanup,
    );

// CHECK: tensor.map_reduce
// CHECK-NOT: tensor.map_reduce
