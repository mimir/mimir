// RUN: %mim -p opt %s -o - | %FileCheck %s

plugin core;
plugin tensor;
plugin affine;
plugin mem;

fun add (x y: I32)@tt: I32 = return (core.wrap.add 0 (x, y));
lam out_i (i j k: affine.Index): affine.Index = i;
lam in_jk (i j k: affine.Index): «2; affine.Index» = (j, k);

extern con main (m: mem.M 0, argc: I32, argv: mem.Ptr (mem.Ptr (I8, 0), 0), return: Cn [mem.M 0, I32]) =
    let n = core.nat.add (core.bitcast Nat argc, 4);
    let base = tensor.from_array @(2, (4, 4), I32) ‹4; (1I32, 2I32, 3I32, 4I32)›;
    let a = tensor.repeat @(I32, 2) (4, 4) (n, 4) base;
    let s = tensor.map_reduce (2, (2, n, 4)) (add, 0I32) out_i in_jk a;
    return (m, tensor.get (s, 0₂));

// CHECK: mem.load
// CHECK: mem.store
