// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p opt -p clos -p ll %s
// RUN: clang %{s:stem}.ll -o %t -Wno-override-module
// RUN: %t; test $? -eq 30

plugin mem;
plugin core;
plugin tensor;

use core.ops.u.w;

lam row_value(indices: «2; I64»): I32 = core.select (indices#0_2 == 0I64, 10I32, 20I32);

extern con main (m: mem.M 0, argc: I32,
                 argv: mem.Ptr (mem.Ptr (I8, 0), 0),
                 return: Cn [mem.M 0, I32]) =
    let generated = tensor.generate (2, 3) row_value;
    return (m, generated#(0_2, 2_3) + generated#(1_2, 1_3));
