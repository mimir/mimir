// RUN: %mim -p opt %s
plugin vec;
plugin option as o;
plugin refly;
plugin core;

use core.ops.n;

let l = vec.fold.l core.nat.add (0, (1, 2, 3, 4, 5));
let r = vec.fold.r core.nat.add ((1, 2, 3, 4, 5), 0);
let _ = refly.struc.e (l, 15);
let _ = refly.struc.e (r, 15);

let l2 = vec.fold.l core.nat.mul (1, «4; 2»);
let r2 = vec.fold.r core.nat.mul («4; 2», 1);
let _ = refly.struc.e (l2, 16);
let _ = refly.struc.e (r2, 16);

let e1 = vec.scan.exists (λ (n: Nat): Bool = n == 3) (0, 1, 2, 3, 4);
let e2 = vec.scan.exists (λ (n: Nat): Bool = n == 5) (0, 1, 2, 3, 4);
let _  = refly.struc.e (e1, tt);
let _  = refly.struc.e (e2, ff);

let a1 = vec.scan.for_all (λ (n: Nat): Bool = n >= 0) (0, 1, 2, 3, 4);
let a2 = vec.scan.for_all (λ (n: Nat): Bool = n < 3) (0, 1, 2, 3, 4);
let _  = refly.struc.e (a1, tt);
let _  = refly.struc.e (a2, ff);

let d1 = vec.diff ((8, 1, 3, 6, 9, 0), (4₆, 2₆));
let d2 = vec.diff (‹6; 23›, (4₆, 2₆));
let _  = refly.struc.e (d1, (8, 1, 6, 0));
let _  = refly.struc.e (d2, (23, 23, 23, 23));

let g1 = vec.first core.ncmp.e ((8, 1, 3, 6, 9, 0), 1);
let g2 = vec.last core.ncmp.e ((8, 1, 3, 6, 9, 0), 2);
let g3 = vec.first (core.icmp.e @10) ((8₁₀, 1₁₀, 3₁₀, 6₁₀, 9₁₀, 0₁₀), 1₁₀ );
let _  = refly.struc.e (g1, o.some 1₆);
let _  = refly.struc.e (g2, o.none (Idx 6));
let _  = refly.struc.e (g3, o.some 1₆);

let r1 = ‹i: 3; i›;
let r2 = ‹i: 3; core.wrap.add 0 (i, 1₃)›;
let _  = refly.struc.e (r1, (0₃, 1₃, 2₃));
let _  = refly.struc.e (r2, (1₃, 2₃, 3₃));

let r0 = vec.zip core.nat.add ((1), (2));
let r1 = vec.zip core.nat.add ((1, 1), (2, 2));
let r2 = vec.zip core.nat.add ((1, 2), (3, 3));
let r3 = vec.zip core.nat.add ((1, 1), (2, 3));
let r4 = vec.zip core.nat.add ((1, 2), (3, 4));
let foo  =  vec.zip (λ (a b: Nat, c: Bool): I32 = 23I32) ((2, 1, 2, 3), (4, 4, 4, 4), (tt, ff, ff, tt));

let _  = refly.struc.e (r0, (3));
let _  = refly.struc.e (r1, (3, 3));
let _  = refly.struc.e (r2, (4, 5));
let _  = refly.struc.e (r3, (3, 4));
let _  = refly.struc.e (r4, (4, 6));
