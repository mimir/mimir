// RUN: rm -rf %t && mkdir -p %t && cd %t && %mim -p opt %s -p ll && %FileCheck %s < %{s:stem}.ll

plugin core;
plugin vec;
plugin math;

use core.ops.n;

fun smpl_op {n: Nat} (A B: «n; Nat»):  «n; Nat» =
    let C = vec.zip `+ (A, B);
    return (vec.zip `- (C, ‹n; 1›));

fun arth_op {n: Nat} (A B: «n; math.F32»): «n; math.F32» =
    use math.ops.fast;
    let C = vec.zip `+ (A, B);
    return (vec.zip `* (C, B));

fun cmp {n: Nat} (A B: «n; Nat»): «n; Bool» =
    return (vec.zip `< (A, B));

extern fun foo (A B: «4; Nat»): «4; Nat» =
    ret C = smpl_op @4 $ (A, B);
    ret D = smpl_op @4 $ (A, B);
    return D;

extern fun bar (A B: «2; math.F32»): «2; math.F32» =
    ret C = arth_op @2 $ (A, B);
    ret D = arth_op @2 $ (A, C);
    return D;

extern fun war (A B: «2; Nat»): «2; Bool» =
    ret C = cmp @2 $ (A, B);
    return C;

// CHECK: define
