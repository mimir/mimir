// RUN: rm -rf %t && mkdir -p %t && cd %t && %mim -p opt %s -p ll && %FileCheck %s < %{s:stem}.ll

plugin core;
plugin vec;
fun foo{n: Nat} (a b: «n; Nat»): «n; Nat» =
    let c = vec.zip core.nat.add (a, b);
    return (vec.zip core.nat.sub (c, ‹n; 1›));
extern fun bar(): «4; Nat» =
    let a = (1, 2, 3, 4);
    let b = (1, 2, 3, 4);
    ret c = foo @4 $ (a, b);
    ret d = foo @4 $ (a, b);
    return d;

// CHECK: define{{.*}} @bar
// CHECK: ret <4 x i64> <i64 1, i64 3, i64 5, i64 7>
