// RUN: rm -f %{s:stem}.ll ; \
// RUN: %mim -p opt %s -o - -p ll | %FileCheck %s
// RUN: clang %{s:stem}.ll -o %t -Wno-override-module
// RUN: %t "a"; test $? -eq 1
// RUN: %t "a1"; test $? -eq 1
// RUN: %t "ab"; test $? -eq 1
// RUN: %t "1a"; test $? -eq 0

plugin mem;
plugin core;
plugin regex;
plugin cps;

use core.ops.u.w;

let re = regex.conj (regex.lit 'a', regex.disj (regex.empty, regex.any));

extern con main(m: mem.M 0, argc: I32, argv: mem.Ptr0 «core.idx2nat argc; mem.Ptr0 I8», exit: Cn [mem.M 0, I32]) =
    (exit, match_argument) # (argc > 1I32) (m, 0I32)
    where
        con match_argument(m: mem.M 0, _: I32) =
            let (m, to_match)     = mem.load (m, mem.lea (argv, core.idx 0 (core.idx2nat argc) 1));
            ret (m, n, to_match)  = mem.cstr $ (m, to_match);
            let np1               = core.nat.add (n, 1);
            let (m, matched, pos) = re (m, to_match, core.idx 0 np1 0);
            let matched           = core.bit2.and_ core.mode.us (matched, pos == core.idx 0 np1 n);
            exit (m, core.conv.u i32 matched);
    end

// CHECK-NOT: regex.
