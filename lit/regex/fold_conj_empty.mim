// RUN: %mim -p opt %s -o - -P %S | %FileCheck %s

import mem;
plugin regex;

import "dont_compile.mim";

let Top = ⊤:Nat;

extern con conj_empty(m: mem.M 0, string: mem.Ptr («Top; I8», 0), return: Cn [mem.M 0, Bool, I32]) =
    let pattern = regex.conj (regex.empty);
    return (pattern (m, string, 0I32));
// CHECK: %regex.empty
// CHECK-NOT: %regex.conj
