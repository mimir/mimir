// RUN: rm -f %{s:stem}.ll ; \
// RUN: %mim -p opt %s -o - -p ll | %FileCheck %s
// RUN: clang %{s:stem}.ll -o %t -Wno-override-module
// RUN: %t "0"; test $? -eq 1
// RUN: %t "1"; test $? -eq 0

plugin mem;
plugin regex;
plugin cps;
plugin core;

let Top = ⊤:Nat;
let re = regex.disj (regex.lit '0', regex.lit '5', regex.lit '9');

extern con main[m: mem.M 0, argc: I32, argv: mem.Ptr («⊤:Nat; mem.Ptr («⊤:Nat; I8», 0)», 0), exit: Cn [mem.M 0, I32]] =
    (exit, match_argument) # (core.icmp.ug (argc, 1I32)) (m, 0I32)
    where
        con match_argument[m: mem.M 0, I32] =
            let arg1 = mem.lea (argv, core.idx_unsafe 1);
            let (m, to_match) = mem.load (m, arg1);
            let (m, matched, pos) = re (m, to_match, 0:(Idx Top));
            exit (m, core.conv.u i32 matched);
    end;

// CHECK-NOT: %regex.
