// RUN: %mim -p opt %s -o - -P %S | %FileCheck %s

import mem;
plugin regex;

import "dont_compile.mim";

let Top = ⊤:Nat;

extern con fold_star_optional(m: mem.M 0, string: mem.Ptr («Top; I8», 0), return: Cn [mem.M 0, Bool, I32]) =
    let pattern = regex.quant.star (regex.quant.optional (regex.cls.d));
    return (pattern (m, string, 0I32));
    // CHECK: regex.quant.star (regex.range (48I8, 57I8))
