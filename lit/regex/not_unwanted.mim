// RUN: (! %mim %s 2>&1) | %FileCheck %s

// `not` accepts only `disj`, `range`, `any` and `not`; the note names the operand that is none of them.
plugin regex;

let bad = regex.not (regex.conj (regex.cls.d, regex.cls.d));

// CHECK:      {{.*}}not_unwanted.mim:6:11-6:59: error: regex.not must only be used with regex.disj, regex.range, regex.any and regex.not: regex.not regex.conj @ 2 ‹2; regex.range (48I8, 57I8)›
// CHECK-NEXT: 6 | let bad = regex.not (regex.conj (regex.cls.d, regex.cls.d));
// CHECK-NEXT:   |           ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
// CHECK-NEXT: = note: found unwanted: regex.conj @ 2 ‹2; regex.range (48I8, 57I8)›
// CHECK-NOT:  error:
