// RUN: rm -f %{s:stem}.ll ; \
// RUN: %mim -p opt %s -o - -p ll | %FileCheck %s
// RUN: clang %{s:stem}.ll -o %t -Wno-override-module
// RUN: %t "g1 "; test $? -eq 1

plugin mem;
plugin core;
plugin regex;
plugin cps;

use core.ops.u;

let re = regex.disj (regex.cls.w, regex.cls.d, regex.cls.s);

extern con main(m: mem.M 0, argc: I32, argv: mem.Ptr0 «core.idx2nat argc; mem.Ptr0 mem.Char», exit: Cn [mem.M 0, I32]) =
    (exit, match_argument) # (argc > 1I32) (m, 0I32)
    where
        con match_argument(m: mem.M 0, _: I32) =
            let (m, to_match)     = mem.load (m, mem.lea (argv, core.idx 0 (core.idx2nat argc) 1));
            ret (m, n, to_match)  = mem.cstr $ (m, to_match);
            let (m, matched, pos) = re (m, to_match, regex.pos n 0);
            exit (m, core.conv.u i32 matched);
    end;

// CHECK-NOT: regex.
