// RUN: rm -f %{s:stem}.ll ; \
// RUN: %mim -p opt %s -o - -p ll --aggr-lam-spec | %FileCheck %s
// RUN: clang %{s:stem}.ll -o %t -Wno-override-module
// RUN: %t; test $? -eq 1

plugin mem;
plugin core;
plugin regex;
plugin cps;
use regex;

let Top     = ⊤:Nat;
let pattern = regex.conj (regex.quant.plus  regex.cls.w, regex.lit '@');
let len     = 10;

extern con main(m: mem.M 0, argc: I32, argv: mem.Ptr («⊤:Nat; mem.Ptr («⊤:Nat; I8», 0)», 0), exit: Cn [mem.M 0, I32]) =
    let (m, string) = mem.alloc («len; Char», 0) m;
    let m           = mem.store (m, string, "testasdf@\0");
    match_regex len ((m, string), exiting)
    where
        fun match_regex(len: Nat) (m: mem.M 0, str: mem.Ptr0 «len; Char»): [mem.M 0, Bool] =
            let (m, matched, pos) = pattern (m, str, 0:(Idx len));
            let end_ = core.idx 0 len (core.nat.sub (len, 1));
            return (m, core.bit2.and_ 0 (core.icmp.e (pos, end_), matched));
        con exiting(m: mem.M 0, return: Bool) = exit (m, core.conv.u i32 return)
    end

// CHECK-NOT: %regex.
