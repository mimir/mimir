// RUN: rm -f %{s:stem}.ll ; \
// RUN: %mim -p opt %s -o - -p ll --aggr-lam-spec | %FileCheck %s
// RUN: clang %{s:stem}.ll -o %t -Wno-override-module
// RUN: %t; test $? -eq 1

plugin mem;
plugin core;
plugin regex;
plugin cps;

use core.ops.u;
use regex;

let pattern = regex.conj (regex.quant.plus  regex.cls.w, regex.lit '@');
let len     = 9;

extern con main(m: mem.M 0, argc: I32, argv: mem.Ptr0 «core.idx2nat argc; mem.Ptr0 mem.Char», exit: Cn [mem.M 0, I32]) =
    let (m, string) = mem.alloc («len; mem.Char», 0) m;
    let m           = mem.store (m, string, "testasdf@");
    match_regex len ((m, string), exiting)
    where
        fun match_regex(len: Nat) (m: mem.M 0, str: mem.Str len): [mem.M 0, Bool] =
            let (m, matched, pos) = pattern (m, str, regex.pos len 0);
            return (m, core.bit2.and 0 (pos == regex.pos len len, matched));
        con exiting(m: mem.M 0, return: Bool) = exit (m, core.conv.u i32 return)
    end

// CHECK-NOT: regex.
