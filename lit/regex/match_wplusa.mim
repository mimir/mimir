// RUN: rm -f %{s:stem}.ll ; \
// RUN: %mim -p opt %s -o - -p ll --aggr-lam-spec | %FileCheck %s
// RUN: clang %{s:stem}.ll -o %t -Wno-override-module
// RUN: %t "aa"; test $? -eq 1
// RUN: %t "abca"; test $? -eq 1
// RUN: %t "a"; test $? -eq 0

plugin mem;
plugin core;
plugin regex;
plugin cps;

use core.ops.u;

let re = regex.conj (regex.quant.plus  regex.cls.w, regex.lit 'a');

extern con strlen [mem.M 0, mem.Ptr0 I8, Cn [mem.M 0, I64]];

extern con main(m: mem.M 0, argc: I32, argv: mem.Ptr0 (mem.Ptr0 I8), exit: Cn [mem.M 0, I32]) =
    (exit, match_argument) # (argc > 1I32) (m, 0I32)
    where
        con match_argument(m: mem.M 0, _: I32) =
            let (m, to_match) = mem.load (m, mem.lea (mem.assume (argv, 2), 1_2));
            strlen (m, to_match, match_len)
            where
                con match_len(m: mem.M 0, len: I64) =
                    let n                 = core.nat.add (core.bitcast Nat len, 1);
                    let to_match          = mem.assume (to_match, n);
                    let (m, matched, pos) = re (m, to_match, 0:(Idx n));
                    exit (m, core.conv.u i32 matched);
            end
    end;

// CHECK-NOT: regex.
