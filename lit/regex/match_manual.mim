// RUN: rm -f %{s:stem}.ll ; \
// RUN: %mim -p opt %s -o - -p ll | %FileCheck %s
// RUN: clang %{s:stem}.ll -o %t -Wno-override-module %S/../lib.c
// RUN: %t "aa"; test $? -eq 1
// RUN: %t "abbaa"; test $? -eq 1
// RUN: %t "a"; test $? -eq 0

plugin mem;
plugin core;
plugin regex;
plugin cps;

use core.ops.u.nw;


// matches (a|b)+a

extern con main(m: mem.M 0, argc: I32, argv: mem.Ptr0 «core.idx2nat argc; mem.Ptr0 mem.Char», exit: Cn [mem.M 0, I32]) =
    (exit, match_argument) # (argc > 1I32) (m, 0I32)
    where
        con match_argument(m: mem.M 0, _: I32) =
            let (m, to_match)    = mem.load (m, mem.lea (argv, core.idx 0 (core.idx2nat argc) 1));
            ret (m, n, to_match) = mem.cstr $ (m, to_match);
            let end_             = regex.pos n n;
            let one              = regex.pos n 1;
            start (m, regex.pos n 0)
            where
                mutual
                    con start(m: mem.M 0, i: regex.Pos n) =
                        (not_end, error)#(i == end_) (m, i)
                        where
                            con not_end(m: mem.M 0, i: regex.Pos n) =
                                let (m, c) = mem.load (m, mem.lea (to_match, core.conv.u n i));
                                (error, state1)#(core.bit2.or 2 (c == 'a', c == 'b')) (m, i + one);
                        end
                    con state1(m: mem.M 0, i: regex.Pos n) =
                        (not_end, error)#(i == end_) (m, i)
                        where
                            con not_end(m: mem.M 0, i: regex.Pos n) =
                                let (m, c) = mem.load (m, mem.lea (to_match, core.conv.u n i));
                                (not_a, state2)#(c == 'a') (m, i + one)
                                where
                                    con not_a(m: mem.M 0, i: regex.Pos n) = (error, state1)#(c == 'b') (m, i);
                                end
                        end
                    con state2(m: mem.M 0, i: regex.Pos n) =
                        (not_end, accept)#(i == end_) (m, i)
                        where
                            con not_end(m: mem.M 0, i: regex.Pos n) =
                                let (m, c) = mem.load (m, mem.lea (to_match, core.conv.u n i));
                                (not_a, state2)#(c == 'a') (m, i + one)
                                where
                                    con not_a(m: mem.M 0, i: regex.Pos n) = (error, state1)#(c == 'b') (m, i);
                                end
                        end
                    con accept(m: mem.M 0, _: regex.Pos n) = exit (m, 1I32);
                    con error (m: mem.M 0, _: regex.Pos n) = exit (m, 0I32);
                end
            end
    end

// CHECK-NOT: regex.
