// RUN: %mim -p opt %s
plugin core;
plugin ord;
plugin refly;
plugin option as o;

let Key = (Nat, core.ncmp.l);

let s = ord.init.set Key (1, 3, 6, 9);
let m = ord.init.map Key ((1, tt), (3, ff), (6, tt), (9, ff));
let _  = refly.struc.e (4, ord.size.set s);
let _  = refly.struc.e (4, ord.size.map m);
let _  = refly.struc.e (o.some ff, ord.get (m, 3));
let _  = refly.struc.e (tt, ord.contains.set (s, 3));
let _  = refly.struc.e (tt, ord.contains.map (m, 3));
let _  = refly.struc.e (ff, ord.contains.set (s, 4));
let _  = refly.struc.e (ff, ord.contains.map (m, 4));
