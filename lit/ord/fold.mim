// RUN: rm -rf %t && mkdir -p %t && cd %t && %mim -p opt %s -p ll && %FileCheck %s < %{s:stem}.ll
/// A hypothetical C++-to-MimIR compiler would produce the output below from this C++ program:
/// ```cpp
/// uint64_t f(uint64_t x) {
///     auto map = std::map<uint32_t, uint64_t>{{23, 42}, {123, 456}};
///     map[0] = x;
///     map[1] = 11;
///     return map[0];
/// }
/// ```

plugin mem;
plugin ord;
plugin option;
plugin core;

use core.ops.u.w;

let Key = (I32, `<);
let Map = ord.Map Key I64;

extern fun f(m: mem.M 0, x: I64): [mem.M 0, I64] =
    ret (m, ptr) = mem.slot  (Map, 0) $ m;
    let  m       = mem.store (m, ptr, ord.init.map Key ((23I32, 42I64), (123I32, 456I64))); // 23 → 42, 123 → 456
    let (m, map) = mem.load  (m, ptr);
    let map = ord.insert.map (map, (0I32, x));                     // 0 → x
    let  m       = mem.store (m, ptr, map);
    let (m, map) = mem.load  (m, ptr);
    let map = ord.insert.map (map, (1I32, 11I64));                 // 1 → 11
    let  m       = mem.store (m, ptr, map);
    let (m, map) = mem.load  (m, ptr);
    let val = option.unwrap_unsafe (ord.get (map, 0I32));          // some x
    return (m, val);                                               // return x

// CHECK: define i64 @f(i64 [[X:%[[:alnum:]_]+]])
// CHECK: ret i64 [[X]]
