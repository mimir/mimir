// RUN: %mim -p opt %s -o -

// If compiling this takes forever, there is some loophole that Mim does sth 100000000 times.
plugin core;
plugin mem;

let size = 100000000;

extern fun main(m: mem.M 0, argc: I32, argv: mem.Ptr0 «core.idx2nat argc; mem.Ptr0 I8»): [mem.M 0, I32] =
    let (alloc_mem, arr) = mem.alloc («size; I32», 0) (m);
    let lea = mem.lea (arr, 0:(Idx size));
    let (load_mem, val) = mem.load (alloc_mem, lea);
    return ( load_mem, 1I32 );
