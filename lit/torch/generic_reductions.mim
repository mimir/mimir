// RUN: %mim -p opt %s -o - | %FileCheck %s \
// RUN:   --implicit-check-not=%%torch. --implicit-check-not=%%runtime.require \
// RUN:   --implicit-check-not=Match

plugin torch;
plugin compile;

// CHECK-DAG: fun extern sum_i64_default
// CHECK-DAG: fun extern sum_bool_default
// CHECK-DAG: fun extern sum_i64_f32

lam nat_max (args: [Nat, Nat]): Nat =
    %core.select (%core.ncmp.ge args, args#ff, args#tt);
lam nat_min (args: [Nat, Nat]): Nat =
    %core.select (%core.ncmp.le args, args#ff, args#tt);
lam nat_never (x: Nat): Bool = ff;
lam nat_is_zero (x: Nat): Bool = %core.ncmp.e (x, 0);

let NatArithmetic: %torch.Arithmetic = (
    (Nat, 0, %core.nat.add, %core.nat.mul),
    %core.nat.sub, %core.nat.div,
    nat_max, nat_min,
    %core.ncmp.e, %core.ncmp.ne,
    %core.ncmp.l, %core.ncmp.le, %core.ncmp.g, %core.ncmp.ge,
    nat_never, nat_is_zero,
);

// CHECK-DAG: fun extern generic_mean
fun extern generic_mean(input: «2, 3, 4; %math.F32»): «2, 1, 4; %math.F32» =
    return (%torch.reduction.mean (%torch.resolve_floating %math.F32)
        @(3, 1, (2, 3, 4)) ((1I64,), tt) input);

// CHECK-DAG: fun extern generic_amax
fun extern generic_amax(input: «2, 3, 4; %math.F32»): «3; %math.F32» =
    return (%torch.reduction.amax (%torch.resolve_floating %math.F32)
        @(3, 2, (2, 3, 4)) ((0I64, 2I64), ff) input);

// CHECK-DAG: fun extern amax_all
fun extern amax_all(input: «8; %math.F32»): %math.F32 =
    return (%torch.reduction.amax_all (%torch.resolve_floating %math.F32)
        @(1, (8,)) input);

// CHECK-DAG: fun extern generic_norm_p2
fun extern generic_norm_p2(input: «2, 3, 4; %math.F32»): «2, 4; %math.F32» =
    return (%torch.reduction.vector_norm (%torch.resolve_floating %math.F32)
        @(3, 1, (2, 3, 4))
        ((1I64,), ff, 0x40000000:%math.F32) input);

// CHECK-DAG: fun extern generic_norm_p0
fun extern generic_norm_p0(input: «2, 3, 4; %math.F32»): «2, 1, 4; %math.F32» =
    return (%torch.reduction.vector_norm (%torch.resolve_floating %math.F32)
        @(3, 1, (2, 3, 4))
        ((1I64,), tt, 0x00000000:%math.F32) input);

// CHECK-DAG: fun extern generic_logsumexp
fun extern generic_logsumexp(input: «2, 3, 4; %math.F32»): «2, 1, 4; %math.F32» =
    return (%torch.reduction.logsumexp (%torch.resolve_floating %math.F32)
        @(3, 1, (2, 3, 4)) ((-2I64,), tt) input);

// CHECK-DAG: fun extern generic_var_mean
fun extern generic_var_mean(input: «2, 3, 4; %math.F32»)
    : [Bool, «2, 1, 4; %math.F32», «2, 1, 4; %math.F32»] =
    return (%torch.reduction.var_mean (%torch.resolve_floating %math.F32)
        @(3, 1, (2, 3, 4))
        ((1I64,), 0x3F800000:%math.F32, tt) input);

fun extern sum_remove_dims(input: «2, 3, 4; Nat»): «3; Nat» =
    return (%torch.reduction.sum NatArithmetic
        @(3, 2, (2, 3, 4)) ((0I64, -1I64), ff) input);

// Definitions are emitted in reverse source order.
// CHECK-LABEL: fun extern sum_keep_dims
// CHECK: %tensor.map_reduce
fun extern sum_keep_dims(input: «2, 3, 4; Nat»): «1, 3, 1; Nat» =
    return (%torch.reduction.sum NatArithmetic
        @(3, 2, (2, 3, 4)) ((0I64, -1I64), tt) input);

// CHECK-LABEL: fun extern sum_remove_dims
// CHECK: %tensor.map_reduce

// Mixed dtype policy is selected by exact flat-type lookup and disappears.
fun extern sum_i64_default(input: «2, 3; I64»): «2; I64» =
    return (%torch.reduction.sum_typed
        (%torch.resolve_reduction I64 I64)
        @(2, 1, (2, 3)) ((1I64,), ff) input);

// PyTorch promotes Bool sum results to I64.
fun extern sum_bool_default(input: «2, 3; Bool»): «2; I64» =
    return (%torch.reduction.sum_typed
        (%torch.resolve_reduction Bool I64)
        @(2, 1, (2, 3)) ((1I64,), ff) input);

// Explicit dtype performs conversion before accumulation.
fun extern sum_i64_f32(input: «2, 3; I64»): «2; %math.F32» =
    return (%torch.reduction.sum_typed
        (%torch.resolve_reduction I64 %math.F32)
        @(2, 1, (2, 3)) ((1I64,), ff) input);

lam extern _compile (): %compile.Phase =
    %compile.phases ff (%torch.lower_torch, %compile.cleanup);
