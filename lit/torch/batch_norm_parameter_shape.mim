// RUN: not %mim %s -p opt -o /dev/null 2>&1 | %FileCheck %s

// CHECK: argument is not assignable to callee's domain

plugin torch;
plugin compile;

fun extern wrong_weight_shape(
    input: «2, 3, 4; %math.F32»,
    mean variance: «3; %math.F32»,
    weight: «4; %math.F32»): «2, 3, 4; %math.F32» =
    return (%torch.normalization.batch_norm
        (%torch.resolve_floating %math.F32) @(3, (2, 3, 4))
        (input, %option.some weight, %option.none @«3; %math.F32»,
         %option.some mean, %option.some variance)
        (ff, 0x3DCCCCCD:%math.F32, 0x3727C5AC:%math.F32, ff));

lam extern _compile (): %compile.Phase = %torch.lower_torch;
