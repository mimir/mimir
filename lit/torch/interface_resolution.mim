// RUN: %mim -p opt %s -o - | %FileCheck \
// RUN:   --implicit-check-not=%%core.resolve --implicit-check-not=%%torch. %s

// CHECK-LABEL: fun extern add_f32
// CHECK: %tensor.map_reduce
// CHECK-LABEL: fun extern add_f64
// CHECK: %tensor.map_reduce
// CHECK-LABEL: fun extern exp_f32
// CHECK: %math.exp
// CHECK-LABEL: fun extern exp_f64
// CHECK: %math.exp

plugin torch;
plugin compile;

fun extern add_f32(lhs rhs: «2, 3; %math.F32»): «2, 3; %math.F32» =
    return (%torch.binary.add (%torch.resolve_arithmetic %math.F32)
        @(2, (2, 3)) (lhs, rhs, 1.0:%math.F32));

fun extern add_f64(lhs rhs: «2, 3; %math.F64»): «2, 3; %math.F64» =
    return (%torch.binary.add (%torch.resolve_arithmetic %math.F64)
        @(2, (2, 3)) (lhs, rhs, 1.0:%math.F64));

fun extern exp_f32(input: «2, 3; %math.F32»): «2, 3; %math.F32» =
    return (%torch.unary.exp (%torch.resolve_floating %math.F32)
        @(2, (2, 3)) input);

fun extern exp_f64(input: «2, 3; %math.F64»): «2, 3; %math.F64» =
    return (%torch.unary.exp (%torch.resolve_floating %math.F64)
        @(2, (2, 3)) input);

lam extern _compile (): %compile.Phase =
    %compile.phases ff (
        %torch.lower_torch,
        %compile.internal_cleanup,
    );
