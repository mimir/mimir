// RUN: %mim -p opt %s -o - | %FileCheck %s \
// RUN:   --implicit-check-not=%%torch. --implicit-check-not=%%tensor.generate \
// RUN:   --implicit-check-not=%%tensor.get --implicit-check-not=Match

plugin torch;
plugin compile;

// CHECK-LABEL: fun extern roll
// CHECK-DAG: %affine.semiop.mod
// CHECK-DAG: %tensor.map_reduce
fun extern roll(input: «2, 3, 4; %math.F32»): «2, 3, 4; %math.F32» =
    return (%torch.indexing.roll @(%math.F32, 3, 2, (2, 3, 4))
        ((1, 2), (1I64, 2I64)) input);

lam extern _compile (): %compile.Phase =
    %compile.phases ff (%torch.lower_torch, %compile.cleanup);
