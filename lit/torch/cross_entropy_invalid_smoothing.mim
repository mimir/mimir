// RUN: not %mim %s -p opt -o /dev/null 2>&1 | %FileCheck %s

// CHECK: label_smoothing in [0,1]

plugin torch;
plugin compile;

fun extern invalid_smoothing(
    input: «2, 4; %math.F32», target: «2; I64»): %math.F32 =
    let F = %torch.resolve_floating %math.F32;
    return (%torch.loss.cross_entropy F @(2, (2, 4))
        (input, %torch.cross_entropy_index_target F
            @(2, (2, 4)) target, %option.none @«4; %math.F32»)
        (1, -100I64, 0x3FC00000:%math.F32));

lam extern _compile (): %compile.Phase = %torch.lower_torch;
