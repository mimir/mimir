// RUN: %mim %s -X torch:preserve=native_layer_norm_op -o - | %FileCheck %s --check-prefix=PRESERVE
// RUN: %mim %s -X torch:preserve=activation.relu -o - | %FileCheck %s --check-prefix=SUBTAG
// RUN: %mim %s -o - | %FileCheck %s --check-prefix=LOWER
// RUN: not %mim %s -X torch:preserve=not_an_op -o /dev/null 2>&1 | %FileCheck %s --check-prefix=INVALID

plugin torch;
plugin compile;

lam nat_max (args: [Nat, Nat]): Nat =
    %core.select (%core.ncmp.ge args, args#ff, args#tt);
lam nat_min (args: [Nat, Nat]): Nat =
    %core.select (%core.ncmp.le args, args#ff, args#tt);
lam nat_never (x: Nat): Bool = ff;
lam nat_is_zero (x: Nat): Bool = %core.ncmp.e (x, 0);
lam nat_identity (x: Nat): Nat = x;

let NatArithmetic: %torch.Arithmetic = (
    (Nat, 0, %core.nat.add, %core.nat.mul),
    %core.nat.sub, %core.nat.div,
    nat_max, nat_min,
    %core.ncmp.e, %core.ncmp.ne,
    %core.ncmp.l, %core.ncmp.le, %core.ncmp.g, %core.ncmp.ge,
    nat_never, nat_is_zero,
);

let NatFloating: %torch.Floating = (
    NatArithmetic, 0,
    nat_identity, nat_identity, nat_identity,
    nat_identity, nat_identity, nat_identity,
    nat_identity, nat_identity,
    nat_identity,
    %core.nat.mul,
);

// PRESERVE-LABEL: fun extern selective_layer_norm
// PRESERVE: %torch.normalization.native_layer_norm
// PRESERVE-NOT: %torch.activation.relu
// LOWER-LABEL: fun extern selective_layer_norm
// LOWER-NOT: %torch.normalization.native_layer_norm
// LOWER-NOT: %torch.activation.relu
fun extern selective_layer_norm(input: «2, 4; Nat»)
  : [«2, 4; Nat», «2, 1; Nat», «2, 1; Nat»] =
    let activated = %torch.activation.relu NatArithmetic @(2, (2, 4)) input;
    return (%torch.normalization.native_layer_norm NatFloating
        @(1, 1) ((2,), (4,)) activated
        ((%option.none @«4; Nat»), (%option.none @«4; Nat»)) 1);

// SUBTAG-LABEL: fun extern selective_activations
// SUBTAG: %torch.activation.relu
// SUBTAG-NOT: %torch.activation.tanh
fun extern selective_activations(input: «2, 4; Nat»)
  : [«2, 4; Nat», «2, 4; Nat»] =
    return (
        %torch.activation.relu NatArithmetic @(2, (2, 4)) input,
        %torch.activation.tanh NatFloating @(2, (2, 4)) input);

// INVALID: unknown Torch operator in `preserve`: `not_an_op`
lam extern _compile (): %compile.Phase =
    %compile.phases ff (
        %torch.decompose_torch,
        %compile.internal_cleanup,
    );
