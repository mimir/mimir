// RUN: not %mim %s -p opt -o /dev/null 2>&1 | %FileCheck %s

// CHECK: triplet_margin_loss expects margin greater than zero

plugin torch;
plugin compile;

fun extern invalid_margin(
    anchor positive negative: «5; %math.F32»): %math.F32 =
    return (%torch.loss.triplet_margin_loss_1d_none
        (%torch.resolve_floating %math.F32) @5
        (anchor, positive, negative)
        (0.0:%math.F32, 2.0:%math.F32, 1e-6:%math.F32, ff));

lam extern _compile (): %compile.Phase = %torch.lower_torch;
