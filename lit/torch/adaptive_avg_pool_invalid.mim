// RUN: not %mim %s -p opt -o /dev/null 2>&1 | %FileCheck %s

// CHECK: adaptive_avg_pool2d expects rank 3/4 and positive input/output sizes

plugin torch;
plugin compile;

fun extern zero_output(input: «2, 5, 7; %math.F32»)
  : «2, 0, 3; %math.F32» =
    return (%torch.pool.adaptive_avg_pool2d
        (%torch.resolve_floating %math.F32)
        @(3, (2, 5, 7)) (0, 3) input);

lam extern _compile (): %compile.Phase = %torch.lower_torch;
