// RUN: %mim %s -o - | %FileCheck %s --implicit-check-not=%%torch.normalization. --implicit-check-not=Match

plugin torch;
plugin compile;

lam nat_max (args: [Nat, Nat]): Nat =
    %core.select (%core.ncmp.ge args, args#ff, args#tt);
lam nat_min (args: [Nat, Nat]): Nat =
    %core.select (%core.ncmp.le args, args#ff, args#tt);
lam nat_never (x: Nat): Bool = ff;
lam nat_is_zero (x: Nat): Bool = %core.ncmp.e (x, 0);
lam nat_identity (x: Nat): Nat = x;

let NatArithmetic: %torch.Arithmetic = (
    (Nat, 0, %core.nat.add, %core.nat.mul),
    %core.nat.sub, %core.nat.div,
    nat_max, nat_min,
    %core.ncmp.e, %core.ncmp.ne,
    %core.ncmp.l, %core.ncmp.le, %core.ncmp.g, %core.ncmp.ge,
    nat_never, nat_is_zero,
);

let NatFloating: %torch.Floating = (
    NatArithmetic, 0,
    nat_identity, nat_identity, nat_identity,
    nat_identity, nat_identity, nat_identity,
    nat_identity, nat_identity,
    nat_identity,
    %core.nat.mul,
);

// CHECK-LABEL: fun extern group_norm_affine
// CHECK: %tensor.map_reduce
fun extern group_norm_affine(
    input: «2, 8, 3, 5; Nat», weight: «8; Nat», bias: «8; Nat»)
  : «2, 8, 3, 5; Nat» =
    return (%torch.normalization.group_norm NatFloating
        @(4, (2, 8, 3, 5))
        (input, %option.some weight, %option.some bias, 4, 1));

// CHECK-LABEL: fun extern instance_norm_no_affine
// CHECK: %tensor.map_reduce
fun extern instance_norm_no_affine(input: «2, 8, 3, 5; Nat»)
  : «2, 8, 3, 5; Nat» =
    return (%torch.normalization.group_norm NatFloating
        @(4, (2, 8, 3, 5))
        (input, %option.none @«8; Nat», %option.none @«8; Nat», 8, 1));

lam extern _compile (): %compile.Phase =
    %compile.phases ff (
        %torch.lower_torch,
        %compile.cleanup,
    );
