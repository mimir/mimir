// RUN: %mim %s -p opt -o /dev/null

plugin torch;
plugin compile;

// An empty non-reduced dimension is legal because no maximum must be chosen
// for an empty reduction group.
fun extern empty_output(input: «0, 3; %math.F32»): «0; %math.F32» =
    return (%torch.reduction.amax_dims (%torch.resolve_floating %math.F32)
        @(2, 1, (0, 3)) (1I64,) input);

lam extern _compile (): %compile.Phase = %torch.lower_torch;
