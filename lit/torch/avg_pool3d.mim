// RUN: %mim -p opt %s -o - | %FileCheck %s \
// RUN:   --implicit-check-not=%%torch. --implicit-check-not=Match

plugin torch;
plugin compile;

// CHECK-LABEL: fun extern avg_pool3d
// CHECK: %tensor.pad
// CHECK: %tensor.map_reduce
// CHECK: %tensor.map_reduce 2
// CHECK-SAME: %tensor.generate
fun extern avg_pool3d(input: «2, 3, 5, 7, 9; %math.F32»)
                    : «2, 3, 3, 4, 5; %math.F32» =
    return (%torch.pool.avg_pool3d (%torch.resolve_floating %math.F32)
        @(2, 3, 5, 7, 9)
        ((3, 3, 3), (2, 2, 2), (1, 1, 1), tt, ff, %option.none @Nat)
        input);

lam extern _compile (): %compile.Phase =
    %compile.phases ff (
        %torch.lower_torch, %tensor.lower_tensor, %compile.internal_cleanup);
