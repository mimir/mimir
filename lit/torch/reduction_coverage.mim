// RUN: %mim -p opt %s -o - | %FileCheck \
// RUN:   --implicit-check-not=%%torch. --implicit-check-not=%%runtime.require \
// RUN:   --implicit-check-not=Match %s

plugin torch;
plugin compile;

lam nat_max (args: [Nat, Nat]): Nat =
    %core.select (%core.ncmp.ge args, args#ff, args#tt);
lam nat_min (args: [Nat, Nat]): Nat =
    %core.select (%core.ncmp.le args, args#ff, args#tt);
lam nat_never (x: Nat): Bool = ff;
lam nat_is_zero (x: Nat): Bool = %core.ncmp.e (x, 0);

let NatArithmetic: %torch.Arithmetic = (
    (Nat, 0, %core.nat.add, %core.nat.mul),
    %core.nat.sub, %core.nat.div,
    nat_max, nat_min,
    %core.ncmp.e, %core.ncmp.ne,
    %core.ncmp.l, %core.ncmp.le, %core.ncmp.g, %core.ncmp.ge,
    nat_never, nat_is_zero,
);

// CHECK-DAG: fun extern sum_dim_keepdim
// CHECK-DAG: %tensor.map_reduce
fun extern sum_dim_keepdim(input: «2, 3, 4; Nat»): «2, 1, 4; Nat» =
    return (%torch.reduction.sum_dim_keepdim NatArithmetic
        @(3, (2, 3, 4)) (1I64) input);

// CHECK-DAG: fun extern sum_dims
// CHECK-DAG: %tensor.map_reduce
fun extern sum_dims(input: «2, 3, 4; Nat»): «3; Nat» =
    return (%torch.reduction.sum_dims NatArithmetic
        @(3, 2, (2, 3, 4)) ((0I64, -1I64)) input);

// CHECK-DAG: fun extern sum_dims_keepdim
// CHECK-DAG: %tensor.map_reduce
fun extern sum_dims_keepdim(input: «2, 3, 4; Nat»): «1, 3, 1; Nat» =
    return (%torch.reduction.sum_dims_keepdim NatArithmetic
        @(3, 2, (2, 3, 4)) ((0I64, -1I64)) input);

// CHECK-DAG: fun extern sum_all
// CHECK-DAG: %tensor.map_reduce
fun extern sum_all(input: «2, 3, 4; Nat»): Nat =
    return (%torch.reduction.sum_all NatArithmetic @(3, (2, 3, 4)) input);

// CHECK-DAG: fun extern amax_dim
// CHECK-DAG: %tensor.map_reduce
fun extern amax_dim(input: «2, 3, 4; %math.F32»): «2, 3; %math.F32» =
    return (%torch.reduction.amax_dim (%torch.resolve_floating %math.F32)
        @(3, (2, 3, 4)) (-1I64) input);

// CHECK-DAG: fun extern amax_dims
// CHECK-DAG: %tensor.map_reduce
fun extern amax_dims(input: «2, 3, 4; %math.F32»): «3; %math.F32» =
    return (%torch.reduction.amax_dims (%torch.resolve_floating %math.F32)
        @(3, 2, (2, 3, 4)) ((0I64, 2I64)) input);

// CHECK-DAG: fun extern mean_dim
// CHECK-DAG: %tensor.map_reduce
fun extern mean_dim(input: «2, 3, 4; %math.F32»): «2, 4; %math.F32» =
    return (%torch.reduction.mean_dim (%torch.resolve_floating %math.F32)
        @(3, (2, 3, 4)) (1I64) input);

// CHECK-DAG: fun extern mean_dim_keepdim
// CHECK-DAG: %tensor.map_reduce
fun extern mean_dim_keepdim(input: «2, 3, 4; %math.F32»): «2, 1, 4; %math.F32» =
    return (%torch.reduction.mean_dim_keepdim (%torch.resolve_floating %math.F32)
        @(3, (2, 3, 4)) (1I64) input);

// CHECK-DAG: fun extern mean_dims
// CHECK-DAG: %tensor.map_reduce
fun extern mean_dims(input: «2, 3, 4; %math.F32»): «3; %math.F32» =
    return (%torch.reduction.mean_dims (%torch.resolve_floating %math.F32)
        @(3, 2, (2, 3, 4)) ((0I64, 2I64)) input);

// CHECK-DAG: fun extern any_dims
// CHECK-DAG: %tensor.map_reduce
fun extern any_dims(input: «2, 3, 4; Bool»): «3; Bool» =
    return (%torch.reduction.any_dims @(3, 2, (2, 3, 4))
        ((0I64, 2I64)) input);

// CHECK-DAG: fun extern all_dims
// CHECK-DAG: %tensor.map_reduce
fun extern all_dims(input: «2, 3, 4; Bool»): «3; Bool» =
    return (%torch.reduction.all_dims @(3, 2, (2, 3, 4))
        ((0I64, 2I64)) input);

lam extern _compile (): %compile.Phase =
    %compile.phases ff (
        %torch.lower_torch,
        %compile.cleanup,
    );
