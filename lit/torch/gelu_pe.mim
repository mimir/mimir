// RUN: %mim %s -o - | %FileCheck %s --implicit-check-not=%%torch.
// RUN: %mim %s --profile summary | %FileCheck %s --check-prefix=PROFILE

plugin torch;
plugin compile;

// PyTorch's default exact GELU selects the erf formula statically.
fun extern gelu_exact(input: «2, 4; %math.F32»): «2, 4; %math.F32» =
    return (%torch.activation.gelu (%torch.resolve_floating %math.F32)
        @(2, (2, 4)) (ff, input));

// `approximate="tanh"` selects the tanh formula statically.
fun extern gelu_tanh(input: «2, 4; %math.F32»): «2, 4; %math.F32» =
    return (%torch.activation.gelu (%torch.resolve_floating %math.F32)
        @(2, (2, 4)) (tt, input));

// CHECK-LABEL: fun extern gelu_exact
// CHECK: %math.er.f
// CHECK-NOT: %math.tri.
// CHECK-LABEL: fun extern gelu_tanh
// CHECK: %math.tri.
// CHECK-NOT: %math.er.f

// PROFILE: Phase counters:
// PROFILE-DAG: 2 %torch.lower_torch: decompose.impl.%torch.activation.gelu
lam extern _compile (): %compile.Phase =
    %compile.phases ff (
        %torch.lower_torch,
        %compile.internal_cleanup,
    );
