// RUN: %mim -p opt %s -o - | %FileCheck \
// RUN:   --implicit-check-not=%%torch. --implicit-check-not=Match %s

plugin torch;
plugin compile;

// CHECK-LABEL: fun extern elu
// CHECK: %tensor.map_reduce
fun extern elu(input: «2, 4; %math.F32»): «2, 4; %math.F32» =
    return (%torch.activation.elu (%torch.resolve_floating %math.F32)
        @(2, (2, 4))
        (input, 1.0:%math.F32, 1.0:%math.F32, 1.0:%math.F32));

// CHECK-LABEL: fun extern hardsigmoid
// CHECK: %tensor.map_reduce
fun extern hardsigmoid(input: «2, 4; %math.F32»): «2, 4; %math.F32» =
    return (%torch.activation.hardsigmoid (%torch.resolve_floating %math.F32)
        @(2, (2, 4)) input);

// CHECK-LABEL: fun extern selu
// CHECK: %tensor.map_reduce
fun extern selu(input: «2, 4; %math.F32»): «2, 4; %math.F32» =
    return (%torch.activation.selu (%torch.resolve_floating %math.F32)
        @(2, (2, 4)) input);

// CHECK-LABEL: fun extern softplus
// CHECK: %tensor.map_reduce
fun extern softplus(input: «2, 4; %math.F32»): «2, 4; %math.F32» =
    return (%torch.activation.softplus (%torch.resolve_floating %math.F32)
        @(2, (2, 4)) (input, 1.0:%math.F32, 20.0:%math.F32));

lam extern _compile (): %compile.Phase =
    %compile.phases ff (
        %torch.lower_torch,
        %compile.internal_cleanup,
    );
