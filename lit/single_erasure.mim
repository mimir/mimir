// RUN: %mim -p opt %s -o - | %FileCheck %s --implicit-check-not='‹' --implicit-check-not='«23»'
plugin core;

// A singleton is dropped from a sigma, which shifts the indices of its successors;
// the dependent reference to `x` must survive that shift.
extern lam dep (d: [x: Nat, s: «23», a: «x; I32»]): «(d#0₃); I32» = d#2₃;
// CHECK-DAG: extern lam dep (x: Nat, _{{[0-9]+}}: «x; I32»)

// A lone singleton has no sigma to vanish from and degrades to the unit type instead.
extern lam solo (s: «23»): Nat = #s;
// CHECK-DAG: extern lam solo (): Nat

// `«T»` sits at kind level, where there is no unit to degrade to.
extern lam only (T: *) (x: «T»): * = #x;
// CHECK-DAG: extern lam only (T: *) (_: *): *

// A whole pack of singletons collapses to the unit value.
extern lam pck (): «4; «23»» = ‹4; ‹23››;
// CHECK-DAG: extern lam pck (): [] =
// CHECK-DAG: ()

// Writing the sole inhabitant back is a no-op; a later index shifts down.
extern lam ins (t: [I32, «23», I32], v: I32): [I32, «23», I32] = t#2₃ ← v;
// CHECK-DAG: {{.*}}#tt ← v

// A lone case is isomorphic to its payload.
rec Box = | Box: Nat;
extern lam unbox (b: Box): Nat = match b with | Box n => n;
// CHECK-DAG: extern lam unbox (b: Nat): Nat =
extern lam mkbox (n: Nat): Box = Box#Box n;
// CHECK-DAG: extern lam mkbox (n: Nat): Nat =

// Without a payload the case carries no information and is dropped altogether.
extern lam tag (t: [I32, | Tag]): I32 = t#0₂;
// CHECK-DAG: extern lam tag (t{{.*}}: I32): I32 =

// A recursive lone case has no payload to erase to.
rec Loop = | Next: [Nat, Loop];
extern lam loop (l: Loop): Loop = l;
// CHECK-DAG: rec Loop = | _0: [Nat, Loop];
// CHECK-DAG: extern lam loop (l: Loop): Loop =
