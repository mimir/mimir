// RUN: %mim %s -p ll
// RUN: %FileCheck %s --check-prefix=LLVM < %{s:stem}.ll
plugin math;
plugin refly;

// Decimal float literals must be encoded with the bit width of their annotated type.
// The Tok stores the value as f64 bits; re-encoding these for math.F32 used to be forgotten,
// so the low 32 bits of the f64 pattern ended up in the Lit (0 for most values).

let _ = refly.equiv.struc_eq (1.0:(math.F32),        1065353216:(math.F32));
let _ = refly.equiv.struc_eq (1e-3:(math.F32),        981668463:(math.F32));
let _ = refly.equiv.struc_eq (128.0:(math.F (23, 8)), 1124073472:(math.F (23, 8)));
let _ = refly.equiv.struc_eq (1.0:(math.F64), 4607182418800017408:(math.F64));

// LLVM-DAG: ret float 0x3ff0000000000000
extern con f32_one(return: Cn math.F32) = return 1.0:(math.F32);

// LLVM-DAG: ret float 0x3f50624de0000000
extern con f32_em3(return: Cn math.F32) = return 1e-3:(math.F32);

// LLVM-DAG: ret float 0x4060000000000000
extern con f32_pe(return: Cn (math.F (23, 8))) = return 128.0:(math.F (23, 8));

// LLVM-DAG: ret double 0x3ff0000000000000
extern con f64_one(return: Cn math.F64) = return 1.0:(math.F64);
