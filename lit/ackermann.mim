// RUN: rm -f %t.ll
// RUN: %mim -p opt %s -p ll -X ll:o=%t.ll
// RUN: %FileCheck %s < %t.ll
// RUN: clang %t.ll -o %t -Wno-override-module
// RUN: %t ; test $? -eq 9
plugin core;
plugin compile;
plugin mem;

use core.ops.n;

// Only 2 of the 3 recursive calls forward `k`, so `compile.static_arg_opt` seeds the split with `k`,
// drops it from the loop, and routes the remaining call through the wrapper.
fun ack (m n: Nat): Nat =
    (m_ne_0, m_eq_0)#(m == 0) ()
    where
        con m_eq_0() = return (n + 1);

        con m_ne_0() =
            (n_ne_0, n_eq_0)#(n == 0) ()
            where
                con n_eq_0() =
                    ret res = ack $ (m - 1, 1);
                    return res;

                con n_ne_0() =
                    ret res = ack $ (m, n - 1);
                    ret res = ack $ (m - 1, res);
                    return res;
            end;
    end;

extern fun main(argc: I32, argv: mem.Ptr0 (mem.Ptr0 I8)): I32 =
    ret res = ack $ (2, 3);
    return (core.bitcast I32 res);

// Only the one call that builds a fresh continuation survives; the other two are jumps into the loop.
// CHECK-LABEL: define{{.*}}@ack
// CHECK:         call{{.*}}@ack
// CHECK-NOT:     call{{.*}}@ack
// CHECK:       }
