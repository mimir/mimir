// RUN: %mim %s --scalarize-threshold 2 -o %t.mim && %mim %t.mim --scalarize-threshold 2 -o - | %FileCheck %s
plugin core;

// Above the threshold, an array-typed Var prints whole, so its components must not print by name.
extern con f (i: Bool, rs: «2; Cn Nat») = (rs#0_2 1, rs#1_2 2)#i;

// CHECK: extern con f (i: Bool, [[V:[[:alnum:]_]+]]: «2; Cn Nat») as
// CHECK: [[V]]#ff 1;
// CHECK: [[V]]#tt 2;
