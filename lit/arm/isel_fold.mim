// RUN: %mim -p opt %s -p arm -X arm:o=- | %FileCheck %s

plugin core;
plugin mem;

/// A product that only the sum uses folds into it, in either order of the sum.
extern con madd (m: mem.M 0, a b c: I32, return: Cn [mem.M 0, I32]) =
    return (m, core.wrap.add 0 (c, core.wrap.mul 0 (a, b)));

/// A product with another user stays a `mul`.
extern con shared (m: mem.M 0, a b c: I32, return: Cn [mem.M 0, I32]) =
    let p = core.wrap.mul 0 (a, b);
    return (m, core.wrap.sub 0 (core.wrap.add 0 (p, c), p));

extern con nand (m: mem.M 0, a b: I32, return: Cn [mem.M 0, I32]) =
    return (m, core.bit2.nand 0 (a, b));

// CHECK: .globl madd
// CHECK-NOT: mul
// CHECK: madd {{w[0-9]+}}, {{w[0-9]+}}, {{w[0-9]+}}, {{w[0-9]+}}
// CHECK: .globl nand
// CHECK: and [[X:w[0-9]+]], {{w[0-9]+}}, {{w[0-9]+}}
// CHECK: eor {{w[0-9]+}}, [[X]], {{w[0-9]+}}
// CHECK: .globl shared
// CHECK: mul [[P:w[0-9]+]]
// CHECK-NOT: madd
// CHECK: add {{w[0-9]+}}, {{.*}}[[P]]
