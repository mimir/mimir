// RUN: %mim %s -o - | %FileCheck %s --implicit-check-not=Match

plugin option;

// CHECK-LABEL: extern fun unwrap_none
// CHECK: return_{{[0-9]+}} 7;
extern fun unwrap_none(): Nat =
    return (match (option.none Nat) with
        | value: Nat => value
        | _: [] => 7);

// The option library is a client of the same generic reduction: its lambda
// unfolds to a Match, which then dispatches on the known injection.
// CHECK-LABEL: extern fun unwrap_or_none
// CHECK: return_{{[0-9]+}} 7;
extern fun unwrap_or_none(): Nat =
    return (option.unwrap_or (option.none Nat) 7);

// CHECK-LABEL: extern fun unwrap_or_some
// CHECK: return_{{[0-9]+}} x_{{[0-9]+}};
extern fun unwrap_or_some(x: Nat): Nat =
    return (option.unwrap_or (option.some x) 7);

// CHECK-LABEL: extern fun unwrap_some
// CHECK: return_{{[0-9]+}} x_{{[0-9]+}};
extern fun unwrap_some(x: Nat): Nat =
    return (match (option.some x) with
        | value: Nat => value
        | _: [] => 7);
