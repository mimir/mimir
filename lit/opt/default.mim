// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p opt %s -p ll -o - | %FileCheck %s

import core;
import compile;
import opt;
plugin mem;

con f (m: mem.M 0, a: I32, return: Cn [mem.M 0, I32]) =
    return (m, a);

extern con main (m: mem.M 0, argc: I32, argv: mem.Ptr (mem.Ptr (I8, 0), 0), return: Cn [mem.M 0, I32]) =
    f (m, 42I32, return);

// CHECK-DAG: return{{.*}}42
