// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p opt -p clos -p math -o - -p ll %s
// RUN: clang %S/../lib.c %{s:stem}.ll -o %t -Wno-override-module
// RUN: %t 2 3 | %FileCheck %s

plugin core;
plugin matrix;

let MT1 = (2, (2, 4), %math.F64);

ccon print_int_matrix    [mem: %mem.M 0, k: Nat, l: Nat, m: %buffer.Buf (2, (⊤:Nat, ⊤:Nat), I32), return: Cn [%mem.M 0]];
ccon print_double_matrix [mem: %mem.M 0, k: Nat, l: Nat, m: %buffer.Buf (2, (⊤:Nat, ⊤:Nat), %math.F64), return: Cn [%mem.M 0]];

con print_int_matrix_wrap [mem: %mem.M 0, k: Nat, l: Nat, m: %buffer.Buf (2, (k, l), I32), return: Cn [%mem.M 0]] =
    let m2 = %core.bitcast (%buffer.Buf (2, (⊤:Nat, ⊤:Nat), I32)) m;
    print_int_matrix(mem, k, l, m2, return);

con print_double_matrix_wrap [mem: %mem.M 0, k: Nat, l: Nat, m: %buffer.Buf (2, (k, l), %math.F64), return: Cn [%mem.M 0]] =
    let m2 = %core.bitcast (%buffer.Buf (2, (⊤:Nat, ⊤:Nat), %math.F64)) m;
    print_double_matrix(mem, k, l, m2, return);

con extern main [mem: %mem.M 0, argc: I64, argv: %mem.Ptr (%mem.Ptr (I8, 0), 0), return: Cn [%mem.M 0, I32]] =
    let c = 42.0:%math.F64;
    let (mem, m1) = %buffer.constant MT1 (mem, c);
    print_double_matrix_wrap (mem, 2, 4, m1, return_cont)
    where
        con return_cont [mem:%mem.M 0] = return (mem, 0I32);
    end;

// CHECK: 42.00, 42.00, 42.00, 42.00,
// CHECK: 42.00, 42.00, 42.00, 42.00,
