// RUN: rm -f %t.ll
// RUN: %mim -p opt -o - %s | %FileCheck %s

plugin core;
plugin matrix;

fun identity(mem: %mem.M 0, a:   I32): [%mem.M 0, I32] = return (mem, a);
fun addition(mem: %mem.M 0, a b: I32): [%mem.M 0, I32] = return (mem, %core.wrap.add 0 (a, b));

fun extern f(mem: %mem.M 0, k l: Nat, M: %buffer.Buf (2, (k, l), I32)): [%mem.M 0, %buffer.Buf (2, (l, k), I32)] =
    let MT = %matrix.map_reduce ((l, k), (l, k))
        (addition, 0I32) //identity
        %affine.id
        (%matrix.proj_map (1, 0),)
        (mem, M);
    return MT;

// CHECK-NOT: %matrix.
