// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p opt %s -p ll --output-mim - | %FileCheck %s

plugin core;
plugin matrix;

con extern main [mem: %mem.M 0, argc: I32, argv: %mem.Ptr (%mem.Ptr (I8, 0), 0), return: Cn [%mem.M 0, I32]] =
    let MT = (2, (3, 3), I32);
    let c = 5I32;
    let (mem, m) = %buffer.constant MT (mem, c);
    let f = %buffer.read MT;
    let idx = ‹2; 0:(Idx 3)›;
    let (mem, d) = %buffer.read MT (mem, m, idx);
    return (mem, d);

// CHECK-DAG: return{{.*}}5
