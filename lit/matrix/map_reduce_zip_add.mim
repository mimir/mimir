// RUN: rm -f %t.ll
// RUN: %mim -p opt -o - %s  | %FileCheck %s

plugin core;
plugin matrix;


con extern g [[mem:%mem.M 0, acc:I32, [a:I32, b:I32]], return: Cn[%mem.M 0, I32]] =
    let v       = %core.wrap.add 0 (a, b);
    let new_acc = %core.wrap.add 0 (acc, v); // reduce op = addition
    return (mem, new_acc);

con extern f [mem: %mem.M 0,
    [k l:Nat],
    M:%buffer.Buf (2, (k, l), I32),
    return: Cn[%mem.M 0, %buffer.Buf (2, (k, l), I32)]] =
    let MT = M;
    let (mem, MT2) = %matrix.map_reduce
        (
            2, (k, l), I32,
            2,
            (2, 2),
            (I32, I32),
            ((k, l), (k, l))
        )
        (
            mem,
            0I32,
            g,
            (
                ((0, 1), M),
                ((0, 1), M)
            )
        )
        ;
    return (mem, MT);

// CHECK-NOT: %matrix.
