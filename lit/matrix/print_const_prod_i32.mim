// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p opt -p clos -o - -p ll %s
// RUN: clang %S/../lib.c %{s:stem}.ll -o %t -Wno-override-module
// RUN: %t | %FileCheck %s

plugin core;
plugin matrix;

let MT1 = (2, (2, 4), I32);
let MT2 = (2, (4, 3), I32);

/// `%matrix.product_2d` is ring-generic: the same axiom runs over `I32` with `%core.wrap` arithmetic.
let R: %matrix.Ring = (I32, 0I32, %core.wrap.add 0, %core.wrap.mul 0);

ccon print_int_matrix [mem: %mem.M 0, k l: Nat, m: %buffer.Buf (2, (⊤:Nat, ⊤:Nat), I32), return: Cn [%mem.M 0]];

con print_int_matrix_wrap (mem: %mem.M 0, k l: Nat, m: %buffer.Buf (2, (k, l), I32), return: Cn [%mem.M 0]) =
    let m2 = %core.bitcast (%buffer.Buf (2, (⊤:Nat, ⊤:Nat), I32)) m;
    print_int_matrix (mem, k, l, m2, return);

con extern main (mem: %mem.M 0, argc: I32, argv: %mem.Ptr (%mem.Ptr (I8, 0), 0), return: Cn [%mem.M 0, I32]) =
    con return_cont (mem: %mem.M 0) = return (mem, 0I32);
    let (mem, m1) = %buffer.constant MT1 (mem, 3I32);
    let (mem, m2) = %buffer.constant MT2 (mem, 5I32);
    let (mem, mP) = %matrix.product_2d R (mem, m1, m2);
    print_int_matrix_wrap (mem, 2, 3, mP, return_cont);

// CHECK: 60, 60, 60,
// CHECK: 60, 60, 60,
