// RUN: rm -f %t.ll
// RUN: %mim -p opt -o - %s

plugin core;
plugin matrix;


con inner_fun ((mem: %mem.M 0, acc: I32, (a b: I32)), return: Cn [%mem.M 0, I32]) =
    let v       = %core.wrap.mul 0 (a, b);
    let new_acc = %core.wrap.add 0 (acc, v); // reduce op = addition
    return (mem, new_acc);

con extern f(mem: %mem.M 0,
              (k l m: Nat),
              M: %buffer.Buf (2, (k, m), I32),
              N: %buffer.Buf (2, (m, l), I32),
              return: Cn [%mem.M 0, %buffer.Buf (2, (k, l), I32)]) =
    let (mem, MN) = %matrix.map_reduce
        (k, l)
        (
            mem,
            0I32,
            inner_fun,
            (
                ((0, 2), M),
                ((2, 1), N)
            )
        );
    return (mem, MN);

// CHECK-NOT: %matrix.
