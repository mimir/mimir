// RUN: (! %mim %s --output-h - --bootstrap 2>&1) | %FileCheck %s
// UNSUPPORTED: roundtrip

axm f: Nat → Nat, normalize_f;
axm g: Nat → Nat, normalize_g;
norm normalize_f (x: Nat): g x => x;

