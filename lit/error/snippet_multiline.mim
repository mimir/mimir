// RUN: (! %mim -p opt %s 2>&1) | %FileCheck %s

// Every row a Loc spans is underlined on the columns it covers there.
plugin core;

let id = λ [T: *] (x: T): T = x;
let n = id
        3;

// CHECK:      {{.*}}snippet_multiline.mim:7:9-8:9: error: argument is not assignable to callee's domain
