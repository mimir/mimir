// RUN: (! %mim -p opt %s 2>&1) | %FileCheck %s

// A `pub` alias exports a private `nom` as an abstract type; `#` stays private.
mod units
    nom Meter = I32;
    pub let Meter = Meter;

    pub lam to_i32 (m: Meter): I32 = #m;
end

extern lam ok (m: units.Meter): I32 = units.to_i32 m;
extern lam bad (m: units.Meter): I32 = #m;

// CHECK: {{.*}}nom_elim.mim:12:40-12:41: error: the representation of private nominal type `Meter` is only accessible within module `units`
// CHECK: {{.*}}nom_elim.mim:5:5-5:19: note: declared here
