// RUN: (! %mim -p opt %s 2>&1) | %FileCheck %s

// `Level` has no type at all, so it is no index; asking must report, not crash.
let x = (1I32, 2I32)#Level;

// CHECK:      {{.*}}level_index.mim:4:9-4:26: error: index must be of `Idx` type but is of type `<no type>`
// CHECK-NEXT: 4 | let x = (1I32, 2I32)#Level;
// CHECK-NEXT:   |         ^^^^^^^^^^^^^^^^^^
