// RUN: (! %mim %s 2>&1) | %FileCheck %s

// A local `nom` within a private declaration keeps its constructors private.
mod m
    lam Opt (T: *): * =
        nom O = | None | Some: T;
        O;

    pub lam some (x: Nat): Opt Nat = (Opt Nat)#Some x;
end

lam get (x: Nat): Nat = match m.some x with | None => 0 | Some y => y;

// CHECK: {{.*}}nom_ctor_scope.mim:12:25-12:69: error: the representation of private nominal type `O` is only accessible within module `m`
// CHECK: {{.*}}nom_ctor_scope.mim:6:9-6:32: note: declared here
