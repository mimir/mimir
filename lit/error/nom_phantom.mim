// RUN: (! %mim %s 2>&1) | %FileCheck %s

// A parameter tells two instances apart even if the representation ignores it.
plugin core;

nom Tagged (T: *) = Nat;

lam bad (x: Tagged Nat): Tagged Bool = x;

