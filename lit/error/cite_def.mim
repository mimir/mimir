// RUN: (! %mim -p opt %s 2>&1) | %FileCheck %s

// As above, but the backticks reach the message through the dumper.
lam `+ (x: Nat): Nat = x;
extern lam g (x: Nat): Nat = x + x;

// CHECK:      {{.*}}cite_def.mim:5:30-5:34: error: argument is not assignable to callee's domain
// CHECK:      {{.*}}cite_def.mim:4:1-4:24: note: callee ``+` declared here
