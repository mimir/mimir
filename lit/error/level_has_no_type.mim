// RUN: (! %mim -p opt %s 2>&1) | %FileCheck %s

// `Level` is the one Def without a type at all; asking for it must report, not crash.
let x = Level 3;

// CHECK:      {{.*}}level_has_no_type.mim:4:9-4:15: error: callee is not of function type
// CHECK-NEXT: 4 | let x = Level 3;
// CHECK-NEXT:   |         ^^^^^^^
// CHECK-NEXT:   = note: callee `Level` has type `<no type>`
