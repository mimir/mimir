// RUN: (! %mim -p opt %s 2>&1) | %FileCheck %s
plugin core;

// `shared`'s unannotated parameter `z` gets an inferred type that depends on an
// index variable bound in a sibling `con`. Since `shared` is called from both
// `left` and `right`, that variable escapes and `foo` cannot be closed.
// This must be reported as a proper error instead of aborting via an assertion.
fun extern foo (b: Bool) = (left, right)#b (3, 0_3) where
  con left  (n: Nat, x: Idx n) = shared x;
  con right (m: Nat, y: Idx m) = shared y;
  con shared (z)               = return 0;
end;
// CHECK: error: external function 'foo' is not closed
