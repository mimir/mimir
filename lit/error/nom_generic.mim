// RUN: (! %mim -p opt %s 2>&1) | %FileCheck %s

// An instance of a `nom` is as private as its declaration.
mod units
    pub lam Box (T: *) =
        nom B = T;
        B;
end

extern lam bad (b: units.Box I32): I32 = #b;

// CHECK: {{.*}}nom_generic.mim:10:42-10:43: error: `inj` and `#` on nominal type `B` are only allowed within module `units`
// CHECK: {{.*}}nom_generic.mim:6:9-6:17: note: declared here
