// RUN: (! %mim -p opt %s 2>&1) | %FileCheck %s

// An instance of a `nom` is as private as its declaration, even through a `pub` alias of its type constructor.
mod units
    lam Box (T: *) =
        nom B = T;
        B;
    pub let Box = Box;
end

extern lam bad (b: units.Box I32): I32 = #b;

// CHECK: {{.*}}nom_generic.mim:11:42-11:43: error: the representation of private nominal type `B` is only accessible within module `units`
// CHECK: {{.*}}nom_generic.mim:6:9-6:17: note: declared here
