// RUN: (! %mim -p opt %s 2>&1) | %FileCheck %s

axm %foo.T: [Nat → Nat] → *;
axm %foo.t: [f: Nat → Nat] → %foo.T f;

lam f(x: Nat): [] =
    lam g(y: Nat): Nat = y;
    lam h(z: Nat): Nat = x;

    lam i(_: %foo.T g): [] = ();

    let x = %foo.t h;
    i x;

// CHECK: {{.*}}var.mim:13:5-13:7: error: argument is not assignable to callee's domain
// CHECK-NEXT: 13 |     i x;
// CHECK-NEXT:    |     ^^^
// CHECK-NEXT:    = note: expected `%foo.T g`, got `%foo.T h`
// CHECK: = note: callee `i` declared at {{.*}}var.mim:10:5-10:31
