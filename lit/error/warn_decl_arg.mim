// RUN: %mim -p opt %s 2>&1 | %FileCheck %s

// A warning renders like an error: snippet plus its notes indented underneath.
plugin core;

lam g(x: Nat): Nat = x;
let y = g let z = 3; z;

// A note with a Loc of its own gets a header line; one about the primary Loc stays a `=` continuation.
// Both located notes point into row 7, which the snippet above already shows, so neither repeats it.
// CHECK:      1 warning(s) encountered
// CHECK-NEXT: {{.*}}warn_decl_arg.mim:7:11-7:13: warning: you are passing a declaration expression as argument
// CHECK-NEXT: 7 | let y = g let z = 3; z;
// CHECK-NEXT:   |           ^^^
// CHECK-NEXT:   {{.*}}warn_decl_arg.mim:7:9: note: passed to this expression
// CHECK-NEXT:   = note: if this was your intention, consider parenthesizing the declaration expression
// CHECK-NEXT:   {{.*}}warn_decl_arg.mim:7:10: note: otherwise, you are probably missing a `;`
