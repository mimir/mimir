// RUN: %mim -p opt %s 2>&1 | %FileCheck %s

// A warning renders like an error: snippet plus its notes indented underneath.
plugin core;

lam g(x: Nat): Nat = x;
let y = g let z = 3; z;

// A note with a Loc of its own gets a header line and a snippet; one without stays a `=` continuation.
// Both Loc%s sit on row 7, but each carries a different caret, so each is shown.
// CHECK:      {{.*}}warn_decl_arg.mim:7:11-7:13: warning: you are passing a declaration expression as argument
// CHECK-NEXT: 7 | let y = g let z = 3; z;
// CHECK-NEXT:   |           ^^^
// CHECK-NEXT:   {{.*}}warn_decl_arg.mim:7:9: note: passed to this expression
// CHECK-NEXT: 7 | let y = g let z = 3; z;
// CHECK-NEXT:   |         ^
// CHECK-NEXT:   = note: if this was your intention, consider parenthesizing the declaration expression
// CHECK-NEXT:   {{.*}}warn_decl_arg.mim:7:10: note: or insert a `;` here
// CHECK-NEXT: 7 | let y = g let z = 3; z;
// CHECK-NEXT:   |          ^
// CHECK-NEXT: 1 warning(s) encountered
