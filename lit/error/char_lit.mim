// RUN: (! %mim %s 2>&1) | %FileCheck %s

// A malformed literal yields exactly one error regardless of its length.
let a = 'ab';
let b = 'abcd';
let c = 'a\'b';
let d = '';
let e = ''';
let f = 'a;

// CHECK:      {{.*}}char_lit.mim:4:9-4:12: error: character literal must contain exactly one character
// CHECK:      {{.*}}char_lit.mim:5:9-5:14: error: character literal must contain exactly one character
// CHECK:      {{.*}}char_lit.mim:6:9-6:14: error: character literal must contain exactly one character
// CHECK:      {{.*}}char_lit.mim:7:9-7:10: error: empty character literal
// CHECK:      {{.*}}char_lit.mim:8:9-8:11: error: character constant must be escaped: `\'`
// CHECK:      {{.*}}char_lit.mim:9:9-9:11: error: unterminated character literal
// CHECK:      6 error(s) encountered
