// RUN: (! %mim %s 2>&1) | %FileCheck %s

// An Arr peels to an element type at *any* index, so the value is checked even for an opaque one.
extern lam f (n: Nat, t: «n; Nat», x: Idx n, v: Bool): «n; Nat» = t#x ← v;

// CHECK: {{.*}}insert_value_opaque.mim:4:67-4:73: error: value is not assignable to element type
// CHECK-NEXT: 4 | extern lam f (n: Nat, t: «n; Nat», x: Idx n, v: Bool): «n; Nat» = t#x ← v;
// CHECK-NEXT:   |                                                                  ^^^^^^^
// CHECK-NEXT:   = note: expected `Nat`, got `Bool`
