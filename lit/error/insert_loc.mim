// RUN: (! %mim -p opt %s 2>&1) | %FileCheck %s

// The Loc of an insert must cover the whole expression, not just the offending operand.
plugin core;

let t = (1I32, 2I32);
let u = t#0I2 ← 7I32;

// CHECK:      {{.*}}insert_loc.mim:7:9-7:20: error: index `0₄` does not fit within arity `2`
// CHECK-NEXT: 7 | let u = t#0I2 ← 7I32;
// CHECK-NEXT:   |         ^^^^^^^^^^^^
