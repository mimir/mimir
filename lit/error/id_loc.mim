// RUN: (! %mim --bootstrap %s 2>&1) | %FileCheck %s

// `Test s s` in a pattern position is parsed as a curried application; the inner
// application must end at its own argument instead of spanning the whole run.
let Test = lm (a: Nat) (b: Nat): * = Nat;
let s = *;
mod test { axm foo: {Test s s} → []; }

// CHECK:      {{.*}}id_loc.mim:7:22-7:27: error: argument is not assignable to callee's domain
// CHECK-NEXT: 7 | mod test { axm foo: {Test s s} → []; }
// CHECK-NEXT:   |                      ^^^^^^
