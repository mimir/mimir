// RUN: %mim %s -o - | %FileCheck %s
plugin compile;

lam f_known     (x: Nat)@ff: Nat = x;
lam f_unknown_1 (x: Nat)@ff: Nat = x;
lam f_unknown_2 (x: Nat)@ff: Nat = x;
lam f_both      (x: Nat)@ff: Nat = x;

lam take1 (f: Nat → Nat)@ff: Nat = f 23;
lam take2 (f: Nat → Nat)@ff: Nat = f 23;

extern lam foo(): «6; Nat» =
    let a = f_known 42;
    let b = take1 f_unknown_1;
    let c = take1 f_unknown_2;
    let d = take2 f_unknown_2;
    let e = f_both 42;
    let f = take1 f_both;
    (a, b, c, d, e, f);

extern lam _compile(): compile.Phase =
    compile.eta_conv;

// CHECK-NOT:  eta_f_known
// CHECK-NOT:  eta_f_unknown_1
// CHECK-DAG:  (f_known 42, take1 f_unknown_1, take1 [[ETA1:[[:alnum:]_]+]], take2 [[ETA2:[[:alnum:]_]+]], [[FBOTH:[[:alnum:]_]+]] 42, take1 [[ETAB:[[:alnum:]_]+]]);
// CHECK-DAG:  lam [[ETA1]] ([[V1:[[:alnum:]_]+]]: Nat): Nat =
// CHECK-DAG:  f_unknown_2 [[V1]];
// CHECK-DAG:  lam [[ETA2]] ([[V2:[[:alnum:]_]+]]: Nat): Nat =
// CHECK-DAG:  f_unknown_2 [[V2]];
// CHECK-DAG:  lam [[ETAB]] ([[V3:[[:alnum:]_]+]]: Nat): Nat =
// CHECK-DAG:  [[FBOTH]] [[V3]];
// CHECK-NOT:  eta_f_known
// CHECK-NOT:  eta_f_unknown_1
