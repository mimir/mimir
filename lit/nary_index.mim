// RUN: %mim -p opt %s

// A multi-dimensional index is one fused Extract/Insert: `t#i#j#k` ≡ `t#(i, j, k)`, mirroring the fused
// shape of `«2, 3, 4; T»`. Components still peel off one by one wherever that folds something away.

plugin refly;

let m  = ((1, 2, 3), (4, 5, 6));
let sq = ((1, 2), (3, 4));

// ## Literal aggregates

// rank 0 and rank 1 are the degenerate ends
let _ = refly.equiv.struc_eq (m#(), m);
let _ = refly.equiv.struc_eq (m#(1₂), m#1₂);

// a tuple index and the `#`-chain it stands for agree - and both fold
let _ = refly.equiv.struc_eq (m#(1₂, 2₃), m#1₂#2₃);
let _ = refly.equiv.struc_eq (m#(1₂, 2₃), 6);

// a pack index applies its body at every level
let _ = refly.equiv.struc_eq (sq#‹2; 1₂›, 4);

// ## Inserts on literals

let _ = refly.equiv.struc_eq (m#(1₂, 2₃) ← 99, m#1₂#2₃ ← 99);
let _ = refly.equiv.struc_eq (m#(1₂, 2₃) ← 99, ((1, 2, 3), (4, 5, 99)));
let _ = refly.equiv.struc_eq (m#() ← ((7, 8, 9), (10, 11, 12)), ((7, 8, 9), (10, 11, 12)));

// ## Opaque index, known rank

// the index type may be a Sigma ...
extern lam sigma_index (is: [Idx 2, Idx 3], t: «2, 3; Nat»): Nat =
    refly.equiv.struc_eq (t#is, t#(is#0_2)#(is#1_2));

// ... or an Arr
extern lam arr_index (is: «2; Idx 2», t: «2, 2; Nat»): Nat =
    refly.equiv.struc_eq (t#is, t#(is#0_2)#(is#1_2));

extern lam rank_4 (is: «4; Idx 2», t: «2, 2, 2, 2; Nat»): Nat =
    refly.equiv.struc_eq (t#is, t#(is#0_4)#(is#1_4)#(is#2_4)#(is#3_4));

// a 1-tuple index is the index itself, so it splices into a longer path
extern lam splice (i: Idx 2, j: Idx 3, t: «2, 3; Nat»): Nat =
    refly.equiv.struc_eq (t#(i)#j, t#(i, j));

extern lam pack_index (i: Idx 2, t: «2, 2; Nat»): Nat =
    refly.equiv.struc_eq (t#‹2; i›, t#i#i);

// ## Inserts with an opaque index

extern lam insert_chain (is: [Idx 2, Idx 3], v: Nat, t: «2, 3; Nat»): «2, 3; Nat» =
    refly.equiv.struc_eq (t#is ← v, t#(is#0_2)#(is#1_2) ← v);

extern lam insert_read_back (is: [Idx 2, Idx 3], v: Nat, t: «2, 3; Nat»): Nat =
    refly.equiv.struc_eq ((t#is ← v)#is, v);

extern lam insert_twice (a b: Nat, t: «2, 3; Nat»): «2, 3; Nat» =
    refly.equiv.struc_eq ((t#(0₂, 0₃) ← a)#(0₂, 1₃) ← b, (t#0₂#0₃ ← a)#0₂#1₃ ← b);

// Writing back a sub-array that was read out collapses into one maximal-rank Insert.
// The `let` is load-bearing: it keeps the frontend from fusing the `#`-path before World::insert sees it.
extern lam insert_read_modify_write (m n: Nat, t: «m, n; Nat», x: Idx m, y: Idx n, v: Nat): «m, n; Nat» =
    let s = t#x;
    refly.equiv.struc_eq (t#x ← (s#y ← v), t#(x, y) ← v);

// as above, but the outer write is itself a *fused* index
extern lam insert_read_modify_write_fused (m n o: Nat, t: «m, n, o; Nat», x: Idx m, y: Idx n, z: Idx o, v: Nat)
: «m, n, o; Nat» =
    let s = t#(x, y);
    refly.equiv.struc_eq (t#(x, y) ← (s#z ← v), t#(x, y, z) ← v);

// ## Type-level corner cases

// a size-1 axis collapses out of `«2, 1, 3; Nat»`, so its index component is a no-op
extern lam size_1 (t: «2, 1, 3; Nat»): Nat =
    refly.equiv.struc_eq (t#(1₂, 0₁, 2₃), t#1₂#2₃);

// the levels need not be homogeneous - here an Arr of Sigmas
extern lam hetero (t: «2; [Nat, Bool]»): Bool =
    refly.equiv.struc_eq (t#(1₂, 1₂), t#1₂#1₂);

extern lam distinct (t: «2, 3; Nat»): Nat =
    refly.equiv.struc_ne (t#(0₂, 0₃), t#(0₂, 1₃));

// ## Dependent tuple types (*mutable* sigmas in IR terms)

// A `rec`-declared sigma is nominal, so a one-component one stays a genuine 1-tuple instead of degrading to
// its sole element. `#0₁` is therefore a real Extract - and a fused index still folds that axis away, which
// makes this the one place where `t#(i, j)` and `t#i#j` part ways.
rec One = [x: Nat];

extern lam one_fused (t: «2; One»): One = refly.equiv.struc_eq (t#(1₂, 0₁), t#1₂);
extern lam one_chain (t: «2; One»): Nat = refly.equiv.struc_ne (t#1₂#0₁, t#1₂);
extern lam one_differs (t: «2; One»): Nat = refly.equiv.struc_ne (t#(1₂, 0₁), t#1₂#0₁);

// the insert side still agrees: writing the field rebuilds the whole 1-tuple either way
extern lam one_insert (t: «2; One», v: Nat): «2; One» =
    refly.equiv.struc_eq (t#(1₂, 0₁) ← v, t#1₂#0₁ ← v);

// an *immutable* one-component sigma is no 1-tuple at all, so both spellings agree
extern lam imm_agrees (t: «2; [Nat]»): Nat = refly.equiv.struc_eq (t#(1₂, 0₁), t#1₂#0₁);

// ## Dynamic rank

// a dynamic rank works the same way - nothing about it is special any more
extern lam dynamic_read_back (n: Nat, s: «n; Nat», is: «j: n; Idx (s#j)», v: Nat, t: «s; Nat»): Nat =
    refly.equiv.struc_eq ((t#is ← v)#is, v);

// a different index does not bypass the insert
extern lam dynamic_distinct (n: Nat, s: «n; Nat», is js: «j: n; Idx (s#j)», v: Nat, t: «s; Nat»): Nat =
    refly.equiv.struc_ne ((t#is ← v)#js, v);
