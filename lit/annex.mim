// RUN: %mim %s --output-h - --bootstrap | %FileCheck %s

plugin math;

pub mod Vec3 {
    anx let xyz = [x: math.F64, y: math.F64, z: math.F64];
    anx let rgb = [r: math.F64, g: math.F64, w: math.F64];
    anx rec rpi = xyz → rpi;
    anx let zero = 0;
    anx lam unit (i: Idx 3): xyz =
        (xyz (1.0:math.F64, 0.0:math.F64, 0.0:math.F64),
         xyz (0.0:math.F64, 1.0:math.F64, 0.0:math.F64),
         xyz (0.0:math.F64, 0.0:math.F64, 1.0:math.F64)
        )#i;
}


// CHECK: zero = 0x8f3c66400000003
// CHECK: unit = 0x8f3c66400000004
// CHECK-NOT: unit = 0x8f3c66400000005
