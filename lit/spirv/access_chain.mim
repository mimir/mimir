// RUN: %mim %s --output-spirv - | %FileCheck %s

plugin mem;
plugin spirv;

let var = %spirv.variable %spirv.storage.PRIVATE () [Nat, «5; «3; Nat»»];
let out = %spirv.variable %spirv.storage.OUTPUT () Nat;

fun extern main [
    mem: %mem.M 0,
    model: %spirv.entry %spirv.model.compute (),
] = let (mem_, val) = %spirv.load (mem, %spirv.access_chain (ff, ff, ff) (1_2, 2_5, 1_3) var);
    return (%spirv.store (mem_, out, val));

// CHECK: OpEntryPoint GLCompute
// CHECK: OpAccessChain
// CHECK: OpLoad
// CHECK: OpStore
