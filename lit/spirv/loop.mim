import mem;
import scf;
import spirv;
import vec;

let F32 = %math.F32;

let positions = (
    (0.0:F32, -0.5:F32),
    (0.5:F32, 0.5:F32),
    (-0.5:F32, 0.5:F32),
);

let colors = (
    (1.0:F32, 0.0:F32, 0.0:F32),
    (0.0:F32, 1.0:F32, 0.0:F32),
    (0.0:F32, 0.0:F32, 1.0:F32),
);

lam vertex_body (vert_id: Idx 3): [«4; F32», «3; F32»]
    = (%vec.cat (positions#vert_id, (0.0:F32, 1.0:F32)), colors#vert_id);

lam fragment_body [color: «3; F32»]: «4; F32»
    = (%vec.cat (color, 1.0:F32));

let v_color = %spirv.output (%spirv.decor.location 0) «3; F32»;

let i_color = %spirv.input (%spirv.decor.location 0) «3; F32»;
let f_color = %spirv.output (%spirv.decor.location 0) «4; F32»;

fun extern vertex [
    mem: %mem.M 0,
    model: %spirv.entry %spirv.model.vertex (),
] = let (mem_, vertex_id) = %spirv.load (mem, %spirv.vertex_id model);
    let (position, color) = vertex_body (%core.bitcast (Idx 3) vertex_id);
    let mem__ = %spirv.store (mem_, %spirv.position model, position);
    return (%spirv.store (mem__, v_color, color));

// fragment uses the structured (con-style) function shape: the return
// continuation is a %scf.Ret parameter consuming a token, while vertex
// above deliberately keeps the raw fun-style CPS return.
con extern fragment [
    mem: %mem.M 0,
    model: %spirv.entry %spirv.model.fragment %spirv.mode.origin_upper_left,
    path: %scf.Path,
    step: %scf.Step,
    token: %scf.Token path step,
    return: %scf.Ret (%mem.M 0),
] = let (mem_, color) = %spirv.load (mem, i_color);
    %scf.header token loop 5 where
        con loop (i: Nat, struct) =
            %scf.loop struct break body () where
            con body (_: [], struct, tok) = %scf.if tok exit (do_break, do_continue) (%core.ncmp.e (i, 0)) () where
                con exit (_: [], tok) = %scf.break.l tok struct ();
                con do_break (_: [], _, tok) = %scf.break.l tok struct ();
                con do_continue (_: [], _, tok) = %scf.continue tok struct (%core.nat.sub (i, 1));
            end;
        end;
        con break (_: [], tok) =
            return tok (%spirv.store (mem_, f_color, fragment_body color));
    end;
