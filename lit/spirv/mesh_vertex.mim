// RUN: %mim %s --output-spirv - | %FileCheck %s

// Vertex+fragment pair for the Vulkan harness's "mesh" mode: real vertex
// buffer input (not a hardcoded constant table) and a push-constant camera
// transform. Vertex attribute layout (must match the harness's
// VkVertexInputAttributeDescription array exactly):
//   location 0: position (vec3)
//   location 1: normal   (vec3)

import mem;
import spirv;
import vec;
import math;

let F32 = %math.F32;

// Push-constant block: `mvp` (mat4, for both gl_Position and, as an
// approximation, transforming normals -- a real engine would use a separate
// inverse-transpose normal matrix, but that's not the point of this test)
// + `time` (a scalar). Two *differently*-typed fields, deliberately: a
// single-field block collapses to its bare element (Mim's arity-1 Sigma
// rule), and -- found the hard way -- a two-field block where both fields
// share the same type *also* collapses, to a plain array instead of a
// struct (same underlying "uniform Sigma is an Arr" identity, just
// triggered by same-typed fields instead of a single field). Either way the
// struct wrapper Block/MemberDecorate need would silently vanish.
let push = %spirv.variable %spirv.storage.PUSH_CONSTANT
    (%spirv.decorc.block,
     %spirv.decor_member 0 (%spirv.decor.offset 0),
     %spirv.decor_member 0 %spirv.decorc.col_major,
     %spirv.decor_member 0 (%spirv.decor.matrix_stride 16),
     %spirv.decor_member 1 (%spirv.decor.offset 64))
    [mvp: «4; «4; F32»», time: F32];

let i_position = %spirv.input (%spirv.decor.location 0) «3; F32»;
let i_normal   = %spirv.input (%spirv.decor.location 1) «3; F32»;
// The vertex-out/fragment-in normal interpolant needs its own location,
// distinct from the vertex stage's own attribute locations (0/1) above: two
// `%spirv.input`/`%spirv.variable` calls with identical (storage class,
// decoration, type) arguments hash-cons into the very same Def, so reusing
// location 0 here would accidentally alias this with `i_position` (both
// INPUT, vec3) even though they belong to different entry points.
let o_normal   = %spirv.output (%spirv.decor.location 2) «3; F32»;

fun extern vertex [
    mem: %mem.M 0,
    model: %spirv.entry %spirv.model.vertex (),
] = let (mem, position) = %spirv.load (mem, i_position);
    let (mem, normal) = %spirv.load (mem, i_normal);
    let (mem, pc) = %spirv.load (mem, push);
    let mvp = pc#(0:(Idx 2));
    let clip_position = %spirv.mat_vec_mul (mvp, %vec.cat (position, 1.0:F32));
    let world_normal = %spirv.mat_vec_mul (mvp, %vec.cat (normal, 0.0:F32));
    let mem = %spirv.store (mem, o_normal, (world_normal#(0:(Idx 4)), world_normal#(1:(Idx 4)), world_normal#(2:(Idx 4))));
    return (%spirv.store (mem, %spirv.position model, clip_position));

let i_frag_normal = %spirv.input (%spirv.decor.location 2) «3; F32»;
let o_color       = %spirv.output (%spirv.decor.location 0) «4; F32»;

fun extern fragment [
    mem: %mem.M 0,
    model: %spirv.entry %spirv.model.fragment %spirv.mode.origin_upper_left,
] = let (mem, normal) = %spirv.load (mem, i_frag_normal);
    // simple normal-visualization shading: color = normal * 0.5 + 0.5
    let half = 0.5:F32;
    let r = %math.arith.add 0 (%math.arith.mul 0 (normal#(0:(Idx 3)), half), half);
    let g = %math.arith.add 0 (%math.arith.mul 0 (normal#(1:(Idx 3)), half), half);
    let b = %math.arith.add 0 (%math.arith.mul 0 (normal#(2:(Idx 3)), half), half);
    return (%spirv.store (mem, o_color, (r, g, b, 1.0:F32)));

// CHECK-DAG: OpEntryPoint Vertex
// CHECK-DAG: OpEntryPoint Fragment
// CHECK-DAG: OpMatrixTimesVector
// CHECK-DAG: OpFMul
// CHECK-DAG: OpFAdd
