// RUN: %mim %s -o - | FileCheck %s
plugin core;
plugin tuple;

lam idx {n: Nat} (v: Nat): Idx n = %core.idx n %core.mode.US v;

/// copy of internal `make_Ts` from src/mim/plug/spirv/spirv.mim
lam make_Ts
    (levels: Nat,
     ns: «levels; Nat»,
     uni: «levels; Bool»,
     indices: «i: levels; Idx (ns#i)»)@(%core.ncmp.g (levels, 0))
  : □
  = let fst = idx 0;
    let done = (%core.ncmp.le (levels, 1));
    let Rec = make_Ts (%core.nat.sub (levels, 1), %tuple.tail ns, %tuple.tail uni, %tuple.tail @ levels @ ‹i: levels; Idx (ns#i)› indices);
    lam dependent (i: Idx (ns#fst)): □ = (★, Rec)#(%core.icmp.e (i, indices#fst));
    lam uniform   (i: Idx (ns#fst)): □ = Rec;
    lam final     (i: Idx (ns#fst)): □ = ★;
    «i: ns#fst; (((dependent, uniform)#(uni#fst), final)#done) i»;

/// 1 level: indices (1_3) over ns (3,)
lam extern t1 () = make_Ts (1, (3,), (ff,), (1_3,));

/// 2 levels: indices (1_3, 0_2) over ns (3, 2)
lam extern t2 () = make_Ts (2, (3, 2), (ff, ff), (1_3, 0_2));

/// 3 levels: indices (0_3, 1_3, 1_2) over ns (3, 3, 2) (matches doc example)
lam extern t3 () = make_Ts (3, (3, 3, 2), (ff, ff, ff), (0_3, 1_3, 1_2));

/// uniform level: open index with uni = tt
lam extern t1_var (i: Idx 3) = make_Ts (1, (3,), (tt,), (i,));

lam extern t2_var (i: Idx 3, j: Idx 2) = make_Ts (2, (3, 2), (tt, tt), (i, j));

/// levels=3 with middle level uniform: open middle index fine, type fully determined
lam extern t3_mid (i: Idx 3) = make_Ts (3, (3, 3, 2), (ff, tt, ff), (0_3, i, 1_2));

// CHECK: t1_var
// CHECK-NEXT: «3; *»
// CHECK: t2_var
// CHECK-NEXT: «3; «2; *»»
// CHECK: t3_mid
// CHECK-NEXT: [«3; «2; *»», *, *]
// CHECK: t2 ()
// CHECK-NEXT: [*, «2; *», *]
// CHECK: t3 ()
// CHECK-NEXT: {{\[\[}}*, «2; *», *], *, *]
// CHECK: t1 ()
// CHECK-NEXT: «3; *»
