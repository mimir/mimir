// RUN: %mim %s -o - | %FileCheck %s
plugin core;

nom Meter = I32;
nom Foot  = I32;
anx nom Kelvin = I32;

mod units
    pub nom Second = I32;

    extern lam tick (s: Second): I32 = #s;
end

nom List = | Nil | Cons: [I32, List];
mutual
    nom Even = | Zero | ESucc: Odd;
    nom Odd  = | OSucc: Even;
end

// A `nom` is opaque: only `inj`/`#` cross between it and its underlying type.
extern lam add (a b: Meter): Meter = (core.wrap.add 0 (#a, #b)) inj Meter;

// Distinct `nom`s over the same type do not unify.
extern lam convert (f: Foot): Meter = #f inj Meter;

extern lam kelvin (x: I32): Kelvin = x inj Kelvin;
extern lam list (l: List): List = l;

// An instance of a `nom` keeps the names of its declaration.
lam Opt (T: *) =
    nom O = | None | Some: T;
    O;
lam Pt (T: *) =
    nom P = [x: T, y: T];
    P;

extern lam get (o: Opt I32, p: Pt I32): I32 =
    match #o with
        | None   => (#p)#y
        | Some n => n;

// A `nom` over a variant has constructors; nested names survive the instantiation, too.
lam Seq (T: *) =
    nom S = | Nil | Cons: [head: T, tail: S];
    S;
lam Box (T: *) =
    nom B = [inner: [a: T, b: Bool], tag: Nat];
    B;

let SN = Seq Nat;

extern lam seq (): Nat =
    match #(SN#Cons (1, SN#Cons (2, SN#Nil))) with
        | Nil    => 0
        | Cons c => c#head;

extern lam unbox (x: Box Nat): Bool = ((#x)#inner)#b;

// Within `mutual`, a `nom` without a mutable body may be referred to ahead of it.
mutual
    nom Tree   = [Nat, Forest];
    nom Forest = Tree;
end

extern lam forest (f: Forest): Forest = f;

mutual
    anx nom Root  = [Nat, Roots];
    anx nom Roots = Root;
end

extern lam roots (r: Roots): Roots = r;

mutual
    anx nom Red   = | RLeaf | RNode: Black;
    anx nom Black = | BLeaf | BNode: Red;
end

extern lam red (r: Red): Red = r;
extern lam even (e: Even): Even = e;

extern lam vec (n: Nat): * =
    nom Vec = «n; Nat»;
    Vec;

// CHECK:      anx nom Kelvin = I32;
// CHECK-NEXT: mutual
// CHECK-NEXT:     anx nom Root = [Nat, Roots];
// CHECK-NEXT:     anx nom Roots = Root;
// CHECK-NEXT: end
// CHECK-NEXT: mutual
// CHECK-NEXT:     anx nom Red = | {{.*}}: Black;
// CHECK-NEXT:     anx nom Black = | {{.*}}: Red;
// CHECK-NEXT: end
// CHECK-DAG: nom Meter = I32;
// CHECK-DAG: nom Foot = I32;
// CHECK-DAG: nom Second = I32;
// CHECK-DAG: nom List = | {{.*}}: [I32, List];
// CHECK-DAG: extern lam add (a: Meter, b: Meter){{.*}}: Meter =
// CHECK-DAG: extern lam convert (f: Foot): Meter =
// CHECK-DAG:     #f inj Meter;
// CHECK-DAG: extern lam tick (s: Second): I32 =
// CHECK-DAG:     #s;
// CHECK-DAG: extern lam kelvin (x: I32): Kelvin =
// CHECK-DAG: extern lam get (o: O, p: P){{.*}}: I32 =
// CHECK-DAG: extern lam seq (): Nat =
// CHECK-DAG: extern lam unbox ({{.*}}: B): Bool =
// CHECK-DAG: mutual
// CHECK-DAG:     nom Even = | {{.*}}: Odd;
// CHECK-DAG:     nom Odd = | {{.*}}: Even;
// CHECK-DAG:     nom Tree = [Nat, Forest];
// CHECK-DAG:     nom Forest = Tree;
// CHECK-DAG: extern lam vec ({{.*}}: Nat): * =
// CHECK-DAG:     nom Vec = «{{.*}}; Nat»;
