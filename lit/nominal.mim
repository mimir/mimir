// RUN: %mim %s -o - | %FileCheck %s
plugin core;

nom Meter = I32;
nom Foot  = I32;
anx nom Kelvin = I32;

mod units {
    pub nom Second = I32;

    extern lam tick (s: Second): I32 = #s;
}

nom List = | Nil | Cons: [I32, List];
// The dump has no `and` groups yet, so nothing may reach this pair.
nom Even = | Zero | ESucc: Odd
and nom Odd = | OSucc: Even;

// A `nom` is opaque: only `inj`/`#` cross between it and its underlying type.
extern lam add (a b: Meter): Meter = (core.wrap.add 0 (#a, #b)) inj Meter;

// Distinct `nom`s over the same type do not unify.
extern lam convert (f: Foot): Meter = #f inj Meter;

extern lam kelvin (x: I32): Kelvin = x inj Kelvin;
extern lam list (l: List): List = l;

// CHECK-DAG: anx nom Kelvin = I32;
// CHECK-DAG: nom Meter = I32;
// CHECK-DAG: nom Foot = I32;
// CHECK-DAG: nom Second = I32;
// CHECK-DAG: nom List = (| {{.*}}: [I32, List]);
// CHECK-DAG: extern lam add (a: Meter, b: Meter){{.*}}: Meter =
// CHECK-DAG: extern lam convert (f: Foot): Meter =
// CHECK-DAG:     #f inj Meter;
// CHECK-DAG: extern lam tick (s: Second): I32 =
// CHECK-DAG:     #s;
// CHECK-DAG: extern lam kelvin (x: I32): Kelvin =
