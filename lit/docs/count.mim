// RUN: %mim -p ll %s
plugin core;

use core.ops.u.w;

extern fun count(n: I32): I32 =
    loop (0I32, 0I32)
    where
        con loop (i acc: I32) =
            let cond = i < n;
            core.select (cond, body, exit) ()
            where
                con body() =
                    loop (i + 1I32, acc + i);
                con exit() = return acc;
            end;
    end;
