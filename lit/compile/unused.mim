// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p opt %s -p ll -o - | %FileCheck %s

plugin core;
import compile;
plugin mem;

extern con main (m: mem.M 0, argc: I32, argv: mem.Ptr (mem.Ptr (I8, 0), 0), return: Cn [mem.M 0, I32]) =
    return (m, 42I32);

anx lam _unused_compile(): compile.Phase =
    compile.cleanup;

// CHECK-DAG: return{{.*}}42
