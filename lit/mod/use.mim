// RUN: %mim -p opt %s -o - | %FileCheck %s

plugin core;
import "lib.mim";
use lib;              // sugar for `use lib as *;`
use lib.inner as *;

extern lam f(): I32 = core.wrap.add 0 (answer, deep);
extern lam g(): I32 = deeper.deepest;

// CHECK-DAG: extern lam f (): I32 =
// CHECK-DAG-NEXT: 65I32;
// CHECK-DAG: extern lam g (): I32 =
// CHECK-DAG-NEXT: 7I32;
