// RUN: %mim -p opt %s -o - | %FileCheck %s

plugin core;
import "lib.mim";
use lib;
use lib.inner;

lam extern f(): I32 = %core.wrap.add 0 (answer, deep);
lam extern g(): I32 = deeper.deepest;

// CHECK-DAG: lam extern f (): I32 =
// CHECK-DAG-NEXT: 65I32;
// CHECK-DAG: lam extern g (): I32 =
// CHECK-DAG-NEXT: 7I32;
