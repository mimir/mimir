// Discovery walks up from the input file to the nearest `mim.ini` and stops at `.git`.
//
// The nearest manifest wins; a parent's entries are not added.
// RUN: rm -rf %t && mkdir -p %t/nearest/sub %t/p-parent %t/p-nearest
// RUN: printf '%%s\n' 'plugin-path = %t/p-parent' > %t/nearest/mim.ini
// RUN: printf '%%s\n' 'plugin-path = %t/p-nearest' > %t/nearest/sub/mim.ini
// RUN: cp %s %t/nearest/sub/test.mim
// RUN: env -u MIM_PLUGIN_PATH -u MIM_IMPORT_PATH -u MIM_PREFIX_PATH %mim %t/nearest/sub/test.mim -l > %t/nearest.txt
// RUN: %FileCheck %s --check-prefix=NEAREST --input-file %t/nearest.txt
//
// A `.git` entry stops the walk; a manifest above it is not read.
// RUN: mkdir -p %t/boundary/repo/.git %t/boundary/repo/src %t/p-above
// RUN: printf '%%s\n' 'plugin-path = %t/p-above' > %t/boundary/mim.ini
// RUN: cp %s %t/boundary/repo/src/test.mim
// RUN: env -u MIM_PLUGIN_PATH -u MIM_IMPORT_PATH -u MIM_PREFIX_PATH %mim %t/boundary/repo/src/test.mim -l > %t/boundary.txt
// RUN: %FileCheck %s --check-prefix=BOUNDARY --input-file %t/boundary.txt
//
// Relative `*-path` entries anchor to the manifest's directory, not to the input's or the cwd's.
// RUN: mkdir -p %t/relative/src %t/relative/sub
// RUN: printf '%%s\n' 'plugin-path = sub' > %t/relative/mim.ini
// RUN: cp %s %t/relative/src/test.mim
// RUN: env -u MIM_PLUGIN_PATH -u MIM_IMPORT_PATH -u MIM_PREFIX_PATH %mim %t/relative/src/test.mim -l > %t/relative.txt
// RUN: %FileCheck %s --check-prefix=RELATIVE --input-file %t/relative.txt
//
// `--config` replaces discovery, so a broken `mim.ini` in the working tree does not matter.
// RUN: mkdir -p %t/override %t/p-explicit
// RUN: printf '%%s\n' 'bogus = 1' > %t/override/mim.ini
// RUN: printf '%%s\n' 'plugin-path = %t/p-explicit' > %t/override/valid.ini
// RUN: cd %t/override && env -u MIM_PLUGIN_PATH -u MIM_IMPORT_PATH -u MIM_PREFIX_PATH %mim -l --config valid.ini > %t/override.txt
// RUN: %FileCheck %s --check-prefix=OVERRIDE --input-file %t/override.txt
//
// `--no-config` skips the discovered manifest but keeps environment variables.
// RUN: mkdir -p %t/noconfig %t/p-env %t/p-noconfig
// RUN: printf '%%s\n' 'plugin-path = %t/p-noconfig' > %t/noconfig/mim.ini
// RUN: cd %t/noconfig && env -u MIM_IMPORT_PATH -u MIM_PREFIX_PATH MIM_PLUGIN_PATH="%t/p-env" %mim --no-config -l > %t/noconfig.txt
// RUN: %FileCheck %s --check-prefix=NO-CONFIG --input-file %t/noconfig.txt

// NEAREST: {{^    .*}}/p-nearest"{{$}}
// NEAREST-NOT: {{^    .*}}/p-parent"{{$}}

// BOUNDARY: {{^}}plugins:{{$}}
// BOUNDARY-NOT: {{^    .*}}/p-above"{{$}}

// RELATIVE: {{^    .*}}/relative/sub"{{$}}
// RELATIVE-NOT: {{^    .*}}/relative/src/sub"{{$}}

// OVERRIDE: {{^    .*}}/p-explicit"{{$}}

// NO-CONFIG: {{^    .*}}/p-env"{{$}}
// NO-CONFIG-NOT: {{^    .*}}/p-noconfig"{{$}}
