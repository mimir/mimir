// RUN: rm -rf %t && mkdir -p %t
//
// Every `mim.ini` parse error reports `file:row:`:
//
// RUN: printf '%%s\n' 'no equals sign' > %t/eq.ini
// RUN: ! env -u MIM_PLUGIN_PATH -u MIM_IMPORT_PATH -u MIM_PREFIX_PATH %mim --config %t/eq.ini > %t/eq.out 2>&1
// RUN: %FileCheck %s --check-prefix=EQUALS --input-file %t/eq.out
//
// RUN: printf '%%s\n' 'bogus = 1' > %t/key.ini
// RUN: ! env -u MIM_PLUGIN_PATH -u MIM_IMPORT_PATH -u MIM_PREFIX_PATH %mim --config %t/key.ini > %t/key.out 2>&1
// RUN: %FileCheck %s --check-prefix=KEY --input-file %t/key.out
//
// RUN: printf '%%s\n' 'plugin-arg = ll' > %t/arg.ini
// RUN: ! env -u MIM_PLUGIN_PATH -u MIM_IMPORT_PATH -u MIM_PREFIX_PATH %mim --config %t/arg.ini > %t/arg.out 2>&1
// RUN: %FileCheck %s --check-prefix=ARG --input-file %t/arg.out
//
// RUN: printf '%%s\n' 'import-path = a' 'bogus = 1' > %t/row.ini
// RUN: ! env -u MIM_PLUGIN_PATH -u MIM_IMPORT_PATH -u MIM_PREFIX_PATH %mim --config %t/row.ini > %t/row.out 2>&1
// RUN: %FileCheck %s --check-prefix=ROW --input-file %t/row.out
//
// RUN: ! env -u MIM_PLUGIN_PATH -u MIM_IMPORT_PATH -u MIM_PREFIX_PATH %mim --config %t/does-not-exist.ini > %t/missing.out 2>&1
// RUN: %FileCheck %s --check-prefix=MISSING --input-file %t/missing.out
//
// RUN: ! env -u MIM_PLUGIN_PATH -u MIM_IMPORT_PATH -u MIM_PREFIX_PATH %mim --config %t/key.ini --no-config > %t/excl.out 2>&1
// RUN: %FileCheck %s --check-prefix=EXCL --input-file %t/excl.out
//
// They are exclusive regardless of their order, even with an otherwise-empty `--config`:
// RUN: ! env -u MIM_PLUGIN_PATH -u MIM_IMPORT_PATH -u MIM_PREFIX_PATH %mim --no-config --config "" > %t/excl-empty.out 2>&1
// RUN: %FileCheck %s --check-prefix=EXCL --input-file %t/excl-empty.out
// RUN: ! env -u MIM_PLUGIN_PATH -u MIM_IMPORT_PATH -u MIM_PREFIX_PATH %mim --config "" --no-config > %t/excl-empty2.out 2>&1
// RUN: %FileCheck %s --check-prefix=EXCL --input-file %t/excl-empty2.out
//
// A directory is not a manifest.
// RUN: mkdir -p %t/dir.ini
// RUN: ! env -u MIM_PLUGIN_PATH -u MIM_IMPORT_PATH -u MIM_PREFIX_PATH %mim --config %t/dir.ini > %t/dir.out 2>&1
// RUN: %FileCheck %s --check-prefix=DIR --input-file %t/dir.out
//
// An empty --config is an explicit error.
// RUN: ! env -u MIM_PLUGIN_PATH -u MIM_IMPORT_PATH -u MIM_PREFIX_PATH %mim --config "" > %t/empty.out 2>&1
// RUN: %FileCheck %s --check-prefix=EMPTY --input-file %t/empty.out

// EQUALS: {{^}}error: {{.*}}:1: expected `key = value`{{$}}
// KEY: {{^}}error: {{.*}}:1: unknown manifest key `bogus`{{$}}
// ARG: {{^}}error: {{.*}}:1: expected `<plugin>:<arg>`, got `ll`{{$}}
// ROW: {{^}}error: {{.*}}:2: unknown manifest key `bogus`{{$}}
// MISSING: {{^}}error: cannot read config file `{{.*}}does-not-exist.ini`{{$}}
// EXCL: {{^}}error: --config and --no-config are mutually exclusive{{$}}
// DIR: {{^}}error: cannot read config file `{{.*}}dir.ini`{{$}}
// EMPTY: {{^}}error: --config expects a non-empty path{{$}}
