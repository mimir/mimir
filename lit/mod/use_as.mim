// RUN: %mim -p opt %s -o - | %FileCheck %s
// RUN: %mim %s --output-ast - | %FileCheck --check-prefix=AST %s

plugin core;
import "lib.mim";
use lib as l;
use l.inner as ii;

extern lam f(): I32 = core.wrap.add 0 (l.answer, ii.deep);
extern lam g(): I32 = ii.deeper.deepest;

// CHECK-DAG: extern lam f (): I32 =
// CHECK-DAG-NEXT: 65I32;
// CHECK-DAG: extern lam g (): I32 =
// CHECK-DAG-NEXT: 7I32;

// AST: use lib as l;
// AST-NEXT: use l.inner as ii;
