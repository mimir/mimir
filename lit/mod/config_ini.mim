// RUN: rm -rf %t && mkdir -p %t/sub %t/empty && cp %s %t/sub/test.mim && printf '%%s\n' 'plugin-path = %libdir' > %t/mim.ini
// RUN: env -u MIM_PLUGIN_PATH -u MIM_IMPORT_PATH -u MIM_PREFIX_PATH %mim %t/sub/test.mim -o - > %t/out.txt
// RUN: %FileCheck %s --input-file %t/out.txt
// RUN: ! env -u MIM_PLUGIN_PATH -u MIM_IMPORT_PATH -u MIM_PREFIX_PATH %mim --no-config %t/sub/test.mim -o - > %t/fail.txt 2>&1
// RUN: %FileCheck %s --check-prefix=FAIL --input-file %t/fail.txt
//
// A CLI `-P` adds to the manifest's `plugin-path` instead of replacing it:
// RUN: env -u MIM_PLUGIN_PATH -u MIM_IMPORT_PATH -u MIM_PREFIX_PATH %mim -P %t/empty %t/sub/test.mim -o - > %t/with-cli.txt
// RUN: %FileCheck %s --input-file %t/with-cli.txt

plugin core;
plugin "mim/demo";

extern lam f(): I32 = demo.const_idx i32;

