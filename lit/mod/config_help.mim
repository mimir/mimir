// RUN: rm -rf %t && mkdir -p %t && printf '%%s\n' 'bogus = 1' > %t/mim.ini
// RUN: env -u MIM_PLUGIN_PATH -u MIM_IMPORT_PATH -u MIM_PREFIX_PATH %mim --help --config %t/mim.ini > %t/help.txt
// RUN: %FileCheck %s --check-prefix=HELP --input-file %t/help.txt
// RUN: env -u MIM_PLUGIN_PATH -u MIM_IMPORT_PATH -u MIM_PREFIX_PATH %mim --help-md --config %t/mim.ini > /dev/null

// HELP: {{^}}Usage: mim [options] <file>{{$}}
// HELP: Reads project configuration from `<path>` instead of
// HELP: searching for `mim.ini`; cannot be combined with
// HELP: `--no-config`.
// HELP: plugin search paths; adds to
// HELP: import search paths; adds to
// HELP: install prefixes; adds to

// A missing plugin must not make help unusable.
// RUN: printf '%%s\n' 'plugin = does-not-exist' > %t/missing-plugin.ini
// RUN: env -u MIM_PLUGIN_PATH -u MIM_IMPORT_PATH -u MIM_PREFIX_PATH %mim --help --config %t/missing-plugin.ini > %t/help-missing.txt
// RUN: %FileCheck %s --check-prefix=HELP --input-file %t/help-missing.txt
// RUN: env -u MIM_PLUGIN_PATH -u MIM_IMPORT_PATH -u MIM_PREFIX_PATH %mim --help --config %t/missing-plugin.ini > /dev/null 2> %t/warn.txt
// RUN: %FileCheck %s --check-prefix=WARN --input-file %t/warn.txt
// RUN: env -u MIM_PLUGIN_PATH -u MIM_IMPORT_PATH -u MIM_PREFIX_PATH %mim --help-md --config %t/missing-plugin.ini > %t/help-md-missing.txt
// RUN: %FileCheck %s --check-prefix=HELP-MD --input-file %t/help-md-missing.txt

// A broken manifest must not block version output.
// RUN: env -u MIM_PLUGIN_PATH -u MIM_IMPORT_PATH -u MIM_PREFIX_PATH %mim --version --config %t/mim.ini > %t/version.txt
// RUN: %FileCheck %s --check-prefix=VERSION --input-file %t/version.txt

