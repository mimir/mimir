// RUN: %mim --no-opt -p opt %s -o - | %FileCheck %s
plugin tensor;
plugin core;

use core.ops.u.w;

extern lam foo {pe: Nat} {r: Nat} {s: «r; Nat»} (lhs: tensor.Tensor r s (Idx pe), rhs: tensor.Tensor r s (Idx pe)) =
  let app = λ (x y: Idx pe) = x + y;
  tensor.map app (lhs, rhs);

// CHECK: tensor.map
