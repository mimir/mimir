// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p opt %s -p ll
// RUN: %FileCheck %s < %{s:stem}.ll

plugin core;

// extern arguments prevent constant folding; this exercises the codegen path
// nat.sub must emit saturating subtraction (select/icmp) not a plain sub nuw
fun extern nat_sub(a b: Nat): Nat = return (%core.nat.sub (a, b));

// CHECK: icmp ugt i64
// CHECK: select i1
