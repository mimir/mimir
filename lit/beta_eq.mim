// RUN: %mim -p opt %s -o -
plugin core;
plugin math;
plugin mem;

use core.ops.n;

rec Num = [T: *, add: [T, T] → T];
lam my_add {pe: «2; Nat»} (a b: math.F pe): math.F pe = math.arith.add 0 (a, b);

let F64 = (math.F64, my_add @math.f64);
pub mod bug { axm Arr: Num → *; }

fun test (N: Num) (A: bug.Arr N): Nat = return 0;

extern fun stuff (m: mem.M 0, A: bug.Arr F64): mem.M 0 =
    ret _ = test F64 $ A;
    return m;

lam pow (a b: Nat): Nat =
    (a * pow (a, b - 1), 1)#(b == 0);

lam foo (a: «8; Nat»): Bool = tt;
let _ = foo(‹pow (2, 3); 42›);
