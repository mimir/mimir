// RUN: %mim %s -o - | %FileCheck %s

plugin core;
plugin compile;
plugin mem;

extern con f (m: mem.M 0, p: mem.Ptr (I32, 0), c: Bool, return: Cn [mem.M 0, I32]) =
    con t () = return (mem.store (m, p, 1I32), 1I32);
    con e () = return (mem.store (m, p, 1I32), 0I32);
    (e, t)#c ();

extern lam _compile (): compile.Phase = compile.phases ff (compile.cleanup, mem.add_mem);

// CHECK-DAG: con e ([[E:_[0-9]+]]: core.M 0)
// CHECK-DAG: return_{{[0-9]+}} ([[E]], 0I32);
// CHECK-DAG: con t ([[T:_[0-9]+]]: core.M 0)
// CHECK-DAG: return_{{[0-9]+}} ([[T]], 1I32);
// CHECK: let [[S:_[0-9]+]] = mem.store
// CHECK: (e, t)#c [[S]];
