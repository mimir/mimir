// RUN: %mim %s -o - | %FileCheck %s

plugin core;
plugin compile;
plugin mem;

extern con f (a: I32, c: Bool, return: Cn [mem.M 0, I32]) =
    let (m, p) = mem.alloc (I32, 0) (⊥:(mem.M 0));
    let (m, x) = mem.load (mem.store (m, p, a), p);
    con t () = return (⊥:(mem.M 0), x);
    con e () = return (⊥:(mem.M 0), core.wrap.add 0 (x, 1I32));
    (e, t)#c ();

extern lam _compile (): compile.Phase = compile.phases ff (compile.cleanup, mem.add_mem);

// CHECK-NOT: mem.load
// CHECK: let [[L:_[0-9]+]] = mem.load
// CHECK-NOT: mem.load
// CHECK: (e, t)#c [[L]]#ff;
