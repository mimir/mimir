// RUN: %mim %s -o - | %FileCheck %s

plugin core;
plugin compile;
plugin mem;

extern con f (m: mem.M 0, p: mem.Ptr (I32, 0), return: Cn [mem.M 0, I32]) =
    let m = mem.store (m, p, 1I32);
    let (m, x) = mem.load (m, p);
    con t () = return (m, 1I32);
    con e () = return (m, 0I32);
    (e, t)#(core.icmp.e (x, 0I32)) ();

extern lam _compile (): compile.Phase = compile.phases ff (compile.cleanup, mem.add_mem);

// CHECK: let [[L:_[0-9]+]] = mem.load
// CHECK: (e, t)#{{.*}} [[L]]#ff;
