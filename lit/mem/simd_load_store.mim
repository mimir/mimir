// RUN: rm -f %{s:stem}.ll
// RUN: %mim %s -p ll -o -
// RUN: clang %{s:stem}.ll -o %t -Wno-override-module
// RUN: %t; test $? -eq 4
// RUN: %t 1; test $? -eq 64
// RUN: %t 1 2; test $? -eq 12

plugin core;
plugin mem;

extern con f(m: mem.M 0, a: I32, v: «4; I32», return: Cn [mem.M 0, I32]) =
    let i      = core.conv.u 4 a;
    let x      = core.wrap.add 0 (v#i, v#(core.conv.u 4 (core.wrap.add 0 (a, 1I32))));
    let (m, q) = mem.alloc («2; «4; I32»», 0) m;
    let m      = mem.store (m, q, ((10I32, 20I32, 30I32, 40I32), v));
    let (m, w) = mem.load (m, mem.lea (q, core.conv.u 2 a));
    let (m, p) = mem.alloc ([I32, «4; I32»], 0) m;
    let m      = mem.store (m, p, (x, w));
    let r      = core.bitcast (mem.Ptr0 «5; I32») p;
    let (m, y) = mem.load (m, mem.lea (r, core.conv.u 5 (core.wrap.add 0 (a, 1I32))));
    return (m, core.wrap.add 0 (y, core.wrap.add 0 (x, w#i)));

extern con main(m: mem.M 0, argc: I32, argv: mem.Ptr0 «core.idx2nat argc; mem.Ptr0 mem.Char», return: Cn [mem.M 0, I32]) =
    f (m, argc, (argc, argc, argc, argc), return);
