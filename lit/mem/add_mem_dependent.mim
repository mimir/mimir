// RUN: %mim -p opt %s -o - > %t.out
// RUN: %FileCheck %s < %t.out
// RUN: %FileCheck %s --check-prefix=GONE < %t.out

// Regression test for issue #177: `add_mem` used to mishandle dependently-typed function domains.
// Prepending the leading `%mem.M` must preserve free type-level variables (e.g. the `s` in `«2; Idx s»`)
// and shift value-dependent index references (e.g. the `«n; I32»` whose arity is an earlier parameter).

plugin core;
plugin mem;

// Free type-level variable `s` in a nested continuation domain `«2; Idx s»`.
fun extern poly {s: Nat} (a b: Idx s) as ab: [Idx s, Cn [Idx s, Cn«2; Idx s»]] =
    return (%core.wrap.mul 0 ab, fn (i: Idx s): «2; Idx s» = return ‹2; i›);

// Value-dependent domain: the type of `a` depends on the earlier parameter `n`.
con extern dep (n: Nat, a: «n; I32», return: Cn [%mem.M 0, I32]) =
    return (⊤:(%mem.M 0), a#(0:(Idx n)));

lam extern _compile (): %compile.Phase =
    %compile.phases ff (
        %compile.internal_cleanup,
        %mem.add_mem,
    );

// A leading %mem.M is prepended while the value-dependent `«n; I32»` domain stays well-typed.
// CHECK-DAG: fun extern dep (_: %mem.M 0, _: Nat, _: «n_{{[0-9]+}}; I32»)
// The free `s` is preserved and every nested continuation gets its own leading %mem.M.
// CHECK-DAG: fun extern poly {s_{{[0-9]+}}: Nat} (_{{[0-9]+}}: %mem.M 0,{{.*}}Cn [%mem.M 0, Idx s_{{[0-9]+}}, Idx s_{{[0-9]+}}]]]
// No `⊥ : %mem.M` placeholder may survive `%mem.add_mem`: it would leave a load unordered w.r.t. the
// stores that fill its buffer, i.e. a read of uninitialised memory (zero-filled, so invisible, on Linux).
// GONE-NOT: :(%mem.M 0)
