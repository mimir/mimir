// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p opt %s -p ll -o - | %FileCheck %s

plugin core;
plugin mem;

fun f(a: I32)@tt: I32 = return (core.wrap.mul 0 (a, a));

extern con main (m: mem.M 0, argc: I32, argv: mem.Ptr (mem.Ptr (I8, 0), 0), return: Cn [mem.M 0, I32]) =
    con ret_cont(r: I32) =
        con ret_cont2(r2: I32) = return (m, r2);
        f (r, ret_cont2);
    f (42I32, ret_cont);

// CHECK-DAG: return{{.*}}3111696
