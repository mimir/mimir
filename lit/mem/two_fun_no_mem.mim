// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p opt %s -p ll -o -
// RUN: clang %{s:stem}.ll -o %t -Wno-override-module
// RUN: %t; test $? -eq 5
// RUN: %t 1; test $? -eq 7
// RUN: %t 1 2; test $? -eq 9

plugin core;
plugin mem;

let Tas = (I32, 0);

con f (m: mem.M 0, p: mem.Ptr (I32, 0), return: Cn [mem.M 0, I32]) =
    let (m, v) = mem.load (m, p);
    g1 cont1
    where
        con g1 (return: Cn I32) =
            let b = core.wrap.add 0 (v, 1I32);
            return b;

        con cont1 (a: I32) =
            g2 cont2
            where
                con g2 (return: Cn I32) =
                    let c = core.wrap.add 0 (v, 2I32);
                    return c;
                con cont2 (b: I32) =
                    let c = core.wrap.add 0 (a, b);
                    return (m, c);
            end;
    end;

extern con main (m: mem.M 0, argc: I32, argv: mem.Ptr (mem.Ptr (I8, 0), 0), return: Cn [mem.M 0, I32]) =
    let (m, p) = mem.alloc Tas m;
    let m      = mem.store (m, p, argc);
    f (m, p, return);
// TODO: check for 1+x, 2+x, a+b
