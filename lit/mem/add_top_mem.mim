// RUN: rm -f %t.ll
// RUN: %mim -p opt %s -o - > %t.out
// RUN: %FileCheck %s < %t.out
// RUN: %FileCheck %s --check-prefix=GONE < %t.out

plugin core;

con extern f (mem: %mem.M 0, a: I32, return: Cn [%mem.M 0, I32]) = return (mem, a);

con extern main (mem: %mem.M 0, argc: I32, argv: %mem.Ptr (%mem.Ptr (I8, 0), 0), return: Cn [%mem.M 0, I32]) =
    f (⊤:(%mem.M 0), argc, return);

lam extern _compile (): %compile.Phase =
    %compile.phases ff (
        %compile.internal_cleanup,
        %mem.add_mem, /* optimization phase */
    );

// CHECK: f (_{{[0-9]+}}, argc_{{[0-9]+}}, return_{{[0-9]+}})
// No `⊥ : %mem.M` placeholder may survive `%mem.add_mem`: it would leave a load unordered w.r.t. the
// stores that fill its buffer, i.e. a read of uninitialised memory (zero-filled, so invisible, on Linux).
// GONE-NOT: :(%mem.M 0)
