// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p opt %s -p ll
// RUN: clang %{s:stem}.ll -o %t -Wno-override-module
// RUN: %t ; test $? -eq 42

plugin core;
plugin mem;
plugin refly;

// A zero offset is the pointer itself, and nested offsets add up.
lam zero (p: mem.Ptr0 I8): mem.Ptr0 I8 = refly.struc.e (mem.ptradd (p, 0I64), p);
lam nested (p: mem.Ptr0 I8): mem.Ptr0 I8 = refly.struc.e (mem.ptradd (mem.ptradd (p, 4I64), 8I64), mem.ptradd (p, 12I64));
lam dynamic (p: mem.Ptr0 I8, i: I64): mem.Ptr0 I8 = refly.struc.e (mem.ptradd (mem.ptradd (p, i), 8I64), mem.ptradd (p, core.wrap.add 0 (i, 8I64)));

// Writes 40 into the third and 2 into the second `I32` of an array through byte offsets, then adds them up.
extern con main (m: mem.M 0, argc: I32, argv: mem.Ptr0 «core.idx2nat argc; mem.Ptr0 mem.Char», return: Cn [mem.M 0, I32]) =
    let (m, arr) = mem.alloc («4; I32», 0) m;
    let base     = core.bitcast (mem.Ptr0 I8) arr;
    let p2       = core.bitcast (mem.Ptr0 I32) (mem.ptradd (base, 8I64));
    let p1       = core.bitcast (mem.Ptr0 I32) (mem.ptradd (mem.ptradd (base, 12I64), -8I64));
    let m        = mem.store (m, p2, 40I32);
    let m        = mem.store (m, p1, 2I32);
    let (m, x)   = mem.load (m, mem.lea (arr, 2_4));
    let (m, y)   = mem.load (m, mem.lea (arr, 1_4));
    return (m, core.wrap.add 0 (x, y));
