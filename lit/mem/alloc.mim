// RUN: rm -f %{s:stem}.ll %t
// RUN: %mim -p opt %s -p ll -o -
// RUN: clang %{s:stem}.ll -o %t -Wno-override-module

plugin core;
plugin mem;

extern con main(m: mem.M 0, argc: I32, argv: mem.Ptr («⊤:Nat; mem.Ptr («⊤:Nat; I8», 0)», 0), return: Cn [mem.M 0, I32]) =
    let a = core.bitcast Nat argc;
    (core.select (core.icmp.e (argc, 0I32), t, f)) m where
        con t(m: mem.M 0) =
            let (m, ptr) = mem.alloc («a; I32», 0) m; // hidden core.nat.mul (a, 4)) will pop up here causing poptential probls in schedule
            n (m, 23);
        con f(m: mem.M 0) =
            n (m, core.nat.mul (a, 4));
        con n(m: mem.M 0, a: Nat) =
            return (m, core.bitcast I32 a);
        end;
