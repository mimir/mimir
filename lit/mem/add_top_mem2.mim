// RUN: rm -f %t.ll
// RUN: %mim -p opt %s -o - | %FileCheck %s

plugin core;
plugin compile;
plugin mem;

extern con f (m: mem.M 0, a: I32, return: Cn [mem.M 0, I32]) = return (m, a);
extern con g (a: I32, return: Cn I32) = return a;
extern con h (a: I32, return: Cn [mem.M 0, I32]) = return (⊤:(mem.M 0), a);

extern con main (m: mem.M 0, argc: I32, argv: mem.Ptr (mem.Ptr (I8, 0), 0), return: Cn [mem.M 0, I32]) =
    f (⊤:(mem.M 0), argc, return);

extern lam _compile(): compile.Phase =
    compile.phases ff (
        compile.cleanup,
        mem.add_mem, /* optimization phase */
    );

// CHECK: f (_{{[0-9]+}}, argc_{{[0-9]+}}, return_{{[0-9]+}})
