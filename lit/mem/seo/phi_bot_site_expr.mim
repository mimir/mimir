// RUN: %mim -p opt %s -o - | %FileCheck %s

// Like phi_bot_site.mim, but head's phi reaches `exit` inside an expression stored to the slot.

plugin core;
plugin mem;

use core.ops.n;

extern fun dont_know[m: mem.M 0]: [mem.M 0, Bool];

extern fun test(m: mem.M 0, c: Bool): [mem.M 0, Nat] =
    ret (m, p) = mem.slot (Nat, 0) $ m;
    (init, early)#c m where
        con early(m: mem.M 0) = exit m;

        con init(m: mem.M 0) =
            let m = mem.store (m, p, 0);
            head m;

        con head(m: mem.M 0) =
            let (m, x) = mem.load (m, p);
            ret (m, cond) = dont_know $ m;
            (done, body)#cond m where
                con body(m: mem.M 0) =
                    let m = mem.store (m, p, x + 1);
                    head m;

                con done(m: mem.M 0) =
                    let m = mem.store (m, p, x + 2);
                    exit m;
            end;

        con exit(m: mem.M 0) =
            let (m, v) = mem.load (m, p);
            ret (m, b) = dont_know $ m;
            return (m, (v, v + 1)#b);
    end;

// CHECK-NOT: mem.slot
// CHECK-DAG: con exit (m{{.*}}: mem.M 0, v: Nat)
// CHECK-DAG: exit ({{.*}}, ⊥:Nat)
