// RUN: rm -rf %t && mkdir -p %t && cd %t && %mim -p opt %s -p ll && %FileCheck %s < %{s:stem}.ll

plugin core;
plugin mem;

extern fun test1(m: mem.M 0): [mem.M 0, Nat] =
    ret (m, ptr) = mem.slot (Nat, 0) $ m;
    let m        = mem.store (m, ptr, 1);
    let (m, a)   = mem.load (m, ptr);
    let m        = mem.store (m, ptr, 2);
    let (m, b)   = mem.load (m, ptr);
    let (m, c)   = mem.load (m, ptr);
    return (m, core.nat.add (a, c));

// CHECK: define i64 @test1()
// CHECK-NOT: alloca
// CHECK: ret i64 3
