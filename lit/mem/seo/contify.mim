// RUN: %mim -p opt %s -o - | %FileCheck %s --implicit-check-not=eta_
plugin core;
plugin mem;

use core.ops.n;

extern fun dont_know[]: Bool;

// Both call sites of `g` hand it the same continuation `k`, so SCCP propagates `k` and drops the parameter.
// EtaConv splits `k` into one wrapper per occurrence first, which SEO has to see through.
extern fun f (x: Nat): Nat =
    ret c = dont_know $ ();
    (a, b)#c () where
        con a () = g (x, k);
        con b () = g (x + 2, k);
        con g (y: Nat, r: Cn Nat) = r (y + 1);
        con k (r: Nat) = return (r + r);
    end;

// CHECK: con g (y: Nat) =
// CHECK: con a () =
// CHECK-NEXT: g x;
