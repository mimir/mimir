// RUN: %mim -p opt %s -o - | %FileCheck %s
plugin core;
plugin mem;

use core.ops.n;

lam f (x1 x2 x3: Nat)@ff: Nat = x1 + (x2 + x3);
lam g (x y: Nat)@ff: Nat = y;

extern lam lf(a: Nat): Nat =
    f (42, a, 23) + f (42, a, 3);

extern lam lg(a: Nat): Nat = g (23, 1) - g (23, a);

