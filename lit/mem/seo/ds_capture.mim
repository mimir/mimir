// RUN: %mim -p opt %s -o - | %FileCheck %s

// The direct-style `incn` stores to the slot through a captured ptr; its effects return implicitly.
// So the slot must stay and the final load must not fold to the initial 1.

plugin core;
plugin mem;

use core.ops.n;

extern fun test(m: mem.M 0, n: Nat): [mem.M 0, Nat] =
    ret (m, p) = mem.slot (Nat, 0) $ m;
    lam incn (m: mem.M 0, n: Nat)@ff: mem.M 0 =
        lam stop (m: mem.M 0): mem.M 0 = m;
        lam go (m: mem.M 0): mem.M 0 =
            let (m, x) = mem.load (m, p);
            incn (mem.store (m, p, x + 1), n - 1);
        (go, stop)#(n == 0) m;
    let m      = mem.store (m, p, 1);
    let m      = incn (m, n);
    let (m, x) = mem.load (m, p);
    return (m, x);

// CHECK: let [[M:[[:alnum:]_]+]] = incn
// CHECK: mem.load @ (Nat, 0) ([[M]], p)
// CHECK: mem.mslot (Nat, 0)
