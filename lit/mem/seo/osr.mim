// RUN: %mim %s -o - | %FileCheck %s
plugin core;
plugin compile;
plugin mem;

extern fun use_ [I32]: [];
extern fun take [Cn I32]: [];

// `i * 4I32` and `k * i` become params of `head` that advance by `4I32` and `k`.
// `n` is no induction variable, as its backedge passes `n * 2I32`.
extern fun direct (lo hi k: I32): I32 =
    head (lo, 1I32) where
        con head (i n: I32) =
            (exit, body)#(core.icmp.sl (i, hi)) () where
                con body () =
                    ret _ = use_ $ (core.wrap.mul 0 (i, 4I32));
                    ret _ = use_ $ (core.wrap.mul 0 (k, i));
                    ret _ = use_ $ (core.wrap.mul 0 (n, 3I32));
                    head (core.wrap.add 0 (i, 1I32), core.wrap.mul 0 (n, 2I32));
                con exit () = return n;
            end;
    end;

// The step `i - 2I32` reaches `head` through `next` and `back`, so `i * 4I32` steps by `-8`.
extern fun chain (lo hi: I32): I32 =
    head (lo, 1I32) where
        con head (i n: I32) =
            (exit, body)#(core.icmp.sl (i, hi)) () where
                con body () =
                    ret _ = use_ $ (core.wrap.mul 0 (i, 4I32));
                    next (core.wrap.sub 0 (i, 2I32));
                con next (x: I32) = back (x, 1I32);
                con back (x m: I32) = head (x, core.wrap.add 0 (n, m));
                con exit () = return n;
            end;
    end;

// `next` and `back` don't use a var of `head`, so `x` and `m` are no step yet; propagating `i + 1I32` makes them one.
extern fun sibling (lo hi: I32): I32 =
    head (lo, 1I32) where
        con head (i n: I32) =
            (exit, body)#(core.icmp.sl (i, hi)) () where
                con body () =
                    ret _ = use_ $ (core.wrap.mul 0 (i, 4I32));
                    next (core.wrap.add 0 (i, 1I32), core.wrap.mul 0 (n, 2I32));
                con next (x m: I32) = back (x, m);
                con back (x m: I32) = head (x, m);
                con exit () = return n;
            end;
    end;

// `loop` escapes into `take`, so its signature stays.
extern fun escape (lo hi: I32): I32 =
    loop lo where
        con loop (i: I32) =
            (exit, body)#(core.icmp.sl (i, hi)) () where
                con body () =
                    ret _ = use_ $ (core.wrap.mul 0 (i, 4I32));
                    ret _ = take $ loop;
                    loop (core.wrap.add 0 (i, 1I32));
                con exit () = return i;
            end;
    end;

extern fun use_n [Nat]: [];

// `i * k` steps by `k` via the saturating `core.nat.sub`.
extern fun nat_down (hi k: Nat): Nat =
    head hi where
        con head (i: Nat) =
            (exit, body)#(core.ncmp.g (i, 0)) () where
                con body () =
                    ret _ = use_n $ (core.nat.mul (i, k));
                    head (core.nat.sub (i, 1));
                con exit () = return i;
            end;
    end;

// `(i + 2I32 * j + k) * 4I32` advances by `(1 - 2 * 3) * 4 = -20`; `k * 4I32` is an invariant offset.
extern fun affine (lo hi k: I32): I32 =
    head (lo, hi) where
        con head (i j: I32) =
            (exit, body)#(core.icmp.sl (i, j)) () where
                con body () =
                    ret _ = use_ $ (core.wrap.mul 0 (core.wrap.add 0 (core.wrap.add 0 (i, core.wrap.mul 0 (2I32, j)), k), 4I32));
                    head (core.wrap.add 0 (i, 1I32), core.wrap.sub 0 (j, 3I32));
                con exit () = return i;
            end;
    end;

// Overflow of a checked product is poison, so wrapping adds refine it.
extern fun checked (lo hi: I32): I32 =
    head lo where
        con head (i: I32) =
            (exit, body)#(core.icmp.sl (i, hi)) () where
                con body () =
                    ret _ = use_ $ (core.wrap.mul 2 (i, 4I32));
                    head (core.wrap.add 2 (i, 1I32));
                con exit () = return i;
            end;
    end;

// `i` doubles and thus is no induction variable.
extern fun doubling (lo hi: I32): I32 =
    head lo where
        con head (i: I32) =
            (exit, body)#(core.icmp.sl (i, hi)) () where
                con body () =
                    ret _ = use_ $ (core.wrap.mul 0 (i, 3I32));
                    head (core.wrap.mul 0 (i, 2I32));
                con exit () = return i;
            end;
    end;

extern fun use_4 [Idx 4]: [];

// `Idx 4` wraps: `i * 2₄` advances by `3 * 2 mod 4 = 2`.
extern fun modular (lo hi: Idx 4): Idx 4 =
    head lo where
        con head (i: Idx 4) =
            (exit, body)#(core.icmp.ul (i, hi)) () where
                con body () =
                    ret _ = use_4 $ (core.wrap.mul 0 (i, 2₄));
                    head (core.wrap.add 0 (i, 3₄));
                con exit () = return i;
            end;
    end;

// The saturating `core.nat.sub` doesn't commute with `(i + k) * 3`, so the backedge recomputes the product.
extern fun nat_mixed (hi k: Nat): Nat =
    head hi where
        con head (i: Nat) =
            (exit, body)#(core.ncmp.g (i, 0)) () where
                con body () =
                    ret _ = use_n $ (core.nat.mul (core.nat.add (i, k), 3));
                    head (core.nat.sub (i, 1));
                con exit () = return i;
            end;
    end;

extern lam _compile(): compile.Phase = mem.seo;

// CHECK-LABEL: extern fun affine
// CHECK:       con head{{[[:alnum:]_]*}} ({{[[:alnum:]_]+}}: I32, {{[[:alnum:]_]+}}: I32, [[JA:_[0-9]+]]: I32, {{[[:alnum:]_]+}}: I32)
// CHECK:       core.wrap.add 0 @ i32 (4294967276I32, [[JA]]);
// CHECK:       [[XA:_[0-9]+]] = core.wrap.mul 0 @ i32 (4I32, {{_[0-9]+}});
// CHECK:       head{{[[:alnum:]_]*}} (lo{{[[:alnum:]_]*}}, hi{{[[:alnum:]_]*}}, [[XA]], {{_[0-9]+}});

// CHECK-LABEL: extern fun chain
// CHECK:       con head{{[[:alnum:]_]*}} ({{[[:alnum:]_]+}}: I32, {{[[:alnum:]_]+}}: I32, [[J:_[0-9]+]]: I32)
// CHECK:       [[NEXT:_[0-9]+]] = core.wrap.add 0 @ i32 (4294967288I32, [[J]]);
// CHECK:       head{{[[:alnum:]_]*}} ({{[[:alnum:]_]+}}, {{[[:alnum:]_]+}}, [[NEXT]]);
// CHECK:       [[INIT:_[0-9]+]] = core.wrap.mul 0 @ i32 (4I32, lo{{[[:alnum:]_]*}});
// CHECK:       head{{[[:alnum:]_]*}} (lo{{[[:alnum:]_]*}}, 1I32, [[INIT]]);

// CHECK-LABEL: extern fun checked
// CHECK:       con head{{[[:alnum:]_]*}} ({{[[:alnum:]_]+}}: I32, [[JC:_[0-9]+]]: I32)
// CHECK:       core.wrap.add 0 @ i32 (4I32, [[JC]]);
// CHECK-NOT:   core.wrap.mul 2

// CHECK-LABEL: extern fun direct
// CHECK:       con head{{[[:alnum:]_]*}} ({{[[:alnum:]_]+}}: I32, {{[[:alnum:]_]+}}: I32, [[J4:_[0-9]+]]: I32, [[JK:_[0-9]+]]: I32)
// CHECK-NOT:   core.wrap.mul 0 @ i32 (4I32, i
// CHECK-DAG:   core.wrap.mul 0 @ i32 (2I32, n
// CHECK-DAG:   [[N4:_[0-9]+]] = core.wrap.add 0 @ i32 (4I32, [[J4]]);
// CHECK-DAG:   [[NK:_[0-9]+]] = core.wrap.add 0 @ i32 (k{{[[:alnum:]_]*}}, [[JK]]);
// CHECK:       head{{[[:alnum:]_]*}} ({{[[:alnum:]_]+}}, {{[[:alnum:]_]+}}, [[N4]], [[NK]]);

// CHECK-LABEL: extern fun doubling
// CHECK:       con head{{[[:alnum:]_]*}} ({{[[:alnum:]_]+}}: I32) =
// CHECK:       core.wrap.mul 0 @ i32 (3I32, i

// CHECK-LABEL: extern fun escape
// CHECK:       con loop ({{[[:alnum:]_]+}}: I32) =
// CHECK:       core.wrap.mul 0 @ i32 (4I32, i

// CHECK-LABEL: extern fun modular
// CHECK:       con head{{[[:alnum:]_]*}} ({{[[:alnum:]_]+}}: Idx 4, [[JM:_[0-9]+]]: Idx 4)
// CHECK:       core.wrap.add 0 @ 4 (2₄, [[JM]]);

// CHECK-LABEL: extern fun nat_down
// CHECK:       con head{{[[:alnum:]_]*}} ({{[[:alnum:]_]+}}: Nat, [[JN:_[0-9]+]]: Nat)
// CHECK:       [[NN:_[0-9]+]] = core.nat.sub ([[JN]], k{{[[:alnum:]_]*}});
// CHECK:       head{{[[:alnum:]_]*}} ({{[[:alnum:]_]+}}, [[NN]]);
// CHECK:       [[IN:_[0-9]+]] = core.nat.mul
// CHECK:       head{{[[:alnum:]_]*}} (hi{{[[:alnum:]_]*}}, [[IN]]);

// CHECK-LABEL: extern fun nat_mixed
// CHECK:       con head{{[[:alnum:]_]*}} ({{[[:alnum:]_]+}}: Nat, {{[[:alnum:]_]+}}: Nat)
// CHECK:       [[DEC:_[0-9]+]] = core.nat.sub (i{{[[:alnum:]_]*}}, 1);
// CHECK:       [[SUM:_[0-9]+]] = core.nat.add ([[DEC]], k{{[[:alnum:]_]*}});
// CHECK:       core.nat.mul (3, [[SUM]]);

// CHECK-LABEL: extern fun sibling
// CHECK:       con head{{[[:alnum:]_]*}} ({{[[:alnum:]_]+}}: I32, {{[[:alnum:]_]+}}: I32, [[JS:_[0-9]+]]: I32)
// CHECK:       [[NS:_[0-9]+]] = core.wrap.add 0 @ i32 (4I32, [[JS]]);
// CHECK:       head{{[[:alnum:]_]*}} ({{[[:alnum:]_]+}}, {{[[:alnum:]_]+}}, [[NS]]);
