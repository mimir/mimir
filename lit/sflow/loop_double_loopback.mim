// RUN: (! %mim %s -o - 2>&1) | FileCheck %s

// Negative test: two loopbacks targeting the same header must fail
// type checking. The header's `loopback_path` slot can only unify
// with one token path, so the second loopback should produce a
// unification error.

// CHECK: error

plugin sflow;

fun extern foo (token: %sflow.Root) = %sflow.header (token, loop) 5 where
    con loop (i: Nat, struct) =
        %sflow.loop (struct, break, continue, body, %core.ncmp.e (i, 0)) () where
        con body (_: [], struct, tok) = %sflow.continue (tok, struct) i;
    end;
    con break (_: [], _) = return (5);
    con continue (i: Nat, struct, token) = %sflow.if (token, if_break, (a, b), ff) () where
        con if_break (_: [], _) = return (5);
        con a (_: [], _, tok) = %sflow.loopback (tok, struct) (%core.nat.sub (i, 1));
        con b (_: [], _, tok) = %sflow.loopback (tok, struct) (%core.nat.sub (i, 1));
    end;
end;
