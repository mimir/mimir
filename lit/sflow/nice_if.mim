plugin sflow;

fun extern foo (cond: Bool, token: %sflow.Root) =
  // make return also consume tokens
  let return = %sflow.lift return;
  // the actual function body; the root token is passed before the arms (their
  // token types are anchored on it) so token threading can be wired
  %sflow.nice_if merge cond () token (else, then) where
    lam then (merge) () = merge 1;
    lam else (merge) () = merge 0;
    lam merge (x: Nat) = return x;
  end;

