// RUN: %mim %s -o -

// Two continue sites targeting the same header are permitted: %sflow.continue
// is the back-edge itself. Backends that require a unique back-edge block
// (SPIR-V) funnel all continue sites through one synthesized latch block.
// The two return sites exit from different depths (different token paths) —
// exactly what the polymorphic %sflow.Ret return permits.

plugin sflow;

con extern foo (root: %sflow.Root, return: %sflow.Ret Nat) =
    let token = %sflow.enter root;
    %sflow.header token loop 5 where
    con loop (i: Nat, struct) =
        %sflow.loop struct break body (%core.ncmp.e (i, 0)) () where
        con body (_: [], struct, tok) = %sflow.if tok if_break (a, b) ff () where
            con if_break (_: [], tok) = return tok 5;
            con a (_: [], _, tok) = %sflow.continue tok struct (%core.nat.sub (i, 1));
            con b (_: [], _, tok) = %sflow.continue tok struct (%core.nat.sub (i, 2));
        end;
        con break (_: [], tok) = return tok 5;
    end;
end;
