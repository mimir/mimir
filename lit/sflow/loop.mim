// RUN: %mim %s -o -

plugin sflow;

con extern foo (token: %sflow.Root, return: %sflow.Ret Nat) = %sflow.header token loop 5 where
    con loop (i: Nat, struct) =
        %sflow.loop struct break body (%core.ncmp.e (i, 0)) () where
        con body (_: [], struct, tok) = %sflow.continue tok struct (%core.nat.sub (i, 1));
        con break (_: [], tok) = return tok 5;
    end;
end;
