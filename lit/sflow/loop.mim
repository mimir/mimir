// RUN: %mim %s -o -

plugin sflow;

fun extern foo (token: %sflow.Root) = %sflow.loop (token, break, continue, loop) 5 where
    con loop (i: Nat, struct, token) =
        %sflow.header (token, struct, (left, right), %core.ncmp.e (i, 0)) () where
        con left (_, struct, tok) = %sflow.continue (tok, struct) i;
        con right (_, struct, tok) = %sflow.break.l (tok, struct) ();
    end;
    con break (_, _) = return (5);
    con continue (i: Nat, struct, token) = %sflow.loopback (token, struct) (%core.nat.sub (i, 1));
end;
