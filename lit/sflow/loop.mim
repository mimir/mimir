plugin sflow;

fun extern foo (token: %sflow.Token %sflow.ROOT) = %sflow.loop token break continue loop 5 where
    con loop (i: Nat, token, struct) =
        %sflow.header token struct (left, right) (%core.ncmp.e (i, 0)) () where
        con left (_: [], _, struct) = %sflow.continue struct i;
        con right (_: [], _, struct) = %sflow.break struct ();
    end;
    con break (_: [], _, struct) = return (5, struct);
    con continue (i: Nat, token, _, header) = %sflow.loopback token header (%core.nat.sub (i, 1));
end;
