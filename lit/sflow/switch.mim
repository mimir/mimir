// RUN: %mim %s -o -

plugin sflow;

fun extern foo (token: %sflow.Token %sflow.ROOT) = %sflow.switch @3 token exit default (0, case0, (1, case1, (2, case2, ()))) 1 () where
  con case2 (_, _, struct) = %sflow.break struct 2;
  con case1 (_, _, struct) = %sflow.break struct 1;
  con case0 (_, _, struct) = %sflow.break struct 0;
  con default (_, _, struct) = %sflow.break struct 4;
  con exit (x: Nat, _, struct) = return x;
end;
