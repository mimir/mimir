plugin sflow;

fun extern foo () = %sflow.switch @3 foo exit default (0, case0, (1, case1, (2, case2, ()))) 1 () where
  con case2 (_, struct) = %sflow.exit.break struct 2;
  con case1 (_, struct) = %sflow.exit.break struct 1;
  con case0 (_, struct) = %sflow.exit.break struct 0;
  con default (_, struct) = %sflow.exit.break struct 4;
  con exit (x: Nat, struct) = return x;
end;
