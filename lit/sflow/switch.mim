// RUN: %mim %s -o -

plugin sflow;

con extern foo (path: %sflow.Path, step: %sflow.Step, token: %sflow.Token path step, return: %sflow.Ret Nat) =
  %sflow.switch @3 token exit default ((0, case0), (1, case1), (2, case2)) 1 () where
    con case2 (_: [], struct, tok) = %sflow.break.s tok struct 2;
    con case1 (_: [], struct, tok) = %sflow.break.s tok struct 1;
    con case0 (_: [], struct, tok) = %sflow.break.s tok struct 0;
    con default (_: [], struct, tok) = %sflow.break.s tok struct 4;
    con exit (x: Nat, tok) = return tok x;
end;
