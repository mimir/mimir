// RUN: %mim %s -o -

plugin sflow;

fun extern foo (token: %sflow.Root, cond_outer: Bool, cond_inner: Bool) =
    %sflow.if merge (else_outer, then_outer) cond_outer token () where
        con then_outer (_, struct, token) = %sflow.merge struct token 1;
        con else_outer (_, struct, token) =
            %sflow.if break_inner (else_inner, then_inner) cond_inner token () where
                con then_inner (_, s, token) = %sflow.merge s token 2;
                con else_inner (_, s, token) = %sflow.merge s token 3;
                con break_inner (x: Nat, _, token) = %sflow.merge struct token x;
            end;
        con merge (x: Nat, _, _) = return x;
    end;
