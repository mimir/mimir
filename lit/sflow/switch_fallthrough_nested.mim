// RUN: not %mim %s -o - 2>&1 | FileCheck %s
// Like %sflow.merge, %sflow.fallthrough's inner_token path is pinned to
// `%sflow.case case path step` -- the case's OWN path -- so a token from one
// level deeper is rejected. `then_` sits one arm inside case0 (path
// `%sflow.arm tt (%sflow.case 0 path step) step'`), so handing its token to
// %sflow.fallthrough is a type error: there is no `case` for which
// `%sflow.case case path step` alpha-equals a term headed by the different
// axiom `%sflow.arm`.

plugin sflow;

con extern foo (path: %sflow.Path, step: %sflow.Step,
                 token: %sflow.Token path step, cond: Bool,
                 return: %sflow.Ret Nat) =
  %sflow.switch @2 token exit default ((0, case0), (1, case1)) 0 1 where
    con case1 (x: Nat, struct, tok) = %sflow.break.s tok struct x;
    con case0 (x: Nat, struct, tok) =
      %sflow.if tok merge (else_, then_) cond () where
        con then_ (_: [], if_struct, inner_tok) = %sflow.fallthrough inner_tok struct x;
        con else_ (_: [], if_struct, inner_tok) = %sflow.merge inner_tok if_struct 0;
        con merge (x: Nat, tok2) = %sflow.break.s tok2 struct x;
      end;
    con default (x: Nat, struct, tok) = %sflow.break.s tok struct 4;
    con exit (x: Nat, tok) = return tok x;
end;

// CHECK: error
