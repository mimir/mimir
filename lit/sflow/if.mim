// RUN: %mim %s -o -

plugin sflow;

fun extern foo (token: %sflow.Root, cond: Bool) = %sflow.if exit (else, then) cond token () where
  con then (_, struct, token) = %sflow.merge struct token 1;
  con else (_, struct, token) = %sflow.merge struct token 0;
  con exit (x: Nat, struct, _) = return x;
end;
