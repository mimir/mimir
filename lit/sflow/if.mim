// RUN: %mim %s -o -

plugin sflow;

fun extern foo (token: %sflow.Root, cond: Bool) = %sflow.if (token, exit, (else, then), cond) () where
  con then (_, struct, token) = %sflow.merge (token, struct) 1;
  con else (_, struct, token) = %sflow.merge (token, struct) 0;
  con exit (x: Nat, struct, _) = return x;
end;
