// RUN: %mim %s -o -

plugin sflow;

con extern foo (root: %sflow.Root, cond: Bool, return: %sflow.Ret Nat) =
  let token = %sflow.enter root;
  %sflow.if token exit (else, then) cond () where
    con then (_, struct, token) = %sflow.merge token struct 1;
    con else (_, struct, token) = %sflow.merge token struct 0;
    con exit (x: Nat, token) = return token x;
end;
