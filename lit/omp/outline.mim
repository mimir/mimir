// RUN: %mim -p opt -p omp %s -o - | %FileCheck %s

// With the omp module loaded, btensor's outer_nest runs the leading output dims of a map_reduce as one
// omp.par_for, and omp.outline turns that into an omp.launch of a closed kernel over the values the
// loop body captured (the operand pointers, here).

plugin core;
plugin btensor;
plugin affine;
plugin buffer;
plugin mem;

use core.ops.u.w;

fun addition (m: mem.M 0, a b: I32): [mem.M 0, I32] = return (m, a + b);

extern fun f (m: mem.M 0, M: buffer.Buf (2, (4, 6), I32)): [mem.M 0, buffer.Buf (2, (6, 4), I32)] =
    return (btensor.map_reduce ((6, 4), (6, 4)) (addition, 0I32) affine.id (btensor.proj_map (1, 0)) (m, M));

// CHECK-NOT: omp.par_for
// CHECK: omp.launch
// CHECK-NOT: omp.par_for
