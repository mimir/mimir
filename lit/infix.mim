// RUN: %mim -p opt %s -o - | %FileCheck %s

plugin core;

let `+ = core.nat.add;
let `- = core.nat.sub;
let `* = core.nat.mul;
let `/ = core.nat.div;
let `% = core.nat.rem;
let `== = core.ncmp.e;
let `!= = core.ncmp.ne;
let `< = core.ncmp.l;
let `<= = core.ncmp.le;
let `> = core.ncmp.g;
let `>= = core.ncmp.ge;

lam id (n: Nat): Nat = n;

extern lam ops (): «6; Nat» =
    ( 2 + 3 * 4                 // 14: `*` binds tighter than `+`
    , (2 + 3) * 4               // 20
    , 10 - 2 - 3                //  5: left associative
    , 1 + 20 / 5 / 2 - 1        //  2
    , id 3 * id 4               // 12: application binds tightest
    , 1 + 17 % 5                //  3: `%` binds like `*`
    );

extern lam rels (): «8; Bool» =
    ( 1 + 1 == 2                // tt: `+` binds tighter than `==`
    , 2 * 3 != 6                // ff
    , `== (3, 3)                // tt: the escape hatch
    , `!= (3, 4)                // tt
    , 1 + 1 < 3                 // tt: `+` binds tighter than `<`
    , 2 * 2 <= 4                // tt
    , 5 > 2 + 2                 // tt
    , 4 >= 5                    // ff
    );

extern lam shifts (): «4; I32» =
    ( 1I32 << 3I32              //  8
    , 1I32 << 1I32 + 2I32       //  8: `+` binds tighter than `<<`
    , 32I32 >> 1I32 >> 2I32     //  4: left associative
    , `>> (32I32, 4I32)         //  2: the escape hatch
    )
    where
        let `+  = core.wrap.add 0;
        let `<< = core.wrap.shl 0;
        let `>> = core.shr.l;
    end;

extern lam cmps (): «2; Bool» =
    ( 1I32 << 2I32 < 5I32       // tt: `<<` binds tighter than `<`
    , 1I32 < 2I32 == tt         // tt: `<` binds tighter than `==`
    )
    where
        let `<  = core.icmp.ul;
        let `== = core.icmp.e;
        let `<< = core.wrap.shl 0;
    end;

// CHECK-DAG: (14, 20, 5, 2, 12, 3)
// CHECK-DAG: (tt, ff, tt, tt, tt, tt, tt, ff)
// CHECK-DAG: (8I32, 8I32, 4I32, 2I32)
// CHECK-DAG: ‹2; tt›
