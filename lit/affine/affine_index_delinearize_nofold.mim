// RUN: rm -f %{s:stem}.ll
// RUN: %mim %s -p opt -p ll -o - | %FileCheck %s
// RUN: clang %{s:stem}.ll -o %t -Wno-override-module
// RUN: %t ; test $? -eq 3
// RUN: %t a a a ; test $? -eq 12

// A genuine reshape: indices over «7, 28» read as «14, 14». `L = 28·a + b` with `b ∈ [0, 27]`, so the rest
// carries into `L floordiv 14` and `affine.lower_index` must keep the divisions.

plugin core;
plugin affine;
plugin mem;

use core.ops.u.w;

let s_in  = (7, 28);
let s_out = (14, 14);

lam reshape (o: «2; affine.Index»): «2; affine.Index» =
    affine.delinearize (affine.linearize (o, s_in), s_out);

extern con main (m: mem.M 0, argc: I32, argv: mem.Ptr (mem.Ptr (I32, 0), 0), return: Cn [mem.M 0, I32]) =
    let idxs = (core.conv.u 7 argc, core.conv.u 28 argc);
    let (m, (h, w)) = affine.map @(2, 2) @(s_in, s_out) reshape idxs m;
    let w32 = 4294967296;
    // (a, b) = (argc, argc) is element 28·argc + argc, i.e. row (29·argc) / 14 and column (29·argc) % 14.
    return (m, core.conv.u w32 h + core.conv.u w32 w);

// CHECK-DAG: core.div.udiv
// CHECK-DAG: core.div.urem
// CHECK-NOT: affine.delinearize
