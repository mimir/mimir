// RUN: rm -f %{s:stem}.ll
// RUN: %mim %s -p opt -p ll -o - | %FileCheck %s
// RUN: clang %{s:stem}.ll -o %t -Wno-override-module
// RUN: %t         ; test $? -eq 1
// RUN: %t 1 2 3 4 5 ; test $? -eq 2

// Exercises the division-based affine semiops: `floordiv` and `mod` lower to `%core.div` (udiv/urem), threading the
// `%affine.map`'s mem through the div chain. Here the mem comes from `main`, so it also runs.

plugin core;
plugin affine;
plugin mem;

lam f (idx: «2; %affine.index»): «2; %affine.index» =
    ( %affine.semiop.floordiv (idx#0_2, 3)
    , %affine.semiop.mod (idx#1_2, 3)
    );

con extern main [mem: %mem.M 0, argc: I32, argv: %mem.Ptr (%mem.Ptr (I32, 0), 0), return: Cn [%mem.M 0, I32]] =
    let a = argc;
    let (mem, r) = %affine.map @(2, 2) @((i32, i32), (i32, i32)) f (a, a) mem;
    // s = argc / 3 + argc % 3
    let s = %core.wrap.add 0 (r#0_2, r#1_2);
    return (mem, s);

// CHECK-DAG: %core.div.udiv
// CHECK-DAG: %core.div.urem
// The affine index algebra must be gone after lowering.
// CHECK-NOT: %affine.semiop
// CHECK-NOT: %affine.map
