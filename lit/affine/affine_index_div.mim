// RUN: rm -f %{s:stem}.ll
// RUN: %mim %s -p opt -p ll -o - | %FileCheck %s
// RUN: clang %{s:stem}.ll -o %t -Wno-override-module
// RUN: %t         ; test $? -eq 1
// RUN: %t 1 2 3 4 5 ; test $? -eq 2

// Exercises the division-based affine semiops: `floordiv` and `rem` lower to `core.div` (udiv/urem), threading the
// `affine.map`'s mem through the div chain. Here the mem comes from `main`, so it also runs.

plugin core;
plugin affine;
plugin mem;

lam f (i j: affine.Index): «2; affine.Index» =
    (affine.semiop.floordiv (i, 3), affine.semiop.rem (j, 3));

extern con main (m: mem.M 0, argc: I32, argv: mem.Ptr (mem.Ptr (I32, 0), 0), return: Cn [mem.M 0, I32]) =
    let a = argc;
    let (m, (r1, r2)) = affine.map f (a, a) m;
    // s = argc / 3 + argc % 3
    let s = core.wrap.add 0 (r1, r2);
    return (m, s);

// CHECK-DAG: core.div.udiv
// CHECK-DAG: core.div.urem
// The affine index algebra must be gone after lowering.
// CHECK-NOT: affine.semiop
// CHECK-NOT: affine.map
