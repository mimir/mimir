// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p opt %s -p ll -o - | %FileCheck %s
// RUN: clang %{s:stem}.ll -o %t -Wno-override-module
// RUN: %t       ; test $? -eq 9
// RUN: %t 1 2 3 ; test $? -eq 21

plugin core;
plugin affine;
plugin mem;

// f exercises the affine index idx over two input indices `a`, `b`:
//   out0 = (a + b) - b = a   (op.add + op.sub)
//   out1 = a * 3             (semiop.mul)
//   out2 = 5                 (constant)
lam f (idx: «2; %affine.Idx»): «3; %affine.Idx» =
    ( %affine.op.sub (%affine.op.add (idx#0₂, idx#1₂), idx#1₂)
    , %affine.semiop.mul (idx#0₂, 3)
    , %affine.constant 5
    );

// The moduli `sin`/`sout` cannot be inferred from `f` (which is %affine.Idx-valued),
// so they are passed explicitly: here both inputs and all outputs are `I32` (modulus 2^32).
con extern main (mem: %mem.M 0, argc: I32, argv: %mem.Ptr (%mem.Ptr (I32, 0), 0), return: Cn [%mem.M 0, I32]) =
    let a = argc;
    let b = 4I32;
    let (mem, r) = %affine.map @(3, 2) @((i32, i32), (i32, i32, i32)) f (a, b) mem;
    // sum = a + 3*a + 5 = 4*a + 5
    let s0 = %core.wrap.add 0 (r#0₃, r#1₃);
    let s  = %core.wrap.add 0 (s0, r#2₃);
    return (mem, s);

// The whole affine index idx must be gone after %affine.lower_index.
// CHECK-NOT: %affine.Idx
// CHECK-NOT: %affine.constant
// CHECK-NOT: %affine.op
// CHECK-NOT: %affine.semiop
// CHECK-NOT: %affine.map
