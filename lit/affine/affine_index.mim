// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p opt %s -p ll -o - | %FileCheck %s
// RUN: clang %{s:stem}.ll -o %t -Wno-override-module
// RUN: %t       ; test $? -eq 9
// RUN: %t 1 2 3 ; test $? -eq 21

plugin core;
plugin affine;
plugin mem;

// f exercises the affine index algebra over two input indices `a`, `b`:
//   out0 = (a + b) - b = a   (op.add + op.sub)
//   out1 = a * 3             (semiop.mul)
//   out2 = 5                 (constant)
lam f (i j: %affine.Idx): «3; %affine.Idx» =
    (%affine.op.sub (%affine.op.add (i, j), j), %affine.semiop.mul (i, 3), %affine.lit 5);

con extern main (mem: %mem.M 0, argc: I32, argv: %mem.Ptr (%mem.Ptr (I32, 0), 0), return: Cn [%mem.M 0, I32]) =
    let a = argc;
    let b = 4I32;
    let (mem, (r1, r2, r3)) = %affine.map f (a, b) mem;
    // sum = a + 3*a + 5 = 4*a + 5
    let s0 = %core.wrap.add 0 (r1, r2);
    let s  = %core.wrap.add 0 (s0, r3);
    return (mem, s);

// The whole affine index algebra must be gone after %affine.lower_index.
// CHECK-NOT: %affine.Idx
// CHECK-NOT: %affine.lit
// CHECK-NOT: %affine.op
// CHECK-NOT: %affine.semiop
// CHECK-NOT: %affine.map
