// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p opt %s -p ll -o - | %FileCheck %s
// RUN: clang %{s:stem}.ll -o %t -Wno-override-module
// RUN: %t 1 3 1; test $? -eq 3
// RUN: %t 0 5 2 ; test $? -eq 6

plugin core;
plugin affine;
plugin mem;

extern con atoi [mem.M 0, mem.Ptr («⊤:Nat; I8», 0), Cn [mem.M 0, I32]];

extern con main (m: mem.M 0, argc: I32, argv: mem.Ptr («⊤:Nat; mem.Ptr («⊤:Nat; I8», 0)», 0), return: Cn [mem.M 0, I32]) =
    con for_body (i: I32, (acc_a acc_b: I32), continue: Cn [I32, I32]) =
        let a: I32 = core.wrap.add 0 (i, acc_a);
        let b: I32 = core.wrap.sub 0 (i, acc_b);
        continue (a, b);

    con atoi_cont_begin (m: mem.M 0, start: I32) =
        let (m, stop_str) = mem.load (m, mem.lea (argv, 2I32));
        con atoi_cont_end (m: mem.M 0, stop: I32) =
            let (m, step_str) = mem.load (m, mem.lea (argv, 3I32));
            con atoi_cont_step (m: mem.M 0, step: I32) =
                con for_exit (acc: [I32, I32]) = return (m, acc#ff);
                affine.For for_body for_exit (start, stop, step, (0I32, 5I32));
            atoi (m, step_str, atoi_cont_step);
        atoi (m, stop_str, atoi_cont_end);

    let (m, start_str) = mem.load (m, mem.lea (argv, 1I32));
    atoi (m, start_str, atoi_cont_begin);

// CHECK-NOT: %affine.for
