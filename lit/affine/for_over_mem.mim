// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p opt %s -p ll -o - | %FileCheck %s
// RUN: clang %{s:stem}.ll -o %t -Wno-override-module
// RUN: %t 0 1 2 3 ; test $? -eq 1
// RUN: %t 0 1 2 3 4 5 6 7 ; test $? -eq 15

plugin core;
plugin affine;
plugin mem;

use core.ops.u.w;

extern con main (m: mem.M 0, argc: I32, argv: mem.Ptr0 «core.idx2nat argc; mem.Ptr0 mem.Char», return: Cn [mem.M 0, I32]) =
    let n        = core.idx2nat argc;
    let (m, ptr) = mem.alloc («n; I32», 0) (m);
    affine.For for_body for_exit (0I32, argc, 1I32, (m, 0I32, 0I32))
    where
        con for_body (i: I32, (m: mem.M 0, acc_a acc_b: I32), continue: Cn [mem.M 0, I32, I32]) =
            let a   = i + acc_a;
            let b   = i - acc_b;
            let lea = mem.lea (ptr, core.conv.u n i);
            let m = mem.store (m, lea, a);
            continue (m, a, b);

        con for_exit (m: mem.M 0, _: I32, _: I32) =
            let lea = mem.lea (ptr, core.conv.u n (argc - 4I32));
            return (mem.load (m, lea));
    end;


// CHECK-NOT: affine.For
