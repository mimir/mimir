// RUN: rm -f %{s:stem}.ll
// RUN: %mim %s -p opt -p ll -o - | %FileCheck %s
// RUN: clang %{s:stem}.ll -o %t -Wno-override-module
// RUN: %t ; test $? -eq 4
// RUN: %t a a a a a a ; test $? -eq 28

// `affine.lower_index` folds `floordiv`/`rem` away where the index domain makes them redundant, so a
// delinearize-of-linearize round trip collapses back to the plain input indices instead of emitting `core.div`.

plugin core;
plugin affine;
plugin mem;

use core.ops.u.w;

let shape = (10, 64, 224, 224);

/// `o ↦ delinearize(linearize(o, shape), shape)`: the identity on indices bounded by `shape`.
lam round_trip (o: «4; affine.Index»): «4; affine.Index» =
    affine.delinearize (affine.linearize (o, shape), shape);

extern con main (m: mem.M 0, argc: I32, argv: mem.Ptr (mem.Ptr (I32, 0), 0), return: Cn [mem.M 0, I32]) =
    // Derived from `argc` so nothing constant-folds; the `core.conv.u` targets are what bound each index.
    let idxs = (core.conv.u 10 argc, core.conv.u 64 argc, core.conv.u 224 argc, core.conv.u 224 argc);
    let (m, (n, c, h, w)) = affine.map @(4, 4) @(shape, shape) round_trip idxs m;
    let w32 = 4294967296;
    // The round trip is the identity, so the sum is 4 * argc.
    return (m, core.conv.u w32 n + core.conv.u w32 c + core.conv.u w32 h + core.conv.u w32 w);

// The whole round trip must lower without a single division.
// CHECK-NOT: core.div
// CHECK-NOT: affine.semiop
// CHECK-NOT: affine.delinearize
// CHECK-NOT: affine.linearize
