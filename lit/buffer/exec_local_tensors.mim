// RUN: %mim -p opt %s -o - > %t.out
// RUN: %FileCheck %s < %t.out
// RUN: %FileCheck %s --check-prefix=GONE < %t.out

// All tensors are local literals, so the DEFAULT pipeline never materializes a buffer: the inserts and
// extracts fold, and a read through the broadcast is answered from its input (tensor.lower_tensor).
// s = m#(1, 1) ← 2; reads s[1][1] + s[1][0] + b[1][0] + b[0][0] = 2 + 30 + 5 + 5 = 42, where
// b broadcasts the row (5, 7) to (2, 2).
// exec_local_tensors_run.mim compiles this to an executable and asserts the exit code.
plugin core;
plugin tensor;
plugin affine;
plugin mem;
plugin cps;
plugin btensor;
plugin buffer;

use core.ops.u.w;

extern con main (mm: mem.M 0, argc: I32, argv: mem.Ptr (mem.Ptr (I8, 0), 0), return: Cn [mem.M 0, I32]) =
    let m  = ((10I32, 20I32), (30I32, 40I32));
    let s  = m#(1₂, 1₂) ← 2I32;
    let b  = tensor.broadcast ((1, 2), (2, 2), (5I32, 7I32));
    return (mm, s#(1₂, 1₂) + s#(1₂, 0₂) + b#(1₂, 0₂) + b#(0₂, 0₂));

// CHECK: 42I32
// GONE-NOT: tensor.
// GONE-NOT: buffer.
// GONE-NOT: %btensor.
// GONE-NOT: mem.load
// GONE-NOT: mem.store
