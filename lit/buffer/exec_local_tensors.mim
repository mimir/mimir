// RUN: %mim -p opt %s -o - > %t.out
// RUN: %FileCheck %s < %t.out
// RUN: %FileCheck %s --check-prefix=GONE < %t.out

// Boundary-less bufferization through the DEFAULT pipeline: all tensors are local literals and no
// function signature mentions a tensor type, so there is nothing to convert at the boundaries — the ops
// themselves materialize their value-world operands into buffers (%buffer.init) and lower as usual.
// s = set m [1][1] := 2; reads s[1][1] + s[1][0] + b[1][0] + b[0][0] = 2 + 30 + 5 + 5 = 42, where
// b broadcasts the row (5, 7) to (2, 2).
// exec_local_tensors_run.mim compiles this to an executable and asserts the exit code.
plugin core;
plugin tensor;
plugin affine;
plugin mem;
plugin cps;

con extern main (mem: %mem.M 0, argc: I32, argv: %mem.Ptr (%mem.Ptr (I8, 0), 0), return: Cn [%mem.M 0, I32]) =
    let m  = ((10I32, 20I32), (30I32, 40I32));
    let s  = %tensor.set ((1₂, 1₂), m, 2I32);
    let b  = %tensor.broadcast ((1, 2), (2, 2), (5I32, 7I32));
    let g1 = %tensor.get ((1₂, 1₂), s);
    let g2 = %tensor.get ((1₂, 0₂), s);
    let g3 = %tensor.get ((1₂, 0₂), b);
    let g4 = %tensor.get ((0₂, 0₂), b);
    let v  = %core.wrap.add 0 (%core.wrap.add 0 (%core.wrap.add 0 (g1, g2), g3), g4);
    return (mem, v);

// CHECK-DAG: %mem.load
// CHECK-DAG: %mem.store
// GONE-NOT: %tensor.
// GONE-NOT: %buffer.
// GONE-NOT: %btensor.
