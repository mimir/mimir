// RUN: %mim -p opt %s -o - | %FileCheck %s
// RUN: %mim -p opt %s -o - | %FileCheck %s --check-prefix=GONE

// Bufferization of %tensor.map_reduce: reduction, transpose (Rr=0) and strided access.
// tensor.lower_to_mem maps it onto the buffer-world %btensor.map_reduce_post, %btensor.lower_map_reduce generates
// the loops over %buffer ops, and %buffer.lower_ptr lowers to %mem. After the full pipeline, all tensor/btensor/
// buffer/affine axioms are gone and only %mem.* + loops remain.
// GONE-NOT: %tensor.
// GONE-NOT: %btensor.
// GONE-NOT: %buffer.
// GONE-NOT: %affine.
plugin core;
plugin tensor;
plugin affine;
plugin mem;
plugin cps;
plugin buffer;
plugin btensor;
plugin opt;

fun add  (x: I32, y: «1; I32»)@tt = return (%core.wrap.add 0 (x, y#0₁));
fun copy (x: I32, y: «1; I32»)@tt = return (y#0₁);
lam id1 (i: %affine.Idx): «1; %affine.Idx» = i;
lam id1i(i, j: %affine.Idx): «1; %affine.Idx» = i;
lam id2 (i, j: %affine.Idx): «2; %affine.Idx» = (i, j);
lam tr  (i, j: %affine.Idx): «2; %affine.Idx» = (j, i);
lam sl  (i: %affine.Idx): «1; %affine.Idx» = (%affine.op.add (%affine.semiop.mul (i, 3), %affine.constant 2), );

// out[i] = sum_j input[i][j]
// CHECK-DAG: fun extern row_sum
fun extern row_sum (input: «3, 4; I32»): «3; I32» =
    return (%tensor.map_reduce (3, (3, 4)) (add, 0I32) id1i id2 input);

// out[j][i] = input[i][j]  (Rn = Ro, no reduction loop)
// CHECK-DAG: fun extern transpose
fun extern transpose (input: «2, 3; I32»): «3, 2; I32» =
    return (%tensor.map_reduce ((3, 2), (2, 3)) (copy, ⊥:I32) tr id2 input);

// out[i] = input[3*i + 2]; the affine read index lowers to %core arithmetic.
// CHECK-DAG: fun extern strided
// CHECK-DAG: %core.wrap.mul {{.*}}(3I64
// CHECK-DAG: %core.wrap.add {{.*}}(2I64
fun extern strided (input: «8; I32»): «2; I32» =
    return (%tensor.map_reduce (‹1; 2›, ‹1; 2›) (copy, ⊥:I32) id1 sl input);

// Memory operations are emitted.
// CHECK-DAG: %mem.alloc
// CHECK-DAG: %mem.lea
// CHECK-DAG: %mem.store

lam extern _compile (): %compile.Phase =
    %compile.phases ff (
        %compile.named "%tensor.lower_tensor",       // high-level ops -> %tensor.map_reduce (+ broadcast)
        %compile.named "%tensor.fuse_tensor",        // fuse map_reduce chains
        %compile.named "%tensor.lower_to_mem",       // bufferize get/set/map_reduce/broadcast onto
                                                           // %buffer/%btensor (hard error if not bufferizable)
        %mem.add_mem,
        %compile.named "%btensor.lower_map_reduce",  // %btensor.map_reduce_post/broadcast -> affine.For over %buffer
        %compile.named "%buffer.lower_ptr",          // %buffer.* -> %mem.Ptr / lea / load / store
        %compile.named "%affine.lower_index",  // %affine.map -> %core arithmetic
        %compile.named "%affine.lower_for",    // affine.For -> CPS loops
    );
