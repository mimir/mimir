// RUN: %mim -p opt %s -o - > %t.out
// RUN: %FileCheck %s < %t.out
// RUN: %FileCheck %s --check-prefix=GONE < %t.out

// End-to-end bufferization of tensor.pad and tensor.concat through the DEFAULT pipeline: `main`
// materializes the literals into buffers and calls the bufferized `pad_row` / `cat_two` (lowered via
// btensor.pad / btensor.concat to loops over buffer, then to mem loops).
// pad (10,20,30) lo=1 hi=2 fill=5 -> (5,10,20,30,5,5); concat (10,20,30)+(1,2) -> (10,20,30,1,2).
// done reads p[3] + c[4] + c[0] = 30 + 2 + 10 = 42.
// exec_pad_concat_run.mim compiles this to an executable and asserts the exit code.
plugin core;
plugin tensor;
plugin affine;
plugin mem;
plugin cps;
plugin btensor;
plugin buffer;

extern fun pad_row (input: tensor.Tensor 1 3 I32): tensor.Tensor 1 6 I32 =
    return (tensor.pad 3 (0, 1, 2) (input, 5I32));

extern fun cat_two (a: tensor.Tensor 1 3 I32, b: tensor.Tensor 1 2 I32): tensor.Tensor 1 5 I32 =
    return (tensor.concat 0₁ (a, b));

extern con main (m: mem.M 0, argc: I32, argv: mem.Ptr («core.idx2nat argc; mem.Ptr (mem.Char, 0)», 0), return: Cn [mem.M 0, I32]) =
    use core.ops.u.w;
    let t = tensor.from_array (10I32, 20I32, 30I32);
    let u = tensor.from_array (1I32, 2I32);
    con done1 (p: tensor.Tensor 1 6 I32) =
        con done2 (c: tensor.Tensor 1 5 I32) = return (m, tensor.get (p, 3₆) + tensor.get (c, 4₅) + tensor.get (c, 0₅));
        cat_two ((t, u), done2);
    pad_row (t, done1);

// CHECK-DAG: mem.load
// CHECK-DAG: mem.store
// GONE-NOT: tensor.
// GONE-NOT: buffer.
// GONE-NOT: %btensor.
