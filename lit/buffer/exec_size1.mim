// RUN: %mim -p opt %s -o - > %t.out
// RUN: %FileCheck %s < %t.out
// RUN: %FileCheck %s --check-prefix=GONE < %t.out

// End-to-end bufferization with size-1 axes through the DEFAULT pipeline: the logical shapes
// (1, 3) / (1, 5) retain both logical axes while buffer.Buf folds their singleton axes.
// pad (7,8,9) as «1,3» with lo=(0,1) hi=(0,1) fill=5 -> (5,7,8,9,5); concat «1,3»+«2,3» along axis 0
// -> ((7,8,9),(10,20,30),(4,5,6)).
// done reads c[1][2] + p[1] + p[0] = 30 + 7 + 5 = 42.
// exec_size1_run.mim compiles this to an executable and asserts the exit code.
plugin core;
plugin tensor;
plugin affine;
plugin mem;
plugin cps;
plugin btensor;
plugin buffer;

extern fun pad_one (input: tensor.Tensor 2 (1, 3) I32): tensor.Tensor 2 (1, 5) I32 =
    return (tensor.pad (1, 3) (0, (0, 1), (0, 1)) (input, 5I32));

extern fun cat_one (a: tensor.Tensor 2 (1, 3) I32, b: tensor.Tensor 2 (2, 3) I32): tensor.Tensor 2 (3, 3) I32 =
    return (tensor.concat 0₂ @((1, 3), (2, 3)) (a, b));

extern con main (m: mem.M 0, argc: I32, argv: mem.Ptr («core.idx2nat argc; mem.Ptr (mem.Char, 0)», 0), return: Cn [mem.M 0, I32]) =
    use core.ops.u.w;
    let a = tensor.from_array @(2, (1, 3), I32) (7I32, 8I32, 9I32);
    let b = tensor.from_array ((10I32, 20I32, 30I32), (4I32, 5I32, 6I32));
    con done1 (p: tensor.Tensor 2 (1, 5) I32) =
        con done2 (c: tensor.Tensor 2 (3, 3) I32) = return (m, tensor.get (c, (1₃, 2₃)) + tensor.get (p, (0₁, 1₅)) + tensor.get (p, (0₁, 0₅)));
        cat_one ((a, b), done2);
    pad_one (a, done1);

// CHECK-DAG: mem.load
// CHECK-DAG: mem.store
// GONE-NOT: tensor.
// GONE-NOT: buffer.
// GONE-NOT: %btensor.
