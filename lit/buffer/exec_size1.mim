// RUN: %mim -p opt %s -o - > %t.out
// RUN: %FileCheck %s < %t.out
// RUN: %FileCheck %s --check-prefix=GONE < %t.out

// End-to-end bufferization with size-1 axes through the DEFAULT pipeline: the logical shapes
// (1, 3) / (1, 5) fold to «3; I32» / «5; I32» (and their buffers fold the same way via %buffer.Buf
// normalization), so the loop generation iterates the logical domains but reads/writes folded buffers.
// pad (7,8,9) as «1,3» with lo=(0,1) hi=(0,1) fill=5 -> (5,7,8,9,5); concat «1,3»+«2,3» along axis 0
// -> ((7,8,9),(10,20,30),(4,5,6)).
// done reads c[1][2] + p[1] + p[0] = 30 + 7 + 5 = 42.
// exec_size1_run.mim compiles this to an executable and asserts the exit code.
plugin core;
plugin tensor;
plugin affine;
plugin mem;
plugin cps;

fun extern pad_one (input: «1, 3; I32»): «1, 5; I32» =
    return (%tensor.pad (1, 3) (0, (0, 1), (0, 1)) (input, 5I32));

fun extern cat_one (a: «1, 3; I32», b: «2, 3; I32»): «3, 3; I32» =
    return (%tensor.concat @(I32, 2, 2) 0_2 @((1, 3), (2, 3)) (a, b));

con extern main [mem: %mem.M 0, argc: I32, argv: %mem.Ptr (%mem.Ptr (I8, 0), 0), return: Cn [%mem.M 0, I32]] =
    let a = (7I32, 8I32, 9I32);
    let b = ((10I32, 20I32, 30I32), (4I32, 5I32, 6I32));
    con done1 (p: «5; I32») =
        con done2 (c: «3, 3; I32») =
            let v1 = %tensor.get @(I32, 2, (3, 3)) (c, (1_3, 2_3));
            let v2 = %tensor.get @(I32, 1, (5,)) (p, (1_5,));
            let v3 = %tensor.get @(I32, 1, (5,)) (p, (0_5,));
            let s  = %core.wrap.add 0 (%core.wrap.add 0 (v1, v2), v3);
            return (mem, s);
        cat_one ((a, b), done2);
    pad_one (a, done1);

// CHECK-DAG: %mem.load
// CHECK-DAG: %mem.store
// GONE-NOT: %tensor.
// GONE-NOT: %buffer.
// GONE-NOT: %matrix.
