// RUN: %mim -p opt %s -o - | %FileCheck %s
// RUN: %mim -p opt %s -o - | %FileCheck %s --check-prefix=GONE

// Bufferization of %tensor.concat: tensor.lower_to_mem maps it onto the buffer-world %matrix.concat,
// %matrix.lower_map_reduce generates the range-selected/clamped-read loops over %buffer ops, and %buffer.lower_ptr
// lowers to %mem. The pipeline below contains NO value-semantics tensor phases, so any residue would
// show up in the GONE checks.
// GONE-NOT: %tensor.
// GONE-NOT: %matrix.
// GONE-NOT: %buffer.
// GONE-NOT: %affine.
plugin core;
plugin tensor;
plugin affine;
plugin mem;
plugin cps;
plugin buffer;
plugin matrix;
plugin opt;

// Concat a 2x3 and a 4x3 matrix along axis 0 -> 6x3: rows 0..1 from a, rows 2..5 from b (b read at row i−2).
// The `i ≥ 2` range test lowers to an unsigned %core.icmp; the shifted read index is clamped via %core.extrema.
// The input shapes deliberately differ: two equal-typed params would group into a single «2; «2, 3; I32»»
// array, which role-based tensor tracking leaves on the value path.
// CHECK-DAG: fun extern cat0
// CHECK-DAG: %core.icmp
// CHECK-DAG: %core.extrema.Sm
fun extern cat0 (a: «2, 3; I32», b: «4, 3; I32»): «6, 3; I32» =
    return (%tensor.concat @(I32, 2, 2) 0₂ @((2, 3), (4, 3)) (a, b));

// Concat a 2x3 and a 2x2 matrix along axis 1 -> 2x5: cols 0..2 from a, cols 3..4 from b.
// CHECK-DAG: fun extern cat1
fun extern cat1 (a: «2, 3; I32», b: «2, 2; I32»): «2, 5; I32» =
    return (%tensor.concat @(I32, 2, 2) 1₂ @((2, 3), (2, 2)) (a, b));

// Concat two 1-D vectors with differing extents: 3 + 2 = 5.
// CHECK-DAG: fun extern cat_vec
fun extern cat_vec (a: «3; I32», b: «2; I32»): «5; I32» =
    return (%tensor.concat @(I32, 2, 1) 0₁ @(3, 2) (a, b));

// Size-1 extent along the concat axis: a's logical shape (1, 3) folds to «3; I32» (and its buffer to
// rank 1) — the read of a folds away the axis-0 coordinate.
// CHECK-DAG: fun extern cat_size1
fun extern cat_size1 (a: «1, 3; I32», b: «2, 3; I32»): «3, 3; I32» =
    return (%tensor.concat @(I32, 2, 2) 0₂ @((1, 3), (2, 3)) (a, b));

// Memory operations are emitted (the concatenated result is materialised into a buffer).
// CHECK-DAG: %mem.alloc
// CHECK-DAG: %mem.lea
// CHECK-DAG: %mem.store

lam extern _compile (): %compile.Phase =
    %compile.phases ff (
        %compile.named "%tensor.lower_tensor",       // high-level ops -> %tensor.map_reduce/concat/… (+ broadcast)
        %compile.named "%tensor.lower_to_mem",       // bufferize get/set/map_reduce/broadcast/pad/concat onto
                                                           // %buffer/%matrix (hard error if not bufferizable)
        %mem.add_mem,
        %compile.named "%matrix.lower_map_reduce",          // %matrix.* -> affine.For over %buffer
        %compile.named "%buffer.lower_ptr",          // %buffer.* -> %mem.Ptr / lea / load / store
        %compile.named "%affine.lower_index",  // %affine.map -> %core arithmetic
        %compile.named "%affine.lower_for",    // affine.For -> CPS loops
    );
