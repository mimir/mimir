// RUN: %mim -p opt %s -o - > %t.out
// RUN: %FileCheck %s --check-prefix=GONE < %t.out

// The matrix product takes the interchanged lowering: its last output dim `j` is unit-stride in
// `b` and invariant in `a`, while the contraction `k` is unit-stride only in `a` — so `j` becomes
// the innermost loop over a row-accumulator buffer (contiguous vector lanes instead of gathers).
// a = ((1,2,3),(4,5,6)), b[k][j] = k+j:
// out[1][2] = 4·(0+2) + 5·(1+2) + 6·(2+2) = 8 + 15 + 24 = 47.
// exec_interchange_run.mim compiles this to an executable and asserts the exit code.
plugin core;
plugin tensor;
plugin affine;
plugin mem;
plugin cps;

fun extern matmul (a: «2, 3; I32», b: «3, 4; I32»): «2, 4; I32» =
    return (%tensor.product_2d (I32, 0I32, %core.wrap.add 0, %core.wrap.mul 0) (a, b));

con extern main (mem: %mem.M 0, argc: I32, argv: %mem.Ptr (%mem.Ptr (I8, 0), 0), return: Cn [%mem.M 0, I32]) =
    let a = ((1I32, 2I32, 3I32), (4I32, 5I32, 6I32));
    let b = ((0I32, 1I32, 2I32, 3I32), (1I32, 2I32, 3I32, 4I32), (2I32, 3I32, 4I32, 5I32));
    con done (o: «2, 4; I32») =
        let v = %tensor.get @(I32, 2, (2, 4)) (o, (1₂, 2₄));
        return (mem, v);
    matmul ((a, b), done);

// GONE-NOT: %tensor.
// GONE-NOT: %buffer.
// GONE-NOT: %matrix.
