// RUN: %mim -p opt %s -o - > %t.out
// RUN: %FileCheck %s --check-prefix=GONE < %t.out

// End-to-end convolutions under the SELECTED schedules (see conv_sched.mim): `small` (cin = 3)
// takes the fully-unrolled classic nest — the whole 27-tap reduction becomes straight-line MACs —
// and `wide` (cin = 4, 36 taps > 32) unrolls only the 3x3 window and runs ow vectorized over a
// row of accumulators. All-ones inputs: each output cell is the tap count (27 resp. 36);
// exec_conv_run.mim asserts the combined exit code 27 + 36 = 63.
plugin core;
plugin tensor;
plugin affine;
plugin mem;
plugin buffer;
plugin cps;
plugin btensor;

use core.ops.u.w;

lam iadd (a b: I32): I32 = a + b;
lam imul (a b: I32): I32 = a * b;
let R: tensor.Ring = (I32, 0I32, iadd, imul);

extern fun small (input: «2, 3, 4, 4; I32», w: «2, 3, 3, 3; I32»): «2, 2, 2, 2; I32» =
    return (tensor.conv_impl R ((1, 1), (1, 1), (0, 0)) (input, w));

extern fun wide (input: «2, 4, 4, 4; I32», w: «2, 4, 3, 3; I32»): «2, 2, 2, 2; I32» =
    return (tensor.conv_impl R ((1, 1), (1, 1), (0, 0)) (input, w));

extern con main (m: mem.M 0, argc: I32, argv: mem.Ptr (mem.Ptr (I8, 0), 0), return: Cn [mem.M 0, I32]) =
    con done_s (os: «2, 2, 2, 2; I32») =
        con done_w (ow: «2, 2, 2, 2; I32») =
            return (m, tensor.get ((1₂, 1₂, 1₂, 1₂), os) + tensor.get ((0₂, 1₂, 0₂, 1₂), ow));
        wide ((‹2; ‹4; ‹4; ‹4; 1I32››››, ‹2; ‹4; ‹3; ‹3; 1I32››››), done_w);
    small ((‹2; ‹3; ‹4; ‹4; 1I32››››, ‹2; ‹3; ‹3; ‹3; 1I32››››), done_s);

// GONE-NOT: %tensor.
// GONE-NOT: %buffer.
// GONE-NOT: %btensor.
