// RUN: %mim -p opt %s -o - | %FileCheck %s
// RUN: %mim -p opt %s -o - | %FileCheck %s --check-prefix=GONE

// Bufferization of %tensor.pad: tensor.lower_to_mem maps it onto the buffer-world %matrix.pad,
// %matrix.lower_aff generates the guarded/clamped-read loops over %buffer ops, and %buffer.lower_ptr
// lowers to %mem. The pipeline below contains NO value-semantics tensor phases, so any residue would
// show up in the GONE checks.
// GONE-NOT: %tensor.
// GONE-NOT: %matrix.
// GONE-NOT: %buffer.
// GONE-NOT: %affine.
plugin core;
plugin tensor;
plugin affine;
plugin mem;
plugin direct;
plugin buffer;
plugin matrix;
plugin opt;

// 1-D constant pad of a length-3 vector to length 6 (lo 1, hi 2, fill 0): out[i] = (1 ≤ i < 4) ? input[i−1] : 0.
// The bounds check lowers to an unsigned %core.icmp on the shifted read index.
// CHECK-DAG: fun extern pad1d_const
// CHECK-DAG: %core.icmp
fun extern pad1d_const (input: «3; I32»): «6; I32» =
    return (%tensor.pad 3 (0, 1, 2) (input, 0I32));

// 1-D replicate pad: the read index is clamped to the nearest edge via %core.extrema, no fill value needed.
// CHECK-DAG: fun extern pad1d_repl
// CHECK-DAG: %core.extrema
fun extern pad1d_repl (input: «3; I32»): «6; I32» =
    return (%tensor.pad 3 (1, 1, 2) (input, ⊥:I32));

// 2-D constant pad: (2, 3) -> (4, 7).
// CHECK-DAG: fun extern pad2d_const
fun extern pad2d_const (input: «2, 3; I32»): «4, 7; I32» =
    return (%tensor.pad (2, 3) (0, (1, 2), (1, 2)) (input, 0I32));

// Size-1 axes: the logical shapes (1, 3) / (1, 5) fold to «3; I32» / «5; I32» at the type level, and
// %buffer.Buf folds them the same way — the loop generation iterates the logical rank-2 domain but
// reads/writes with folded indices.
// CHECK-DAG: fun extern pad_size1
fun extern pad_size1 (input: «1, 3; I32»): «1, 5; I32» =
    return (%tensor.pad (1, 3) (0, (0, 1), (0, 1)) (input, 0I32));

// Memory operations are emitted (the padded result is materialised into a buffer).
// CHECK-DAG: %mem.alloc
// CHECK-DAG: %mem.lea
// CHECK-DAG: %mem.store

lam extern _compile (): %compile.Phase =
    %compile.phases ff (
        %compile.named_phase "%tensor.lower_tensor",       // high-level ops -> %tensor.map_reduce/pad/… (+ broadcast)
        %compile.named_phase "%tensor.lower_to_mem",       // bufferize get/set/map_reduce/broadcast/pad/concat onto
                                                           // %buffer/%matrix (hard error if not bufferizable)
        %compile.named_phase "%matrix.lower_aff",          // %matrix.* -> affine.For over %buffer
        %compile.named_phase "%buffer.lower_ptr",          // %buffer.* -> %mem.Ptr / lea / load / store
        %compile.named_phase "%affine.lower_index_phase",  // %affine.map -> %core arithmetic
        %compile.named_phase "%affine.lower_for_phase",    // affine.For -> CPS loops
    );
