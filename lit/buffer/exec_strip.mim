// RUN: %mim -p opt %s -o - > %t.out
// RUN: %FileCheck %s --check-prefix=GONE < %t.out

// Strip-mining end-to-end, driven entirely from the frontend: the reduction dim `a` (extent 8) of
// a row sum is split into (2, 4) via %tensor.strip_mine_red, so the lowering sees an ordinary
// map_reduce_post over the (2, 2, 4, 3) domain — nothing interprets the transform. Summing an
// all-ones «2, 8, 3» tensor yields 24 per output cell — a wrong split or recombination (iota)
// would miscount or read out of bounds.
// exec_strip_run.mim compiles this to an executable and asserts the exit code.
plugin core;
plugin tensor;
plugin affine;
plugin mem;
plugin buffer;
plugin cps;

fun add (x: I32, y: «1; I32»)@tt = return (%core.wrap.add 0 (x, y#0₁));
lam mo (i a b: %affine.index): «1; %affine.index» = i;
lam mi (i a b: %affine.index): «3; %affine.index» = (i, a, b);

// out[i] = sum_{a, b} input[i][a][b], with `a` strip-mined by 4.
fun extern sum_all (input: «2, 8, 3; I32»): «2; I32» =
    return (%tensor.materialize (%tensor.strip_mine_red (
        %tensor.mr_tileable @1 @(I32, I32, 1, 2) (2, 0, (2, 8, 3))
            @(I32, 3, (2, 8, 3)) (add, 0I32, %tensor.id @I32)
            mo mi input,
        1, 4)));

con extern main (mem: %mem.M 0, argc: I32, argv: %mem.Ptr (%mem.Ptr (I8, 0), 0), return: Cn [%mem.M 0, I32]) =
    let t = ‹2; ‹8; ‹3; 1I32›››;
    con done (o: «2; I32») =
        let v = %tensor.get @(I32, 1, (2, )) (o, (1₂, ));
        return (mem, v);
    sum_all (t, done);

// GONE-NOT: %tensor.
// GONE-NOT: %buffer.
// GONE-NOT: %matrix.
