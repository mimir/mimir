// RUN: %mim -p opt %s -o - | %FileCheck %s
// RUN: %mim -p opt %s -o - | %FileCheck %s --check-prefix=GONE

// Size-1 dimension folding: «3,1;I32» is stored as «3;I32», so a size-1 axis has already folded out of
// the array type and carries no index. The bufferized signature uses a rank-1 mem.Ptr.
// GONE-NOT: tensor.
// GONE-NOT: buffer.
plugin core;
plugin tensor;
plugin mem;
plugin cps;
plugin buffer;
plugin affine;
plugin opt;
plugin compile;

extern fun f (input: «3, 1; I32»): «3, 1; I32» =
    let input = tensor.buf input;
    let v     = input#(1₃, 0₁);
    return (input#(0₃, 0₁) ← v);

// CHECK: mem.Ptr («3; I32», 0)
// CHECK-DAG: mem.load
// CHECK-DAG: mem.store

extern lam _compile (): compile.Phase =
    compile.phases ff (
        tensor.lower_to_mem,
        mem.add_mem,
        buffer.lower_ptr,
        affine.lower_index,
        affine.lower_for,
        compile.cleanup,
    );
