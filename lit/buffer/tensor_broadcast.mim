// RUN: %mim -p opt %s -o - | %FileCheck %s
// RUN: %mim -p opt %s -o - | %FileCheck %s --check-prefix=GONE

// Bufferization of tensor.broadcast via the buffer-world btensor.broadcast.
// Exercises size-1 dimension folding: the input «3,1;I32» is stored as «3;I32», so the input read uses a
// single (folded) index while the output is rank 2.
// GONE-NOT: tensor.
// GONE-NOT: %btensor.
// GONE-NOT: buffer.
// GONE-NOT: affine.
plugin core;
plugin tensor;
plugin affine;
plugin mem;
plugin cps;
plugin buffer;
plugin btensor;
plugin opt;
plugin compile;

// out[i][j] = input[i][0]
// CHECK-DAG: extern con bc (
extern fun bc (input: tensor.Tensor 2 (3, 1) I32): tensor.Tensor 2 (3, 4) I32 =
    return (tensor.broadcast ((3, 1), (3, 4), input));

// Singleton source axes remain logical tensor axes and fold in the buffer representation.
// out[i][j] = x
// CHECK-DAG: extern con bc_scalar
extern fun bc_scalar (x: tensor.Tensor 2 (1, 1) I32): tensor.Tensor 2 (3, 4) I32 =
    return (tensor.broadcast ((1, 1), (3, 4), x));

// CHECK-DAG: mem.alloc
// CHECK-DAG: mem.load
// CHECK-DAG: mem.store

extern lam _compile (): compile.Phase =
    compile.phases ff (
        tensor.lower_to_mem,
        mem.add_mem,
        btensor.lower_map_reduce,
        buffer.lower_ptr,
        affine.lower_index,
        affine.lower_for,
        compile.cleanup,
    );
