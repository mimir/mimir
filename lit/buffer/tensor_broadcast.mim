// RUN: %mim -p opt %s -o - | %FileCheck %s
// RUN: %mim -p opt %s -o - | %FileCheck %s --check-prefix=GONE

// Bufferization of %tensor.broadcast via the buffer-world %btensor.broadcast.
// Exercises size-1 dimension folding: the input «3,1;I32» is stored as «3;I32», so the input read uses a
// single (folded) index while the output is rank 2.
// GONE-NOT: %tensor.
// GONE-NOT: %btensor.
// GONE-NOT: %buffer.
// GONE-NOT: %affine.
plugin core;
plugin tensor;
plugin affine;
plugin mem;
plugin cps;
plugin buffer;
plugin btensor;
plugin opt;

// out[i][j] = input[i][0]
// CHECK-DAG: fun extern bc (
fun extern bc (input: «3, 1; I32»): «3, 4; I32» =
    return (%tensor.broadcast ((3, 1), (3, 4), input));

// Rank-0 source: an all-size-1 input shape folds to a plain scalar `x`, so there is no input buffer to
// read from. Broadcasting a scalar fills every output element with it (lowers to %buffer.constant).
// out[i][j] = x
// CHECK-DAG: fun extern bc_scalar
fun extern bc_scalar (x: I32): «3, 4; I32» =
    return (%tensor.broadcast ((1, 1), (3, 4), x));

// CHECK-DAG: %mem.alloc
// CHECK-DAG: %mem.load
// CHECK-DAG: %mem.store

lam extern _compile (): %compile.Phase =
    %compile.phases ff (
        %tensor.lower_to_mem,
        %mem.add_mem,
        %btensor.lower_map_reduce,
        %buffer.lower_ptr,
        %affine.lower_index,
        %affine.lower_for,
        %compile.cleanup,
    );
