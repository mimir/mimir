// RUN: %mim -p opt %s -o - > %t.out
// RUN: %FileCheck %s < %t.out
// RUN: %FileCheck %s --check-prefix=GONE < %t.out

// End-to-end epilogue fusion through the DEFAULT pipeline: the trailing %tensor.unary over the
// reducing map_reduce is composed into its `post` slot by fuse_tensor, then bufferized via
// %matrix.map_reduce_post (whose lowering runs `post` once per output cell before the store).
// Row sums of ((1..4),(5..8),(9..12)) are (10, 26, 42); with the +1 epilogue done reads
// out[2] = 43. exec_epilogue_run.mim compiles this to an executable and asserts the exit code.
plugin core;
plugin tensor;
plugin affine;
plugin mem;
plugin cps;

fun add (x: I32, y: «1; I32»)@tt = return (%core.wrap.add 0 (x, y#0₁));
lam add1 (x: I32): I32 = %core.wrap.add 0 (x, 1I32);
lam id1i (i j: %affine.index): «1; %affine.index» = i;
lam id2  (i j: %affine.index): «2; %affine.index» = (i, j);

// out[i] = (sum_j input[i][j]) + 1
fun extern row_sum1 (input: «3, 4; I32»): «3; I32» =
    let sums = %tensor.map_reduce @1 @(I32, 1, 1) (3, (3, 4))
                   @(I32, 2, (3, 4)) (add, 0I32) id1i id2 input;
    return (%tensor.unary @(I32, I32) add1 @(1, 3) sums);

con extern main (mem: %mem.M 0, argc: I32, argv: %mem.Ptr (%mem.Ptr (I8, 0), 0), return: Cn [%mem.M 0, I32]) =
    let t = ((1I32, 2I32, 3I32, 4I32), (5I32, 6I32, 7I32, 8I32), (9I32, 10I32, 11I32, 12I32));
    con done (o: «3; I32») =
        let v = %tensor.get @(I32, 1, (3, )) (o, (2₃, ));
        return (mem, v);
    row_sum1 (t, done);

// CHECK-DAG: %mem.load
// CHECK-DAG: %mem.store
// GONE-NOT: %tensor.
// GONE-NOT: %buffer.
// GONE-NOT: %matrix.
