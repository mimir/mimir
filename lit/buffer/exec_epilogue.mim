// RUN: %mim -p opt %s -o - > %t.out
// RUN: %FileCheck %s < %t.out
// RUN: %FileCheck %s --check-prefix=GONE < %t.out

// End-to-end epilogue fusion through the DEFAULT pipeline: the input arrives transposed and is
// read through %tensor.transpose_2d (a copy map_reduce absorbed into the reduction's access map);
// the trailing bias-add and %tensor.unary over the reducing map_reduce are composed into its
// `post` slot by fuse_tensor — the bias becomes an epilogue input read once per output cell —
// then bufferized via %btensor.map_reduce_post (whose lowering runs `post` once per output cell
// before the store; the value-world bias literal is materialized into a buffer).
// Row sums of the transposed input ((1..4),(5..8),(9..12)) are (10, 26, 42); with bias (1, 2, 3)
// and the +1 epilogue done reads out[2] = 42 + 3 + 1 = 46. exec_epilogue_run.mim compiles this to
// an executable and asserts the exit code.
plugin core;
plugin tensor;
plugin affine;
plugin mem;
plugin cps;

fun add (x: I32, y: «1; I32»)@tt = return (%core.wrap.add 0 (x, y#0₁));
lam addb (x y: I32): I32 = %core.wrap.add 0 (x, y);
lam add1 (x: I32): I32 = %core.wrap.add 0 (x, 1I32);
lam id1i (i j: %affine.index): «1; %affine.index» = i;
lam id2  (i j: %affine.index): «2; %affine.index» = (i, j);

// out[i] = (sum_j input[j][i]) + bias[i] + 1
fun extern row_sum1 (input: «4, 3; I32», bias: «3; I32»): «3; I32» =
    let t      = %tensor.transpose_2d input;
    let sums   = %tensor.map_reduce (3, (3, 4))
                     (add, 0I32) id1i id2 t;
    let biased = %tensor.binary addb (sums, bias);
    return (%tensor.unary add1 biased);

con extern main (mem: %mem.M 0, argc: I32, argv: %mem.Ptr (%mem.Ptr (I8, 0), 0), return: Cn [%mem.M 0, I32]) =
    let t = ((1I32, 5I32, 9I32), (2I32, 6I32, 10I32), (3I32, 7I32, 11I32), (4I32, 8I32, 12I32));
    let bias = (1I32, 2I32, 3I32);
    con done (o: «3; I32») =
        let v = %tensor.get ((2₃, ), o);
        return (mem, v);
    row_sum1 ((t, bias), done);

// CHECK-DAG: %mem.load
// CHECK-DAG: %mem.store
// GONE-NOT: %tensor.
// GONE-NOT: %buffer.
// GONE-NOT: %btensor.
