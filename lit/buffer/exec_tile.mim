// RUN: %mim -p opt %s -o - > %t.out
// RUN: %FileCheck %s --check-prefix=GONE < %t.out

// Classic GEMM cache tiling, composed entirely in the frontend from domain transforms:
// C[i, j] = Σ_k A[i, k]·B[k, j] over (4, 4, 8); strip-mine i and j by 2 (packing the output as
// (io, ii, jo, ji)) and k by 4, then interchange the loops to (io, jo, ii, ji, ko, ki) — the
// parallel tile loops hoist outward. (Hoisting ko above ii/ji would need partial reduction,
// which map_reduce's per-cell fold cannot express.) The lowering sees ONE ordinary
// map_reduce_post over the six-dim domain — nothing interprets the transforms.
// exec_tile_run.mim compiles this to an executable and asserts the exit code.
plugin core;
plugin tensor;
plugin affine;
plugin mem;
plugin buffer;
plugin cps;

fun mul_add (acc: I32, ab: «2; I32»)@tt =
    return (%core.wrap.add 0 (acc, %core.wrap.mul 0 (ab#0₂, ab#1₂)));

fun extern gemm (a: «4, 8; I32», b: «8, 4; I32»): «2, 2, 2, 2; I32» =
    return (%tensor.materialize (%tensor.interchange (
        %tensor.strip_mine_red (
            %tensor.strip_mine_par (
                %tensor.strip_mine_par (
                    %tensor.mr_tileable @2 @(I32, I32, 2, 1) ((4, 4), (0, 1), (4, 4, 8))
                        (mul_add, 0I32, %tensor.id)
                        (%tensor.proj_map (0, 1))
                        (%tensor.proj_map (0, 2), %tensor.proj_map (2, 1))
                        (a, b),
                    0, 2),
                2, 2),
            4, 4),
        (0, 2, 1, 3, 4, 5))));

// A[i][k] = i + 1, B[k][j] = 2·j + 1 ⇒ C[i, j] = 8·(i + 1)·(2·j + 1), asymmetric in (i, j):
// a misplaced write (omega) or misrecombined read (iota) lands on a different value.
// C_packed[0, 1, 1, 0] = C[1, 2] = 80.
con extern main (mem: %mem.M 0, argc: I32, argv: %mem.Ptr (%mem.Ptr (I8, 0), 0), return: Cn [%mem.M 0, I32]) =
    let a = (‹8; 1I32›, ‹8; 2I32›, ‹8; 3I32›, ‹8; 4I32›);
    let b = ‹8; (1I32, 3I32, 5I32, 7I32)›;
    con done (o: «2, 2, 2, 2; I32») =
        let v = %tensor.get ((0₂, 1₂, 1₂, 0₂), o);
        return (mem, v);
    gemm ((a, b), done);

// GONE-NOT: %tensor.
// GONE-NOT: %buffer.
// GONE-NOT: %btensor.
