// RUN: %mim -p opt %s -o - | %FileCheck %s
// RUN: %mim -p opt %s -o - | %FileCheck %s --check-prefix=GONE

// Isolated check of the buffer plugin's lower_ptr phase: a hand-written
// alloc/write/read program must lower to mem.alloc/lea/load/store, with no %buffer.* left.
plugin core;
plugin mem;
plugin buffer;
plugin opt;
plugin compile;

extern con main (m: mem.M 0, argc: I32, argv: mem.Ptr (mem.Ptr (I8, 0), 0), return: Cn [mem.M 0, I32]) =
    let RST          = (2, (2, 2), I32);
    let (m, buf)  = buffer.alloc RST m;
    let idx          = (1₂, 0₂);
    let (m, buf2) = buffer.write RST (m, buf, idx, 7I32);
    let (m, v)    = buffer.read RST (m, buf2, idx);
    return (m, v);

extern lam _compile (): compile.Phase =
    compile.phases ff (
        compile.cleanup,
        buffer.lower_ptr,
        compile.cleanup,
    );

// CHECK-DAG: %mem.alloc
// CHECK-DAG: %mem.lea
// CHECK-DAG: %mem.load
// CHECK-DAG: %mem.store
// GONE-NOT: %buffer.
