// RUN: %mim -p opt %s -o - > %t.out
// RUN: %FileCheck %s < %t.out
// RUN: %FileCheck %s --check-prefix=GONE < %t.out

// End-to-end bufferization of %tensor.map_reduce through the DEFAULT pipeline: `main` materializes
// the tensor literal into a buffer and calls the bufferized `row_sum` (lowered via %btensor.map_reduce
// to affine loops over %buffer, then to %mem loops). The result buffer flows back into `main`'s
// mem-extended continuation `done`, where the `get` reads from it directly.
// Row sums of ((1..4),(5..8),(9..12)) are (10, 26, 42); done reads out[2] = 42.
// exec_map_reduce_run.mim compiles this to an executable and asserts the exit code.
plugin core;
plugin tensor;
plugin affine;
plugin mem;
plugin cps;

fun add (x: I32, y: «1; I32»)@tt = return (%core.wrap.add 0 (x, y#0₁));
lam id1i (i j: %affine.index): «1; %affine.index» = i;
lam id2  (i j: %affine.index): «2; %affine.index» = (i, j);

// out[i] = sum_j input[i][j]
fun extern row_sum (input: «3, 4; I32»): «3; I32» =
    return (%tensor.map_reduce (3, (3, 4)) (add, 0I32) id1i id2 input);

con extern main (mem: %mem.M 0, argc: I32, argv: %mem.Ptr (%mem.Ptr (I8, 0), 0), return: Cn [%mem.M 0, I32]) =
    let t = ((1I32, 2I32, 3I32, 4I32), (5I32, 6I32, 7I32, 8I32), (9I32, 10I32, 11I32, 12I32));
    con done (o: «3; I32») =
        let v = %tensor.get ((2₃, ), o);
        return (mem, v);
    row_sum (t, done);

// CHECK-DAG: %mem.load
// CHECK-DAG: %mem.store
// GONE-NOT: %tensor.
// GONE-NOT: %buffer.
// GONE-NOT: %btensor.
