// RUN: %mim -p opt %s -o - > %t.out
// RUN: %FileCheck %s --check-prefix=GONE < %t.out

// K = 4 hits dot_schedule's register blocking with an exactly-one-tile split: the contraction
// becomes (1, 4) — a LEADING extent-1 loop dim that previously never existed. `Idx 1` is zero bits
// wide (⌈log₂ 1⌉ = 0), so without folding/clamping the backend emits invalid i0 arithmetic for its
// loop index. Conversions into `Idx 1` now normalize to the literal 0 and the ll backend clamps
// index types to ≥ i1. C[i,j] = Σ_k 1·2 = 8; exec_ktile_run.mim asserts the exit code.
plugin core;
plugin tensor;
plugin affine;
plugin mem;
plugin buffer;
plugin cps;

lam iadd (a b: I32): I32 = %core.wrap.add 0 (a, b);
lam imul (a b: I32): I32 = %core.wrap.mul 0 (a, b);
let R: %tensor.Ring = (I32, 0I32, iadd, imul);

fun extern mm (a: «2, 4; I32», b: «4, 2; I32»): «2, 2; I32» =
    return (%tensor.product_2d_impl R (a, b));

con extern main (mem: %mem.M 0, argc: I32, argv: %mem.Ptr (%mem.Ptr (I8, 0), 0), return: Cn [%mem.M 0, I32]) =
    con done (o: «2, 2; I32») =
        return (mem, %tensor.get @(I32, 2, (2, 2)) ((1₂, 1₂), o));
    mm ((‹2; ‹4; 1I32››, ‹4; ‹2; 2I32››), done);

// GONE-NOT: %tensor.
// GONE-NOT: %buffer.
// GONE-NOT: %btensor.
