// RUN: rm -f %{s:stem}.ll %{s:stem}_dev.ll %t
// RUN: %mim -p opt -p gpu %S/../tensor/%{s:stem}.mim -p nvptx
// RUN: %if system-linux && cuda %{ clang++ -std=c++23 %S/../tensor/hlo_train_aux.cpp %{s:stem}.ll -lcuda -o %t -Wno-override-module %}
// RUN: %if system-linux && cuda %{ %t %}

// A result whose readers are all in one chain stays on the device: 9 launches, 6 copies back to the host.
// RUN: %FileCheck %s --input-file=%{s:stem}.ll --check-prefix=COPIES
// COPIES-COUNT-6: call i32 @cuMemcpyDtoH
// COPIES-NOT: call i32 @cuMemcpyDtoH
