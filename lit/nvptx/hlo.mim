// RUN: rm -f %{s:stem}.ll %{s:stem}_dev.ll %t
// RUN: %mim -p opt -p gpu %S/../tensor/%{s:stem}.mim -p nvptx
// RUN: %if system-linux && cuda %{ clang++ -std=c++23 %S/../tensor/hlo_step_aux.cpp %{s:stem}.ll -lcuda -o %t -Wno-override-module %}
// RUN: %if system-linux && cuda %{ %t %}

// A result whose readers are all in one chain stays on the device: 22 launches, 15 copies back to the host.
// The 128x1024 contraction over 1024 runs shared-memory tiled.
// RUN: %FileCheck %s --input-file=%{s:stem}.ll --check-prefix=COPIES
// RUN: %FileCheck %s --input-file=%{s:stem}_dev.ll --check-prefix=DEVICE
// COPIES-COUNT-15: call i32 @cuMemcpyDtoH
// COPIES-NOT: call i32 @cuMemcpyDtoH
// DEVICE: define ptx_kernel void @gemmTiledKernel
