// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p ll %s
// RUN: clang %S/lib.c %{s:stem}.ll -o %t -Wno-override-module
// RUN: %t | %FileCheck %s
plugin core;
plugin mem;

extern fun println_char[mem.M 0, I8]: mem.M 0;
extern fun print_str[mem.M 0, mem.Ptr0 «⊤:Nat; I8»]: mem.M 0;

extern fun main(m: mem.M 0, argc: I32, argv: mem.Ptr0 (mem.Ptr0 I8)): [mem.M 0, I32] =
    ret (m, p1) = mem.slot («15; I8», 0) $ m;
    let m       = mem.store (m, p1, "Hello, World!\n\0");
    let p2        = core.bitcast (mem.Ptr0 «⊤:Nat; I8») p1;
    ret m       = println_char $ (m, 'x');
    ret m       = print_str $ (m, p2);
    return (m, 0I32);
// CHECK: x
// CHECK: Hello, World!
