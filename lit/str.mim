// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p ll %s
// RUN: clang %S/lib.c %{s:stem}.ll -o %t -Wno-override-module
// RUN: %t | %FileCheck %s
plugin core;
plugin mem;

extern fun println_char[mem.M 0, mem.Char]: mem.M 0;
extern fun print_str[mem.M 0, mem.Ptr0 mem.Char]: mem.M 0;

extern fun main(m: mem.M 0, argc: I32, argv: mem.Ptr0 «core.idx2nat argc; mem.Ptr0 mem.Char»): [mem.M 0, I32] =
    ret (m, p1) = mem.slot («15; mem.Char», 0) $ m;
    let m       = mem.store (m, p1, "Hello, World!\n\0");
    ret m       = println_char $ (m, 'x');
    ret m       = print_str $ (m, mem.decay p1);
    return (m, 0I32);
// CHECK: x
// CHECK: Hello, World!
