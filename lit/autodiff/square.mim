// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p opt -p cps %s -p ll -o - | %FileCheck %s

plugin core;
plugin autodiff;
plugin mem;

use core.ops.u.w;

fun f(a: I32): I32 = return (a * a);

extern con main (m: mem.M 0, argc: I32, argv: mem.Ptr (mem.Ptr (I8, 0), 0), return: Cn [mem.M 0, I32]) =
    (autodiff.ad f) (42I32, ret_cont)
    where
        con ret_cont (r: I32, pb: Fn I32 → I32) =
            pb(1I32, pb_ret_cont)
            where
                con pb_ret_cont (pr: I32) =
                    return (m, 1000I32 * r + pr);
            end;
    end;

// CHECK-DAG: return{{.*}}1764084
