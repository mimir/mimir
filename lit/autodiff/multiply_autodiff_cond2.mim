// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p opt -p cps %s -p ll -o - | %FileCheck %s

plugin core;
plugin autodiff;
plugin mem;

use core.ops.s.w;


fun f(a: I32): I32 =
    let cmp = a <= 5I32;
    (twice, thrice)#cmp ()
    where
        con twice () =
            let b = 2I32 * a;
            return b;
        con thrice () =
            let b = 3I32 * a;
            return b;
    end;

extern con main (m: mem.M 0, argc: I32, argv: mem.Ptr (mem.Ptr (I8, 0), 0), return: Cn [mem.M 0, I32]) =
    let f_diff      = autodiff.ad f;
    let f_diff_cast = f_diff;
    let c           = 7I32; // 42
    f_diff_cast (c, ret_cont)
    where
        con ret_cont (r: I32, pb: Fn I32 → I32) =
            pb(1I32, pb_ret_cont)
            where
                con pb_ret_cont (pr: I32) =
                    return (m, 100I32 * r + pr);
            end;
    end;

// CHECK-DAG: return{{.*}}1402
