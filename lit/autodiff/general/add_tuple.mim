// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p opt -p cps %s -p ll -o - | %FileCheck %s

plugin core;
plugin autodiff;
plugin mem;

use core.ops.u.w;

extern con main (m: mem.M 0, argc: I32, argv: mem.Ptr (mem.Ptr (I8, 0), 0), return: Cn [mem.M 0, I32]) =
    let (tx, ty) = autodiff.add ((41I32, 42I32), (43I32, 44I32));
    return (m, tx * ty);

// CHECK-DAG: return{{.*}}7224
