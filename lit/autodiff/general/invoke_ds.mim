// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p opt %s -o - -p ll | %FileCheck %s

plugin core;
plugin cps;
plugin autodiff;
plugin mem;

use core.ops.u.w;

con extract_pb1 (s: mem.M 0, ret_cont: Cn [mem.M 0, «2; I32»]) =
    con k arg: [mem.M 0, «2; I32»] = ret_cont arg;
    k (s, ‹2; 0I32›);

con extract_pb2 (s: I32, ret_cont: Cn [mem.M 0, «2; I32»]) =
    con k arg: [mem.M 0, «2; I32»] = ret_cont arg;
    k (autodiff.zero (mem.M 0), (0I32, s));

extern con main (m: mem.M 0, argc: I32, argv: mem.Ptr (mem.Ptr ((I8), 0), 0), return: Cn [mem.M 0, I32]) =
    let a = cps.cps2ds extract_pb1 m;
    let b = cps.cps2ds extract_pb2 1I32;
    let m = autodiff.add (a#ff, b#0₂);
    let (tx, ty) = autodiff.add (a#tt, b#1₂);
    return (m, 430000I32 + ty + 100I32 * tx);

// CHECK-DAG: return{{.*}}430001
