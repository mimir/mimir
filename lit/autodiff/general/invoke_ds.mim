// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p opt %s -o - -p ll | %FileCheck %s

plugin core;
plugin cps;
plugin autodiff;

con extract_pb1 (s: %mem.M 0, ret: Cn [%mem.M 0, «2; I32»]) =
    con k arg: (%mem.M 0, «2; I32») = ret arg;
    k (s, ‹2; 0I32›);

con extract_pb2 (s: I32, ret: Cn [%mem.M 0, «2; I32»]) =
    con k arg: (%mem.M 0, «2; I32») = ret arg;
    k (%autodiff.zero (%mem.M 0), (0I32, s));

con extern main (mem: %mem.M 0, argc: I32, argv: %mem.Ptr (%mem.Ptr ((I8), 0), 0), return: Cn [%mem.M 0, I32]) =
    let a: (%mem.M 0, «2; I32») = %cps.cps2ds (%mem.M 0, (%mem.M 0, «2; I32»)) extract_pb1 mem;
    let b: (%mem.M 0, «2; I32») = %cps.cps2ds (I32, (%mem.M 0, «2; I32»)) extract_pb2 1I32;
    let m: %mem.M 0  = %autodiff.add (a#ff, b#0₂);
    let t: «2; I32»  = %autodiff.add (a#tt, b#1₂);
    let x: I32 = %core.wrap.mul 0 (100I32, t#0₂);
    let y: I32 = %core.wrap.add 0 (t#1₂, x);
    let z: I32 = %core.wrap.add 0 (430000I32, y);
    return (m, z);

// CHECK-DAG: return{{.*}}430001
