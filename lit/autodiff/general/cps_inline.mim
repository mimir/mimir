// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p opt %s -p ll -o - | %FileCheck %s

plugin core;
plugin mem;

use core.ops.u.w;

fun f(a: I32): I32 = return (2I32 * a);

extern con main (m: mem.M 0, argc: I32, argv: mem.Ptr (mem.Ptr (I8, 0), 0), return: Cn [mem.M 0, I32]) =
    ret r = f $ 42I32;
    return (m, r);

// CHECK-DAG: return{{.*}}84
