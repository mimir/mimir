// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p opt -p cps %s -p ll -o - | %FileCheck %s

plugin core;
plugin autodiff;
plugin mem;

use core.ops.u.w;

con f (a: I32, return: Cn [I32, I32]) =
    let b = 2I32 * a;
    let c = 3I32 * a;
    return (b, c);

extern con main (m: mem.M 0, argc: I32, argv: mem.Ptr (mem.Ptr (I8, 0), 0), return: Cn [mem.M 0, I32]) =
    con ret_cont ((r1 r2: I32)) =
        con pb_ret_cont (pr: I32) =
            return (m, 100I32 * r1 + pr);
        // pb((1I32,0I32,pb_ret_cont)
        pb_ret_cont 1I32;

    let f_diff = f;
    let c = 42I32;
    f_diff (c, ret_cont);

// CHECK-DAG: return{{.*}}8401
