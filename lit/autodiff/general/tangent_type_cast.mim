// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p opt %s -p ll -o - | %FileCheck %s

plugin core;
plugin autodiff;
plugin mem;

con f (a: I32, return: Cn I32) =
    return (core.wrap.add 0 (a, a));

extern con main (m: mem.M 0, argc: I32, argv: mem.Ptr (mem.Ptr (I8, 0), 0), return: Cn [mem.M 0, I32]) =
    con ret_cont r: autodiff.Tangent I32 =
        return (m, core.bitcast I32 r);

    con ret_wrap r: I32 =
        ret_cont (core.bitcast (autodiff.Tangent I32) r);

    f (43I32, ret_wrap);

// CHECK-DAG: return{{.*}}86
