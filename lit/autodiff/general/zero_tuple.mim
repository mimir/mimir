// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p opt %s -p ll -o - | %FileCheck %s

plugin core;
plugin cps;
plugin autodiff;
plugin mem;

extern con main (m: mem.M 0, argc: I32, argv: mem.Ptr («core.idx2nat argc; mem.Ptr (mem.Char, 0)», 0), return: Cn [mem.M 0, I32]) =
    let (c, _) = autodiff.zero [I32, I32];
    return (m, c);

// CHECK-DAG: return_{{[0-9]+}} ({{.*}}, 0I32)
