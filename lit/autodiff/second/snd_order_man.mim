// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p opt -p cps %s -p ll -o - | %FileCheck %s

plugin core;
plugin autodiff;
plugin mem;

use core.ops.u.w;


fun g_diff(a: I32): [I32, Fn I32 → I32] =
    let b = 3I32 + a;
    let c = a * b;
    return (c, fn (s: I32): I32 =
        let b = 2I32 * a;
        let c = 3I32 + b;
        return ((c)));

fun f(a: I32): I32 =
    con ret_cont (r: I32, pb: Fn I32 → I32) =
        con pb_ret_cont (pr: I32) = return pr;
        pb(1I32, pb_ret_cont);
    g_diff (a, ret_cont);

extern con main (m: mem.M 0, argc: I32, argv: mem.Ptr (mem.Ptr (I8, 0), 0), return: Cn [mem.M 0, I32]) =
    con ret_cont (r: I32, pb: Fn I32 → I32) =
        con pb_ret_cont (pr: I32) =
            return (m, 100I32 * r + pr);
        pb(1I32, pb_ret_cont);

    let f_diff      = autodiff.ad f;
    let f_diff_cast = f_diff;
    let c           = 42I32;
    f_diff_cast (c, ret_cont);

// CHECK-DAG: return{{.*}}8702
