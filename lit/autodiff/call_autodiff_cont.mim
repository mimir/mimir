// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p opt -p cps  %s -p ll -o - | %FileCheck %s

plugin core;
plugin autodiff;
plugin mem;

use core.ops.u.w;


fun g(b: I32): I32 =
    let c = 3I32 + b;
    return c;

// 4(3+2a)
fun f(a: I32): I32 =
    let b = 2I32 * a;
    ret x = g $ b;
    let c = 4I32 * x;
    return c;

extern con main(m: mem.M 0, argc: I32, argv: mem.Ptr (mem.Ptr (I8, 0), 0), return: Cn [mem.M 0, I32]) =
    let f_diff = autodiff.ad f;
    let c      = 42I32;
    f_diff (c, ret_cont)
    where
        con ret_cont (r: I32, pb: Cn [I32, Cn I32]) =
            pb(1I32, pb_ret_cont)
            where
                con pb_ret_cont (pr: I32) =
                    return (m, 100I32 * r + pr);
            end;
    end;

// CHECK-DAG: return{{.*}}34808
