// RUN: %mim %s -o - | %FileCheck %s
plugin core;
plugin compile;

use core.ops.n;

extern fun dont_know []: Bool;

// `c` is always 23, so the comparison folds and the `false` branch dies.
// `x` is propagated as an expression; `t` joins 3 and 4 and stays.
extern fun f (x: Nat): Nat =
    head (23, x, 3) where
        con head (c x t: Nat) =
            ret cond = dont_know $ ();
            (exit, body)#cond () where
                con body () =
                    (false, true)#(core.ncmp.e (c, 23)) () where
                        con true () = next (c, x, 4);
                        con false () =
                            let c = c + 1;
                            let x = x + 1;
                            next (c, x, t);
                        con next (c x t: Nat) as cxt = head cxt;
                    end;
                con exit () = return (c + x + t);
            end
    end;

extern lam _compile (): compile.Phase =
    compile.phases ff (
        compile.beta_red,
        compile.eta_conv,
        compile.sccp,
    );

// CHECK-NOT:  con false
// CHECK-DAG:  con head ({{[[:alnum:]_]+}}: Nat) =
// CHECK-DAG:  head 3;
// CHECK-DAG:  head 4;
// CHECK-DAG:  core.nat.add (23, x);
// CHECK-NOT:  con false
