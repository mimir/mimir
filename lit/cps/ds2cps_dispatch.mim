// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p opt -p clos %s -p ll
// RUN: clang %{s:stem}.ll -o %t -Wno-override-module
// RUN: %t; test $? -eq 39
// RUN: %t select-true; test $? -eq 42

// A dynamically selected direct-style callee must be lifted as one CPS
// dispatch. Both targets capture `argc`, exercising closure conversion after
// the `%cps.cps2ds_dep` wrappers have been removed.
plugin core;
plugin cps;

con extern main(mem: %mem.M 0, argc: I32,
                argv: %mem.Ptr (%mem.Ptr (I8, 0), 0),
                return: Cn [%mem.M 0, I32]) =
    lam subtract(y: I32): I32 = %core.wrap.sub 0 (y, argc);
    lam add(y: I32): I32 = %core.wrap.add 0 (y, argc);

    let condition = %core.icmp.sg (argc, 1I32);
    let result = (subtract, add)#condition 40I32;
    return (mem, result);
