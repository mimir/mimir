// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p opt %s -p ll -o - | %FileCheck %s

plugin core;
plugin cps;
plugin mem;

lam U (n: Nat): * = Idx n;
lam f (n: Nat): Idx n = core.idx n 0 42;

extern con main (m: mem.M 0, argc: I32, argv: mem.Ptr (mem.Ptr (I8, 0), 0), return: Cn [mem.M 0, I32]) =
    let n = i32;
    let c = f n;
    return (m, c);

// CHECK-DAG: return{{.*}}42
