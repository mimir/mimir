// RUN: %mim -p opt %s -o - | %FileCheck %s

// see https://github.com/mimir/mimir/issues/429

plugin core;
plugin cps;

lam U (n: Nat): * = «n; Nat»;

con f (n: Nat, return: Cn «n; Nat») = return ‹i: n; %core.bitcast Nat i›;

fun extern main (mem: %mem.M 0, argc: I32, argv: %mem.Ptr (%mem.Ptr (I8, 0), 0)): [%mem.M 0, I32] =
    let n  = %core.bitcast Nat argc;
    let xs = %cps.cps2ds_dep (Nat, U) f n;
    return (mem, %core.bitcast I32 (xs#(%core.idx n 0 0)));

// CHECK: fun extern main
// CHECK: return
