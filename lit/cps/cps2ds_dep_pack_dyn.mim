// RUN: %mim -p opt %s -o - | %FileCheck %s

// see https://github.com/mimir/mimir/issues/429

plugin core;
plugin cps;
plugin mem;

lam U (n: Nat): * = «n; Nat»;

con f (n: Nat, return: Cn «n; Nat») = return ‹i: n; core.idx2nat i›;

extern fun main (m: mem.M 0, argc: I32, argv: mem.Ptr («core.idx2nat argc; mem.Ptr (mem.Char, 0)», 0)): [mem.M 0, I32] =
    let n  = core.idx2nat argc;
    let xs = cps.cps2ds_dep U f n;
    return (m, core.bitcast I32 (xs#(core.idx 0 n 0)));

// CHECK: extern con main
// CHECK: return
