// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p opt %s -p ll -o - | %FileCheck %s

// sanity check that the pass do not interfere with normal operation

plugin core;
plugin cps;
plugin mem;

con h (m: mem.M 0, a: I32, return: Cn [mem.M 0, I32]) =
    let c = a;
    return (m, c);

extern con main (m: mem.M 0, argc: I32, argv: mem.Ptr (mem.Ptr (I8, 0), 0), return: Cn [mem.M 0, I32]) =
    h (m, 40I32, return);

// CHECK-DAG: return{{.*}}40
