// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p opt %s -p ll -o - | %FileCheck %s

plugin core;
plugin cps;
plugin mem;

use core.ops.u.w;

fun f(a: I32): I32 =
    return (2I32 + a);

fun f2(a: I32): I32 =
    return (30I32 + a);

extern con main (m: mem.M 0, argc: I32, argv: mem.Ptr (mem.Ptr (I8, 0), 0), return: Cn [mem.M 0, I32]) =
    return (m, cps.cps2ds f2 (cps.cps2ds f 10I32));

// CHECK-DAG: return{{.*}}42
