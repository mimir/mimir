// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p opt %s -p ll -o - | %FileCheck %s

plugin core;
plugin cps;
plugin mem;

con f(a: I32, return: Cn I32)@tt = return (core.wrap.add 0 (2I32, a));

extern con main(m: mem.M 0, argc: I32, argv: mem.Ptr (mem.Ptr (I8, 0), 0), return: Cn [mem.M 0, I32]) =
    let g = cps.cps2ds f;
    let c1 = g 38I32;
    let h = cps.cps2ds f;
    let c2 = h (c1);
    return (m, c2);

// CHECK-DAG: return{{.*}}42
