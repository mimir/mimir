list(APPEND CMAKE_MODULE_PATH "@PROJECT_SOURCE_DIR@/cmake")

if(NOT TARGET mim::libmim OR NOT TARGET mim::mim)
    message(FATAL_ERROR "The build-tree mim package requires the in-tree MimIR targets")
endif()

# No MIM_PLUGIN_LIST/LAYOUT reset here: this package is only ever included from within the MimIR
# build, which already resets them once per configure - resetting again would drop every plugin
# registered before this find_package(mim).
set(MIM_TARGET_NAMESPACE "mim::")

if(NOT COMMAND add_mim_plugin)
    include(Mim)
endif()
