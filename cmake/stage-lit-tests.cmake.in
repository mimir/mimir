cmake_minimum_required(VERSION @CMAKE_MINIMUM_REQUIRED_VERSION@)

set(MIM_LIT_STAGE_ROOT "@CMAKE_CURRENT_BINARY_DIR@/tests")
set(MIM_LIT_STAGE_FILES
@MIM_LIT_STAGE_FILES_SCRIPT@)

file(MAKE_DIRECTORY "${MIM_LIT_STAGE_ROOT}")

set(staged "${MIM_LIT_STAGE_ROOT}/.stamp")
foreach(entry IN LISTS MIM_LIT_STAGE_FILES)
    string(REPLACE "|" ";" pair "${entry}")
    list(GET pair 0 src)
    list(GET pair 1 dst_rel)
    cmake_path(SET dst NORMALIZE "${MIM_LIT_STAGE_ROOT}/${dst_rel}")
    get_filename_component(dst_dir "${dst}" DIRECTORY)
    file(MAKE_DIRECTORY "${dst_dir}")
    file(COPY_FILE "${src}" "${dst}" ONLY_IF_DIFFERENT)
    list(APPEND staged "${dst}")
endforeach()

# Removing only stale files keeps the mtimes of unchanged ones.
file(GLOB_RECURSE existing "${MIM_LIT_STAGE_ROOT}/*")
foreach(file IN LISTS existing)
    if(NOT file IN_LIST staged)
        file(REMOVE "${file}")
    endif()
endforeach()
