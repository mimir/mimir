{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build-${presetName}",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "MIM_BUILD_EXAMPLES": "ON"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "asan",
      "displayName": "Debug with ASan, UBSan, and LSan",
      "inherits": "base",
      "condition": {
        "type": "notEquals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined,leak,bounds -fsanitize-address-use-after-scope -fno-omit-frame-pointer -fno-sanitize=vptr",
        "MIM_BUILD_PYTHON": "OFF",
        "MIM_TEST_ROUNDTRIP": "OFF"
      }
    },
    {
      "name": "static",
      "displayName": "Debug with static libraries and plugins",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_SHARED_LIBS": "OFF"
      }
    },
    {
      "name": "docs",
      "displayName": "Documentation",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "OFF",
        "MIM_BUILD_EXAMPLES": "OFF",
        "MIM_BUILD_DOCS": "ON",
        "MIM_BUILD_PYTHON": "OFF"
      }
    },
    {
      "name": "wasm",
      "displayName": "WebAssembly playground (Emscripten)",
      "inherits": "base",
      "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_SHARED_LIBS": "OFF",
        "BUILD_TESTING": "OFF",
        "MIM_BUILD_EXAMPLES": "OFF",
        "MIM_BUILD_PYTHON": "OFF",
        "MIM_VERIFY_PLUGINS": "OFF",
        "MIM_NATIVE_MIM": "${sourceDir}/build/bin/mim"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug",   "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "asan",    "configurePreset": "asan" },
    { "name": "static",  "configurePreset": "static" },
    { "name": "docs",    "configurePreset": "docs", "targets": ["docs"] },
    { "name": "wasm",    "configurePreset": "wasm", "targets": ["mim_playground"] }
  ],
  "testPresets": [
    { "name": "debug",   "configurePreset": "debug",   "output": { "outputOnFailure": true } },
    { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } },
    { "name": "asan",    "configurePreset": "asan",    "output": { "outputOnFailure": true } },
    { "name": "static",  "configurePreset": "static",  "output": { "outputOnFailure": true } }
  ]
}
