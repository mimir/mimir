/// Example used in `docs/README.md`: `iter f (n, x)` applies `f` to `x` `n` times.
/// Polymorphic over `T` and recursive; `extern` keeps it as a root so the
/// sea-of-nodes cleanup does not remove it.
plugin core;

lam extern iter {T: *} (f: T → T) (n: Nat, x: T)@(%core.pe.is_closed n): T =
    let cond = %core.ncmp.le (n, 0);
    (alt, cons)#cond () where
        lam alt (): T =
            let m = %core.nat.sub (n, 1);
            let y = f x;
            iter f (m, y);
        lam cons(): T = x;
    end;
