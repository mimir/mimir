/// # The compile Plugin {#compile}
///
/// @see mim::plug::compile
///
/// [TOC]
///
/// This plugin handles the optimization pipeline of the compilation of MimIR programs.
/// This plugin's axioms can register mim::Phase%s.
/// Invoke the optimization pipeline by defining a function `_compile: [] → %%compile.Phase`.
///
/// ## Types
///
/// ### %%compile.Phase
///
/// The type of compilation phases.
///
axm %compile.Phase: *;
///
/// ## Utility
///
/// ### %%compile.is_loaded
///
/// Checks whether the given plugin is loaded.
///
axm %compile.is_loaded: {n: Nat} → «n; I8» → Bool, normalize_is_loaded;
///
/// ### %%compile.named_phase
///
/// Resolves to the `%compile.Phase` annex with the given fully-qualified name (e.g. `"clos.clos_conv_phase"`).
/// Resolution is deferred until the phase pipeline is built so that the referenced plugin's `.mim` file does not
/// have to be imported by users of this axm.
/// If the named annex is missing at pipeline build time (its plugin is not loaded), it is silently elided, i.e. the
/// enclosing `%compile.phases` simply skips it.
///
axm %compile.named_phase: {n: Nat} → «n; I8» → %compile.Phase;
///
/// ### %%compile.cond_phase
///
/// Yields `phase` if the named plugin is loaded, otherwise `%compile.null_phase`.
/// Used to gate whole sub-pipelines on a plugin without importing it.
///
axm %compile.cond_phase: {n: Nat} → «n; I8» → %compile.Phase → %compile.Phase, normalize_cond_phase;
///
/// ## Constructors
///
/// ### %%compile.phases
///
/// Sets up `n` phases and bundles them
///
axm %compile.phases: {n: Nat} → Bool → «n; %compile.Phase» → %compile.Phase;
///
/// ### Phases
///
axm %compile.beta_red_phase:                            %compile.Phase;
axm %compile.branch_normalize_phase:                    %compile.Phase;
axm %compile.cleanup_phase:                             %compile.Phase;
axm %compile.eta_exp_phase:                             %compile.Phase;
axm %compile.eta_red_phase:                             %compile.Phase;
axm %compile.lam_spec_phase:                            %compile.Phase;
axm %compile.null_phase:                                %compile.Phase;
axm %compile.ret_wrap_phase:                            %compile.Phase;
axm %compile.scalarize_phase:                           %compile.Phase;
axm %compile.tail_rec_elim_phase:                       %compile.Phase;
axm %compile.prefix_cleanup_phase: {n: Nat} → «n; I8» → %compile.Phase;

let %compile.internal_cleanup_phase = %compile.prefix_cleanup_phase "internal_";
