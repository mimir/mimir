/// # The matrix Plugin {#matrix}
///
/// @see mim::plug::matrix
///
/// [TOC]
///
/// Buffer-world matrix/tensor operations: a generic `map_reduce` loop-nest abstraction plus derived operations
/// (matrix product, transpose, sum, pad, concat, ...), lowered to `%%affine.For` loop nests over `%%buffer` element
/// operations.
///
/// This is the bufferized mirror of the `tensor` plugin: every op here is the `%%buffer.Buf` counterpart of a
/// `%%tensor.*` op, takes the same groups in the same order, and threads `%%mem.M` on top.
/// `%%tensor.lower_to_mem` bufferizes the SSA-world `%%tensor.*` ops onto these.
///
/// ## Dependencies
///
plugin core;
plugin cps; // for %cps.cps2ds
plugin affine;
plugin buffer;
///
/// ## Types
///
/// Matrices are n-dimensional dependent arrays, represented by the shared `%%buffer.Buf` type.
/// The element operations (`%%buffer.alloc` / `%%buffer.read` / `%%buffer.write` / `%%buffer.constant` /
/// `%%buffer.shape`) and their lowering to `%%mem.Ptr` (`%%buffer.lower_ptr`) live in the `buffer` plugin.
///
/// ### %%matrix.Ring
///
/// Represents an [algebraic ring](https://en.wikipedia.org/wiki/Ring_(mathematics)).
/// E.g., `let nat_ring = (Nat, 0, %%core.nat.add, %%core.nat.mul);`.
///
/// %%tensor.Ring is an alias for this type: `tensor` bufferizes onto `%%matrix.*`, so `matrix` is the lower of the
/// two layers and owns the definition.
let %matrix.Ring = [
    T: *,
    _0: T,
    add: [T, T] → T,
    mul: [T, T] → T,
];
///
/// ## Operations
///
/// ### %%matrix.map_reduce
///
/// The buffer-world counterpart of %%tensor.map_reduce and the workhorse behind every operation below:
/// a reduction fold over an affinely-indexed loop nest on `%%buffer.Buf` operands, threading `%%mem.M`.
///
/// The iteration domain and the result shape are stated explicitly:
/// * `Sr`: the bounds of the full loop nest of length `Rn`. Its leading `Ro` dimensions are the parallel output loops; the trailing `Rn - Ro` dimensions are the reduction loops that are folded away.
/// * `So`: the shape of the result buffer (rank `Ro`). It may differ from the leading `Ro` bounds of `Sr`, which is what lets `map_out` write to a re-shaped output (e.g. a transpose).
///
/// The full loop iteration vector `(o…, r…)` has length `Rn`.
/// * `f` folds one element of each input into the accumulator (seeded per output cell with `init`); unlike %%tensor.map_reduce's `f` it is mem-threaded.
/// * `map_out` maps the full loop vector to the `Ro` write coordinates in the result. As the reduction is folded away before the write, it must depend only on the leading `Ro` output indices.
/// * `maps#i` maps the full loop vector to the `Ris#i` read coordinates of input `i`. Transposes, slices and broadcasts are expressed here, by reading the inputs accordingly.
///
/// `nis`, `Ro`, `Rn` and the `Ris` must be literals before entering the `%%matrix.lower_map_reduce` phase for the
/// lowering to succeed; the bounds `So` and `Sr` may be symbolic.
///
axm %matrix.map_reduce: {nis: Nat}
                      → {To: *, Ro Rn: Nat}
                      → [So: «Ro; Nat», Sr: «Rn; Nat»]
                      → {Tis: «nis; *», Ris: «i: nis; Nat», Sis: «i: nis; «Ris#i; Nat»»}
                      → [f: Fn [%mem.M 0, To, «i: nis; Tis#i»] → [%mem.M 0, To], init: To]
                      → [map_out: [«Rn; %affine.index»] → «Ro; %affine.index»]
                      → [maps: «i: nis; ([«Rn; %affine.index»] → «Ris#i; %affine.index»)»]
                      → [%mem.M 0, is: «i: nis; %buffer.Buf (Ris#i, Sis#i, Tis#i)»]
                      → [%mem.M 0, %buffer.Buf (Ro, So, To)];
///
/// ### %%matrix.map_reduce_idx
///
/// The index-tuple flavor of %%matrix.map_reduce, inspired by and generalizing einsum.
/// It maps a combination function `f` over the elements addressed by a set of index tuples and reduces the
/// results with an accumulator starting from `init`; e.g. `einsum(idx, is) = map_reduce_idx(0, +, product, is)`.
/// Instead of the affine `map_out`/`maps` of %%matrix.map_reduce, each input carries its own subscript tuple
/// inline - `is#i` is a pair of the `Ris#i` loop ids to read it at and the buffer itself - and the loop bounds are
/// recovered from those subscripts rather than being passed as `Sr`.
/// %%matrix.product_2d, %%matrix.transpose_2d, and %%matrix.sum are all expressed via `map_reduce_idx`
/// (see the `_impl` annexes below).
/// The counts, dimensions, and indices are assumed to be statically known, to avoid inline meta-programming.
///
/// * `nis`: the number of inputs
/// * `To`/`Ro`: the element type and rank of the result
/// * `So`: the shape of the result buffer
/// * `Tis`/`Ris`/`Sis`: the element type, rank and shape of each input
/// * `init`: the initial accumulator, seeded per output cell
/// * `f`: the inner combination, folding one element of each input into the accumulator
/// * `is#i`: the `Ris#i` loop ids to read input `i` at, paired with the input buffer itself
///
/// The group structure mirrors %%matrix.map_reduce: input count, then output element type and rank, then the
/// output shape as the only *explicit* group, then the input meta.
/// Everything but the output shape `So` is inferred:
/// * `To` from `init`, and `Ro` from `So` itself;
/// * `nis`, `Tis`, `Ris` and `Sis` from `is` — `%%buffer.Buf` spells its rank, shape and element type out as
///   ordinary arguments, so they unify structurally (no nested-array peeling involved).
///
axm %matrix.map_reduce_idx: {nis: Nat}
                          → {To: *, Ro: Nat}
                          → [So: «Ro; Nat»]
                          → {Tis: «nis; *», Ris: «nis; Nat», Sis: «i: nis; «Ris#i; Nat»»}
                          → [ mem: %mem.M 0, init: To,
                              f: Fn [%mem.M 0, To, «i: nis; Tis#i»] → [%mem.M 0, To],
                              is: «i: nis; [«Ris#i; Nat», %buffer.Buf (Ris#i, Sis#i, Tis#i)]»]
                          → [%mem.M 0, %buffer.Buf (Ro, So, To)], normalize_map_reduce_idx;
///
/// ### %%matrix.product_2d
///
/// Computes the matrix product of two 2-dimensional matrices in the ring `R` - the buffer-world counterpart of
/// %%tensor.product_2d.
/// `[R: %%matrix.Ring]` is the leading *explicit* group, as in %%tensor.product_2d: a ring cannot be recovered from
/// `R#T` by inference.
///
axm %matrix.product_2d: [R: %matrix.Ring]
                      → {m k l: Nat}
                      → [%mem.M 0, t1: %buffer.Buf (2, (m, k), R#T), t2: %buffer.Buf (2, (k, l), R#T)]
                      → [%mem.M 0, %buffer.Buf (2, (m, l), R#T)], normalize_product_2d;

/// Fused multiply-add over the ring `R`; `ab#0` is the `t1` element, `ab#1` the `t2` element.
/// The mem-threaded counterpart of the `tensor` plugin's `conv_fun`.
fun product_2d_fun [R: %matrix.Ring] (mem: %mem.M 0, acc: R#T, ab: «2; R#T»)@tt: [%mem.M 0, R#T] =
    return (mem, R#add (acc, R#mul (ab#0_2, ab#1_2)));

/// Follows the principle `ij ← ik, kj` (`out[i, j] = Σ_k t1[i, k] · t2[k, j]`) using `R#mul` as
/// combination and `R#add` as reduction.
fun %matrix.product_2d_impl [R: %matrix.Ring] {m k l: Nat}
                            (mem: %mem.M 0, t1: %buffer.Buf (2, (m, k), R#T), t2: %buffer.Buf (2, (k, l), R#T))@tt
                          : [%mem.M 0, %buffer.Buf (2, (m, l), R#T)] =
    let s_out = (m, l);
    let is    = (((0, 2), t1), ((2, 1), t2));
    return (%matrix.map_reduce_idx s_out (mem, R#_0, product_2d_fun R, is));
///
/// ### %%matrix.transpose_2d
///
/// Permutes the dimensions of a 2-dimensional matrix - the buffer-world counterpart of %%tensor.transpose_2d.
/// As there, the shape is a single `«2; Nat»` vector instead of two separate `Nat`s, and `{T}` precedes `{s}`.
///
axm %matrix.transpose_2d: {T: *}
                        → {s: «2; Nat»}
                        → [%mem.M 0, input: %buffer.Buf (2, s, T)]
                        → [%mem.M 0, %buffer.Buf (2, (s#tt, s#ff), T)], normalize_transpose_2d;

/// Ignores the (⊥) accumulator and just returns the read value - the mem-threaded `tensor_copy`.
fun matrix_copy {T: *} (mem: %mem.M 0, acc y: T)@tt: [%mem.M 0, T] = return (mem, y);

/// Transpose a matrix by iterating the indices in swapped order.
fun %matrix.transpose_2d_impl {T: *} {s: «2; Nat»}
                              (mem: %mem.M 0, input: %buffer.Buf (2, s, T))@tt
                            : [%mem.M 0, %buffer.Buf (2, (s#tt, s#ff), T)] =
    let s_out = (s#tt, s#ff);
    let is    = ((1, 0), input);
    return (%matrix.map_reduce_idx s_out (mem, ⊥:T, matrix_copy, is));
///
/// ### %%matrix.sum
///
/// Sums up all elements of a matrix with `R#add` and returns a scalar.
/// There is no `%%tensor.*` counterpart; like %%matrix.product_2d the ring `R` leads as an explicit group.
///
axm %matrix.sum: [R: %matrix.Ring]
               → {r: Nat, s: «r; Nat»}
               → [%mem.M 0, input: %buffer.Buf (r, s, R#T)]
               → [%mem.M 0, R#T];

/// Folds one element into the accumulator with `R#add`.
fun sum_fun [R: %matrix.Ring] (mem: %mem.M 0, acc y: R#T)@tt: [%mem.M 0, R#T] = return (mem, R#add (acc, y));

/// Reduces every axis at once: all `r` loops are reduction loops, so the result is a single cell.
fun %matrix.sum_impl [R: %matrix.Ring] {r: Nat, s: «r; Nat»}
                     (mem: %mem.M 0, input: %buffer.Buf (r, s, R#T))@tt
                   : [%mem.M 0, R#T] =
    let idxs       = ‹i: r; %core.nat.add (1, %core.bitcast Nat i)›;
    let is         = (idxs, input);
    let (mem, res) = %matrix.map_reduce_idx 1 (mem, R#_0, sum_fun R, is);
    return (mem, %core.bitcast R#T res);
///
/// ### %%matrix.broadcast
///
/// Expands the dimensions of `input` to fit `s_out` - the buffer-world counterpart of %%tensor.broadcast:
/// for all `i`, either `s_in#i = s_out#i` or `s_in#i = 1`, and the size-1 dimensions are expanded to fit `s_out`.
/// The input/output buffer shapes (`ri`/`si`, `ro`/`so`) are the actual — possibly size-1-folded — buffer
/// shapes and are inferred from the operands; `s_in`/`s_out` are the logical (unfolded) shapes.
///
axm %matrix.broadcast: {T: *, ri: Nat, si: «ri; Nat», ro: Nat, so: «ro; Nat», r: Nat}
                     → [s_in s_out: «r; Nat»]
                     → [%mem.M 0, input: %buffer.Buf (ri, si, T)]
                     → [%mem.M 0, %buffer.Buf (ro, so, T)];
///
/// ### %%matrix.pad
///
/// Pads each axis - the buffer-world counterpart of %%tensor.pad: `out[…o…] = input[…o−lo…]` inside the interior,
/// `value` (mode 0, constant) or the clamped edge element (mode ≠ 0, replicate) outside.
/// The groups mirror %%tensor.pad (`{T, r}` → input shape → pad parameters → operands); unlike there, `s_out`
/// cannot be computed here (`pad_shape` lives in the `tensor` plugin), so it rides along with the parameters.
/// The buffer shapes are stated as the logical shapes; `%%buffer.Buf` normalizes literal size-1 axes
/// away, so they agree with the folded buffer handles, and the loop generation folds its read/write
/// indices accordingly.
///
axm %matrix.pad: {T: *, r: Nat}
              → [s_in: «r; Nat»]
              → [s_out: «r; Nat», mode: Nat, lo hi: «r; Nat»]
              → [%mem.M 0, input: %buffer.Buf (r, s_in, T), value: T]
              → [%mem.M 0, %buffer.Buf (r, s_out, T)];
///
/// ### %%matrix.concat
///
/// Joins `nis` buffers along axis `ax` - the buffer-world counterpart of %%tensor.concat.
/// `out[…o…] = is#k[… o with o#ax ↦ o#ax − off#k …]`, where `k` is the input whose range `o#ax` lands in
/// (`off` are the prefix sums of the per-input extents along `ax`).
/// Unlike %%tensor.concat, `s_out` (the summed extent along `ax`, the shared extents elsewhere) is passed
/// explicitly, since `concat_shape` lives in the `tensor` plugin.
///
axm %matrix.concat: {T: *, nis r: Nat}
                  → [ax: Idx r]
                  → {Sis: «i: nis; «r; Nat»»}
                  → [s_out: «r; Nat»]
                  → [%mem.M 0, is: «i: nis; %buffer.Buf (r, Sis#i, T)»]
                  → [%mem.M 0, %buffer.Buf (r, s_out, T)];
///
/// ## Phases
///
/// * `lower_matrix`: lowers the high-level matrix axioms to the low-level ones (`map_reduce_idx`, ...) by re-applying the matching `*_impl` annexes.
/// * `lower_map_reduce_idx`: lowers `%%matrix.map_reduce_idx` into `%%affine.For` loops, making the iteration scheme explicit.
/// * `lower_map_reduce`: lowers the affine buffer-world ops (`%%matrix.map_reduce`, `%%matrix.broadcast`, `%%matrix.pad`,
/// `%%matrix.concat`) to `%%affine.For` loops over `%%buffer` element operations.
///
axm %matrix.lower_matrix:         %compile.Phase;
axm %matrix.lower_map_reduce_idx: %compile.Phase;
axm %matrix.lower_map_reduce:     %compile.Phase;
