/// # The spirv Plugin {#spirv}
///
/// @see mim::plug::spirv
///
/// [TOC]
///
/// A plugin providing a spir-v backend for MimIR.
///
import core;
import math;
import mem;
import vec;

let M = %mem.M 0;

/// ## Primitive Types
axm %spirv.Bool: ★;

/// ## Execution Models
///
axm %spirv.Model: ★;
axm %spirv.model(fragment, vertex, compute): %spirv.Model;

axm %spirv.Mode: ★;
axm %spirv.mode(
    invocations,
    spacing_equal,
    spacing_fractional_even,
    spacing_fractional_odd,
    vertex_order_cw,
    vertex_order_ccw,
    pixel_center_integer,
    origin_upper_left,
    origin_lower_left,
    early_fragment_tests,
    // TODO: add more modes
): %spirv.Mode;

axm %spirv.entry: %spirv.Model → {n: Nat} → «n; %spirv.Mode» → ★;

/// ## Decorations
///
axm %spirv.Decoration: ★;
let Decoration = %spirv.Decoration;

axm %spirv.decorc(block): %spirv.Decoration;
axm %spirv.decor(builtin): Nat → %spirv.Decoration;
axm %spirv.decor(location): Nat → %spirv.Decoration;

/// ## Storage Classes
///
axm %spirv.StorageClass: [write: Bool] → ★;
///
axm %spirv.storage(INPUT):          %spirv.StorageClass ff;
axm %spirv.storage(OUTPUT):         %spirv.StorageClass tt;
axm %spirv.storage(UNIFORM):        %spirv.StorageClass ff;
axm %spirv.storage(WORKGROUP):      %spirv.StorageClass tt;
axm %spirv.storage(PRIVATE):        %spirv.StorageClass tt;
axm %spirv.storage(FUNCTION):       %spirv.StorageClass tt;
axm %spirv.storage(PUSH_CONSTANT):  %spirv.StorageClass ff;
axm %spirv.storage(STORAGE_BUFFER): %spirv.StorageClass tt;
axm %spirv.storage(IMAGE):          %spirv.StorageClass tt;

/// ## Variables and Pointers
///
axm %spirv.Ptr: {write: Bool} → (%spirv.StorageClass write) → ★ → ★;
let Ptr = %spirv.Ptr;
axm %spirv.variable: Nat
    → {write: Bool}
    → [class: %spirv.StorageClass write]
    → {n: Nat} → «n; Decoration»
    → [T: ★]
    → [M, %spirv.Ptr class T];

axm %spirv.input: %spirv.variable 0 %spirv.storage.INPUT;
axm %spirv.output: %spirv.variable 0 %spirv.storage.OUTPUT;
axm %spirv.uniform: %spirv.variable 0 %spirv.storage.UNIFORM;

axm %spirv.load: {write: Bool, class: %spirv.StorageClass write}
    → {T: ★}
    → [M, Ptr class T]
    → [M, T];

axm %spirv.store: {class: %spirv.StorageClass tt}
    → {T: ★}
    → [M, Ptr class T, T]
    → [M];

/// ## Builtins
///
axm %spirv.builtin(frag_coord): {n: Nat, modes: «n; %spirv.Mode»}
    → [%spirv.entry %spirv.model.fragment modes]
    → %spirv.variable %spirv.storage.INPUT (%spirv.decor.builtin 15) «2; %math.F32»;

axm %spirv.builtin(vertex_index): {n: Nat, modes: «n; %spirv.Mode»}
    → [%spirv.entry %spirv.model.vertex modes]
    → %spirv.variable %spirv.storage.INPUT (%spirv.decor.builtin 42) Nat;

axm %spirv.builtin(instance_index): {n: Nat, modes: «n; %spirv.Mode»}
    → [%spirv.entry %spirv.model.vertex modes]
    → %spirv.variable %spirv.storage.INPUT (%spirv.decor.builtin 43) Nat;

axm %spirv.builtin(vertex_id): {n: Nat, modes: «n; %spirv.Mode»}
    → [%spirv.entry %spirv.model.vertex modes]
    → %spirv.variable %spirv.storage.INPUT (%spirv.decor.builtin 5) Nat;

axm %spirv.builtin(instance_id): {n: Nat, modes: «n; %spirv.Mode»}
    → [%spirv.entry %spirv.model.vertex modes]
    → %spirv.variable %spirv.storage.INPUT (%spirv.decor.builtin 6) Nat;

axm %spirv.builtin(position): {n: Nat, modes: «n; %spirv.Mode»}
    → [%spirv.entry %spirv.model.vertex modes]
    → %spirv.variable %spirv.storage.OUTPUT (%spirv.decor.builtin 0) «4; %math.F32»;
