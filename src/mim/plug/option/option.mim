/// # The option Plugin {#option}
///
/// @see mim::plug::option
///
/// An optional value type: either a value of type `T` or nothing.
///
/// [TOC]
///
/// ## Dependencies
///
plugin core;
///
/// ## Types
///
/// ### Opt
///
/// The option type: `| None | Some: T`.
/// Unlike `[] ∪ T`, it neither collapses `Opt []` to `[]` nor flattens `Opt (Opt T)` to `Opt T`.
/// It is nominal, but its constructors `None` and `Some` are public.
///
anx nom Opt (T: *) =
    | None
    | Some: T;
///
/// ## Constructors
///
/// ### some
///
/// Wraps a value into an option.
///
anx lam some {T: *} (v: T): Opt T = (Opt T)#Some v;
///
/// ### none
///
/// The empty option.
///
anx lam none (T: *): Opt T = (Opt T)#None;
///
/// ### some_if
///
/// Wraps `v` into an option iff `b` holds.
///
anx lam some_if {T: *} (b: Bool, v: T): Opt T = (none T, some v)#b;
///
/// ## Operations
///
/// ### is_some
///
/// Returns `tt` if the option contains a value.
///
anx lam is_some {T: *} (o: Opt T): Bool =
    match o with
        | None   => ff
        | Some _ => tt;
///
/// ### unwrap_unsafe
///
/// Extracts the value without checking - undefined behavior for `option.none`.
///
axm unwrap_unsafe: {T: *} → Opt T → T, normalize_unwrap_unsafe;
///
/// ### unwrap_or
///
/// Extracts the value or returns `default`.
///
anx lam unwrap_or {T: *} (o: Opt T) (default: T): T =
    match o with
        | None   => default
        | Some x => x;
