/// # The sflow Plugin {#sflow}
///
/// @see mim::plug::sflow
///
/// [TOC]
///
/// ## Dependencies
///
plugin compile;
plugin core;
///
/// A plugin with axioms to model explicit structured
/// control flow and passes to transform arbitrary code
/// to structured control flow constructs.
///
/// ## Structured Control Flow
///
/// Any basic block ending with an application with
/// either one of the following two axioms as a callee
/// is a header block. In structured control flow, all
/// branching has to conform to one of those structures.
///
/// Branching to a header is only allowed in loop constructs
/// from the continue block.
///
/// Each header block must strictly structurally dominate its
/// merge block.

lam inc (step: Nat) = %core.nat.add (step, 1);

axm %sflow.Path: ★;
let Path = %sflow.Path;
axm %sflow.ROOT: Path;
axm %sflow.arm: Bool → [Path, Nat] → Path;
axm %sflow.case: Nat → [Path, Nat] → Path;
axm %sflow.default: [Path, Nat] → Path;

axm %sflow.Token: Path → Nat → ★;
let Token = %sflow.Token;
let %sflow.Root = Token %sflow.ROOT 0;

/// Capability flowing through the arms/merge target of an `if`.
/// `B` is the merge payload.
axm %sflow.If: {path: Path, step: Nat} → [token: %sflow.Token path step] → [B: ★] → ★;
let If = %sflow.If;
/// Capability flowing through the cases/break target of a `switch`.
/// `C` is the (fall-through) case payload, `B` the break payload.
axm %sflow.Switch: {path: Path, step: Nat} → [token: %sflow.Token path step]
  → [C: ★] → [B: ★] → ★;
let Switch = %sflow.Switch;
/// Capability flowing through a `loop`. `C` is the continue payload, `B` the
/// break payload, `H` the loop-header (loopback) payload. The loopback target
/// coordinates `(loopback_path, loopback_step)` are carried directly, folding in
/// what used to be the separate `Header` type.
axm %sflow.Loop: {path: Path, step: Nat} → [token: %sflow.Token path step]
  → [loopback: [Path, Nat]] → [C: ★] → [B: ★] → [H: ★] → ★;
let Loop = %sflow.Loop;

/// Branch to the continue target of a given control flow structure.
axm %sflow.continue: {
  C B H: ★,
  path loopback_path inner_path: Path, step loopback_step inner_step: Nat,
  token: Token path step,
  continue: Cn [C, Loop token (loopback_path, loopback_step) ⊥ B H, Token path 0]
} → [
    inner_token: Token inner_path inner_step,
    Loop token (loopback_path, loopback_step) C B H
    ] → Cn C;
///
/// Branch to the next case of a given switch structure.
axm %sflow.fallthrough: {
  C B: ★,
  path next_path inner_path: Path, step inner_step: Nat,
  token: Token path step,
  continue: Cn [C, Switch token ⊥ B, Token next_path 0]
} → [
    inner_token: Token inner_path inner_step,
    Switch token C B
    ] → Cn C;
///
/// Branch to the break target of a `switch`.
axm %sflow.break_switch: {
  C B: ★, path inner_path: Path, step inner_step: Nat,
  token: Token path step,
  break: Cn [B, Switch token ⊥ ⊥, Token path (inc step)]
} → [
    inner_token: Token inner_path inner_step,
    Switch token C B
    ] → Cn B;
///
/// Branch to the break target of a `loop`.
axm %sflow.break_loop: {
  C B H: ★, path loopback_path inner_path: Path, step loopback_step inner_step: Nat,
  token: Token path step,
  break: Cn [B, Loop token (loopback_path, loopback_step) ⊥ ⊥ ⊥, Token path (inc step)]
} → [
    inner_token: Token inner_path inner_step,
    Loop token (loopback_path, loopback_step) C B H
    ] → Cn B;
///
/// Branch to the merge target of the innermost if/switch structure.
/// Unlike break, merge requires a token from the same scope as the struct
/// (path must match; step may differ as progress within the scope).
axm %sflow.merge: {
  B: ★, path: Path, step inner_step: Nat, arm: Bool, token: Token path step,
  break: Cn [B, If token ⊥, Token path (inc step)]
} → [
    merge_token: Token (%sflow.arm arm (path, step)) inner_step,
    If token B
    ] → Cn B;
///
/// Branch to the loop header from inside a continue target.
axm %sflow.loopback: {
  C B H: ★, path loopback_path: Path, step loopback_step: Nat,
  token: Token path step
} → [
    loopback_token: Token loopback_path loopback_step,
    Loop token (loopback_path, loopback_step) C B H
    ] → Cn H;

/// ## Branching
/// Represents a structured branch (if-else or switch-case)
axm %sflow.if: {T B: ★} → {path: Path, step: Nat}
  → [
    token: Token path step,
    break: Cn [B, If token ⊥, Token path (inc step)],
    tuple: «arm: 2; Cn [T, If token B, Token (%sflow.arm arm (path, step)) 0]»,
    index: Bool
    ]
  → Cn T;

/// Convenience thing that automatically threads tokens and structures through an interface that looks clean and uses higher order
/// abstractions.
///
/// Examples of what this allows to do:
/// ```mim
/// fun extern foo (cond: Bool, token: %sflow.Root) =
///   // make return also consume tokens
///   let return = %sflow.lift return;
///
///   // the actual function body
///   let body = %sflow.nice_if merge (else, then) cond () where
///     lam then (merge) () = merge 1;
///     lam else (merge) () = merge 0;
///     lam merge (x: Nat) = return x;
///   end;
///
///   // pass the root token in so token threading can be wired
///   body token;
/// ```
lam %sflow.nice_if
    {T B: ★}
    {path: Path, step: Nat}
    (merge: B → {path: Path, step: Nat} → Cn Token path step)
    (tuple: «arm: 2; [B → {inner: Nat} → Cn Token (%sflow.arm arm (path, step)) inner] → T → Cn Token (%sflow.arm arm (path, step)) 0»)
    (cond: Bool)
    (arg: T)
    (token: Token path step)
  = let merge = (cn (arg: B, struct: If token ⊥, token: Token path (inc step)) = merge arg token);
    let tuple = ‹arm: 2; cn (arg: T, struct: If token B, token: Token (%sflow.arm arm (path, step)) 0) =
      let merge = (cn (v: B) {inner: Nat} (token: Token (%sflow.arm arm (path, step)) inner) = %sflow.merge (token, struct) v);
      tuple#arm merge arg token›;
    %sflow.if (token, merge, tuple, cond) arg;

/// Lift a continuation to also consume a token
lam %sflow.lift {T: ★} (f: Cn T) = (cn (v: T) {path: Path, step: Nat} (token: Token path step) = f v);


/// Represents a structured switch.
///
/// Each case is a dependent tuple `(index, continuation)` where `index` is the
/// arbitrary `Nat` matched against the scrutinee and the continuation receives
/// the case payload `T`, the `Switch` capability, and a token on its own case
/// path. The case path is keyed by the array position `i` (a unique
/// discriminator), not by `index`, so cases stay independent and the array is
/// an ordinary dependent array.
axm %sflow.switch: {count: Nat} → {T B: ★} → {path: Path, step: Nat}
  → [
    token: Token path step,
    break: Cn [B, Switch token ⊥ ⊥, Token path (%core.nat.add (step, 1))],
    default: Cn [T, Switch token ⊥ B, Token (%sflow.default (path, step)) 0],
    cases: «i: count; [index: Nat, Cn [T, Switch token T B, Token (%sflow.case (%core.bitcast Nat i) (path, step)) 0]]»,
    index: Nat]
  → Cn T;

/// ## Loops
///
/// Represents a structured loop. The loopback target is carried inside the
/// `Loop` capability itself (the `H` payload plus the loopback coordinates),
/// so the continue block receives a single `Loop` and can `%sflow.loopback`
/// directly without a separate `Header` value.
// TODO: check whether this can be refactored sligthly to allow passing the header as continue target also, which
// would allow to model single block loops
axm %sflow.loop: {C B H: ★} → {path loopback_path: Path, step loopback_step: Nat}
  → [
    token: Token path step,
    break: Cn [B, Loop token (loopback_path, loopback_step) ⊥ ⊥ ⊥, Token path (%core.nat.add (step, 1))],
    continue: Cn [C, Loop token (loopback_path, loopback_step) ⊥ B H, Token path 0],
    header: Cn [H, Loop token (loopback_path, loopback_step) C B ⊥, Token path 0]
    ]
  → Cn H;
///
/// This is used by the loop header to call into its body. The body branches
/// receive the `Loop` capability so they can `%sflow.continue` (which
/// constructs the tuple required by the continue block).
axm %sflow.header: {
  C B T H: ★,
  path loopback_path: Path, step loopback_step: Nat,
  token: Token path step,
  break: Cn [B, Loop token (loopback_path, loopback_step) ⊥ ⊥ ⊥, Token path (%core.nat.add (step, 1))],
  continue: Cn [C, Loop token (loopback_path, loopback_step) ⊥ B H, Token path 0]
} → [
  header_token: Token path 0,
  Loop token (loopback_path, loopback_step) C B ⊥,
  tuple: «i: 2; Cn [T, Loop token (loopback_path, loopback_step) C B H, Token (%sflow.arm i (path, step)) 0]»,
  index: Bool
  ] → Cn T;

/// Function call to a returning function in continuation passing style.
axm %sflow.call: {T R: ★, path: Path, step: Nat}
  → [Fn [T, Token %sflow.ROOT 0] → R]
  → [Token path step]
  → [Fn T → [R, Token path (%core.nat.add (step, 1))]];

/// Regular unconditional forward call.
axm %sflow.branch: {T: ★, path: Path, step: Nat}
  → [Cn [T, Token path (%core.nat.add (step, 1))]]
  → [Token path step]
  → Cn T;

/// ## Phases
// TODO: the phases are all unimplemented at the moment
///
/// Performs controlled node splitting to ensure the control flow graph is reducible.
axm %sflow.reduciblify: %compile.Phase;
///
/// Transforms control flow between basic blocks into
/// explicit structured control flow using the structures defined above.
axm %sflow.structurize: %compile.Phase;
///
/// Transforms recursion in top-level returning Lams into basic blocks
/// with an explicit stack.
axm %sflow.derecursify: %compile.Phase;
