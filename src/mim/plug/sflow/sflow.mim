/// # The sflow Plugin {#sflow}
///
/// @see mim::plug::sflow
///
/// [TOC]
///
/// ## Dependencies
///
plugin compile;
plugin core;
///
/// A plugin with axioms to model explicit structured
/// control flow and passes to transform arbitrary code
/// to structured control flow constructs.
///
/// ## Structured Control Flow
///
/// Any basic block ending with an application with
/// either one of the following two axioms as a callee
/// is a header block. In structured control flow, all
/// branching has to conform to one of those structures.
///
/// Branching to a header is only allowed in loop constructs
/// from the continue block.
///
/// Each header block must strictly structurally dominate its
/// merge block.

axm %sflow.Path: ★;
let Path = %sflow.Path;
axm %sflow.ROOT: Path;
axm %sflow.arm: Bool → Path → Path;
axm %sflow.case: Nat → Path → Path;
axm %sflow.default: Path → Path;

axm %sflow.Token: Path → Nat → ★;
let Token = %sflow.Token;
let %sflow.Root = Token %sflow.ROOT 0;

axm %sflow.Struct: {C B: ★} → [can_break: Bool] → [path: Path, step: Nat] → [continue: Cn C] → [break: Cn B] → ★;
let Struct = %sflow.Struct;
axm %sflow.Header: {B: ★} → [H: ★] → [path: Path, step: Nat] → [break: Cn B] → ★;
let Header = %sflow.Header;

/// Branch to the continue target of a given control flow structure.
axm %sflow.continue: {
  C B H: ★,
  path loopback_path: Path, step loopback_step: Nat,
  break: Cn B,
  continue: Cn [C, Struct tt (path, step) (⊥: Cn ⊥) break, Token path 0, Header H (loopback_path, loopback_step) break]
} → [Struct tt (path, step) continue break] → Cn C;
///
/// Branch to the next case of a given switch structure.
axm %sflow.fallthrough: {
  C B: ★,
  path next_path: Path, step: Nat,
  break: Cn B,
  continue: Cn [C, Struct tt (path, step) (⊥: Cn ⊥) break, Token next_path 0]
} → [Struct tt (path, step) continue break] → Cn C;
///
/// Branch to the break target of a given control flow structure.
axm %sflow.break: {
  C B: ★, path: Path, step: Nat,
  continue: Cn C, break: Cn [B, Struct tt (path, step) (⊥: Cn ⊥) (⊥: Cn ⊥), Token path (%core.nat.add (step, 1))]
} → [Struct tt (path, step) continue break] → Cn B;
///
/// Branch to the merge target of the innermost if/switch structure.
/// Unlike break, merge requires a token from the same scope as the struct
/// (path must match; step may differ as progress within the scope).
axm %sflow.merge: {
  C B: ★, path: Path, step inner_step: Nat, arm: Bool,
  continue: Cn C, break: Cn [B, Struct ff (path, step) (⊥: Cn ⊥) (⊥: Cn ⊥), Token path (%core.nat.add (step, 1))]
} → [Struct ff (path, step) continue break] → [token: Token (%sflow.arm arm path) inner_step] → Cn B;
///
/// Branch to the loop header from inside a continue target.
axm %sflow.loopback: {H B: ★, path: Path, step: Nat, break: Cn B}
  → [Header H (path, step) break]
  → [token: Token path 0] → Cn H;

/// ## Branching
/// Represents a structured branch (if-else or switch-case)
axm %sflow.if: {T B: ★} → {path: Path, step: Nat}
  → [break: Cn [B, Struct ff (path, step) (⊥: Cn ⊥) (⊥: Cn ⊥), Token path (%core.nat.add (step, 1))]]
  → [tuple: «i: 2; Cn [T, Struct ff (path, step) (⊥: Cn ⊥) break, Token (%sflow.arm i path) 0]»]
  → [index: Bool]
  → [token: Token path step]
  → Cn T;

// TODO: Make type params implicit again once that is figured out
/// Computes the type of a switch target list.
///   Cases 0 next = []
///   Cases n next = [Nat, Cn [T, Token, Struct header next break],
///                  [Nat, Cn [T, Token, Struct header case_0 break],
///                  ...]...]]
/// where each case's continue target is the previous case (fallthrough).
///
lam %sflow.Cases
  (T: ★, C: ★, B: ★,
   next_path: Path,
   path: Path, step: Nat,
   continue: Cn C,
   break: Cn B,
   count: Nat,
   next: Cn [T, Struct tt (path, step) continue break, Token next_path 0])@(%core.pe.is_closed count)
  : ★
  = ([
      index: Nat,
      case: Cn [T, Struct tt (path, step) next break, Token (%sflow.case index path) 0],
      %sflow.Cases (T, [T, Struct tt (path, step) continue break, Token next_path 0],
      B, %sflow.case index path, path, step, next, break,
      %core.nat.sub (count, 1), case)
    ], [])#(%core.ncmp.e (count, 0));

/// Represents a structured switch.
///
/// Notice that the case functions are given in reverse order, as they
/// have their fall-through (continue) target in their signature.
axm %sflow.switch: {count: Nat} → {T B: ★} → {path: Path, step: Nat}
  → [break: Cn [B, Struct tt (path, step) (⊥: Cn ⊥) (⊥: Cn ⊥), Token path (%core.nat.add (step, 1))]]
  → [default: Cn [T, Struct tt (path, step) (⊥: Cn ⊥) break, Token (%sflow.default path) 0]]
  → [targets: %sflow.Cases (T, ⊥, [B, Struct tt (path, step) (⊥: Cn ⊥) (⊥: Cn ⊥), Token path (%core.nat.add (step, 1))], %sflow.default path, path, step, (⊥: Cn ⊥), break, count, default)]
  → [index: Nat]
  → [token: Token path step]
  → Cn T;

/// ## Loops
///
/// Represents a structured loop. The Header reference is passed as a separate
/// parameter to the continue block (and to body branches via `%sflow.header`),
/// so that the structural type of `Struct` does not need to recursively
/// mention the Header. This keeps the per-axiom type signatures shallow enough
/// for bottom-up inference of unannotated block parameters.
axm %sflow.loop: {C B H: ★} → {path loopback_path: Path, step loopback_step: Nat}
  → [break: Cn [B, Struct tt (path, step) (⊥: Cn ⊥) (⊥: Cn ⊥), Token path (%core.nat.add (step, 1))]]
  → [continue: Cn [C, Struct tt (path, step) (⊥: Cn ⊥) break, Token path 0, Header H (loopback_path, loopback_step) break]]
  → [header: Cn [H, Struct tt (path, step) continue break, Token path 0]]
  → [token: Token path step]
  → Cn H;
///
/// This is used by the loop header to call into its body. The body branches
/// receive the Header as their fourth parameter so they can `%sflow.continue`
/// (which constructs the tuple required by the continue block).
axm %sflow.header: {C B T H: ★}
  → {path loopback_path: Path, step loopback_step: Nat}
  → {break: Cn [B, Struct tt (path, step) (⊥: Cn ⊥) (⊥: Cn ⊥), Token path (%core.nat.add (step, 1))]}
  → {continue: Cn [C, Struct tt (path, step) (⊥: Cn ⊥) break, Token path 0, Header H (loopback_path, loopback_step) break]}
  → [Struct tt (path, step) continue break]
  → [tuple: «i: 2; Cn [T, Struct tt (path, step) continue break, Token (%sflow.arm i path) 0]»]
  → [index: Bool]
  → [token: Token path 0]
  → Cn T;

/// Function call to a returning function in continuation passing style.
axm %sflow.call: {T R: ★, path: Path, step: Nat}
  → [Fn [T, Token %sflow.ROOT 0] → R]
  → [Token path step]
  → [Fn T → [R, Token path (%core.nat.add (step, 1))]];

/// Regular unconditional forward call. The path in the token type is used to
/// ensure the target cannot be called from anywhere else as long as all control flow
/// is structured.
axm %sflow.branch: {T: ★, path: Path, step: Nat}
  → [Cn [T, Token path (%core.nat.add (step, 1))]]
  → [Token path step]
  → Cn T;

/// ## Phases
///
axm %sflow.check_headers: %compile.Phase;
///
/// Inserts additional lams if multiple structures share the same merge lam.
axm %sflow.seperate_merge: %compile.Phase;
///
/// Performs controlled node splitting to ensure the control flow graph is reducible.
axm %sflow.reduciblify: %compile.Phase;
///
/// Transforms control flow between basic blocks into
/// explicit structured control flow using the structures defined above.
axm %sflow.structurize: %compile.Phase;
///
/// Transforms recursion in top-level returning Lams into basic blocks
/// with an explicit stack.
axm %sflow.derecursify: %compile.Phase;
