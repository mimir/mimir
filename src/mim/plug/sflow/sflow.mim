/// # The sflow Plugin {#sflow}
///
/// @see mim::plug::sflow
///
/// [TOC]
///
/// ## Dependencies
///
plugin compile;
plugin core;
///
/// A plugin with axioms to model explicit structured
/// control flow and passes to transform arbitrary code
/// to structured control flow constructs.
///
/// ## Structured Control Flow
///
/// Any basic block ending with an application with
/// either one of the following two axioms as a callee
/// is a header block. In structured control flow, all
/// branching has to conform to one of those structures.
///
/// Branching to a header is only allowed in loop constructs
/// from the continue block.
///
/// Each header block must strictly structurally dominate its
/// merge block.
axm %sflow.Token: ★;
axm %sflow.Key: ★;
axm %sflow.gen: %sflow.Token → [%sflow.Token, %sflow.Key];
///
axm %sflow.Targets: {C B: ★} → [key: %sflow.Key] → [continue: Cn C] → [break: Cn B] → ★;
lam %sflow.Struct {C B: ★} [key: %sflow.Key] [continue: Cn C] [break: Cn B]: ★
  = [%sflow.Token, %sflow.Targets key continue break];
let %sflow.Root: ★ = %sflow.Struct (⊥: %sflow.Key) (⊥: Cn ⊥) (⊥: Cn ⊥);

axm %sflow.continue: {
  C B_inner B N: ★,
  key ikey: %sflow.Key,
  next: Cn N,
  break: Cn B, ibreak: Cn B_inner,
  continue: Cn [C, %sflow.Struct ikey next ibreak]
} → [%sflow.Struct key continue break] → Cn C;
axm %sflow.break: {
  C B: ★, key: %sflow.Key,
  continue: Cn C, break: Cn [B, %sflow.Struct key (⊥: Cn ⊥) (⊥: Cn ⊥)]
} → [%sflow.Struct key continue break] → Cn B;

/// ## Branching
/// Represents a structured branch (if-else or switch-case)
///
/// The header argument to any structure must always point to the lam containing it, otherwise
/// the normalizer will throw an error.
///
axm %sflow.if: {n: Nat} → {T B H S: ★}
  → [token: %sflow.Token, _: S]
  → let (token, key) = %sflow.gen token;
    [break: Cn [B, %sflow.Struct key (⊥: Cn ⊥) (⊥: Cn ⊥)]]
  → [tuple: «2; Cn [T, %sflow.Struct key (⊥: Cn ⊥) break]»]
  → [index: Idx 2]
  → Cn T, normalize_branch;

// TODO: Make type params implicit again once that is figured out
/// Computes the type of a switch target list.
///   Targets 0 next = []
///   Targets n next = [Nat, Cn [T, Struct header next break],
///                    [Nat, Cn [T, Struct header case_0 break],
///                    ...]...]]
/// where each case's continue target is the previous case (fallthrough).
///
lam %sflow.Cases
  (T: ★, C: ★, B: ★, H: ★,
   key: %sflow.Key,
   continue: Cn C,
   break: Cn B,
   count: Nat,
   next: Cn [T, %sflow.Struct key continue break])@(%core.pe.is_closed count)
  : ★
  = ([Nat, case: Cn [T, %sflow.Struct key next break], %sflow.Cases (T, [T, %sflow.Struct key continue break], B, H, key, next, break, %core.nat.sub (count, 1), case)], [])#(%core.ncmp.e (count, 0));

/// Represents a structured switch.
///
/// Notice that the case functions are given in reverse order, as they
/// have their fall-through (continue) target in their signature.
axm %sflow.switch: {n: Nat} → {T B H S: ★}
  → [token: %sflow.Token, _: S]
  → let (token, key) = %sflow.gen token;
    [break: Cn [B, %sflow.Struct key (⊥: Cn ⊥) (⊥: Cn ⊥)]]
  → [default: Cn [T, %sflow.Struct key (⊥: Cn ⊥) break]]
  → [targets: %sflow.Cases (T, ⊥, [B, %sflow.Struct key (⊥: Cn ⊥) (⊥: Cn ⊥)], H, key, (⊥: Cn ⊥), break, n, default)]
  → [index: Nat]
  → Cn T, normalize_switch;

/// ## Loops
///
/// Represents the loop header corresponding to a given key in an opaque way,
/// because functions cannot contain each other recursively in their signatures as their types
/// would recurse infinitely, which is currently not possible to represent.
axm %sflow.Header: {C B: ★} → [H: ★] → [key: %sflow.Key] → Cn [H, %sflow.Struct key (⊥: Cn ⊥) (⊥: Cn ⊥)];
///
/// Represents a structured loop. As the loop construct has to know its header
/// to be able to call back into it, the function containing the loop declaration cannot
/// be the header itself.
axm %sflow.loop: {C B H S: ★}
  → [token: %sflow.Token, _: S]
  → let (token, key) = %sflow.gen token;
    {break: Cn [B, %sflow.Struct key (⊥: Cn ⊥) (⊥: Cn ⊥)]}
  → {continue: Cn [C, %sflow.Struct key (%sflow.Header H key) break]}
  → [header: Cn [H, %sflow.Struct key continue break]]
  → Cn H;
///
/// This is used by to loop header to call into its body
axm %sflow.header: {C B T H S: ★}
  → {key: %sflow.Key}
  → [break: Cn [B, %sflow.Struct key (⊥: Cn ⊥) (⊥: Cn ⊥)]]
  → [continue: Cn [C, %sflow.Struct key (%sflow.Header H key) break]]
  → [tuple: «2; Cn [T, %sflow.Struct key continue break]»]
  → [index: Bool]
  → Cn T;

/// ## Phases
///
axm %sflow.check_headers: %compile.Phase;
///
/// Inserts additional lams if multiple structures share the same merge lam.
axm %sflow.seperate_merge: %compile.Phase;
///
/// Performs controlled node splitting to ensure the control flow graph is reducible.
axm %sflow.reduciblify: %compile.Phase;
///
/// Transforms control flow between basic blocks into
/// explicit structured control flow using the structures defined above.
axm %sflow.structurize: %compile.Phase;
///
/// Transforms recursion in top-level returning Lams into basic blocks
/// with an explicit stack.
axm %sflow.derecursify: %compile.Phase;
