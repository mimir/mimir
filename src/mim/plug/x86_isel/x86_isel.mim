/// # The x86_isel Plugin {#x86_isel}
///
/// @see mim::plug::x86_isel
///
/// [TOC]
///
/// The instruction-selection rules of the `x86` backend.
/// `gen` writes them as C++ that the `x86` plugin compiles in, so the compiler itself never loads this plugin.
///
/// ## Dependencies
///
plugin core;
import compile;
import mem;
import x86;
///
/// ## Guards
///
/// A guard is `tt` after instantiation or a conjunction of these atoms on meta variables.
///
/// ### imm
///
/// A literal that fits a sign-extended 32-bit immediate; stuck on anything but a literal.
///
axm imm: {s: Nat} → Idx s → Bool, normalize_imm;
///
/// ### sh
///
/// A literal shift count; x86 masks it, so any literal fits.
///
axm sh: {s: Nat} → Idx s → Bool, normalize_sh;
///
/// ## Operands
///
/// ### addr
///
/// The pointer `p` as an address operand.
/// isel picks its form, `x86.Base` or `x86.Index`, and the builder infers which.
///
axm addr: {T: *, a: Nat} → mem.Ptr (T, a) → x86.Base;
///
/// ### reg
///
/// The pointer `p` in a register.
///
axm reg: {T: *, a: Nat} → mem.Ptr (T, a) → I64;
///
/// ### nat
///
/// The `Nat` `n` in a register.
///
axm nat: Nat → I64;
///
/// ## Commutativity
///
/// The operations whose two operands a rule also matches swapped.
///
anx let commutes = (core.wrap.add, core.wrap.mul, core.bit2.and, core.bit2.or, core.bit2.xor, core.bit2.nand, core.bit2.nor, core.bit2.nxor, core.nat.add, core.nat.mul);
///
/// ## Rules
///
/// Each family takes the operand size; the instance tuples fix the sizes its instruction supports.
/// A meta variable that the right-hand side uses and no other meta variable's type mentions is an operand, unless it is a memory.
/// An lhs `(m, e)` replaces `e` and, by the memory of the rhs, the memory `m` of an inner node of `e`.
///
/// ### ALU
///
rule add      (s: Nat) (m: Nat, a b: Idx s): core.wrap.add m (a, b)             => x86.add (a, b);
rule add_imm  (s: Nat) (m: Nat, a b: Idx s): core.wrap.add m (a, b)  when imm b => x86.add (a, b);
rule sub      (s: Nat) (m: Nat, a b: Idx s): core.wrap.sub m (a, b)             => x86.sub (a, b);
rule sub_imm  (s: Nat) (m: Nat, a b: Idx s): core.wrap.sub m (a, b)  when imm b => x86.sub (a, b);
rule mul      (s: Nat) (m: Nat, a b: Idx s): core.wrap.mul m (a, b)             => x86.imul (a, b);
rule mul_imm  (s: Nat) (m: Nat, a b: Idx s): core.wrap.mul m (a, b)  when imm b => x86.imul (a, b);
rule mul8              (m: Nat, a b: I8):    core.wrap.mul m (a, b)             => x86.trunc i8 (x86.imul (x86.movzx i32 a, x86.movzx i32 b));
rule mul8_imm          (m: Nat, a b: I8):    core.wrap.mul m (a, b)  when imm b => x86.trunc i8 (x86.imul (x86.movzx i32 a, x86.movzx i32 b));
rule and      (s: Nat) (m: Nat, a b: Idx s): core.bit2.and m (a, b)             => x86.and (a, b);
rule and_imm  (s: Nat) (m: Nat, a b: Idx s): core.bit2.and m (a, b)  when imm b => x86.and (a, b);
rule or       (s: Nat) (m: Nat, a b: Idx s): core.bit2.or m (a, b)              => x86.or (a, b);
rule or_imm   (s: Nat) (m: Nat, a b: Idx s): core.bit2.or m (a, b)   when imm b => x86.or (a, b);
rule xor      (s: Nat) (m: Nat, a b: Idx s): core.bit2.xor m (a, b)             => x86.xor (a, b);
rule xor_imm  (s: Nat) (m: Nat, a b: Idx s): core.bit2.xor m (a, b)  when imm b => x86.xor (a, b);
rule nand     (s: Nat) (m: Nat, a b: Idx s): core.bit2.nand m (a, b)            => let x = x86.and (a, b); x86.xor (x, core.bit1.t 0 x);
rule nand_imm (s: Nat) (m: Nat, a b: Idx s): core.bit2.nand m (a, b) when imm b => let x = x86.and (a, b); x86.xor (x, core.bit1.t 0 x);
rule nor      (s: Nat) (m: Nat, a b: Idx s): core.bit2.nor m (a, b)             => let x = x86.or (a, b); x86.xor (x, core.bit1.t 0 x);
rule nor_imm  (s: Nat) (m: Nat, a b: Idx s): core.bit2.nor m (a, b)  when imm b => let x = x86.or (a, b); x86.xor (x, core.bit1.t 0 x);
rule nxor     (s: Nat) (m: Nat, a b: Idx s): core.bit2.nxor m (a, b)            => let x = x86.xor (a, b); x86.xor (x, core.bit1.t 0 x);
rule nxor_imm (s: Nat) (m: Nat, a b: Idx s): core.bit2.nxor m (a, b) when imm b => let x = x86.xor (a, b); x86.xor (x, core.bit1.t 0 x);
rule shl      (s: Nat) (m: Nat, a b: Idx s): core.wrap.shl m (a, b)             => x86.shl (a, b);
rule shl_imm  (s: Nat) (m: Nat, a b: Idx s): core.wrap.shl m (a, b)  when sh b  => x86.shl (a, b);
rule shr      (s: Nat) (a b: Idx s):         core.shr.l (a, b)                  => x86.shr (a, b);
rule shr_imm  (s: Nat) (a b: Idx s):         core.shr.l (a, b)       when sh b  => x86.shr (a, b);
rule sar      (s: Nat) (a b: Idx s):         core.shr.a (a, b)                  => x86.sar (a, b);
rule sar_imm  (s: Nat) (a b: Idx s):         core.shr.a (a, b)       when sh b  => x86.sar (a, b);
///
/// ### Nat
///
/// `Nat` is `I64`; `core.nat.sub` saturates at 0.
///
rule nat_add     (a b: Nat): core.nat.add (a, b)                      => x86.add (nat a, nat b);
rule nat_add_imm (a b: Nat): core.nat.add (a, b) when imm (nat b)     => x86.add (nat a, nat b);
rule nat_sub     (a b: Nat): core.nat.sub (a, b)                      => x86.cmovcc.b (x86.cmp (nat a, nat b), x86.sub (nat a, nat b), x86.mov 0I64);
rule nat_sub_imm (a b: Nat): core.nat.sub (a, b) when imm (nat b)     => x86.cmovcc.b (x86.cmp (nat a, nat b), x86.sub (nat a, nat b), x86.mov 0I64);
rule nat_mul     (a b: Nat): core.nat.mul (a, b)                      => x86.imul (nat a, nat b);
rule nat_mul_imm (a b: Nat): core.nat.mul (a, b) when imm (nat b)     => x86.imul (nat a, nat b);
rule nat_div     (a b: Nat): core.nat.div (a, b)                      => (x86.div (nat a, nat b))#0_2;
rule nat_rem     (a b: Nat): core.nat.rem (a, b)                      => (x86.div (nat a, nat b))#1_2;
///
/// ### Division
///
/// `div` and `idiv` yield both the quotient and the remainder; they have no 8-bit form, so `i8` widens to `i32`.
/// `core.rem` puts its divisor into a register with `x86.mov`, whose result type only folds for a literal size.
///
rule udiv  (s: Nat) (m: mem.M 0, a b: Idx s): core.div.udiv (m, (a, b)) => (m, (x86.div (a, b))#0_2);
rule urem  (s: Nat) (m: mem.M 0, a b: Idx s): core.div.urem (m, (a, b)) => (m, (x86.div (a, b))#1_2);
rule sdiv  (s: Nat) (m: mem.M 0, a b: Idx s): core.div.sdiv (m, (a, b)) => (m, (x86.idiv (a, b))#0_2);
rule srem  (s: Nat) (m: mem.M 0, a b: Idx s): core.div.srem (m, (a, b)) => (m, (x86.idiv (a, b))#1_2);
rule udiv8          (m: mem.M 0, a b: I8):    core.div.udiv (m, (a, b)) => (m, x86.trunc i8 (x86.div (x86.movzx i32 a, x86.movzx i32 b))#0_2);
rule urem8          (m: mem.M 0, a b: I8):    core.div.urem (m, (a, b)) => (m, x86.trunc i8 (x86.div (x86.movzx i32 a, x86.movzx i32 b))#1_2);
rule sdiv8          (m: mem.M 0, a b: I8):    core.div.sdiv (m, (a, b)) => (m, x86.trunc i8 (x86.idiv (x86.movsx i32 a, x86.movsx i32 b))#0_2);
rule srem8          (m: mem.M 0, a b: I8):    core.div.srem (m, (a, b)) => (m, x86.trunc i8 (x86.idiv (x86.movsx i32 a, x86.movsx i32 b))#1_2);
rule rem8           (d: Nat, x: I8):          core.rem d x              => x86.trunc i8 (x86.div (x86.movzx i32 x, x86.mov (core.idx 0 i32 d)))#1_2;
rule rem16          (d: Nat, x: I16):         core.rem d x              => (x86.div (x, x86.mov (core.idx 0 i16 d)))#1_2;
rule rem32          (d: Nat, x: I32):         core.rem d x              => (x86.div (x, x86.mov (core.idx 0 i32 d)))#1_2;
rule rem64          (d: Nat, x: I64):         core.rem d x              => (x86.div (x, x86.mov (core.idx 0 i64 d)))#1_2;
///
/// ### Comparisons
///
/// Each family takes the predicate and its condition code.
///
rule icmp     (p: {s: Nat} → «2; Idx s» → Bool, c: x86.Flags → Bool) (s: Nat, a b: Idx s): p (a, b)            => c (x86.cmp (a, b));
rule icmp_imm (p: {s: Nat} → «2; Idx s» → Bool, c: x86.Flags → Bool) (s: Nat, a b: Idx s): p (a, b) when imm b => c (x86.cmp (a, b));
rule ncmp     (p: «2; Nat» → Bool, c: x86.Flags → Bool)               (a b: Nat):           p (a, b)                  => c (x86.cmp (nat a, nat b));
rule ncmp_imm (p: «2; Nat» → Bool, c: x86.Flags → Bool)               (a b: Nat):           p (a, b) when imm (nat b) => c (x86.cmp (nat a, nat b));
///
/// ### Loads and Stores
///
/// Every pointer is a byte pointer `mem.Ptr0 I8` by now.
///
rule load      (s: Nat) (m: mem.M 0, p: mem.Ptr0 (Idx s)):                   mem.load (m, p)                => x86.load s (m, addr p);
rule load_ptr           (m: mem.M 0, p: mem.Ptr0 (mem.Ptr0 I8)):             mem.load (m, p)                => x86.load i64 (m, addr p);
rule store              (s: Nat, m: mem.M 0, p: mem.Ptr0 (Idx s), x: Idx s): mem.store (m, p, x)            => x86.store (m, addr p, x);
rule store_imm          (s: Nat, m: mem.M 0, p: mem.Ptr0 (Idx s), x: Idx s): mem.store (m, p, x) when imm x => x86.store (m, addr p, x);
rule store_ptr          (m: mem.M 0, p: mem.Ptr0 (mem.Ptr0 I8), x: mem.Ptr0 I8): mem.store (m, p, x)        => x86.store (m, addr p, reg x);
///
/// ### Memory Operands
///
/// `op r, m` folds a load into the second operand; `op m, r` also stores to the address it loads from.
///
rule add_rm     (s: Nat) (k: Nat, a: Idx s, m: mem.M 0, p: mem.Ptr0 (Idx s)): let (mm, v) = mem.load (m, p); (mm, core.wrap.add k (a, v)) => x86.rm x86.add (m, a, addr p);
rule sub_rm     (s: Nat) (k: Nat, a: Idx s, m: mem.M 0, p: mem.Ptr0 (Idx s)): let (mm, v) = mem.load (m, p); (mm, core.wrap.sub k (a, v)) => x86.rm x86.sub (m, a, addr p);
rule mul_rm     (s: Nat) (k: Nat, a: Idx s, m: mem.M 0, p: mem.Ptr0 (Idx s)): let (mm, v) = mem.load (m, p); (mm, core.wrap.mul k (a, v)) => x86.rm x86.imul (m, a, addr p);
rule and_rm     (s: Nat) (k: Nat, a: Idx s, m: mem.M 0, p: mem.Ptr0 (Idx s)): let (mm, v) = mem.load (m, p); (mm, core.bit2.and k (a, v)) => x86.rm x86.and (m, a, addr p);
rule or_rm      (s: Nat) (k: Nat, a: Idx s, m: mem.M 0, p: mem.Ptr0 (Idx s)): let (mm, v) = mem.load (m, p); (mm, core.bit2.or k (a, v))  => x86.rm x86.or (m, a, addr p);
rule xor_rm     (s: Nat) (k: Nat, a: Idx s, m: mem.M 0, p: mem.Ptr0 (Idx s)): let (mm, v) = mem.load (m, p); (mm, core.bit2.xor k (a, v)) => x86.rm x86.xor (m, a, addr p);
rule add_mr     (s: Nat) (k: Nat, b: Idx s, m: mem.M 0, p: mem.Ptr0 (Idx s)): let (mm, v) = mem.load (m, p); mem.store (mm, p, core.wrap.add k (v, b))            => x86.mr (x86.add @ s) (m, addr p, b);
rule add_mr_imm (s: Nat) (k: Nat, b: Idx s, m: mem.M 0, p: mem.Ptr0 (Idx s)): let (mm, v) = mem.load (m, p); mem.store (mm, p, core.wrap.add k (v, b)) when imm b => x86.mr (x86.add @ s) (m, addr p, b);
rule sub_mr     (s: Nat) (k: Nat, b: Idx s, m: mem.M 0, p: mem.Ptr0 (Idx s)): let (mm, v) = mem.load (m, p); mem.store (mm, p, core.wrap.sub k (v, b))            => x86.mr (x86.sub @ s) (m, addr p, b);
rule sub_mr_imm (s: Nat) (k: Nat, b: Idx s, m: mem.M 0, p: mem.Ptr0 (Idx s)): let (mm, v) = mem.load (m, p); mem.store (mm, p, core.wrap.sub k (v, b)) when imm b => x86.mr (x86.sub @ s) (m, addr p, b);
rule and_mr     (s: Nat) (k: Nat, b: Idx s, m: mem.M 0, p: mem.Ptr0 (Idx s)): let (mm, v) = mem.load (m, p); mem.store (mm, p, core.bit2.and k (v, b))            => x86.mr (x86.and @ s) (m, addr p, b);
rule and_mr_imm (s: Nat) (k: Nat, b: Idx s, m: mem.M 0, p: mem.Ptr0 (Idx s)): let (mm, v) = mem.load (m, p); mem.store (mm, p, core.bit2.and k (v, b)) when imm b => x86.mr (x86.and @ s) (m, addr p, b);
rule or_mr      (s: Nat) (k: Nat, b: Idx s, m: mem.M 0, p: mem.Ptr0 (Idx s)): let (mm, v) = mem.load (m, p); mem.store (mm, p, core.bit2.or k (v, b))            => x86.mr (x86.or @ s) (m, addr p, b);
rule or_mr_imm  (s: Nat) (k: Nat, b: Idx s, m: mem.M 0, p: mem.Ptr0 (Idx s)): let (mm, v) = mem.load (m, p); mem.store (mm, p, core.bit2.or k (v, b)) when imm b => x86.mr (x86.or @ s) (m, addr p, b);
rule xor_mr     (s: Nat) (k: Nat, b: Idx s, m: mem.M 0, p: mem.Ptr0 (Idx s)): let (mm, v) = mem.load (m, p); mem.store (mm, p, core.bit2.xor k (v, b))            => x86.mr (x86.xor @ s) (m, addr p, b);
rule xor_mr_imm (s: Nat) (k: Nat, b: Idx s, m: mem.M 0, p: mem.Ptr0 (Idx s)): let (mm, v) = mem.load (m, p); mem.store (mm, p, core.bit2.xor k (v, b)) when imm b => x86.mr (x86.xor @ s) (m, addr p, b);
///
/// ### Addresses
///
/// The offset of a `mem.ptradd` is the index and displacement of an address, also if something else uses its parts.
/// Of two matches that cost the same, isel keeps the first, so larger patterns come first.
///
rule index2_disp (m n: Nat, p: mem.Ptr0 I8, i c: I64): mem.ptradd (p, core.wrap.add m (core.wrap.mul n (i, 2I64), c)) when imm c => x86.index (x86.addr (core.conv.u i32 c, reg p)) (i, x86.scale_2);
rule index4_disp (m n: Nat, p: mem.Ptr0 I8, i c: I64): mem.ptradd (p, core.wrap.add m (core.wrap.mul n (i, 4I64), c)) when imm c => x86.index (x86.addr (core.conv.u i32 c, reg p)) (i, x86.scale_4);
rule index8_disp (m n: Nat, p: mem.Ptr0 I8, i c: I64): mem.ptradd (p, core.wrap.add m (core.wrap.mul n (i, 8I64), c)) when imm c => x86.index (x86.addr (core.conv.u i32 c, reg p)) (i, x86.scale_8);
rule base_index2 (m n: Nat, p: mem.Ptr0 I8, x i: I64): mem.ptradd (p, core.wrap.add m (x, core.wrap.mul n (i, 2I64)))            => x86.index (x86.addr (0I32, x86.lea (x86.index (x86.addr (0I32, reg p)) (x, x86.scale_1)))) (i, x86.scale_2);
rule base_index4 (m n: Nat, p: mem.Ptr0 I8, x i: I64): mem.ptradd (p, core.wrap.add m (x, core.wrap.mul n (i, 4I64)))            => x86.index (x86.addr (0I32, x86.lea (x86.index (x86.addr (0I32, reg p)) (x, x86.scale_1)))) (i, x86.scale_4);
rule base_index8 (m n: Nat, p: mem.Ptr0 I8, x i: I64): mem.ptradd (p, core.wrap.add m (x, core.wrap.mul n (i, 8I64)))            => x86.index (x86.addr (0I32, x86.lea (x86.index (x86.addr (0I32, reg p)) (x, x86.scale_1)))) (i, x86.scale_8);
rule index2      (m: Nat, p: mem.Ptr0 I8, i: I64):     mem.ptradd (p, core.wrap.mul m (i, 2I64))                                 => x86.index (x86.addr (0I32, reg p)) (i, x86.scale_2);
rule index4      (m: Nat, p: mem.Ptr0 I8, i: I64):     mem.ptradd (p, core.wrap.mul m (i, 4I64))                                 => x86.index (x86.addr (0I32, reg p)) (i, x86.scale_4);
rule index8      (m: Nat, p: mem.Ptr0 I8, i: I64):     mem.ptradd (p, core.wrap.mul m (i, 8I64))                                 => x86.index (x86.addr (0I32, reg p)) (i, x86.scale_8);
rule index_disp  (m: Nat, p: mem.Ptr0 I8, i c: I64):   mem.ptradd (p, core.wrap.add m (i, c))                         when imm c => x86.index (x86.addr (core.conv.u i32 c, reg p)) (i, x86.scale_1);
rule disp        (p: mem.Ptr0 I8, c: I64):             mem.ptradd (p, c)                                              when imm c => x86.addr (core.conv.u i32 c, reg p);
rule index       (p: mem.Ptr0 I8, i: I64):             mem.ptradd (p, i)                                                         => x86.index (x86.addr (0I32, reg p)) (i, x86.scale_1);
///
/// ## Instances
///
/// `imul` has no 8-bit form, so `mul8` widens to `i32`; the logical instructions also take `Bool`.
/// x86 has no negated logical instructions, so `nand`, `nor`, and `nxor` complement with an `xor`.
///
anx let alu = (
    add i8, add i16, add i32, add i64, add_imm i8, add_imm i16, add_imm i32, add_imm i64,
    sub i8, sub i16, sub i32, sub i64, sub_imm i8, sub_imm i16, sub_imm i32, sub_imm i64,
    mul8, mul i16, mul i32, mul i64, mul8_imm, mul_imm i16, mul_imm i32, mul_imm i64,
    and i1, and i8, and i16, and i32, and i64, and_imm i1, and_imm i8, and_imm i16, and_imm i32, and_imm i64,
    or i1, or i8, or i16, or i32, or i64, or_imm i1, or_imm i8, or_imm i16, or_imm i32, or_imm i64,
    xor i1, xor i8, xor i16, xor i32, xor i64, xor_imm i1, xor_imm i8, xor_imm i16, xor_imm i32, xor_imm i64,
    nand i1, nand i8, nand i16, nand i32, nand i64, nand_imm i1, nand_imm i8, nand_imm i16, nand_imm i32, nand_imm i64,
    nor i1, nor i8, nor i16, nor i32, nor i64, nor_imm i1, nor_imm i8, nor_imm i16, nor_imm i32, nor_imm i64,
    nxor i1, nxor i8, nxor i16, nxor i32, nxor i64, nxor_imm i1, nxor_imm i8, nxor_imm i16, nxor_imm i32, nxor_imm i64,
    shl i8, shl i16, shl i32, shl i64, shl_imm i8, shl_imm i16, shl_imm i32, shl_imm i64,
    shr i8, shr i16, shr i32, shr i64, shr_imm i8, shr_imm i16, shr_imm i32, shr_imm i64,
    sar i8, sar i16, sar i32, sar i64, sar_imm i8, sar_imm i16, sar_imm i32, sar_imm i64);
anx let compares = (
    icmp (core.icmp.e,   x86.cc.e),  icmp (core.icmp.ne,  x86.cc.ne), icmp (core.icmp.ul, x86.cc.b), icmp (core.icmp.ule, x86.cc.be),
    icmp (core.icmp.ug,  x86.cc.a),  icmp (core.icmp.uge, x86.cc.ae), icmp (core.icmp.sl, x86.cc.l), icmp (core.icmp.sle, x86.cc.le),
    icmp (core.icmp.sg,  x86.cc.g),  icmp (core.icmp.sge, x86.cc.ge),
    icmp_imm (core.icmp.e,  x86.cc.e),  icmp_imm (core.icmp.ne,  x86.cc.ne), icmp_imm (core.icmp.ul, x86.cc.b), icmp_imm (core.icmp.ule, x86.cc.be),
    icmp_imm (core.icmp.ug, x86.cc.a),  icmp_imm (core.icmp.uge, x86.cc.ae), icmp_imm (core.icmp.sl, x86.cc.l), icmp_imm (core.icmp.sle, x86.cc.le),
    icmp_imm (core.icmp.sg, x86.cc.g),  icmp_imm (core.icmp.sge, x86.cc.ge),
    ncmp (core.ncmp.e, x86.cc.e), ncmp (core.ncmp.ne, x86.cc.ne), ncmp (core.ncmp.l, x86.cc.b),
    ncmp (core.ncmp.le, x86.cc.be), ncmp (core.ncmp.g, x86.cc.a), ncmp (core.ncmp.ge, x86.cc.ae),
    ncmp_imm (core.ncmp.e, x86.cc.e), ncmp_imm (core.ncmp.ne, x86.cc.ne), ncmp_imm (core.ncmp.l, x86.cc.b),
    ncmp_imm (core.ncmp.le, x86.cc.be), ncmp_imm (core.ncmp.g, x86.cc.a), ncmp_imm (core.ncmp.ge, x86.cc.ae));
anx let division = (
    udiv8, udiv i16, udiv i32, udiv i64, urem8, urem i16, urem i32, urem i64,
    sdiv8, sdiv i16, sdiv i32, sdiv i64, srem8, srem i16, srem i32, srem i64,
    rem8, rem16, rem32, rem64);
anx let memory = (load i8, load i16, load i32, load i64, load_ptr, store, store_imm, store_ptr);
anx let addresses = (index2_disp, index4_disp, index8_disp, base_index2, base_index4, base_index8, index2, index4, index8, index_disp, disp, index);
///
/// `imul` has no `op m, r` form.
///
anx let mem_ops = (
    add_rm i8, add_rm i16, add_rm i32, add_rm i64,
    sub_rm i8, sub_rm i16, sub_rm i32, sub_rm i64,
    mul_rm i16, mul_rm i32, mul_rm i64,
    and_rm i8, and_rm i16, and_rm i32, and_rm i64,
    or_rm i8, or_rm i16, or_rm i32, or_rm i64,
    xor_rm i8, xor_rm i16, xor_rm i32, xor_rm i64,
    add_mr i8, add_mr i16, add_mr i32, add_mr i64, add_mr_imm i8, add_mr_imm i16, add_mr_imm i32, add_mr_imm i64,
    sub_mr i8, sub_mr i16, sub_mr i32, sub_mr i64, sub_mr_imm i8, sub_mr_imm i16, sub_mr_imm i32, sub_mr_imm i64,
    and_mr i8, and_mr i16, and_mr i32, and_mr i64, and_mr_imm i8, and_mr_imm i16, and_mr_imm i32, and_mr_imm i64,
    or_mr i8, or_mr i16, or_mr i32, or_mr i64, or_mr_imm i8, or_mr_imm i16, or_mr_imm i32, or_mr_imm i64,
    xor_mr i8, xor_mr i16, xor_mr i32, xor_mr i64, xor_mr_imm i8, xor_mr_imm i16, xor_mr_imm i32, xor_mr_imm i64);
///
/// ## Phases
///
/// ### gen
///
/// Writes the closed rules of this plugin as C++ matchers and builders (mim::plug::x86::rules) to `-X x86_isel:o=<file>`, or to stdout.
///
axm gen: compile.Phase;
