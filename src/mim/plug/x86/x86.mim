/// # The x86 Plugin {#x86}
///
/// @see mim::plug::x86
///
/// [TOC]
///
/// The native x86-64 backend.
/// Loading this plugin (`mim foo.mim -p x86`) appends instruction selection and emission to the compilation pipeline.
/// Instruction selection rewrites `core`, `math`, and `mem` into the axioms below.
/// A literal operand of an instruction is an immediate and has to fit its encoding; `mov` puts any other constant into a register.
/// Registers are no concern of these types; register allocation introduces them later.
/// The schedule is the `mem.M 0` chain: memory instructions sit on it, and scheduling threads all other instructions onto it via `sched`.
///
/// ## Dependencies
///
plugin core;
plugin mem;
plugin opt;
plugin refly;
import compile;
///
/// ## Types
///
/// ### Flags
///
/// The flags register.
///
axm Flags: *;
///
/// ### Addr
///
/// A memory operand `disp(base, index, scale)`; the `Bool` states whether it has an index.
/// It is no value and occupies no register of its own; only memory instructions and `lea` take one.
///
axm Addr: Bool → *;
///
/// ### Base
///
/// An address `disp(base)` without an index.
///
anx let Base = Addr ff;
///
/// ### Index
///
/// An address `disp(base, index, scale)`.
///
anx let Index = Addr tt;
///
/// ### addr
///
/// `addr (disp, base)` addresses `disp + base`, like AT&T's `disp(base)`.
/// A literal `0I64` as `base` means there is none.
/// A literal `base` folds into `disp` if the sum fits, else it goes into a register.
///
axm addr: [disp: I32, base: I64] → Base, normalize_addr;
///
/// ### index
///
/// `index a (i, scale)` addresses `a + (i << scale)`, like AT&T's `disp(base, index, scale)`.
/// An address has at most one index.
///
axm index: Base → [index: I64, scale: I2] → Index;
///
/// These lets name the scales.
///
anx let scale_1 = 0I2;
anx let scale_2 = 1I2;
anx let scale_4 = 2I2;
anx let scale_8 = 3I2;
///
/// ### Spill
///
/// A spill slot holding a value of type `Idx s`.
/// It is no register value; slot assignment gives it a place in the stack frame.
///
axm Spill: Nat → *;
///
/// ## Operand Sizes
///
/// Instructions are polymorphic in the operand size `s` and state which sizes they support via `refly.check` in their codomain.
/// A literal `s` folds the check away; an unsupported one is an error.
///
lam is (s n: Nat): Bool = core.ncmp.e (s, n);
///
/// ### gpr
///
/// `i8`, `i16`, `i32`, or `i64`.
///
anx lam gpr (s: Nat): Nat =
    let ok = core.bit2.or 0 (core.bit2.or 0 (is (s, i8), is (s, i16)), core.bit2.or 0 (is (s, i32), is (s, i64)));
    refly.check (ok, s, "x86: operand size must be i8, i16, i32, or i64");
///
/// ### gpr16
///
/// `i16`, `i32`, or `i64`.
///
anx lam gpr16 (s: Nat): Nat =
    let ok = core.bit2.or 0 (is (s, i16), core.bit2.or 0 (is (s, i32), is (s, i64)));
    refly.check (ok, s, "x86: operand size must be i16, i32, or i64");
///
/// ### logic
///
/// `Bool` or a gpr size.
///
anx lam logic (s: Nat): Nat =
    let ok = core.bit2.or 0 (is (s, 2), core.bit2.or 0 (core.bit2.or 0 (is (s, i8), is (s, i16)), core.bit2.or 0 (is (s, i32), is (s, i64))));
    refly.check (ok, s, "x86: operand size must be Bool, i8, i16, i32, or i64");
///
/// ## Instruction Forms
///
/// The plugin pretends that x86 uses three-address code and copes with x86's two-address code later on.
/// However, some artifacts shine through:
/// for two-address instructions the tied value operand comes first; the tie is only a register-assignment constraint (`add (a, b)` computes `a + b`), and `x86.emit` reverses the value operands for its AT&T output.
///
/// ### rm
///
/// `op r, addr`: `rm f (m, a, addr)` is `f (a, b)` with `b` loaded from `addr`.
///
axm rm: {s: Nat, C: *, i: Bool} → («2; Idx s» → C) → [mem.M 0, Idx s, Addr i] → [mem.M 0, C];
///
/// ### mr
///
/// `op addr, r`: `mr f (m, addr, b)` stores `f (a, b)` to `addr` with `a` loaded from `addr`.
///
axm mr: {s: Nat, C: *, i: Bool} → («2; Idx s» → C) → [mem.M 0, Addr i, Idx s] → mem.M 0;
///
/// ### sched
///
/// Places the pure instruction `f x` on the `mem.M 0` chain right after `m`: `let (m, y) = x86.sched x86.add m (a, b)`.
/// The chain token makes each placement a distinct Def, so copies, spills, and reloads at different points never merge.
///
axm sched: {D C: *} → (D → C) → mem.M 0 → D → [mem.M 0, C];
///
/// ## Registers
///
/// ### in
///
/// `in r v` is `v`, which lives in register `r`; the operand size `s` selects the subregister.
/// Register allocation wraps every use of a value, so all uses of `v` share one `in r v`.
/// It is no instruction: it is neither scheduled nor on the chain.
///
axm in: [r: I4] → {s: Nat} → Idx s → Idx s;
///
/// ### reg
///
/// The general-purpose registers in hardware encoding order.
/// A register's subtag is its hardware encoding, so they have to stay in this order.
///
pub mod reg
    anx let rax = 0I4;
    anx let rcx = 1I4;
    anx let rdx = 2I4;
    anx let rbx = 3I4;
    anx let rsp = 4I4;
    anx let rbp = 5I4;
    anx let rsi = 6I4;
    anx let rdi = 7I4;
    anx let r8  = 8I4;
    anx let r9  = 9I4;
    anx let r10 = 10I4;
    anx let r11 = 11I4;
    anx let r12 = 12I4;
    anx let r13 = 13I4;
    anx let r14 = 14I4;
    anx let r15 = 15I4;
end
///
/// ## Instructions
///
/// ### lea
///
/// `lea r, addr` materializes an address as a value.
/// The address `addr (0, b)` is `b`, and `addr (d, 0)` the literal `d`.
///
axm lea: {i: Bool} → Addr i → I64, normalize_lea;
///
/// ### mov
///
/// `mov r, imm` materializes a constant.
///
axm mov: {s: Nat} → Idx s → Idx (logic s);
///
/// ### load
///
/// `mov r, addr`.
///
axm load: [s: Nat] → {i: Bool} → [mem.M 0, Addr i] → [mem.M 0, Idx (gpr s)];
///
/// ### store
///
/// `mov addr, r`.
///
axm store: {s: Nat, i: Bool} → [mem.M 0, Addr i, Idx s] → mem.M 0;
///
/// ### slot
///
/// Reserves `n` bytes in the stack frame and yields their address via `lea`.
///
axm slot: [n: Nat] → mem.M 0 → [mem.M 0, I64];
///
/// ### spill
///
/// `spill x` stores `x` into a spill slot; it is placed on the chain via `sched` like any other pure instruction.
///
axm spill: {s: Nat} → Idx s → Spill s;
///
/// ### reload
///
/// `reload x` loads `x` from its spill slot.
///
axm reload: {s: Nat} → Spill s → Idx s;
///
/// ### Arithmetic
///
/// Two-address arithmetic `op r, r/imm`.
///
axm (add, sub): {s: Nat} → «2; Idx s» → Idx (gpr s);
axm (and, or, xor): {s: Nat} → «2; Idx s» → Idx (logic s);
axm imul: {s: Nat} → «2; Idx s» → Idx (gpr16 s);
///
/// ### Division
///
/// `div`/`idiv` yield the quotient (`rax`) and the remainder (`rdx`).
///
axm (div, idiv): {s: Nat} → «2; Idx s» → «2; Idx (gpr16 s)»;
///
/// ### Shifts
///
/// Shifts by `cl` or an immediate.
///
axm (shl, shr, sar): {s: Nat} → «2; Idx s» → Idx (gpr s);
///
/// ### Conversions
///
/// `movzx`, `movsx`, and truncation to the low bits of the register; they fold a literal.
///
axm movzx: {s: Nat} → [d: Nat] → Idx s → Idx d, normalize_movzx;
axm movsx: {s: Nat} → [d: Nat] → Idx s → Idx d, normalize_movsx;
axm trunc: {s: Nat} → [d: Nat] → Idx s → Idx d, normalize_trunc;
///
/// ### Comparisons
///
/// `cmp r, r/imm` and `test r, r/imm`.
///
axm (cmp, test): {s: Nat} → «2; Idx s» → Flags;
///
/// ### Condition Codes
///
/// The condition codes in hardware encoding order:
///
/// | Subtag | cc |
/// |--------|----|
/// | `o`    |  0 |
/// | `no`   |  1 |
/// | `b`    |  2 |
/// | `ae`   |  3 |
/// | `e`    |  4 |
/// | `ne`   |  5 |
/// | `be`   |  6 |
/// | `a`    |  7 |
/// | `s`    |  8 |
/// | `ns`   |  9 |
/// | `p`    | 10 |
/// | `np`   | 11 |
/// | `l`    | 12 |
/// | `ge`   | 13 |
/// | `le`   | 14 |
/// | `g`    | 15 |
///
/// #### cc
///
/// Tests a condition code on the flags: `jcc` as a branch condition, `setcc` otherwise.
///
axm cc.(o, no, b, ae, e, ne, be, a, s, ns, p, np, l, ge, le, g): Flags → Bool;
///
/// #### cmovcc
///
/// `cmovcc.l (f, x, y)` yields `y` if `l` holds on `f`, else `x`, like `(x, y)#cond`.
///
/// `cmovcc.ne (test (cc.l f, cc.l f), x, y)` normalizes to `cmovcc.l (f, x, y)`.
///
axm cmovcc.(o, no, b, ae, e, ne, be, a, s, ns, p, np, l, ge, le, g): {s: Nat} → [Flags, Idx s, Idx s] → Idx (gpr16 s), normalize_cmovcc;
///
/// ## Phases
///
/// ### isel
///
/// Instruction selection.
/// `-X x86:isel-dot=<file>` writes the PBQP graph in Graphviz DOT format, with the chosen options highlighted.
///
axm isel: compile.Phase;
///
/// ### schedule
///
/// Threads every instruction of a block onto the block's `mem.M 0` chain.
/// Expects every continuation to take a `mem.M 0`.
///
axm schedule: compile.Phase;
///
/// ### spilling
///
/// Spills and reloads until at most `k` general-purpose values are live at every point (Braun & Hack, CC 2009).
/// `k` is 14 by default and `-X x86:k=<n>` overrides it.
///
axm spilling: compile.Phase;
///
/// ### constrain
///
/// Moves the operands that an instruction needs in a fixed register, and a two-address operand that stays live, into a fresh continuation right before it.
/// The jump is the copy, so the copies' live ranges end at the instruction and the interference graph stays chordal.
/// The fixed operands are wrapped in `in`.
/// Likewise, a fixed result that stays live is passed on to a fresh continuation right after its instruction.
///
axm constrain: compile.Phase;
///
/// ### color
///
/// Assigns a register to every general-purpose value by one PBQP per function (Buchwald, Zwinkau, Bersch, CC 2011) and wraps each use of a value in `in`.
/// Jumps, calls, and returns are parallel copies: their arguments only prefer the registers of the parameters they bind.
/// Removes chain instructions whose results are all dead.
/// `-X x86:color-dot=<file>` writes the PBQP graph of each function in Graphviz DOT format, with the chosen options highlighted.
///
axm color: compile.Phase;
///
/// ### emit
///
/// Emits GNU assembler code (AT&T syntax) to `<world>.s`.
///
axm emit: compile.Phase;
///
/// ### live
///
/// Prints the liveness of every scheduled function to stdout, or to `-X x86:live=<file>`: per block the live-in and live-out values and the maximum number of live values (general-purpose registers, flags).
///
axm live: compile.Phase;
