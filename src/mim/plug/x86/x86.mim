/// # The x86 Plugin {#x86}
///
/// @see mim::plug::x86
///
/// [TOC]
///
/// The native x86-64 backend.
/// Loading this plugin (`mim foo.mim -p x86`) appends instruction selection and emission to the compilation pipeline.
/// Instruction selection rewrites `core`, `math`, and `mem` into the axioms below.
/// Registers, immediates, addressing modes, and the schedule are no concern of these types; register allocation introduces them later.
///
/// ## Dependencies
///
plugin core;
plugin mem;
plugin opt;
plugin refly;
import compile;
///
/// ## Types
///
/// ### Fl
///
/// The flags register.
///
axm Fl: *;
///
/// ### emit
///
/// Emits GNU assembler code (Intel syntax) to `<world>.s`.
///
axm emit: compile.Phase;
///
/// ## Operand Sizes
///
/// Instructions are polymorphic in the operand size `s` and state which sizes they support via `refly.check` in their codomain.
/// A literal `s` folds the check away; an unsupported one is an error.
///
lam is (s n: Nat): Bool = core.ncmp.e (s, n);
///
/// ### gpr
///
/// `i8`, `i16`, `i32`, or `i64`.
///
anx lam gpr (s: Nat): Nat =
    let ok = core.bit2.or 0 (core.bit2.or 0 (is (s, i8), is (s, i16)), core.bit2.or 0 (is (s, i32), is (s, i64)));
    refly.check (ok, s, "x86: operand size must be i8, i16, i32, or i64");
///
/// ### gpr16
///
/// `i16`, `i32`, or `i64`.
///
anx lam gpr16 (s: Nat): Nat =
    let ok = core.bit2.or 0 (is (s, i16), core.bit2.or 0 (is (s, i32), is (s, i64)));
    refly.check (ok, s, "x86: operand size must be i16, i32, or i64");
///
/// ### logic
///
/// `Bool` or a gpr size.
///
anx lam logic (s: Nat): Nat =
    let ok = core.bit2.or 0 (is (s, 2), core.bit2.or 0 (core.bit2.or 0 (is (s, i8), is (s, i16)), core.bit2.or 0 (is (s, i32), is (s, i64))));
    refly.check (ok, s, "x86: operand size must be Bool, i8, i16, i32, or i64");
///
/// ## Instructions
///
/// ### load
///
/// `mov r, [addr]`.
///
axm load: [s: Nat] → {a: Nat} → [mem.M a, I64] → [mem.M a, Idx (gpr s)];
///
/// ### store
///
/// `mov [addr], r`.
///
axm store: {s a: Nat} → [mem.M a, I64, Idx s] → mem.M a;
///
/// ### Arithmetic
///
/// Two-address arithmetic `op r, r/imm`.
///
axm (add, sub): {s: Nat} → «2; Idx s» → Idx (gpr s);
axm (and, or, xor): {s: Nat} → «2; Idx s» → Idx (logic s);
axm imul: {s: Nat} → «2; Idx s» → Idx (gpr16 s);
///
/// ### Shifts
///
/// Shifts by `cl` or an immediate.
///
axm (shl, shr, sar): {s: Nat} → «2; Idx s» → Idx (gpr s);
///
/// ### Conversions
///
/// `movzx`, `movsx`, and truncation to the low bits of the register.
///
axm (movzx, movsx, trunc): {s: Nat} → [d: Nat] → Idx s → Idx d;
///
/// ### Comparisons
///
/// `cmp r, r/imm` and `test r, r/imm`.
///
axm (cmp, test): {s: Nat} → «2; Idx s» → Fl;
///
/// ## Condition Codes
///
/// A condition code `cc` is a Nat in hardware encoding order:
/// o = 0, no = 1, b = 2, ae = 3, e = 4, ne = 5, be = 6, a = 7, s = 8, ns = 9, p = 10, np = 11, l = 12, ge = 13, le = 14, g = 15.
///
/// ### cc
///
/// Tests `cc` on the flags: `jcc` as a branch condition, `setcc` otherwise.
///
axm cc: [cc: Nat] → Fl → Bool;
///
/// ### cmovcc
///
axm cmovcc: [cc: Nat] → {s: Nat} → [Fl, Idx s, Idx s] → Idx (gpr16 s);
///
/// ## Phases
///
/// ### isel
///
/// Instruction selection.
///
axm isel: compile.Phase;
///
