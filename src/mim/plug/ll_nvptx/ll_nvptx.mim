/// # The ll_nvptx Plugin {#ll_nvptx}
///
/// @see mim::plug::ll_nvptx
///
/// A plugin to target LLVM IR with PTX intrinsics.
///
/// [TOC]
///
/// ## Dependencies
///
plugin gpu;
plugin nvptx;
plugin opt;
import compile;
///
/// ## Command-Line Arguments {#ll_nvptx_cli_args}
///
/// This plugin reads the following [plugin arguments](@ref clipluginargs) (`-X ll_nvptx:<arg>`):
///
/// | Argument   | Effect                                                                      |
/// |------------|-----------------------------------------------------------------------------|
/// | `o=<file>`         | Write the (host) LLVM IR to `<file>` instead of the default `<world>.ll`/`a.ll`.         |
/// | `o-dev=<file>`     | Write the device LLVM IR to `<file>` instead of the default `<world>_dev.ll`/`a_dev.ll`. |
/// | `no-embed`         | Don't embed compiled device binary in host LLVM IR, which is the default behavior.       |
/// | `no-ptx-embed`     | If embedding device binary, don't embed PTX image into fat binary (default: PTX and CUBIN).            |
/// | `no-cubin-embed`   | If embedding device binary, don't embed CUBIN image into fat binary (default: PTX and CUBIN).          |
/// | `sm=<SM>`          | If embedding device binary, compile the device binary for compute capability sm_`<SM>`.                |
/// | `libdevice=<path>` | If embedding device binary and if linking libdevice, link against the libdevice NVVM library at `<path>` instead of trying to find it via CUDA paths. |
/// | `Xlink_llvm=<args>`| If embedding device binary and if linking libdevice, invoke link_llvm with `<args>` (default: none).   |
/// | `Xopt=<args>`      | If embedding device binary and if linking libdevice, invoke opt with `<args>` (default: `-passes="default<O2>,nvvm-reflect"`). |
/// | `Xllc=<args>`      | If embedding device binary, invoke llc with `<args>` (default: none).                                  |
/// | `Xptxas=<args>`    | If embedding device binary, invoke ptxas with `<args>` (default: none). Also passed to fatbinary via --cmdline if embedding PTX image. |
/// | `Xfatbinary=<args>`| If embedding device binary, invoke fatbinary with `<args>` (default: none).                            |
///
/// ## Phases
///
/// ### %%ll_nvptx.emit
///
/// Emits the LLVM IR with PTX intrinsics for the host and device worlds split from the current world.
/// This phase is spliced into the default pipeline (see `opt`) whenever the `ll_nvptx` plugin is loaded.
///
axm %ll_nvptx.emit: %compile.Phase;
