/// # The ll_nvptx Plugin {#ll_nvptx}
///
/// @see mim::plug::ll_nvptx
///
/// A plugin to target LLVM IR with PTX intrinsics.
///
/// [TOC]
///
/// ## Dependencies
///
plugin gpu;
plugin nvptx;
plugin opt;
import compile;
///
/// ## Phases
///
/// ### %%ll_nvptx.emit
///
/// Emits the LLVM IR with PTX intrinsics for the host and device worlds split from the current world.
/// This phase is spliced into the default pipeline (see `opt`) whenever the `ll_nvptx` plugin is loaded.
///
axm %ll_nvptx.emit: %compile.Phase;
