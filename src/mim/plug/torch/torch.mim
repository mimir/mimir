/// # The Torch Plugin {#torch}
///
/// Framework-level Torch operators with executable Mim implementations.
/// Each public `*_op` axiom has a matching `*_op_impl` lambda. Running
/// `%torch.lower_torch` exposes those semantics as tensor operations.
///
/// Scalar behavior is supplied explicitly through `%torch.Arithmetic`. This is
/// a lightweight typeclass dictionary that keeps dtype-specific behavior out
/// of operator definitions. `%torch.resolve_arithmetic` and
/// `%torch.resolve_floating` map flat scalar types to built-in dictionaries;
/// exact static lookup and the provider branch disappear under PE.
///
/// Utility comments cite the matching PyTorch implementation when one exists.
/// `PyTorch source` means that the predicate or formula intentionally mirrors
/// that implementation. `MimIR lowering` marks helpers that only construct
/// tensor loop/projection metadata after the PyTorch-level choice is known.
///
plugin tensor;
plugin core;
plugin math;
plugin affine;
plugin runtime;
plugin vec;
plugin option;

/// Exact lookup in a flat `(scalar type, instance)` table. This deliberately
/// small Torch-local dispatcher is sufficient for non-compositional dtypes.
axm %torch.resolve: {V: *, n: Nat}
                  → [key: *, instances: «n; [*, V]»]
                  → V, normalize_resolve;

let %torch.Arithmetic = [
    R: %tensor.Ring,
    sub: [R#T, R#T] → R#T,
    div: [R#T, R#T] → R#T,
    maximum: [R#T, R#T] → R#T,
    minimum: [R#T, R#T] → R#T,
    eq: [R#T, R#T] → Bool,
    ne: [R#T, R#T] → Bool,
    lt: [R#T, R#T] → Bool,
    le: [R#T, R#T] → Bool,
    gt: [R#T, R#T] → Bool,
    ge: [R#T, R#T] → Bool,
    is_nan: R#T → Bool,
    is_zero: R#T → Bool,
];

let %torch.Floating = [
    A: %torch.Arithmetic,
    neg_inf: A#R#T,
    exp: A#R#T → A#R#T,
    log: A#R#T → A#R#T,
    tanh: A#R#T → A#R#T,
    erf: A#R#T → A#R#T,
    sqrt: A#R#T → A#R#T,
    rsqrt: A#R#T → A#R#T,
    sin: A#R#T → A#R#T,
    cos: A#R#T → A#R#T,
    from_nat: Nat → A#R#T,
    pow: [A#R#T, A#R#T] → A#R#T,
];

/// Python: `return math.isnan(x)`.
lam torch_float_is_nan {pe: «2; Nat»} (x: %math.F pe): Bool =
    %math.cmp.u @pe 0 (x, x);

/// Python: `return x == 0`.
lam torch_float_is_zero {pe: «2; Nat»} (x: %math.F pe): Bool =
    %math.cmp.e @pe 0 (x, 0:(%math.F pe));

/// Python: `return float(x)`.
lam torch_float_from_nat {pe: «2; Nat»} (x: Nat): %math.F pe =
    %math.conv.u2f pe (%core.bitcast I64 x);

/// Builds the scalar semantics shared by IEEE floating-point Torch dtypes.
lam torch_float_arithmetic {pe: «2; Nat»}(): %torch.Arithmetic = (
    (%math.F pe, 0:(%math.F pe), %math.arith.add @pe 0, %math.arith.mul @pe 0),
    %math.arith.sub @pe 0,
    %math.arith.div @pe 0,
    %math.extrema.ieee754max @pe 0,
    %math.extrema.ieee754min @pe 0,
    %math.cmp.e @pe 0,
    %math.cmp.ne @pe 0,
    %math.cmp.l @pe 0,
    %math.cmp.le @pe 0,
    %math.cmp.g @pe 0,
    %math.cmp.ge @pe 0,
    torch_float_is_nan @pe,
    torch_float_is_zero @pe,
);

lam torch_f32_arithmetic (): %torch.Arithmetic =
    torch_float_arithmetic @%math.f32 ();
lam torch_f64_arithmetic (): %torch.Arithmetic =
    torch_float_arithmetic @%math.f64 ();
lam torch_f32_floating (): %torch.Floating = (
    torch_f32_arithmetic (),
    0xFF800000:%math.F32,
    %math.exp.exp @%math.f32 0,
    %math.exp.log @%math.f32 0,
    %math.tri.tanh @%math.f32 0,
    %math.er.f @%math.f32 0,
    %math.rt.sq @%math.f32 0,
    %math.rrt @%math.f32 0,
    %math.tri.sin @%math.f32 0,
    %math.tri.cos @%math.f32 0,
    torch_float_from_nat @%math.f32,
    %math.pow @%math.f32 0,
);
lam torch_f64_floating (): %torch.Floating = (
    torch_f64_arithmetic (),
    0xFFF0000000000000:%math.F64,
    %math.exp.exp @%math.f64 0,
    %math.exp.log @%math.f64 0,
    %math.tri.tanh @%math.f64 0,
    %math.er.f @%math.f64 0,
    %math.rt.sq @%math.f64 0,
    %math.rrt @%math.f64 0,
    %math.tri.sin @%math.f64 0,
    %math.tri.cos @%math.f64 0,
    torch_float_from_nat @%math.f64,
    %math.pow @%math.f64 0,
);

let %torch.scalar_type_tags = (
    (%math.F32, 0),
    (%math.F64, 1),
);

lam torch_select_arithmetic
    (condition: Bool, if_true if_false: %torch.Arithmetic): %torch.Arithmetic =
    (if_false, if_true)#condition;

lam torch_select_floating
    (condition: Bool, if_true if_false: %torch.Floating): %torch.Floating =
    (if_false, if_true)#condition;

/// Resolves exact scalar arithmetic semantics for a supported flat dtype.
lam %torch.resolve_arithmetic (T: *): %torch.Arithmetic =
    let tag = %torch.resolve @(Nat, 2) (T, %torch.scalar_type_tags);
    torch_select_arithmetic (
        %core.ncmp.e (tag, 0),
        torch_f32_arithmetic (),
        torch_f64_arithmetic ());

/// Resolves exact floating-point semantics for a supported flat dtype.
lam %torch.resolve_floating (T: *): %torch.Floating =
    let tag = %torch.resolve @(Nat, 2) (T, %torch.scalar_type_tags);
    torch_select_floating (
        %core.ncmp.e (tag, 0),
        torch_f32_floating (),
        torch_f64_floating ());

/// Python: `return max(x, 0)`.
lam torch_relu_scalar [A: %torch.Arithmetic] (x: A#R#T): A#R#T =
    A#maximum (x, A#R#_0);

/// Python: `return x if x >= 0 else negative_slope * x`.
lam torch_leaky_relu_scalar [F: %torch.Floating]
                            (negative_slope: F#A#R#T)
                            (x: F#A#R#T): F#A#R#T =
    %core.select
        (F#A#ge (x, F#from_nat 0), x,
         F#A#R#mul (negative_slope, x));

/// Python: `return scale * x`.
lam torch_scale_scalar [A: %torch.Arithmetic] (scale: A#R#T) (x: A#R#T): A#R#T =
    A#R#mul (scale, x);

/// Python: `return x / denominator`.
lam torch_div_scalar [A: %torch.Arithmetic] (denominator: A#R#T) (x: A#R#T): A#R#T =
    A#div (x, denominator);

/// Python: `return acc + x * weight`.
fun torch_linear_comb [A: %torch.Arithmetic]
                      [acc: A#R#T, [x: A#R#T, weight: A#R#T]]@tt: A#R#T =
    return (A#R#add (acc, A#R#mul (x, weight)));

/// Python: `return x + offset`.
lam torch_add_scalar [A: %torch.Arithmetic] (offset: A#R#T) (x: A#R#T): A#R#T =
    A#R#add (x, offset);

/// Python: `return wrap_i64(x + offset)`.
lam torch_add_i64_scalar (offset: I64) (x: I64): I64 =
    %core.wrap.add 0 (x, offset);

/// Python: `return x - other`.
lam torch_sub_scalar [A: %torch.Arithmetic] (other: A#R#T) (x: A#R#T): A#R#T =
    A#sub (x, other);

/// Python: `return self + alpha * other` for scalar `self` and tensor `other`.
lam torch_add_scalar_lhs [A: %torch.Arithmetic]
                         (self alpha: A#R#T) (other: A#R#T): A#R#T =
    A#R#add (self, A#R#mul (alpha, other));

/// Python: `return self - alpha * other` for scalar `self` and tensor `other`.
lam torch_sub_scalar_lhs [A: %torch.Arithmetic]
                         (self alpha: A#R#T) (other: A#R#T): A#R#T =
    A#sub (self, A#R#mul (alpha, other));

/// Python: `return wrap_i64(x - other)`.
lam torch_sub_i64_scalar (other: I64) (x: I64): I64 =
    %core.wrap.sub 0 (x, other);

/// Python: `return x != other`.
lam torch_ne_i64_scalar (other: I64) (x: I64): Bool =
    %core.icmp.ne (x, other);

lam torch_eq_i64_scalar (other: I64) (x: I64): Bool =
    %core.icmp.e (x, other);
lam torch_lt_i64_scalar (other: I64) (x: I64): Bool =
    %core.icmp.sl (x, other);
lam torch_le_i64_scalar (other: I64) (x: I64): Bool =
    %core.icmp.sle (x, other);
lam torch_gt_i64_scalar (other: I64) (x: I64): Bool =
    %core.icmp.sg (x, other);
lam torch_ge_i64_scalar (other: I64) (x: I64): Bool =
    %core.icmp.sge (x, other);

/// Python: signed I64 elementwise comparison helpers.
lam torch_eq_i64 (lhs rhs: I64): Bool = %core.icmp.e (lhs, rhs);
lam torch_ne_i64 (lhs rhs: I64): Bool = %core.icmp.ne (lhs, rhs);
lam torch_lt_i64 (lhs rhs: I64): Bool = %core.icmp.sl (lhs, rhs);
lam torch_le_i64 (lhs rhs: I64): Bool = %core.icmp.sle (lhs, rhs);
lam torch_gt_i64 (lhs rhs: I64): Bool = %core.icmp.sg (lhs, rhs);
lam torch_ge_i64 (lhs rhs: I64): Bool = %core.icmp.sge (lhs, rhs);

lam torch_neg_scalar [A: %torch.Arithmetic] (x: A#R#T): A#R#T =
    A#sub (A#R#_0, x);

/// Python: `return x if x >= 0 else -x`.
lam torch_abs_scalar [A: %torch.Arithmetic] (x: A#R#T): A#R#T =
    %core.select @A#R#T (A#ge (x, A#R#_0), x, torch_neg_scalar A x);

/// Python: `abs(x-y)` for beta zero, otherwise SmoothL1's quadratic/linear split.
lam torch_smooth_l1_scalar [F: %torch.Floating]
                           (beta: F#A#R#T)
                           (args: «2; F#A#R#T»): F#A#R#T =
    let distance = torch_abs_scalar F#A (F#A#sub (args#ff, args#tt));
    let half = F#A#div (F#from_nat 1, F#from_nat 2);
    let quadratic = F#A#div (
        F#A#R#mul (half, F#A#R#mul (distance, distance)), beta);
    let linear = F#A#sub (distance, F#A#R#mul (half, beta));
    let smooth = %core.select @F#A#R#T
        (F#A#lt (distance, beta), quadratic, linear);
    %core.select @F#A#R#T (F#A#is_zero beta, distance, smooth);

/// Python:
/// ```python
/// if log_target:
///     return exp(target) * (target - input)
/// loss = target * (log(target) - input)
/// return 0 if target == 0 else loss
/// ```
/// Only an exact zero target is masked. Negative targets intentionally retain
/// the NaN produced by `log(target)`, matching `aten.kl_div`.
lam torch_kl_div_scalar [F: %torch.Floating]
                          (log_target: Bool)
                          (args: «2; F#A#R#T»): F#A#R#T =
    let input = args#ff;
    let target = args#tt;
    let probability_target = F#A#R#mul (
        target, F#A#sub (F#log target, input));
    let ordinary = %core.select @F#A#R#T (
        F#A#is_zero target, F#A#R#_0, probability_target);
    let logarithmic = F#A#R#mul (
        F#exp target, F#A#sub (target, input));
    %core.select @F#A#R#T (log_target, logarithmic, ordinary);

/// Python: `abs(lhs - rhs + eps) ** p` for one PairwiseDistance component.
lam torch_pairwise_power_scalar [F: %torch.Floating]
                                  (eps p: F#A#R#T)
                                  (args: «2; F#A#R#T»): F#A#R#T =
    let shifted = F#A#R#add (F#A#sub (args#ff, args#tt), eps);
    F#pow (torch_abs_scalar F#A shifted, p);

/// Python: `max(distance_positive - distance_negative + margin, 0)`.
lam torch_triplet_margin_scalar [F: %torch.Floating]
                                 (margin: F#A#R#T)
                                 (args: «2; F#A#R#T»): F#A#R#T =
    F#A#maximum (
        F#A#R#add (F#A#sub (args#ff, args#tt), margin),
        F#A#R#_0);

/// Python: `return compare(args[0], args[1])`.
lam torch_compare_scalar [A: %torch.Arithmetic]
                         (compare: [A#R#T, A#R#T] → Bool)
                         (args: «2; A#R#T»): Bool =
    compare (args#ff, args#tt);

/// Python: `return math.exp(x)`.
lam torch_exp_scalar [F: %torch.Floating] (x: F#A#R#T): F#A#R#T = F#exp x;
/// Python: `return math.log(x)`.
lam torch_log_scalar [F: %torch.Floating] (x: F#A#R#T): F#A#R#T = F#log x;
/// Python: `return math.tanh(x)`.
lam torch_tanh_scalar [F: %torch.Floating] (x: F#A#R#T): F#A#R#T = F#tanh x;
/// Python: `return math.sqrt(x)`.
lam torch_sqrt_scalar [F: %torch.Floating] (x: F#A#R#T): F#A#R#T = F#sqrt x;
/// Python: `return 1.0 / math.sqrt(x)`.
lam torch_rsqrt_scalar [F: %torch.Floating] (x: F#A#R#T): F#A#R#T = F#rsqrt x;
/// Python: `return math.sin(x)`.
lam torch_sin_scalar [F: %torch.Floating] (x: F#A#R#T): F#A#R#T = F#sin x;
/// Python: `return math.cos(x)`.
lam torch_cos_scalar [F: %torch.Floating] (x: F#A#R#T): F#A#R#T = F#cos x;

/// Python: `return 1 / x`.
lam torch_reciprocal_scalar [F: %torch.Floating] (x: F#A#R#T): F#A#R#T =
    F#A#div (F#from_nat 1, x);

/// Python: `return 1 / (1 + math.exp(-x))`.
lam torch_sigmoid_scalar [F: %torch.Floating] (x: F#A#R#T): F#A#R#T =
    let one = F#from_nat 1;
    let denominator = F#A#R#add (one, F#exp (torch_neg_scalar F#A x));
    F#A#div (one, denominator);

/// Python: `return x * sigmoid(x)`.
lam torch_silu_scalar [F: %torch.Floating] (x: F#A#R#T): F#A#R#T =
    F#A#R#mul (x, torch_sigmoid_scalar F x);

/// Python equivalent of `torch.nn.functional.gelu(x, approximate=...)`.
/// `approximate_tanh` is static for normal Torch programs, so PE retains only
/// the selected formula. Rational constants avoid dtype-specific literals.
lam torch_gelu_scalar [F: %torch.Floating]
                      (approximate_tanh: Bool)
                      (x: F#A#R#T): F#A#R#T =
    let one = F#from_nat 1;
    let two = F#from_nat 2;
    let half = F#A#div (one, two);
    let exact = F#A#R#mul (
        F#A#R#mul (half, x),
        F#A#R#add (one, F#erf (F#A#div (x, F#sqrt two))));
    let x3 = F#A#R#mul (F#A#R#mul (x, x), x);
    let cubic_coefficient = F#A#div (F#from_nat 44715, F#from_nat 1000000);
    let tanh_coefficient = F#A#div (F#from_nat 39894228, F#from_nat 50000000);
    let tanh_argument = F#A#R#mul (
        tanh_coefficient,
        F#A#R#add (x, F#A#R#mul (cubic_coefficient, x3)));
    let approximate = F#A#R#mul (
        F#A#R#mul (half, x),
        F#A#R#add (one, F#tanh tanh_argument));
    %core.select @F#A#R#T (approximate_tanh, approximate, exact);

/// Python equivalent of `aten.elu(input, alpha, scale, input_scale)`.
lam torch_elu_scalar [F: %torch.Floating]
                      (alpha scale input_scale: F#A#R#T)
                      (x: F#A#R#T): F#A#R#T =
    let positive = F#A#R#mul (scale, x);
    let scaled_input = F#A#R#mul (input_scale, x);
    let negative = F#A#R#mul (
        F#A#R#mul (alpha, scale),
        F#A#sub (F#exp scaled_input, F#from_nat 1));
    %core.select @F#A#R#T (F#A#gt (x, F#A#R#_0), positive, negative);

/// Python equivalent of `hardsigmoid(x) = clamp(x + 3, 0, 6) / 6`.
lam torch_hardsigmoid_scalar [F: %torch.Floating]
                              (x: F#A#R#T): F#A#R#T =
    let six = F#from_nat 6;
    let shifted = F#A#R#add (x, F#from_nat 3);
    let lower = %core.select @F#A#R#T
        (F#A#ge (shifted, F#A#R#_0), shifted, F#A#R#_0);
    let bounded = %core.select @F#A#R#T
        (F#A#le (lower, six), lower, six);
    %core.select @F#A#R#T (F#A#is_nan x, x, F#A#div (bounded, six));

/// Python equivalent of `softplus(x, beta, threshold)`.
lam torch_softplus_scalar [F: %torch.Floating]
                          (beta threshold: F#A#R#T)
                          (x: F#A#R#T): F#A#R#T =
    let scaled = F#A#R#mul (beta, x);
    let smooth = F#A#div (
        F#log (F#A#R#add (F#from_nat 1, F#exp scaled)), beta);
    %core.select @F#A#R#T (F#A#gt (scaled, threshold), x, smooth);

/// Python: `return x ** exponent`.
lam torch_pow_scalar [F: %torch.Floating]
                     (exponent: F#A#R#T) (x: F#A#R#T): F#A#R#T =
    F#pow (x, exponent);

/// PyTorch source: `return where(x <= threshold, value, x)`.
lam torch_threshold_scalar [A: %torch.Arithmetic]
                           (threshold: A#R#T, value: A#R#T)
                           (x: A#R#T): A#R#T =
    %core.select @A#R#T (A#le (x, threshold), value, x);

/// Python: `return x if isnan(x) or x >= minimum else minimum`.
lam torch_clamp_min_scalar [A: %torch.Arithmetic]
                           (minimum: A#R#T) (x: A#R#T): A#R#T =
    %core.select @A#R#T (
        A#is_nan x,
        x,
        %core.select @A#R#T (A#ge (x, minimum), x, minimum));

/// Python: `return x if isnan(x) or x <= maximum else maximum`.
lam torch_clamp_max_scalar [A: %torch.Arithmetic]
                           (maximum: A#R#T) (x: A#R#T): A#R#T =
    %core.select @A#R#T (
        A#is_nan x,
        x,
        %core.select @A#R#T (A#le (x, maximum), x, maximum));

/// Python: `return x`.
lam torch_bool_id (x: Bool): Bool = x;

/// PyTorch source: `torch/_prims_common/__init__.py::prod`.
/// Python: `return math.prod(shape)`.
lam torch_numel {r: Nat} (s: «r; Nat»): Nat =
    %vec.fold.l %core.nat.mul (1, s);

/// PyTorch source: `torch/_prims_common/__init__.py::is_same_shape`.
/// Ranks are equal by type, so only corresponding extents remain to check.
/// Python: `return all(a == b for a, b in zip(actual, expected))`.
lam torch_shapes_equal {r: Nat} (actual expected: «r; Nat»): Bool =
    let checks = ‹i: r; %core.ncmp.e (actual#i, expected#i)›;
    %vec.fold.l (%core.bit2.and_ 0) (tt, checks);

/// PyTorch source: `torch/_prims/__init__.py::_broadcast_in_dim_meta` requires
/// `broadcast_dimensions` to be strictly ascending.
/// Python: `return all(a < b for a, b in zip(dims, dims[1:]))`.
lam torch_dims_strictly_ascending {ri ro: Nat}
                                   (dims: «ri; Idx ro»): Bool =
    let checks = ‹i: %core.nat.sub (ri, 1);
        let left_i = %core.idx ri 0 (%core.bitcast Nat i);
        let right_i = %core.idx ri 0 (%core.nat.add (%core.bitcast Nat i, 1));
        %core.icmp.ul @ro (dims#left_i, dims#right_i)›;
    %vec.fold.l (%core.bit2.and_ 0) (tt, checks);

/// PyTorch source: `torch/_prims/__init__.py::_broadcast_in_dim_meta`.
/// Unlike `torch/_prims_common.is_expandable_to`, this helper validates an
/// explicit source-to-output dimension map rather than trailing alignment.
/// Python: `return strictly_ascending(dims) and all(si == 1 or si == s_out[d] for si, d in zip(s_in, dims))`.
lam torch_broadcast_compatible {ri ro: Nat}
                               (s_in: «ri; Nat», s_out: «ro; Nat», dims: «ri; Idx ro»): Bool =
    let compatible = ‹i: ri;
        %core.bit2.or_ 0 (
            %core.ncmp.e (s_in#i, 1),
            %core.ncmp.e (s_in#i, s_out#(dims#i)))›;
    %core.bit2.and_ 0 (
        torch_dims_strictly_ascending @(ri, ro) dims,
        %vec.fold.l (%core.bit2.and_ 0) (tt, compatible));

/// PyTorch source: `torch/_prims_common/__init__.py::canonicalize_dim` and
/// `aten/src/ATen/WrapDimUtils.h`. Scalar wrapping is not used here because
/// the result type `Idx r` already requires a nonzero tensor rank.
/// Python: `return -rank <= dimension < rank`.
lam torch_dim_in_range {r: Nat} (dimension: I64): Bool =
    let rank = %core.bitcast I64 r;
    let neg_rank = %core.wrap.sub 0 (0I64, rank);
    %core.bit2.and_ 0 (
        %core.icmp.sge (dimension, neg_rank),
        %core.icmp.sl (dimension, rank));

/// PyTorch source: `torch/_prims_common/__init__.py::canonicalize_dim`.
/// Python: `return dimension + rank if dimension < 0 else dimension`.
lam torch_canonical_dim {r: Nat} (dimension: I64): Idx r =
    let rank = %core.bitcast I64 r;
    let adjusted = %core.select (
        %core.icmp.sl (dimension, 0I64),
        %core.wrap.add 0 (dimension, rank),
        dimension);
    %core.conv.u r adjusted;

/// PyTorch source correspondence: negative tensor indices are wrapped by the
/// indexing path in `aten/src/ATen/TensorIndexing.h`.
/// Python: `return -extent <= index < extent`.
lam torch_index_in_range (extent: Nat, index: I64): Bool =
    let extent_i64 = %core.bitcast I64 extent;
    let neg_extent = %core.wrap.sub 0 (0I64, extent_i64);
    %core.bit2.and_ 0 (
        %core.icmp.sge (index, neg_extent),
        %core.icmp.sl (index, extent_i64));

/// PyTorch source correspondence: `aten/src/ATen/TensorIndexing.h`.
/// Python: `return index + extent if index < 0 else index`.
lam torch_canonical_index (extent: Nat, index: I64): Nat =
    let extent_i64 = %core.bitcast I64 extent;
    let adjusted = %core.select (
        %core.icmp.sl (index, 0I64),
        %core.wrap.add 0 (index, extent_i64),
        index);
    %core.bitcast Nat adjusted;

/// MimIR lowering: constructs the projection used to remove one reduction
/// axis; PyTorch computes the same shape with
/// `torch/_prims_common/__init__.py::compute_reduction_output_shape`.
/// Python: `return i + 1 if i >= dimension else i`.
lam torch_kept_dim {r: Nat}
                   (dimension: Idx r, i: Idx (%core.nat.sub (r, 1))): Idx r =
    let i_nat = %core.bitcast Nat i;
    let dim_nat = %core.bitcast Nat dimension;
    let source = %core.select (
        %core.ncmp.ge (i_nat, dim_nat),
        %core.nat.add (i_nat, 1),
        i_nat);
    %core.idx r 0 source;

/// PyTorch source: `torch/_prims_common/__init__.py::compute_reduction_output_shape`.
/// Python: `return shape[:dimension] + shape[dimension + 1:]`.
lam torch_reduce_shape {r: Nat}
                       (s: «r; Nat», dimension: Idx r): «%core.nat.sub (r, 1); Nat» =
    ‹i: %core.nat.sub (r, 1); s#(torch_kept_dim @r (dimension, i))›;

/// MimIR lowering: materializes the kept-axis list consumed by
/// `%tensor.broadcast_in_dim_impl` and projection maps.
/// Python: `return [d for d in range(rank) if d != dimension]`.
lam torch_kept_dims {r: Nat}
                    (dimension: Idx r): «%core.nat.sub (r, 1); Idx r» =
    ‹i: %core.nat.sub (r, 1); torch_kept_dim @r (dimension, i)›;

/// MimIR lowering: map each source axis to its kept-output loop or the final
/// reduction loop. PyTorch's reference implementation expresses this through
/// `sum(..., dim=dimension)` instead of exposing loop subscripts.
lam torch_reduce_subscripts {r: Nat} (dimension: Idx r): «r; Nat» =
    let ro = %core.nat.sub (r, 1);
    let kept = torch_kept_dims @r dimension;
    ‹d: r;
        let position = (%vec.first (%core.icmp.e @r) (kept, d))#tt;
        %core.select (
            %core.icmp.e @r (d, dimension),
            ro,
            %core.bitcast Nat position)›;

/// Reduces one arbitrary dimension and removes it from the result shape.
/// A static `dimension` specializes all projection maps to affine projections.
/// Python: `return fold(g, input, axis=dimension, initial=init)`.
lam torch_reduce_dim {T: *, r: Nat}
                     (g: [T, T] → T, init: T)
                     (s: «r; Nat», dimension: Idx r)
                     (input: «s; T»)
                   : «torch_reduce_shape (s, dimension); T» =
    let ro = %core.nat.sub (r, 1);
    let loops = %core.nat.add (ro, 1);
    let s_out = torch_reduce_shape (s, dimension);
    let s_full = %vec.cat (s_out, (s#dimension,));
    let out_subs = ‹i: ro; %core.bitcast Nat i›;
    let in_subs = torch_reduce_subscripts @r dimension;
    %tensor.map_reduce @1 @(T, ro, loops) (s_out, s_full)
        @(T, r, s) (pool_fun g, init)
        (%tensor.proj_map @(loops, ro) out_subs)
        (%tensor.proj_map @(loops, r) in_subs,)
        input;

/// Python: `(sum(abs(lhs-rhs+eps)**p, dim=1))**(1/p)`.
lam torch_pairwise_distance_2d [F: %torch.Floating]
                                {n d: Nat}
                                (eps p: F#A#R#T)
                                (lhs rhs: «n, d; F#A#R#T»)
                              : «n; F#A#R#T» =
    let powers = %tensor.binary_impl
        @(F#A#R#T, F#A#R#T, F#A#R#T)
        (torch_pairwise_power_scalar F (eps, p))
        @(2, (n, d)) (lhs, rhs);
    let sums = torch_reduce_dim
        (F#A#R#add, F#A#R#_0) ((n, d), 1_2) powers;
    let reciprocal_p = F#A#div (F#from_nat 1, p);
    %tensor.unary_impl @(F#A#R#T, F#A#R#T)
        (torch_pow_scalar F reciprocal_p) @(1, (n,)) sums;

/// PyTorch source correspondence: reduction references use keepdim or
/// unsqueeze followed by expand; explicit mapping follows
/// `torch/_prims/__init__.py::_broadcast_in_dim_meta`.
/// Python: `return reduced.unsqueeze(dimension).expand(shape)`.
lam torch_broadcast_reduced {T: *, r: Nat}
                            (s: «r; Nat», dimension: Idx r)
                            (input: «torch_reduce_shape (s, dimension); T»): «s; T» =
    let ro = %core.nat.sub (r, 1);
    let s_in = torch_reduce_shape (s, dimension);
    let dims = torch_kept_dims @r dimension;
    %tensor.broadcast_in_dim_impl @(T, ro, r) (s_in, s, input, dims);

/// Python: `return shape[:dimension] + [1] + shape[dimension + 1:]`.
lam torch_keepdim_shape {r: Nat}
                        (s: «r; Nat», dimension: Idx r): «r; Nat» =
    ‹i: r;
        %core.select (
            %core.icmp.e @r (i, dimension),
            1,
            s#i)›;

/// PyTorch source: `torch/_prims_common/__init__.py::canonicalize_dims`.
/// Python: `return all(-rank <= d < rank for d in dimensions)`.
lam torch_dims_in_range {r nr: Nat} (dimensions: «nr; I64»): Bool =
    let checks = ‹i: nr; torch_dim_in_range @r (dimensions#i)›;
    %vec.fold.l (%core.bit2.and_ 0) (tt, checks);

/// PyTorch source: `torch/_prims_common/__init__.py::canonicalize_dims`.
/// Python: `return tuple(d + rank if d < 0 else d for d in dimensions)`.
lam torch_canonical_dims {r nr: Nat}
                         (dimensions: «nr; I64»): «nr; Idx r» =
    ‹i: nr; torch_canonical_dim @r (dimensions#i)›;

/// PyTorch source correspondence: `torch/_prims_common/__init__.py::reduction_dims`
/// canonicalizes dimensions and calls `validate_no_repeating_dims`. This
/// variant additionally requires the operator-specific non-empty list.
lam torch_dims_valid {r nr: Nat} (dimensions: «nr; I64»): Bool =
    let canonical = torch_canonical_dims @(r, nr) dimensions;
    %core.bit2.and_ 0 (
        %core.ncmp.ge (nr, 1),
        %core.bit2.and_ 0 (
            %core.ncmp.le (nr, r),
            %core.bit2.and_ 0 (
                torch_dims_in_range @(r, nr) dimensions,
                %vec.is_unique canonical)));

/// PyTorch source: `torch/_prims_common/__init__.py::reduction_dims` and
/// `validate_no_repeating_dims`; an empty explicit list is accepted here.
lam torch_axis_list_valid {r nr: Nat} (dimensions: «nr; I64»): Bool =
    let canonical = torch_canonical_dims @(r, nr) dimensions;
    %core.bit2.and_ 0 (
        %core.ncmp.le (nr, r),
        %core.bit2.and_ 0 (
            torch_dims_in_range @(r, nr) dimensions,
            %vec.is_unique canonical));

/// PyTorch source: `torch/_prims_common/__init__.py::compute_reduction_output_shape`.
/// Python: `return tuple(d for d in range(rank) if d not in dimensions)`.
lam torch_kept_axes {r nr: Nat}
                    (dimensions: «nr; Idx r») =
    %vec.diff (‹i: r; i›, dimensions);

/// Python: `return rank - len(set(dimensions))`.
lam torch_reduced_rank {r nr: Nat} (dimensions: «nr; Idx r»): Nat =
    %vec.len (torch_kept_axes @(r, nr) dimensions);

/// PyTorch source: `torch/_prims_common/__init__.py::compute_reduction_output_shape`.
/// Python: `return tuple(shape[d] for d in range(rank) if d not in dimensions)`.
lam torch_multi_reduce_shape {r nr: Nat}
                             (s: «r; Nat», dimensions: «nr; Idx r»)
                           : «torch_reduced_rank dimensions; Nat» =
    let kept = torch_kept_axes @(r, nr) dimensions;
    ‹i: torch_reduced_rank dimensions; s#(kept#i)›;

/// Python: `return tuple(1 if d in dimensions else shape[d] for d in range(rank))`.
lam torch_multi_keepdim_shape {r nr: Nat}
                              (s: «r; Nat», dimensions: «nr; Idx r»): «r; Nat» =
    ‹i: r;
        let reduced = (%vec.first (%core.icmp.e @r) (dimensions, i))#ff;
        %core.select (reduced, 1, s#i)›;

/// MimIR lowering: map kept axes to output loops and reduced axes to trailing
/// reduction loops. This is the loop-level realization of PyTorch's
/// `compute_reduction_output_shape` plus reduction over `dimensions`.
lam torch_multi_reduce_subscripts {r nr: Nat}
                                  (dimensions: «nr; Idx r»): «r; Nat» =
    let ro = torch_reduced_rank dimensions;
    let kept = torch_kept_axes @(r, nr) dimensions;
    ‹d: r;
        let (is_reduced, reduced_pos) =
            %vec.first (%core.icmp.e @r) (dimensions, d);
        let kept_pos = (%vec.first (%core.icmp.e @r) (kept, d))#tt;
        %core.select (
            is_reduced,
            %core.nat.add (ro, %core.bitcast Nat reduced_pos),
            %core.bitcast Nat kept_pos)›;

/// Python: `return fold(g, input, axes=dimensions, initial=init)`.
lam torch_multi_reduce {T: *, r nr: Nat}
                       (g: [T, T] → T, init: T)
                       (s: «r; Nat», dimensions: «nr; Idx r»)
                       (input: «s; T»)
                     : «torch_multi_reduce_shape (s, dimensions); T» =
    let ro = torch_reduced_rank dimensions;
    let s_out = torch_multi_reduce_shape (s, dimensions);
    let s_red = ‹i: nr; s#(dimensions#i)›;
    let s_full = %vec.cat (s_out, s_red);
    let loops = %core.nat.add (ro, nr);
    let out_subs = ‹i: ro; %core.bitcast Nat i›;
    let in_subs = torch_multi_reduce_subscripts @(r, nr) dimensions;
    %tensor.map_reduce @1 @(T, ro, loops) (s_out, s_full)
        @(T, r, s) (pool_fun g, init)
        (%tensor.proj_map @(loops, ro) out_subs)
        (%tensor.proj_map @(loops, r) in_subs,)
        input;

/// Python: `return math.prod(shape[d] for d in dimensions)`.
lam torch_reduction_numel {r nr: Nat}
                          (s: «r; Nat», dimensions: «nr; Idx r»): Nat =
    %vec.fold.l %core.nat.mul (1, ‹i: nr; s#(dimensions#i)›);

/// Python: `return x * x`.
lam torch_square_scalar [A: %torch.Arithmetic] (x: A#R#T): A#R#T =
    A#R#mul (x, x);

/// Python: `return (sum_sq - sum * (sum / count)) / denominator`.
lam torch_variance_scalar [F: %torch.Floating]
                          (count denominator: F#A#R#T)
                          (args: «2; F#A#R#T»): F#A#R#T =
    let sum = args#ff;
    let sum_sq = args#tt;
    let mean = F#A#div (sum, count);
    let centered_sum_sq = F#A#sub (sum_sq, F#A#R#mul (sum, mean));
    F#A#div (centered_sum_sq, denominator);

/// PyTorch source: `torch/_meta_registrations.py::pooling_output_shape_pad_lr`
/// and `aten/src/ATen/native/Pool.h::pooling_output_shape_pad_lr`.
/// Python equivalent of PyTorch's pooling output-size helper. Ceil mode first
/// rounds the division upward, then drops a final window whose start would lie
/// entirely in the right padded region.
lam torch_pool_dim (size kernel stride dilation padding: Nat,
                    ceil_mode: Bool): Nat =
    let effective_kernel = %core.nat.add (
        %core.nat.mul (dilation, %core.nat.sub (kernel, 1)), 1);
    let padded = %core.nat.add (size, %core.nat.mul (2, padding));
    let ceil_adjust = %core.select (ceil_mode, %core.nat.sub (stride, 1), 0);
    let rounded = %core.nat.add (
        %core.nat.div (
            %core.nat.add (
                %core.nat.sub (padded, effective_kernel), ceil_adjust),
            stride),
        1);
    let starts_in_right_padding = %core.ncmp.ge (
        %core.nat.mul (%core.nat.sub (rounded, 1), stride),
        %core.nat.add (size, padding));
    %core.select (
        %core.bit2.and_ 0 (ceil_mode, starts_in_right_padding),
        %core.nat.sub (rounded, 1),
        rounded);

lam torch_pool_shape
    (h w: Nat, kernel stride dilation padding: «2; Nat»,
     ceil_mode: Bool): «2; Nat» =
    (torch_pool_dim (h, kernel#ff, stride#ff, dilation#ff, padding#ff, ceil_mode),
     torch_pool_dim (w, kernel#tt, stride#tt, dilation#tt, padding#tt, ceil_mode));

lam torch_pool3d_shape
    (d h w: Nat, kernel stride dilation padding: «3; Nat»,
     ceil_mode: Bool): «3; Nat» =
    (torch_pool_dim
        (d, kernel#0_3, stride#0_3, dilation#0_3, padding#0_3, ceil_mode),
     torch_pool_dim
        (h, kernel#1_3, stride#1_3, dilation#1_3, padding#1_3, ceil_mode),
     torch_pool_dim
        (w, kernel#2_3, stride#2_3, dilation#2_3, padding#2_3, ceil_mode));

/// MimIR lowering: derives the high padding required to materialize the final
/// window selected by PyTorch's `pooling_output_shape_pad_lr`.
/// Additional right padding required to materialize a ceil-mode pooling
/// window. Nat subtraction saturates at zero, so floor-mode windows add none.
lam torch_pool_extra_hi
    (size kernel stride dilation padding output: Nat): Nat =
    let effective_kernel = %core.nat.add (
        %core.nat.mul (dilation, %core.nat.sub (kernel, 1)), 1);
    let required = %core.nat.add (
        %core.nat.mul (%core.nat.sub (output, 1), stride),
        effective_kernel);
    %core.nat.sub (required, %core.nat.add (size, %core.nat.mul (2, padding)));

/// Python: `return 1`, the channel axis of an NCHW tensor.
lam torch_channel_dim {r: Nat}: Idx r = %core.idx r 0 1;

/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.add.html
/// Types: two same-shape `Arithmetic` tensors and same-dtype `alpha` to the same tensor type.
axm %torch.binary(add): [A: %torch.Arithmetic]
                  → {r: Nat, s: «r; Nat»}
                  → [lhs: «s; A#R#T», rhs: «s; A#R#T», alpha: A#R#T]
                  → «s; A#R#T»;
lam %torch.binary_impl.add [A: %torch.Arithmetic]
                       {r: Nat, s: «r; Nat»}
                       (lhs: «s; A#R#T», rhs: «s; A#R#T»,
                        alpha: A#R#T): «s; A#R#T» =
    let scaled_rhs = %tensor.unary_impl @(A#R#T, A#R#T)
        (torch_scale_scalar A alpha) @(r, s) rhs;
    %tensor.binary_impl @(A#R#T, A#R#T, A#R#T)
        A#R#add @(r, s) (lhs, scaled_rhs);

/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.sub.html
/// Types: two same-shape `Arithmetic` tensors and same-dtype `alpha` to the same tensor type.
axm %torch.binary(sub): [A: %torch.Arithmetic]
                  → {r: Nat, s: «r; Nat»}
                  → [lhs: «s; A#R#T», rhs: «s; A#R#T», alpha: A#R#T]
                  → «s; A#R#T»;
lam %torch.binary_impl.sub [A: %torch.Arithmetic]
                       {r: Nat, s: «r; Nat»}
                       (lhs: «s; A#R#T», rhs: «s; A#R#T»,
                        alpha: A#R#T): «s; A#R#T» =
    let scaled_rhs = %tensor.unary_impl @(A#R#T, A#R#T)
        (torch_scale_scalar A alpha) @(r, s) rhs;
    %tensor.binary_impl @(A#R#T, A#R#T, A#R#T)
        A#sub @(r, s) (lhs, scaled_rhs);

/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.mul.html
/// Types: two same-shape `Arithmetic` tensors to a tensor of the same shape and element type.
axm %torch.binary(mul): [A: %torch.Arithmetic]
                  → {r: Nat, s: «r; Nat»}
                  → [lhs: «s; A#R#T», rhs: «s; A#R#T»]
                  → «s; A#R#T»;
lam %torch.binary_impl.mul [A: %torch.Arithmetic]
                       {r: Nat, s: «r; Nat»}
                       (lhs: «s; A#R#T», rhs: «s; A#R#T»): «s; A#R#T» =
    %tensor.binary_impl @(A#R#T, A#R#T, A#R#T) A#R#mul @(r, s) (lhs, rhs);

/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.div.html
/// Types: two same-shape `Arithmetic` tensors to a tensor of the same shape and element type.
axm %torch.binary(div): [A: %torch.Arithmetic]
                  → {r: Nat, s: «r; Nat»}
                  → [lhs: «s; A#R#T», rhs: «s; A#R#T»]
                  → «s; A#R#T»;
lam %torch.binary_impl.div [A: %torch.Arithmetic]
                       {r: Nat, s: «r; Nat»}
                       (lhs: «s; A#R#T», rhs: «s; A#R#T»): «s; A#R#T» =
    %tensor.binary_impl @(A#R#T, A#R#T, A#R#T) A#div @(r, s) (lhs, rhs);

/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.add.html
/// Types: an `Arithmetic` tensor plus same-dtype `alpha * other`.
axm %torch.binary(add_scalar): [A: %torch.Arithmetic]
                         → {r: Nat, s: «r; Nat»}
                         → [input: «s; A#R#T», other alpha: A#R#T]
                         → «s; A#R#T»;
lam %torch.binary_impl.add_scalar [A: %torch.Arithmetic]
                              {r: Nat, s: «r; Nat»}
                              (input: «s; A#R#T», other alpha: A#R#T): «s; A#R#T» =
    let scaled_other = A#R#mul (other, alpha);
    %tensor.unary_impl @(A#R#T, A#R#T)
        (torch_add_scalar A scaled_other) @(r, s) input;

/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.add.html
/// Types: an I64 tensor and I64 scalar to a shape-preserving I64 tensor.
axm %torch.binary(add_i64_scalar): {r: Nat, s: «r; Nat»}
                             → [input: «s; I64», other alpha: I64]
                             → «s; I64»;
lam %torch.binary_impl.add_i64_scalar {r: Nat, s: «r; Nat»}
                                  (input: «s; I64», other alpha: I64): «s; I64» =
    let scaled_other = %core.wrap.mul 0 (other, alpha);
    %tensor.unary_impl @(I64, I64)
        (torch_add_i64_scalar scaled_other) @(r, s) input;

/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.sub.html
/// Types: an `Arithmetic` tensor minus same-dtype `alpha * other`.
axm %torch.binary(sub_scalar): [A: %torch.Arithmetic]
                         → {r: Nat, s: «r; Nat»}
                         → [input: «s; A#R#T», other alpha: A#R#T]
                         → «s; A#R#T»;
lam %torch.binary_impl.sub_scalar [A: %torch.Arithmetic]
                              {r: Nat, s: «r; Nat»}
                              (input: «s; A#R#T», other alpha: A#R#T): «s; A#R#T» =
    let scaled_other = A#R#mul (other, alpha);
    %tensor.unary_impl @(A#R#T, A#R#T)
        (torch_sub_scalar A scaled_other) @(r, s) input;

/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.add.html
/// Types: scalar `self` plus `alpha` times a same-dtype tensor.
axm %torch.binary(add_scalar_lhs): [A: %torch.Arithmetic]
                             → {r: Nat, s: «r; Nat»}
                             → [self: A#R#T, other: «s; A#R#T», alpha: A#R#T]
                             → «s; A#R#T»;
lam %torch.binary_impl.add_scalar_lhs [A: %torch.Arithmetic]
                                  {r: Nat, s: «r; Nat»}
                                  (self: A#R#T, other: «s; A#R#T»,
                                   alpha: A#R#T): «s; A#R#T» =
    %tensor.unary_impl @(A#R#T, A#R#T)
        (torch_add_scalar_lhs A (self, alpha)) @(r, s) other;

/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.sub.html
/// Types: scalar `self` minus `alpha` times a same-dtype tensor.
axm %torch.binary(sub_scalar_lhs): [A: %torch.Arithmetic]
                             → {r: Nat, s: «r; Nat»}
                             → [self: A#R#T, other: «s; A#R#T», alpha: A#R#T]
                             → «s; A#R#T»;
lam %torch.binary_impl.sub_scalar_lhs [A: %torch.Arithmetic]
                                  {r: Nat, s: «r; Nat»}
                                  (self: A#R#T, other: «s; A#R#T»,
                                   alpha: A#R#T): «s; A#R#T» =
    %tensor.unary_impl @(A#R#T, A#R#T)
        (torch_sub_scalar_lhs A (self, alpha)) @(r, s) other;

/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.sub.html
/// Types: an I64 tensor and I64 scalar to a shape-preserving I64 tensor.
axm %torch.binary(sub_i64_scalar): {r: Nat, s: «r; Nat»}
                             → [input: «s; I64», other alpha: I64]
                             → «s; I64»;
lam %torch.binary_impl.sub_i64_scalar {r: Nat, s: «r; Nat»}
                                  (input: «s; I64», other alpha: I64): «s; I64» =
    let scaled_other = %core.wrap.mul 0 (other, alpha);
    %tensor.unary_impl @(I64, I64)
        (torch_sub_i64_scalar scaled_other) @(r, s) input;

/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.ne.html
/// Types: an I64 tensor and scalar to a same-shape Bool tensor.
axm %torch.comparison(ne_i64_scalar): {r: Nat, s: «r; Nat»}
                            → [input: «s; I64», other: I64]
                            → «s; Bool»;
lam %torch.comparison_impl.ne_i64_scalar {r: Nat, s: «r; Nat»}
                                 (input: «s; I64», other: I64): «s; Bool» =
    %tensor.unary_impl @(I64, Bool)
        (torch_ne_i64_scalar other) @(r, s) input;

/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.eq.html
/// Types: an I64 tensor and scalar to a same-shape Bool tensor.
axm %torch.comparison(eq_i64_scalar): {r: Nat, s: «r; Nat»}
                            → [input: «s; I64», other: I64]
                            → «s; Bool»;
lam %torch.comparison_impl.eq_i64_scalar {r: Nat, s: «r; Nat»}
                                 (input: «s; I64», other: I64): «s; Bool» =
    %tensor.unary_impl @(I64, Bool)
        (torch_eq_i64_scalar other) @(r, s) input;

/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.lt.html
/// Types: an I64 tensor and scalar to a same-shape Bool tensor.
axm %torch.comparison(lt_i64_scalar): {r: Nat, s: «r; Nat»}
                            → [input: «s; I64», other: I64] → «s; Bool»;
lam %torch.comparison_impl.lt_i64_scalar {r: Nat, s: «r; Nat»}
                                 (input: «s; I64», other: I64): «s; Bool» =
    %tensor.unary_impl @(I64, Bool)
        (torch_lt_i64_scalar other) @(r, s) input;

/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.le.html
/// Types: an I64 tensor and scalar to a same-shape Bool tensor.
axm %torch.comparison(le_i64_scalar): {r: Nat, s: «r; Nat»}
                            → [input: «s; I64», other: I64] → «s; Bool»;
lam %torch.comparison_impl.le_i64_scalar {r: Nat, s: «r; Nat»}
